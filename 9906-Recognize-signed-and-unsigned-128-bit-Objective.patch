From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: designonet <271930877+designonet@users.noreply.github.com>
Date: Thu, 15 Oct 2026 11:34:41 +0800
Subject: [PATCH] 9906: Recognize signed and unsigned 128-bit Objective-C type
 encodings

---
 .../util/bin/format/objc/objc1/Objc1TypeEncodings.java | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/bin/format/objc/objc1/Objc1TypeEncodings.java b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/bin/format/objc/objc1/Objc1TypeEncodings.java
index 1ccdc5ba07..2c0a3a1c36 100644
--- a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/bin/format/objc/objc1/Objc1TypeEncodings.java
+++ b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/bin/format/objc/objc1/Objc1TypeEncodings.java
@@ -39,6 +39,8 @@ public final class Objc1TypeEncodings {
 	public final static char _C_ULNG = 'L';
 	public final static char _C_LNG_LNG = 'q';
 	public final static char _C_ULNG_LNG = 'Q';
+	public final static char _C_INT128 = 't';
+	public final static char _C_UINT128 = 'T';
 	public final static char _C_FLT = 'f';
 	public final static char _C_DBL = 'd';
 	public final static char _C_BOOL = 'B';
@@ -291,6 +293,14 @@ public final class Objc1TypeEncodings {
 				buffer.deleteCharAt(0);
 				return new TypedefDataType("unsigned long long", new QWordDataType());
 			}
+			case _C_INT128: {
+				buffer.deleteCharAt(0);
+				return new Integer16DataType();
+			}
+			case _C_UINT128: {
+				buffer.deleteCharAt(0);
+				return new UnsignedInteger16DataType();
+			}
 			case _C_FLT: {
 				buffer.deleteCharAt(0);
 				return new FloatDataType();
-- 
2.45.1

