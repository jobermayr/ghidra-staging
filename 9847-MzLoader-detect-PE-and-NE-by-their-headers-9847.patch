From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Berg <github@slipsprogrammor.no>
Date: Mon, 12 Oct 2026 12:49:54 +0200
Subject: [PATCH] 9847: MzLoader: detect PE and NE by their headers- #9847

MzLoader: add tests for PE and NE detection

Since GP-6991, MzLoader offers no load spec for an MZ file whose
e_lfanew lies inside the file, which most DOS executables have:
PortableExecutable and NewExecutable do not throw on a missing
header, only on a read past the end of the file. testAcceptsMz and
testAcceptsMzWithLeHeader fail until the next commit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

MzLoader: detect PE and NE by their headers

PortableExecutable and NewExecutable leave the NT or Windows header
null when there is none, so isPeOrNe() returned true for any e_lfanew
inside the file, including the common 0. Check the headers, as
PeLoader and NeLoader do.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../ghidra/app/util/opinion/MzLoader.java     |  15 +-
 .../ghidra/app/util/opinion/MzLoaderTest.java | 132 ++++++++++++++++++
 2 files changed, 137 insertions(+), 10 deletions(-)
 create mode 100644 Ghidra/Features/Base/src/test/java/ghidra/app/util/opinion/MzLoaderTest.java

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/MzLoader.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/MzLoader.java
index 68f56b238b..cfba27855e 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/MzLoader.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/MzLoader.java
@@ -137,19 +137,14 @@ public class MzLoader extends AbstractLibrarySupportLoader {
 	 */
 	private boolean isPeOrNe(ByteProvider provider) {
 		try {
-			new PortableExecutable(provider, SectionLayout.FILE, false, false);
-			return true;
+			PortableExecutable pe =
+				new PortableExecutable(provider, SectionLayout.FILE, false, false);
+			return pe.getNTHeader() != null ||
+				new NewExecutable(provider, null).getWindowsHeader() != null;
 		}
 		catch (IOException e) {
-			try {
-				new NewExecutable(provider, null);
-				return true;
-			}
-			catch (IOException e2) {
-				// fall through
-			}
+			return false;
 		}
-		return false;
 	}
 
