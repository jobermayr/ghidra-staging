From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rudy Celekli <rudy@gradiahq.com>
Date: Wed, 14 Oct 2026 15:19:20 -0400
Subject: [PATCH] 9865: Capture SuperH source values before predecrement stores

Capture SuperH source values before predecrement stores

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 Ghidra/Processors/SuperH/data/languages/superh.sinc | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Processors/SuperH/data/languages/superh.sinc b/Ghidra/Processors/SuperH/data/languages/superh.sinc
index a8c7401a90..55d318fba8 100644
--- a/Ghidra/Processors/SuperH/data/languages/superh.sinc
+++ b/Ghidra/Processors/SuperH/data/languages/superh.sinc
@@ -285,20 +285,23 @@ disppc2: @(disp,pc) is disp_00_07 & pc
 
 :mov.b  rm_04_07,@-rn_08_11  is opcode_12_15=0b0010 & rn_08_11 & rm_04_07 & opcode_00_03=0b0100 
 {
+    local value = rm_04_07:1;
     rn_08_11 = rn_08_11 -1;
-    *:1 rn_08_11 = rm_04_07:1;
+    *:1 rn_08_11 = value;
 }
 
 :mov.w  rm_04_07,@-rn_08_11  is opcode_12_15=0b0010 & rn_08_11 & rm_04_07 & opcode_00_03=0b0101 
 {
+    local value = rm_04_07:2;
     rn_08_11 = rn_08_11 -2;
-    *:2 rn_08_11 = rm_04_07:2;
+    *:2 rn_08_11 = value;
 }
 
 :mov.l  rm_04_07,@-rn_08_11  is opcode_12_15=0b0010 & rn_08_11 & rm_04_07 & opcode_00_03=0b0110 
 {
+    local value = rm_04_07;
     rn_08_11 = rn_08_11 -4;
-    *:4 rn_08_11 = rm_04_07;
+    *:4 rn_08_11 = value;
 }
 
 :mov.b  @(disp_00_03,rm_04_07),r0  is r0 & opcode_08_15=0b10000100 & rm_04_07 & disp_00_03  
-- 
