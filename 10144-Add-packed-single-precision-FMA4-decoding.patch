 @include "avx512_bmm.sinc"
 @include "gfni.sinc"
 @include "avx_vnni.sinc"
+@include "fma4.sinc"
 @include "adx.sinc"
 @include "clwb.sinc"
 @include "pclmulqdq.sinc"
