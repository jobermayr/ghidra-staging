 <Yeking@Red54.com>
Date: Sun, 26 Jul 2026 18:58:58 +0800
Subject: [PATCH] 9448: Add support for linux_loongarch_64.

---
 GPL/DemanglerGnu/build.gradle                 |  2 ++
 GPL/GnuDisassembler/buildGdis.gradle          |  5 ++++-
 GPL/nativePlatforms.gradle                    | 19 +++++++++++++++++++
 Ghidra/Features/BSim/support/make-postgres.sh |  2 ++
 .../Features/Decompiler/buildNatives.gradle   |  4 ++++
 .../Features/FileFormats/buildNatives.gradle  |  1 +
 .../java/ghidra/framework/Architecture.java   |  1 +
 .../main/java/ghidra/framework/Platform.java  |  4 ++++
 gradle/hasProtobuf.gradle                     |  5 ++++-
 9 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/GPL/DemanglerGnu/build.gradle b/GPL/DemanglerGnu/build.gradle
index 1fa482295e..cef2471660 100644
--- a/GPL/DemanglerGnu/build.gradle
+++ b/GPL/DemanglerGnu/build.gradle
@@ -80,6 +80,7 @@ model {
 			targetPlatform "win_arm_64"
 			targetPlatform "linux_x86_64"
 			targetPlatform "linux_arm_64"
+			targetPlatform "linux_loongarch_64"
 			targetPlatform "mac_x86_64"
 			targetPlatform "mac_arm_64"
 			targetPlatform "freebsd_x86_64"
@@ -106,6 +107,7 @@ model {
 			targetPlatform "win_arm_64"
 			targetPlatform "linux_x86_64"
 			targetPlatform "linux_arm_64"
+			targetPlatform "linux_loongarch_64"
 			targetPlatform "mac_x86_64"
 			targetPlatform "mac_arm_64"
 			targetPlatform "freebsd_x86_64"
diff --git a/GPL/GnuDisassembler/buildGdis.gradle b/GPL/GnuDisassembler/buildGdis.gradle
index 3f3a85de26..0955d667b6 100644
--- a/GPL/GnuDisassembler/buildGdis.gradle
+++ b/GPL/GnuDisassembler/buildGdis.gradle
@@ -4,7 +4,7 @@
 
 defaultTasks 'assemble'
 
-ext.supportedPlatforms = ['mac_x86_64', 'mac_arm_64', 'linux_x86_64', 'linux_arm_64']
+ext.supportedPlatforms = ['mac_x86_64', 'mac_arm_64', 'linux_x86_64', 'linux_arm_64', 'linux_loongarch_64']
 
 ext.binutilsResource = new File("${binutilsLocation}/${binutils}.tar.bz2")
 
@@ -57,6 +57,9 @@ model {
 	tasks.compileGdisLinux_arm_64ExecutableGdisC {
 		dependsOn 'copyBinutilsArtifcats_linux_arm_64'
 	}
+	tasks.compileGdisLinux_loongarch_64ExecutableGdisC {
+		dependsOn 'copyBinutilsArtifcats_linux_loongarch_64'
+	}
 	
 }
 
diff --git a/GPL/nativePlatforms.gradle b/GPL/nativePlatforms.gradle
index 5d832b2b14..6ace12f728 100644
--- a/GPL/nativePlatforms.gradle
+++ b/GPL/nativePlatforms.gradle
@@ -24,6 +24,7 @@ project.ext.PLATFORMS = [
 	[name: "win_arm_64", os: "windows", arch: "arm64"],
 	[name: "linux_x86_64", os: "linux", arch: "x86_64"],
 	[name: "linux_arm_64", os: "linux", arch: "arm64"],
+	[name: "linux_loongarch_64", os: "linux", arch: "loongarch64"],
 	[name: "mac_x86_64", os: "osx", arch: "x86_64"],
 	[name: "mac_arm_64", os: "osx", arch: "arm64"],
 	[name: "freebsd_x86_64", os: "freebsd", arch: "x86_64"],
@@ -82,6 +83,10 @@ ext.getCurrentPlatformName = {
 		case "arm64":
 			arch = "arm_64"
 			break
+		case "loongarch64":
+		case "loong64":
+			arch = "loongarch_64"
+			break
 		default:
 			throw new GradleException("Unrecognized platform architecture: $arch" )
 	}
@@ -191,6 +196,20 @@ ext.isCurrentArm_64 = {
 	return isArm_64(getCurrentPlatformName())
 }
 
+/*********************************************************************************
+ * Returns true if the given platform is Loongarch.
+ *********************************************************************************/
+ext.isLoongarch_64 = { platform_name ->
+	return platform_name.contains("loongarch")
+}
+
+/*********************************************************************************
+ * Returns true if the current platform is Loongarch.
+ *********************************************************************************/
+ext.isCurrentLoongarch_64 = {
+	return isLoongarch_64(getCurrentPlatformName())
+}
+
 /****************************************************************************
  * Establish Visual Studio configuration environment for Windows native builds
  * NOTE: vsconfig.gradle path is relative to each GPL project module
diff --git a/Ghidra/Features/BSim/support/make-postgres.sh b/Ghidra/Features/BSim/support/make-postgres.sh
index 2e81a9df7d..7f63712b82 100755
--- a/Ghidra/Features/BSim/support/make-postgres.sh
+++ b/Ghidra/Features/BSim/support/make-postgres.sh
@@ -98,6 +98,8 @@ elif [ "$ARCH" = "x86_64" ]; then
 	OSDIR="linux_x86_64"
 elif [ "$ARCH" = "aarch64" ]; then
 	OSDIR="linux_arm_64"
+elif [ "$ARCH" = "loongarch64" ]; then
+	OSDIR="linux_loongarch_64"
 else
 	echo "Unsupported platform: $OS $ARCH"
 	exit -1	
diff --git a/Ghidra/Features/Decompiler/buildNatives.gradle b/Ghidra/Features/Decompiler/buildNatives.gradle
index 566c9ace0d..431528f0d6 100644
--- a/Ghidra/Features/Decompiler/buildNatives.gradle
+++ b/Ghidra/Features/Decompiler/buildNatives.gradle
@@ -200,6 +200,7 @@ model {
 			targetPlatform "win_arm_64"
 			targetPlatform "linux_x86_64"
 			targetPlatform "linux_arm_64"
+			targetPlatform "linux_loongarch_64"
 			targetPlatform "mac_x86_64"
 			targetPlatform "mac_arm_64"
 			targetPlatform "freebsd_x86_64"
@@ -246,6 +247,7 @@ model {
 			targetPlatform "win_arm_64"
 			targetPlatform "linux_x86_64"
 			targetPlatform "linux_arm_64"
+			targetPlatform "linux_loongarch_64"
 			targetPlatform "mac_x86_64"
 			targetPlatform "mac_arm_64"
 			targetPlatform "freebsd_x86_64"
@@ -306,6 +308,7 @@ model {
 				baseName "decomp_dbg"
 				targetPlatform "linux_x86_64"
 				targetPlatform "linux_arm_64"
+				targetPlatform "linux_loongarch_64"
 				targetPlatform "mac_x86_64"
 				targetPlatform "mac_arm_64"
 				targetPlatform "freebsd_x86_64"
@@ -356,6 +359,7 @@ model {
 			sleigh_dbg(NativeExecutableSpec) {
 				targetPlatform "linux_x86_64"
 				targetPlatform "linux_arm_64"
+				targetPlatform "linux_loongarch_64"
 				targetPlatform "mac_x86_64"
 				targetPlatform "mac_arm_64"
 				targetPlatform "freebsd_x86_64"
diff --git a/Ghidra/Features/FileFormats/buildNatives.gradle b/Ghidra/Features/FileFormats/buildNatives.gradle
index 010f09bd60..1dd2c9c676 100644
--- a/Ghidra/Features/FileFormats/buildNatives.gradle
+++ b/Ghidra/Features/FileFormats/buildNatives.gradle
@@ -32,6 +32,7 @@ model {
 			targetPlatform "win_arm_64"
 			targetPlatform "linux_x86_64"
 			targetPlatform "linux_arm_64"
+			targetPlatform "linux_loongarch_64"
 			targetPlatform "mac_x86_64"
 			targetPlatform "mac_arm_64"
 			targetPlatform "freebsd_x86_64"
diff --git a/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Architecture.java b/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Architecture.java
index 1b0c7c37cd..f31dc4673b 100644
--- a/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Architecture.java
+++ b/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Architecture.java
@@ -21,6 +21,7 @@ public enum Architecture {
 	POWERPC("ppc"),
 	POWERPC_64("ppc64"),
 	ARM_64("aarch64", "arm64"),
+	LOONGARCH_64("loongarch64", "loong64"),
 	UNKNOWN("Unknown Architecture");
 
 	/**
diff --git a/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Platform.java b/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Platform.java
index a970a5cc6d..babc6d0672 100644
--- a/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Platform.java
+++ b/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Platform.java
@@ -43,6 +43,9 @@ public enum Platform {
 	/// Identifies a Linux ARM 64-bit OS
 	LINUX_ARM_64(OperatingSystem.LINUX, Architecture.ARM_64, "linux_arm_64", ".so", ""),
 
+	/// Identifies a Linux Loongarch 64-bit OS
+	LINUX_LOONGARCH_64(OperatingSystem.LINUX, Architecture.LOONGARCH_64, "linux_loongarch_64", ".so", ""),
+
 	/// Identifies a macOS x86 32-bit OS
 	MAC_X86_32(OperatingSystem.MAC_OS_X, Architecture.X86, "mac_x86_32", ".dylib", ""),
 
@@ -129,6 +132,7 @@ public enum Platform {
 			paths.add("/lib64");
 			paths.add("/lib/x86_64-linux-gnu");
 			paths.add("/lib/aarch64-linux-gnu");
+			paths.add("/lib/loongarch64-linux-gnu");
 			paths.add("/usr/bin");
 			paths.add("/usr/lib");
 			paths.add("/usr/X11R6/bin");
diff --git a/gradle/hasProtobuf.gradle b/gradle/hasProtobuf.gradle
index 537c51fb65..1722b11046 100644
--- a/gradle/hasProtobuf.gradle
+++ b/gradle/hasProtobuf.gradle
@@ -41,9 +41,12 @@ dependencies {
 		if (platform.endsWith("x86_64")) {
 			protocArtifact "com.google.protobuf:protoc:${version}:linux-x86_64@exe"
 		}
-		else {
+		else if (platform.endsWith("arm_64")) {
 			protocArtifact "com.google.protobuf:protoc:${version}:linux-aarch_64@exe"
 		}
+		else {
+			protocArtifact files('/usr/bin/protoc')
+		}
 	}
 	if (isCurrentMac()) {
 		if (platform.endsWith("x86_64")) {
