Subject: [PATCH] 10161: ARM: fix SRSDA/SRSDB LR/SPSR store order

ARM: fix SRSDA/SRSDB LR/SPSR store order

SRSDA/SRSDB stored SPSR below LR. Per the ARM ARM, LR goes to MemA[address] and SPSR to MemA[address+4], so the decrement forms must store with increasing addresses like SRSIA/SRSIB. Writeback (sp-8) preserved.

ARM: fix SRS decrement-form addresses (wordhigher is P==U)

The previous commit put the LR/SPSR pair in the wrong blocks: SRSDA
must store [sp-4,sp] and SRSDB [sp-8,sp-4] per the ARM ARM decode
(increment is U==1, wordhigher is P==U), matching the RFE loads they
pair with. Keep the LR-low/SPSR-high order and the sp-8 writeback.
---
 .../data/languages/ARMTHUMBinstructions.sinc  | 10 ++++----
 .../ARM/data/languages/ARMinstructions.sinc   | 24 +++++++++----------
 2 files changed, 16 insertions(+), 18 deletions(-)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
index 9d8d0e5c9d..5a59733916 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
@@ -10222,20 +10222,20 @@ thdXtop: "X" is thc0404=1 & Rm0003       { local tmpRm0003 = Rm0003; tmp:2 = tmp
 {
   build ItCond;
   # register list is always: r14, spsr
-  ptr:4 = sp - 4;
+  ptr:4 = sp - 8;
   *ptr = lr;
-  ptr = ptr - 4;
+  ptr = ptr + 4;
   *ptr = spsr;
-  sp = ptr;
+  sp = ptr - 4;
 }
 
 :srsdb^ItCond sp,thSRSMode 		is TMode=1 & ItCond & op6=0x3a0 & sp & thc0505=0 & thc0004=0xd; op8=0xc0 & sop0507=0 & thSRSMode
 {
   build ItCond;
   # register list is always: r14, spsr
-  ptr:4 = sp - 4;
+  ptr:4 = sp - 8;
   *ptr = lr;
-  ptr = ptr - 4;
+  ptr = ptr + 4;
   *ptr = spsr;
 }
 
diff --git a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
index ad776bd773..15174bd67e 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
@@ -2708,19 +2708,19 @@ SetMode: "#"^31  is c0004=0x1f  { setSystemMode(); }
 :srsda SRSMode 		is $(AMODE) & ARMcond=0 & cond=15 & c2527=4 & P24=0 & U23=0 & W21=0 & S22=1 & L20=0 & c1215=0 & c0811=5 & c0507=0 & SRSMode
 {
   # register list is always: r14, spsr
-  ptr:4 = sp;
+  ptr:4 = sp - 4;
   *ptr = lr;
-  ptr = ptr - 4;
+  ptr = ptr + 4;
   *ptr = spsr;
-  ptr = ptr - 4;
+  ptr = ptr + 4;
 }
 
 :srsdb SRSMode 		is $(AMODE) & ARMcond=0 & cond=15 & c2527=4 & P24=1 & U23=0 & W21=0 & S22=1 & L20=0 & c1215=0 & c0811=5 & c0507=0 & SRSMode
 {
   # register list is always: r14, spsr
-  ptr:4 = sp - 4;
+  ptr:4 = sp - 8;
   *ptr = lr;
-  ptr = ptr - 4;
+  ptr = ptr + 4;
   *ptr = spsr;
 }
 
@@ -2748,23 +2748,21 @@ SetMode: "#"^31  is c0004=0x1f  { setSystemMode(); }
 :srsda SRSMode! 		is $(AMODE) & ARMcond=0 & cond=15 & c2527=4 & P24=0 & U23=0 & W21=1 & S22=1 & L20=0 & c1215=0 & c0811=5 & c0507=0 & SRSMode
 {
   # register list is always: r14, spsr
-  ptr:4 = sp;
+  ptr:4 = sp - 4;
   *ptr = lr;
-  ptr = ptr - 4;
+  ptr = ptr + 4;
   *ptr = spsr;
-  ptr = ptr - 4;
-  sp = ptr;
+  sp = ptr - 8;
 }
 
 :srsdb SRSMode! 		is $(AMODE) & ARMcond=0 & cond=15 & c2527=4 & P24=1 & U23=0 & W21=1 & S22=1 & L20=0 & c1215=0 & c0811=5 & c0507=0 & SRSMode
 {
   # register list is always: r14, spsr
-  ptr:4 = sp;
-  ptr = ptr - 4;
+  ptr:4 = sp - 8;
   *ptr = lr;
-  ptr = ptr - 4;
+  ptr = ptr + 4;
   *ptr = spsr;
-  sp = ptr;
+  sp = ptr - 4;
 }
 
