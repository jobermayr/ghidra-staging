From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leon Zandman <leon@wirwar.com>
Date: Mon, 19 Oct 2026 21:56:27 +0200
Subject: [PATCH] 9969: Swift demangler: apply labels, not functions, to data
 symbols

Label Swift data symbols instead of creating functions on
 them

The Swift demangler created a function at Swift symbols that name data:
async function pointers (Tu), coroutine function pointers (Twc),
dynamically replaceable function keys (Tx) and variables (TX), outlined
variables (Tv), outlined read-only objects (Tv...r) and accessible
function records (HF). These marker kinds were not in
SwiftDemangledNodeKind, so SwiftGlobalNode ignored the marker and
demangled the next child as a DemangledFunction. Add the kinds and make
SwiftGlobalNode return an unknown (label) for them, so the symbol gets a
label rather than a function.
---
 .../swift/SwiftDemangledNodeKind.java         |   7 +
 .../swift/nodes/SwiftGlobalNode.java          |   9 ++
 .../demangler/swift/SwiftDemanglerTest.java   | 143 ++++++++++++++++++
 3 files changed, 159 insertions(+)

diff --git a/Ghidra/Features/Swift/src/main/java/ghidra/app/util/demangler/swift/SwiftDemangledNodeKind.java b/Ghidra/Features/Swift/src/main/java/ghidra/app/util/demangler/swift/SwiftDemangledNodeKind.java
index 181a63e393..3cfa41c051 100644
--- a/Ghidra/Features/Swift/src/main/java/ghidra/app/util/demangler/swift/SwiftDemangledNodeKind.java
+++ b/Ghidra/Features/Swift/src/main/java/ghidra/app/util/demangler/swift/SwiftDemangledNodeKind.java
@@ -25,19 +25,24 @@ import ghidra.app.util.demangler.swift.nodes.SwiftNode;
 public enum SwiftDemangledNodeKind {
 	//@formatter:off
 	
+	AccessibleFunctionRecord,
 	Allocator,
 	AnonymousDescriptor,
 	ArgumentTuple,
+	AsyncFunctionPointer,
 	BoundGenericStructure,
 	BuiltinTypeName,
 	Class,
 	Constructor,
+	CoroFunctionPointer,
 	Deallocator,
 	DefaultArgumentInitializer,
 	DependentGenericParamType,
 	DependentGenericType,
 	Destructor,
 	DispatchThunk,
+	DynamicallyReplaceableFunctionKey,
+	DynamicallyReplaceableFunctionVar,
 	Enum,
 	Extension,
 	FirstElementMarker,
@@ -65,6 +70,8 @@ public enum SwiftDemangledNodeKind {
 	ObjCAttribute,
 	OutlinedConsume,
 	OutlinedCopy,
+	OutlinedReadOnlyObject,
+	OutlinedVariable,
 	Owned,
 	PrivateDeclName,
 	Protocol,
diff --git a/Ghidra/Features/Swift/src/main/java/ghidra/app/util/demangler/swift/nodes/SwiftGlobalNode.java b/Ghidra/Features/Swift/src/main/java/ghidra/app/util/demangler/swift/nodes/SwiftGlobalNode.java
index 769f8c9d3b..fb4af335db 100644
--- a/Ghidra/Features/Swift/src/main/java/ghidra/app/util/demangler/swift/nodes/SwiftGlobalNode.java
+++ b/Ghidra/Features/Swift/src/main/java/ghidra/app/util/demangler/swift/nodes/SwiftGlobalNode.java
@@ -37,6 +37,15 @@ public class SwiftGlobalNode extends SwiftNode {
 				case MergedFunction:
 				case ObjCAttribute:
 					continue;
+				case AccessibleFunctionRecord:
+				case AsyncFunctionPointer:
+				case CoroFunctionPointer:
+				case DynamicallyReplaceableFunctionKey:
+				case DynamicallyReplaceableFunctionVar:
+				case OutlinedReadOnlyObject:
+				case OutlinedVariable:
+					// The symbol is data that belongs to the entity in the next child, not its code
+					return getUnknown();
 				case Suffix:
 					suffix = child.demangle(demangler);
 					break;
diff --git a/Ghidra/Features/Swift/src/test/java/ghidra/app/util/demangler/swift/SwiftDemanglerTest.java b/Ghidra/Features/Swift/src/test/java/ghidra/app/util/demangler/swift/SwiftDemanglerTest.java
index 73f93f2aec..1694ff8df1 100644
