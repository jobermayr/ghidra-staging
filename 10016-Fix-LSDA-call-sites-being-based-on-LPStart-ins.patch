From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mi11ione <i@mi11ion.io>
Date: Sat, 24 Oct 2026 15:43:41 +0200
Subject: [PATCH] 10016: Fix LSDA call sites being based on LPStart instead of
 the function start

---
 .../gccexcepttable/LSDACallSiteRecord.java           |  2 +-
 .../structures/gccexcepttable/LSDAHeaderTest.java    | 12 ++++++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/exceptionhandlers/gcc/structures/gccexcepttable/LSDACallSiteRecord.java b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/exceptionhandlers/gcc/structures/gccexcepttable/LSDACallSiteRecord.java
index 5736962a48..328a98068f 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/exceptionhandlers/gcc/structures/gccexcepttable/LSDACallSiteRecord.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/exceptionhandlers/gcc/structures/gccexcepttable/LSDACallSiteRecord.java
@@ -88,7 +88,7 @@ public class LSDACallSiteRecord extends GccAnalysisClass {
 
 		Address lpStart = region.getLSDATable().getHeader().getLPStartAddress();
 
-		Address callSiteBaseAddr = lpStart.add(getCallSitePosition());
+		Address callSiteBaseAddr = region.getRangeStart().add(getCallSitePosition());
 		Address callSiteExtentAddr = callSiteBaseAddr.add(getCallSiteLength() - 1);
 
 		callSiteRange = new AddressRangeImpl(callSiteBaseAddr, callSiteExtentAddr);
diff --git a/Ghidra/Features/Base/src/test/java/ghidra/app/plugin/exceptionhandlers/gcc/structures/gccexcepttable/LSDAHeaderTest.java b/Ghidra/Features/Base/src/test/java/ghidra/app/plugin/exceptionhandlers/gcc/structures/gccexcepttable/LSDAHeaderTest.java
index 66ddf14c0d..35f561b8b9 100644
--- a/Ghidra/Features/Base/src/test/java/ghidra/app/plugin/exceptionhandlers/gcc/structures/gccexcepttable/LSDAHeaderTest.java
+++ b/Ghidra/Features/Base/src/test/java/ghidra/app/plugin/exceptionhandlers/gcc/structures/gccexcepttable/LSDAHeaderTest.java
@@ -50,6 +50,18 @@ public class LSDAHeaderTest extends AbstractGenericTest {
 		builder.dispose();
 	}
 
+	@Test
+	public void testCallSiteRelativeToFunctionStart() throws Exception {
+		builder.setBytes("0x1000",
+			"1b 4e 00 00 00 1b 0d 01 04 08 04 11 01 01 00 00 f4 02 00 00");
+
+		LSDACallSiteRecord record =
+			createTable().getCallSiteTable().getCallSiteRecords().get(0);
+
+		assertEquals(addr(0x1008), record.getCallSite().getMinAddress());
+		assertEquals(addr(0x1060), record.getLandingPad());
+	}
+
 	@Test
 	public void testSingleByteTTypeOffset() throws Exception {
 		builder.setBytes("0x1000", "ff 1b 0d 01 04 00 02 02 01 01 00 00 f4 02 00 00");
-- 
2.45.1

