From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joel Pasapera <108155277+JoelPasapera@users.noreply.github.com>
Date: Sat, 7 Nov 2026 23:01:07 -0500
Subject: [PATCH] 10165: ARM: fix QASX/QSAX halfword exchange and saturation

10138: ARM: QASX/QSAX exchange halfwords and saturate before
 truncating

ARM: fix QASX/QSAX halfword exchange and saturation
---
 .../data/languages/ARMTHUMBinstructions.sinc  | 28 +++++++------------
 .../ARM/data/languages/ARMinstructions.sinc   | 28 +++++++------------
 2 files changed, 20 insertions(+), 36 deletions(-)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
index 4eb43b085a..bb7996e702 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
@@ -9441,15 +9441,11 @@ thspsrmask: spsr^thpsrmask	is thpsrmask & spsr { export thpsrmask; }
 :qasx^ItCond   Rd0811,Rn0003,Rm0003    is TMode=1 & ItCond & op4=0xfaa & Rn0003; op12=0xf & Rd0811 & thc0407=0x1 & Rm0003
 {
   build ItCond;
-  local lRn = Rn0003 & 0xffff;
-  local lRm = Rm0003 & 0xffff;
-  local uRn = (Rn0003 >> 16) & 0xffff;
-  local uRm = (Rm0003 >> 16) & 0xffff;
-  sum1:2 = lRn:2 - lRm:2;
-  sum1 = SignedSaturate(sum1,16:2);
-  sum2:2 = uRn:2 + uRm:2;
-  sum2 = SignedSaturate(sum2,16:2);
-  Rd0811 = (zext(sum2) << 16) | zext(sum1);
+  local lo:4 = sext(Rn0003[ 0,16]) - sext(Rm0003[16,16]);
+  local hi:4 = sext(Rn0003[16,16]) + sext(Rm0003[ 0,16]);
+  local satlo:4 = SignedSaturate(lo, 16:2);
+  local sathi:4 = SignedSaturate(hi, 16:2);
+  Rd0811 = (zext(sathi[0,16]) << 16) | zext(satlo[0,16]);
 }
 
 @endif # VERSION_6
@@ -9488,15 +9484,11 @@ thspsrmask: spsr^thpsrmask	is thpsrmask & spsr { export thpsrmask; }
 :qsax^ItCond   Rd0811,Rn0003,Rm0003    is TMode=1 & ItCond & op4=0xfae & Rn0003; op12=0xf & Rd0811 & thc0407=0x1 & Rm0003
 {
   build ItCond;
-  local lRn = Rn0003 & 0xffff;
-  local lRm = Rm0003 & 0xffff;
-  local uRn = (Rn0003 >> 16) & 0xffff;
-  local uRm = (Rm0003 >> 16) & 0xffff;
-  sum1:2 = lRn:2 + lRm:2;
-  sum1 = SignedSaturate(sum1,16:2);
-  sum2:2 = uRn:2 - uRm:2;
-  sum2 = SignedSaturate(sum2,16:2);
-  Rd0811 = (zext(sum2) << 16) | zext(sum1);
+  local lo:4 = sext(Rn0003[ 0,16]) + sext(Rm0003[16,16]);
+  local hi:4 = sext(Rn0003[16,16]) - sext(Rm0003[ 0,16]);
+  local satlo:4 = SignedSaturate(lo, 16:2);
+  local sathi:4 = SignedSaturate(hi, 16:2);
+  Rd0811 = (zext(sathi[0,16]) << 16) | zext(satlo[0,16]);
 }
 
 @endif # VERSION_6
diff --git a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
index 7323604103..11074d0a68 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
@@ -12014,15 +12014,11 @@ ArmPCRelImmed12: reloff		is U23=0 & immed & rotate
 :qasx^COND  Rd, Rn, Rm    is $(AMODE) & ARMcond=1 & COND & c2027=0x62 & c0811=15 & c0407=3 & Rn & Rd & Rm
 {
   build COND;
-  local lRn = Rn & 0xffff;
-  local lRm = Rm & 0xffff;
-  local uRn = (Rn >> 16) & 0xffff;
-  local uRm = (Rm >> 16) & 0xffff;
-  sum1:2 = lRn:2 - lRm:2;
-  sum1 = SignedSaturate(sum1,16:2);
-  sum2:2 = uRn:2 + uRm:2;
-  sum2 = SignedSaturate(sum2,16:2);
-  Rd = (zext(sum2) << 16) | zext(sum1);
+  local lo:4 = sext(Rn[ 0,16]) - sext(Rm[16,16]);
+  local hi:4 = sext(Rn[16,16]) + sext(Rm[ 0,16]);
+  local satlo:4 = SignedSaturate(lo, 16:2);
+  local sathi:4 = SignedSaturate(hi, 16:2);
+  Rd = (zext(sathi[0,16]) << 16) | zext(satlo[0,16]);
 }
 
 @endif # VERSION_6
@@ -12061,15 +12057,11 @@ ArmPCRelImmed12: reloff		is U23=0 & immed & rotate
 :qsax^COND  Rd, Rn, Rm    is $(AMODE) & ARMcond=1 & COND & c2027=0x62 & c0811=15 & c0407=5 & Rn & Rd & Rm
 {
   build COND;
-  local lRn = Rn & 0xffff;
-  local lRm = Rm & 0xffff;
-  local uRn = (Rn >> 16) & 0xffff;
-  local uRm = (Rm >> 16) & 0xffff;
-  sum1:2 = lRn:2 + lRm:2;
-  sum1 = SignedSaturate(sum1,16:2);
-  sum2:2 = uRn:2 - uRm:2;
-  sum2 = SignedSaturate(sum2,16:2);
-  Rd = (zext(sum2) << 16) | zext(sum1);
+  local lo:4 = sext(Rn[ 0,16]) + sext(Rm[16,16]);
+  local hi:4 = sext(Rn[16,16]) - sext(Rm[ 0,16]);
+  local satlo:4 = SignedSaturate(lo, 16:2);
+  local sathi:4 = SignedSaturate(hi, 16:2);
+  Rd = (zext(sathi[0,16]) << 16) | zext(satlo[0,16]);
 }
 
 @endif # VERSION_6
-- 
