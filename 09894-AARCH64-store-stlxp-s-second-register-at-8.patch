From: Priyanshu Kumar <priyanshukumarpu@gmail.com>
Date: Wed, 14 Oct 2026 22:28:34 +0530
Subject: [PATCH] 09894: AARCH64: store stlxp's second register at +8

---
 Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index bec203b358..4507f62cb3 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -6149,7 +6149,7 @@ is size.ldstr=3 & b_2429=0x8 & b_23=0 & L=0 & b_21=1 & Rs_GPR32 & b_15=1 & Rt2_G
 	check:1 = ExclusiveMonitorPass(addrReg, rsize);
 	if (!check) goto <fail>;
 	*addrReg = Rt_GPR64;
-	*(addrReg + 4) = Rt2_GPR64;
+	*(addrReg + 8) = Rt2_GPR64;
 	LORelease();
 	status = ExclusiveMonitorsStatus();
 <fail>
