From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Simon=20Sch=C3=B6n?= <sschoen@acecom.de>
Date: Fri, 16 Oct 2026 04:41:42 +0200
Subject: [PATCH] 09930: Decompiler: fix use-after-free in
 SplitDatatype::splitStore

---
 .../src/decompile/cpp/include/ghidra/subflow.hh          | 2 +-
 Ghidra/Features/Decompiler/src/decompile/cpp/subflow.cc  | 9 +++++++--
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/subflow.hh b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/subflow.hh
index f4faecb9b3..9c348173bb 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/subflow.hh
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/subflow.hh
@@ -280,7 +280,7 @@ class SplitDatatype {
   public:
     bool find(PcodeOp *op,Datatype *valueType,ResolveCache &resolver);	///< Locate root pointer for underlying LOAD or STORE
     void duplicateToTemp(Funcdata &data,PcodeOp *followOp);	///< COPY the root varnode into a temp register
-    void freePointerChain(Funcdata &data);	///< Remove unused pointer calculations
+    void freePointerChain(Funcdata &data,RootPointer *other=(RootPointer *)0);	///< Remove unused pointer calculations
   };
   Funcdata &data;			///< The containing function
   TypeFactory *types;			///< The data-type container
diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/subflow.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/subflow.cc
index 7c10c4a562..fc4babbb5f 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/subflow.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/subflow.cc
@@ -2200,12 +2200,17 @@ void SplitDatatype::RootPointer::duplicateToTemp(Funcdata &data,PcodeOp *followO
 /// If the pointer Varnode is no longer used, recursively check and remove the op producing it,
 /// which will be either an INT_ADD or PTRSUB, until the root \b pointer is reached or
 /// a Varnode still being used is encountered.
+/// If a second chain is given and it shares a Varnode with this chain, the shared remainder is freed here,
+/// and the other chain is marked as already freed, so that it does not access the destroyed Varnodes.
 /// \param data is the containing function
-void SplitDatatype::RootPointer::freePointerChain(Funcdata &data)
+/// \param other is another pointer chain that may share Varnodes with \b this (or null)
+void SplitDatatype::RootPointer::freePointerChain(Funcdata &data,RootPointer *other)
 
 {
   while (firstPointer != pointer && !firstPointer->isAddrTied() && firstPointer->hasNoDescend()) {
     PcodeOp *tmpOp = firstPointer->getDef();
+    if (other != (RootPointer *)0 && other->firstPointer == firstPointer)
+      other->firstPointer = other->pointer;	// Shared remainder of the chain is freed here
     firstPointer = tmpOp->getIn(0);
     data.opDestroy(tmpOp);
   }
@@ -2911,7 +2916,7 @@ bool SplitDatatype::splitStore(PcodeOp *storeOp,Datatype *outType)
 
   if (loadOp != (PcodeOp *)0) {
     data.opDestroy(loadOp);
-    loadRoot.freePointerChain(data);
+    loadRoot.freePointerChain(data,&storeRoot);
   }
   storeRoot.freePointerChain(data);
   return true;
-- 
