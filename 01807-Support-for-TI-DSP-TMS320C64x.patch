+++ b/Ghidra/Processors/TMS320C28x/data/languages/tms320c28x_f2812.pspec
@@ -0,0 +1,98 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  SPDX-License-Identifier: Apache-2.0
+  Copyright 2026 Nishanth Samala
+-->
+
+<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/processor_spec.rxg -->
+
+<!-- Processor spec for the TMS320F2812 (and the pin/memory-compatible F2810/F2811),
+     the original fixed-point C28x family (F281x). This is a DEVICE variant of the
+     shared C28x SLEIGH core: it reuses the same tms320c28x.sla and .cspec (the F2812
+     instruction set is a strict subset of the decoded ISA — no FPU/TMU/VCU/CLA), and
+     differs from the F2837xD default only in the DEVICE-specific memory map: the
+     peripheral (MMIO) frames and the interrupt vectors live at F281x addresses, not
+     F2837xD ones. Addresses are WORD addresses (the C28x is word-addressable; 1 addr
+     = 16 bits). Verified against the device datasheet SPRS174V (memory map Figure 9-13)
+     and the TI DSP281x header package (peripheral bases in DSP281x_Headers_nonBIOS.cmd). -->
+<processor_spec>
+  <programcounter register="PC"/>
+
+  <!-- Disable Ghidra's heuristic no-return / shared-return analyzers for this processor.
+       Same rationale as the F28377D pspec: on C28x images the heuristic "Non-Returning
+       Functions - Discovered" mis-marks flash-to-RAM copied functions (.ramfunc) as
+       non-returning and truncates their genuine flash callers into ?? data. Both stock
+       analyzers honor these language properties in getDefaultEnablement() (ARM's pspec does
+       the same). Re-enable per-program in Analysis Options if a specific image needs it. -->
+  <properties>
+    <property key="enableNoReturnAnalysis"     value="false"/>
+    <property key="enableSharedReturnAnalysis" value="false"/>
+  </properties>
+
+  <!-- AMODE context bit: 0 = C28x addressing modes (compiler default). -->
+  <context_data>
+    <context_set space="ram">
+      <set name="ctx_AMODE" val="0"/>
+      <!-- DP-relative @6bit resolution: "DP unknown" default; see tms320c28x.pspec. -->
+      <set name="ctx_DP"        val="0"/>
+      <set name="ctx_DP_valid"  val="0"/>
+    </context_set>
+  </context_data>
+
+  <!-- Peripheral-register (MMIO) ranges marked volatile so the decompiler never elides
+       or reorders reads/writes to hardware registers (a status poll or a write-to-clear
+       must not be optimized away). F2812 peripheral frames (SPRS174V, word addresses):
+         0x000800-0x000CFF  Peripheral Frame 0: DevEmu, Flash/OTP cfg, CSM, XINTF cfg,
+                            CPU timers 0/1/2, PIE control (PIECTRL/PIEACK/PIEIERx/PIEIFRx)
+         0x006000-0x006FFF  Peripheral Frame 1 (protected): eCAN-A (control regs +
+                            LAM/MOTS/MOTO + 32 mailboxes)
+         0x007000-0x007FFF  Peripheral Frame 2 (protected): SysCtrl/PLL/WD, SPI-A, SCI-A,
+                            external-interrupt, GPIO mux/data, ADC, EV-A, EV-B, SCI-B,
+                            McBSP-A
+       The PIE vector table at 0x000D00-0x000DFF is writable RAM (interrupt-pointer
+       table), NOT MMIO — deliberately left non-volatile so it reads as pointer data.
+       On-chip SARAM (M0/M1/L0/L1/H0) and flash are likewise NOT volatile. -->
+  <volatile outputop="write_volatile" inputop="read_volatile">
+    <range space="ram" first="0x000800" last="0x000CFF"/>
+    <range space="ram" first="0x006000" last="0x007FFF"/>
+  </volatile>
+
+  <default_symbols>
+    <!-- C28x CPU interrupt vector table, boot-ROM (BROM) vector map at 0x3FFFC0
+         (SPRU430F Table 3-1; enabled when VMAP=1, MP/MC=0, ENPIE=0). Word addresses.
+         On a device using the PIE (ENPIE=1) the live vectors are instead in the PIE
+         vector RAM at 0x000D00 (see PIE_VECT below) — these BROM names still correctly
+         label the reset/CPU vector fetch entries. -->
+    <symbol name="RESET"   address="ram:0x3FFFC0" entry="true"/>
+    <symbol name="INT1"    address="ram:0x3FFFC2"/>
+    <symbol name="INT2"    address="ram:0x3FFFC4"/>
+    <symbol name="INT3"    address="ram:0x3FFFC6"/>
+    <symbol name="INT4"    address="ram:0x3FFFC8"/>
+    <symbol name="INT5"    address="ram:0x3FFFCA"/>
+    <symbol name="INT6"    address="ram:0x3FFFCC"/>
+    <symbol name="INT7"    address="ram:0x3FFFCE"/>
+    <symbol name="INT8"    address="ram:0x3FFFD0"/>
+    <symbol name="INT9"    address="ram:0x3FFFD2"/>
+    <symbol name="INT10"   address="ram:0x3FFFD4"/>
+    <symbol name="INT11"   address="ram:0x3FFFD6"/>
+    <symbol name="INT12"   address="ram:0x3FFFD8"/>
+    <symbol name="INT13"   address="ram:0x3FFFDA"/>
+    <symbol name="INT14"   address="ram:0x3FFFDC"/>
+    <symbol name="DLOGINT" address="ram:0x3FFFDE"/>
+    <symbol name="RTOSINT" address="ram:0x3FFFE0"/>
+    <symbol name="NMI"     address="ram:0x3FFFE4"/>
+    <symbol name="ILLEGAL" address="ram:0x3FFFE6"/>
+    <symbol name="USER1"   address="ram:0x3FFFE8"/>
+    <symbol name="USER2"   address="ram:0x3FFFEA"/>
+    <symbol name="USER3"   address="ram:0x3FFFEC"/>
+    <symbol name="USER4"   address="ram:0x3FFFEE"/>
+    <symbol name="USER5"   address="ram:0x3FFFF0"/>
+    <symbol name="USER6"   address="ram:0x3FFFF2"/>
+    <symbol name="USER7"   address="ram:0x3FFFF4"/>
+    <symbol name="USER8"   address="ram:0x3FFFF6"/>
+    <symbol name="USER9"   address="ram:0x3FFFF8"/>
+    <symbol name="USER10"  address="ram:0x3FFFFA"/>
+    <symbol name="USER11"  address="ram:0x3FFFFC"/>
+    <symbol name="USER12"  address="ram:0x3FFFFE"/>
+  </default_symbols>
+</processor_spec>
diff --git a/Ghidra/Processors/TMS320C28x/data/languages/tms320c28x_flow.sinc b/Ghidra/Processors/TMS320C28x/data/languages/tms320c28x_flow.sinc
new file mode 100644
index 0000000000..cacf855c25
--- /dev/null
+++ b/Ghidra/Processors/TMS320C28x/data/languages/tms320c28x_flow.sinc
@@ -0,0 +1,245 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 Nishanth Samala
+# Copyright the mwdmwd/ghidra-c28x contributors (https://github.com/mwdmwd/ghidra-c28x)
+#
+# Portions adapted from mwdmwd/ghidra-c28x (Apache-2.0): the 0x3F program-page base
+# for the C2xLP X* family, which the xpmadest / xpmaval / xpmaaddr sub-tables below
+# resolve. See THIRD-PARTY.md.
+#
+# C28x control flow: branches, calls, returns.
+# Included by tms320c28x.sinc. Encodings verified against ch6_instruction_detail.txt.
+#
+# Highest-priority family after MOV: without branch/call/return the linear
+# disassembler dead-ends, so implementing these is what lifts real coverage and
+# connects functions (essential for following CAN ISR / setup code).
+#
+# PC is word-addressed; branch targets are PC-relative in words. `inst_next` is the
+# address of the following instruction; `inst_start` the current one.
+
+# =============================================================================
+# COND condition codes (4-bit, SPRU430F B-instruction table). The CC subtable
+# exports a 1-byte boolean = "branch taken". Flags live in ST0 (@define'd in the
+# .slaspec): $(Z) $(N) $(C) $(V) $(TC).
+# NOV/OV also CLEAR V: every COND user (B/SB/BF/XB/XCALL/XRETC, MOVL/MOVB ...,COND) reads
+# "if the V flag is tested by the condition, then V is cleared" in SPRU430F. V is otherwise
+# sticky -- the arithmetic ops only ever set it -- so this is how code consumes an overflow.
+# =============================================================================
+CC: "NEQ"   is cond4=0x0 { local c:1 = ($(Z) == 0);              export c; }
+CC: "EQ"    is cond4=0x1 { local c:1 = ($(Z) != 0);              export c; }
+CC: "GT"    is cond4=0x2 { local c:1 = (($(Z)==0) && ($(N)==0)); export c; }
+CC: "GEQ"   is cond4=0x3 { local c:1 = ($(N) == 0);              export c; }
+CC: "LT"    is cond4=0x4 { local c:1 = ($(N) != 0);              export c; }
+CC: "LEQ"   is cond4=0x5 { local c:1 = (($(Z)!=0) || ($(N)!=0)); export c; }
+CC: "HI"    is cond4=0x6 { local c:1 = (($(C)!=0) && ($(Z)==0)); export c; }
+CC: "HIS"   is cond4=0x7 { local c:1 = ($(C) != 0);              export c; }
+CC: "LO"    is cond4=0x8 { local c:1 = ($(C) == 0);              export c; }
+CC: "LOS"   is cond4=0x9 { local c:1 = (($(C)==0) || ($(Z)!=0)); export c; }
+CC: "NOV"   is cond4=0xa { local c:1 = ($(V) == 0); $(V) = 0;    export c; }
+CC: "OV"    is cond4=0xb { local c:1 = ($(V) != 0); $(V) = 0;    export c; }
+CC: "NTC"   is cond4=0xc { local c:1 = ($(TC) == 0);             export c; }
+CC: "TC"    is cond4=0xd { local c:1 = ($(TC) != 0);             export c; }
+CC: "NBIO"  is cond4=0xe { local c:1 = 0:1;                      export c; } # BIO not modeled
+CC: "UNC"   is cond4=0xf { local c:1 = 1:1;                      export c; } # unconditional
+
+# Parallel condition subtable for SB, where COND occupies bits 8..11 (cond4hi).
+CC8: "NEQ"  is cond4hi=0x0 { local c:1 = ($(Z) == 0);              export c; }
+CC8: "EQ"   is cond4hi=0x1 { local c:1 = ($(Z) != 0);              export c; }
+CC8: "GT"   is cond4hi=0x2 { local c:1 = (($(Z)==0) && ($(N)==0)); export c; }
+CC8: "GEQ"  is cond4hi=0x3 { local c:1 = ($(N) == 0);              export c; }
+CC8: "LT"   is cond4hi=0x4 { local c:1 = ($(N) != 0);              export c; }
+CC8: "LEQ"  is cond4hi=0x5 { local c:1 = (($(Z)!=0) || ($(N)!=0)); export c; }
+CC8: "HI"   is cond4hi=0x6 { local c:1 = (($(C)!=0) && ($(Z)==0)); export c; }
+CC8: "HIS"  is cond4hi=0x7 { local c:1 = ($(C) != 0);              export c; }
+CC8: "LO"   is cond4hi=0x8 { local c:1 = ($(C) == 0);              export c; }
+CC8: "LOS"  is cond4hi=0x9 { local c:1 = (($(C)==0) || ($(Z)!=0)); export c; }
+CC8: "NOV"  is cond4hi=0xa { local c:1 = ($(V) == 0); $(V) = 0;    export c; }
+CC8: "OV"   is cond4hi=0xb { local c:1 = ($(V) != 0); $(V) = 0;    export c; }
+CC8: "NTC"  is cond4hi=0xc { local c:1 = ($(TC) == 0);             export c; }
+CC8: "TC"   is cond4hi=0xd { local c:1 = ($(TC) != 0);             export c; }
+CC8: "NBIO" is cond4hi=0xe { local c:1 = 0:1;                      export c; }
+CC8: "UNC"  is cond4hi=0xf { local c:1 = 1:1;                      export c; }
+
+# =============================================================================
+# Branch targets
+# =============================================================================
+# PC-relative branch targets. The destination is a CODE address = address-of-this-
+# instruction + signed offset (in words). Computed in the disassembly action and
+# exported as a constant address via the special `*[ram]` form so goto/call can
+# use it and Ghidra shows/follows the absolute target.
+rel16dest: reloc  is simm16  [ reloc = inst_start + simm16; ] { export *[ram]:4 reloc; }
+rel8dest:  reloc  is simm8   [ reloc = inst_start + simm8;  ] { export *[ram]:4 reloc; }
+
+# =============================================================================
+# C2xLP program addresses (the X* family)
+# =============================================================================
+# SPRU430F forces the upper 6 bits of the 22-bit program address to 0x3F for EVERY
+# C2xLP source-compatible instruction -- "PC = 0x3F:pma", "[loc16] = Prog[0x3F:pma]",
+# "the C28x forces the upper 6 bits ... to 0x3F". So the 16-bit `pma` operand names a
+# location in the high 64K of program space (0x3F0000-0x3FFFFF), NOT the bare 16-bit
+# address. These instructions exist for hand-ported C2xLP assembly, which lived up
+# there; TI's C compiler does not emit them.
+#
+# BEWARE the near-identical NON-X forms, which force the page to 0x00 instead
+# (SPRU430F on `MAC P,loc16,*(pma)`: "P = signed T * signed Prog[0x00:pma]"). A plain
+# zext is correct for those and wrong for these, so this is not a family-wide search
+# and replace.
+#
+# Resolved in the disassembly action rather than computed at runtime, so Ghidra shows
+# and follows the real target and lays down a reference -- same reason as rel16dest.
+# The rendered operand is therefore the resolved 22-bit address where TI's dis2000
+# prints the raw 16-bit pma; that is the same absolute-vs-encoded operand difference
+# the parity harness already tolerates for every PC-relative branch.
+# Three exports of the same resolved address, because the three uses need different things:
+# a branch target, the data word AT the address (the `*[ram]` export is what gives Ghidra the
+# reference), and the address itself as a constant -- which the repeated forms need, since they
+# walk a shadow copy of it rather than dereferencing it once.
+xpmadest: reloc  is imm16  [ reloc = 0x3f0000 | imm16; ] { export *[ram]:4 reloc; }    # branch/call target
+xpmaval:  reloc  is imm16  [ reloc = 0x3f0000 | imm16; ] { export *[ram]:2 reloc; }    # 16-bit data word
+xpmaaddr: reloc  is imm16  [ reloc = 0x3f0000 | imm16; ] { export *[const]:4 reloc; }  # the address itself
+
+# ABSOLUTE 22-bit call/branch targets (LCR/LC/FFC/LB #22bit). word1 low 6 bits = addr[21:16],
+# word2 (imm16) = addr[15:0]. Like rel16dest, the destination subtable EXPORTs a ram varnode at the
+# constant address so `call`/`goto` records a real CALL/JUMP reference (a `call [local_varnode]` is a
+# computed branch and Ghidra logs NO xref → empty call graph).
+#
+# CRITICAL pattern-size rule learned the hard way: the address spans two 16-bit tokens (loc_off6 in
+# word1, imm16 in word2), so the subtable is intrinsically 2 words. A subtable referenced by `&` must
+# equal the parent's word-length; a parent matching only the opcode bits is 1 word → SLEIGH errors
+# "Mismatched pattern sizes -- 2 vs 1". Referencing it by `;` makes the subtable START at word2 (the
+# regression: every LCR mis-parsed across 3 words, decoding garbage targets + cascading halt_baddata).
+# The only correct form: the DESTINATION SUBTABLE matches the FULL 2-word instruction including the
+# opcode discriminator, and the parent constructor just references it (parent size == subtable size).
+# Hence one subtable per opcode (the discriminator bits differ). The *XARn indirect forms below stay
+# `call [reg]` — those are genuinely computed.
+lcrdest: reloc  is op_hi8=0x76 & op_lo_76=0b01 & loc_off6 ; imm16  [ reloc = (loc_off6 << 16) | imm16; ] { export *[ram]:4 reloc; }
+ffcdest: reloc  is op_hi8=0x00 & op_lo_76=0b11 & loc_off6 ; imm16  [ reloc = (loc_off6 << 16) | imm16; ] { export *[ram]:4 reloc; }
+
+# =============================================================================
+# Conditional branches
+# =============================================================================
+# B 16bitOffset,COND   1111 1111 1110 COND : CCCC CCCC CCCC CCCC
+:B rel16dest,CC  is rpt_phase=1 & op_hi8=0xFF & op_lo_hi4=0b1110 & cond4 & CC; simm16 & rel16dest {
+    if (CC) goto rel16dest;
+}
+
+# SB 8bitOffset,COND   0110 COND CCCC CCCC   (single word, 8-bit signed offset).
+# COND is in bits 8..11 here, so use the parallel CC8 subtable keyed on cond4hi.
+:SB rel8dest,CC8  is rpt_phase=1 & sb_grp=0b0110 & cond4hi & CC8 & rel8dest & simm8 {
+    if (CC8) goto rel8dest;
+}
+
+# UNCONDITIONAL branch forms — these MUST be a plain `goto`, not `if(UNC)goto`. The UNC row
+# of the CC/CC8 subtable exports a const-true guard, which SLEIGH compiles to a CBRANCH that
+# KEEPS a (dead) fall-through edge — the decompiler then prunes the fall-through-only blocks as
+# unreachable. A dedicated cond4=0xf / cond4hi=0xf constructor (more specific, so SLEIGH picks
+# it over the generic CC/CC8 form) emits a real BRANCH with no fall-through.
+:B  rel16dest,"UNC" is rpt_phase=1 & op_hi8=0xFF & op_lo_hi4=0b1110 & cond4=0xf ; simm16 & rel16dest { goto rel16dest; }
+:SB rel8dest,"UNC"  is rpt_phase=1 & sb_grp=0b0110 & cond4hi=0xf & rel8dest & simm8 { goto rel8dest; }
+
+# SBF 8bitOffset,EQ/NEQ/TC/NTC   1110 11SS CCCC CCCC  (Short Branch Fast, single word;
+# 8-bit signed word offset in the low byte). Four fixed condition encodings — EQ=0xEC
+# NEQ=0xED TC=0xEE NTC=0xEF. dis2000-confirmed (op_hi8=0xEE present in the DIR image).
+:SBF rel8dest,"EQ"   is rpt_phase=1 & op_hi8=0xEC & rel8dest & simm8  { if ($(Z) != 0)  goto rel8dest; }
+:SBF rel8dest,"NEQ"  is rpt_phase=1 & op_hi8=0xED & rel8dest & simm8  { if ($(Z) == 0)  goto rel8dest; }
+:SBF rel8dest,"TC"   is rpt_phase=1 & op_hi8=0xEE & rel8dest & simm8  { if ($(TC) != 0) goto rel8dest; }
+:SBF rel8dest,"NTC"  is rpt_phase=1 & op_hi8=0xEF & rel8dest & simm8  { if ($(TC) == 0) goto rel8dest; }
+
+# BANZ 16bitOffset,ARn--   0000 0000 0000 1nnn : CCCC CCCC CCCC CCCC
+# Branch if AR(n) != 0, then post-decrement AR(n).  Bits 7..3 of low byte = 00001.
+:BANZ rel16dest,banz_n^"--"  is rpt_phase=1 & op_hi8=0x00 & op_lo_hi5=0b00001 & banz_n; simm16 & rel16dest {
+    local taken:1 = (banz_n != 0);
+    banz_n = banz_n - 1;
+    if (taken) goto rel16dest;
+}
+
+# BAR 16bitOffset,ARn,ARm,EQ/NEQ    1000 1111 1CNNNMMM : ssss ssss ssss ssss
+# Branch-on-Auxiliary-Register-comparison (SPRU430F ch.6). Two-word: word1 low byte
+# encodes (bit7=1 fixed, bit6=cond 0=EQ/1=NEQ, bits5:3=ARn, bits2:0=ARm); word2 is
+# the 16-bit signed PC-relative offset (target = inst_next + simm16). Verified
+# against asm2000 across all 8 register combinations + both conditions.
+:BAR rel16dest, bar_arn, loc_areg16, "EQ"
+  is rpt_phase=1 & op_hi8=0x8F & loc_b7=1 & bar_condbit=0 & bar_arn & loc_areg16
+   ; simm16 & rel16dest
+{
+    if (bar_arn == loc_areg16) goto rel16dest;
+}
+:BAR rel16dest, bar_arn, loc_areg16, "NEQ"
+  is rpt_phase=1 & op_hi8=0x8F & loc_b7=1 & bar_condbit=1 & bar_arn & loc_areg16
+   ; simm16 & rel16dest
+{
+    if (bar_arn != loc_areg16) goto rel16dest;
+}
+
+# BF 16bitOffset,COND   0101 0110 1100 COND : CCCC CCCC CCCC CCCC  (branch fast,
+# PC-relative like B). word1 = 0x56C0 | COND; word2 = signed offset. The COND lives
+# in the low nibble of word1 (cond4); the rel target uses word2 (simm16).
+:BF rel16dest,CC  is rpt_phase=1 & op_hi8=0x56 & loc_hi4=0b1100 & cond4 & CC; simm16 & rel16dest {
+    if (CC) goto rel16dest;
+}
+
+# =============================================================================
+# Long / indirect calls and returns
+# =============================================================================
+# CALL-SITE DP INVALIDATION: TI's C ABI does NOT preserve DP across calls -- callees
+# reload it (MOVW/MOVZ DP,#imm) before any @6bit access. So the ctx_DP snapshot the
+# caller flowed forward is stale at the fall-through / return address. Every call
+# constructor globalset(inst_next, ctx_DP_valid=0), which forces the ctx_DP_valid=0
+# branch of the loc16/loc32 @6bit sub-tables (i.e. runtime DP register expression)
+# until the next MOVW/MOVZ DP re-arms it. Without this we'd emit resolved absolute
+# addresses using the caller's DP for any @6bit access that follows a return but
+# precedes the next explicit DP load -- a wrong-XREF class bug that's hard to spot.
+#
+# LCR #22bit          0111 0110 01CC CCCC : CCCC CCCC CCCC CCCC  (call using RPC)
+# The target is an ABSOLUTE 22-bit address: word1 low 6 bits = addr[21:16],
+# word2 = addr[15:0]. (NOT pc-relative — the earlier rel16dest version computed
+# inst_start+simm16, so every LCR pointed back at itself; in unlinked .objs the
+# field is a 0 reloc placeholder, which made it look like a self-call.)
+:LCR lcrdest  is rpt_phase=1 & lcrdest
+        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ] {
+    # RPC nested-call save/restore is NOT modeled here on purpose. Pushing the OLD RPC
+    # (a live-in register, unlike x86's constant inst_next) made the decompiler treat the
+    # store as an unprovable write into the caller's own frame, so every local degraded to
+    # an offset off a roaming frame pointer and return addresses surfaced as data values.
+    # The chain is emulated in TMS320C28xEmulateInstructionStateModifier instead.
+    # inst_next>>1 = word return address (wordsize=2 space).
+    RPC = inst_next >> 1;
+    call lcrdest;
+}
+
+# LCR *XARn           0011 1110 0110 0RRR  (indirect call using RPC)
+:LCR "*"loc_areg  is rpt_phase=1 & op_hi8=0x3E & op_lo_35=0b01100 & loc_areg
+        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ] {
+    RPC = inst_next >> 1;   # nested-call chain: see the LCR #22bit note above.
+    call [loc_areg];
+}
+
+# FFC XAR7,#22bit     0000 0000 11CC CCCC : CCCC CCCC CCCC CCCC  (fast call; return
+# PC saved in XAR7, ABSOLUTE 22-bit target). word1 low 6 bits = addr[21:16].
+:FFC "XAR7,"ffcdest  is rpt_phase=1 & ffcdest
+        [ ctx_DP_valid = 0; globalset(inst_next, ctx_DP_valid); ] {
+    XAR7 = inst_next >> 1;
+    call ffcdest;
+}
+
+# LRETR               0000 0000 0000 0110   (long return using RPC)
+:LRETR  is rpt_phase=1 & op16=0x0006 {
+    # Mirror of LCR: the caller-RPC pop is emulated in the state modifier, not here.
+    return [RPC];
+}
+
+# LRET                0111 0110 0001 0100
+:LRET   is rpt_phase=1 & op16=0x7614 {
+    # 22-bit return address was pushed as two words; pop the 32-bit value off SP.
+    SP = SP - 2;
+    local addr:4 = SP;
+    local t:4 = *[ram]:4 addr;
+    return [t];
+}
+
+# IRET                0111 0110 0000 0010   (interrupt return)
+:IRET   is rpt_phase=1 & op16=0x7602 {
+    SP = SP - 2;
+    local addr:4 = SP;
+    local t:4 = *[ram]:4 addr;
+    return [t];
+}
