Subject: [PATCH] 10106: ARM: decode Thumb-2 STMIA sp! as stm.w, not push.w

---
 .../ARM/data/languages/ARMTHUMBinstructions.sinc          | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
index a55d17a203..7bc149e68f 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
@@ -9349,14 +9349,6 @@ thspsrmask: spsr^thpsrmask	is thpsrmask & spsr { export thpsrmask; }
    return [pc];
 }
 
-:push^ItCond^".w"    thstrlist_dec           is TMode=1 & ItCond & op0=0xe8ad; thc1515=0 & thc1313=0 & thstrlist_dec
-{
-   build ItCond;
-   mult_addr = sp-4;
-   build thstrlist_dec;
-   sp = mult_addr + 4;
-}
-
 :push^ItCond^".w"    Rt1215           is TMode=1 & ItCond & op0=0xf84d; Rt1215 & offset12=0xd04
 {
    build ItCond;
