From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Laxmi Narayan Behera <lnb@lnbfederal.com>
Date: Wed, 4 Nov 2026 13:32:43 -0500
Subject: [PATCH] 10128: ARM: add Advanced SIMD VFMS (vector)

---
 Ghidra/Processors/ARM/data/languages/ARMneon.sinc | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMneon.sinc b/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
index 173c654c3b..13f77af079 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
@@ -2665,6 +2665,7 @@ define pcodeop VectorRoundHalvingAdd;
 define pcodeop VectorRoundAddAndNarrow;
 define pcodeop VectorDotProduct;
 define pcodeop vectorFusedMultiplyAccumulate;
+define pcodeop vectorFusedMultiplySubtract;
 define pcodeop BfloatMultiplyAccumulate;
 define pcodeop VectorMultiplyAddLongVector;
 define pcodeop VectorMultiplyAddLongScalar;
@@ -2867,6 +2868,18 @@ extImm: "#"^thv_c0811	is TMode=1 & thv_c0811	{ tmp:1 = thv_c0811; export tmp; }
 	Qd = vectorFusedMultiplyAccumulate(Qn, Qm, fesize2020);
 }
 
+:vfms.f^fesize2020 Dd,Dn,Dm  is ( ( $(AMODE) & ARMcond=0 & cond=15 & c2327=4 &     c2121=1 &     c0811=0xc &     c0606=0  &     c0404=1 ) |
+                                ($(TMODE_E) &     thv_c2327=0x1e & thv_c2121=1 & thv_c0811=0xc & thv_c0606=0  & thv_c0404=1) ) & fesize2020 & Dd & Dn & Dm
+{
+	Dd = vectorFusedMultiplySubtract(Dn, Dm, fesize2020);
+}
+
+:vfms.f^fesize2020 Qd,Qn,Qm  is ( ( $(AMODE) & ARMcond=0 & cond=15 & c2327=4 &     c2121=1 &     c0811=0xc &     c0606=1  &     c0404=1 ) |
+                                ($(TMODE_E) &     thv_c2327=0x1e & thv_c2121=1 & thv_c0811=0xc & thv_c0606=1  & thv_c0404=1) ) & fesize2020 & Qd & Qn & Qm
+{
+	Qd = vectorFusedMultiplySubtract(Qn, Qm, fesize2020);
+}
+
 
 # Floating-point Multiply-Accumulate BFloat (vector)
 :vfmab.BF16 Qd,Qn,Qm  is ( ($(AMODE) & ARMcond=0 & cond=15 & c2327=0x18 &     c2021=0x3 &     c0811=8 &     c0606=0  &     c0404=1 ) |
-- 
2.45.1

