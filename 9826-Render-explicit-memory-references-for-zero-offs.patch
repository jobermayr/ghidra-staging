From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rudy Celekli <rudy@gradiahq.com>
Date: Tue, 13 Oct 2026 10:58:40 -0400
Subject: [PATCH] 9826: Render explicit memory references for zero-offset
 operands

Render a sole zero scalar with its explicit memory reference

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../ghidra/program/model/listing/CodeUnitFormat.java  | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/program/model/listing/CodeUnitFormat.java b/Ghidra/Features/Base/src/main/java/ghidra/program/model/listing/CodeUnitFormat.java
index 4c4c170a17..6b8f6230f3 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/program/model/listing/CodeUnitFormat.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/program/model/listing/CodeUnitFormat.java
@@ -1551,13 +1551,13 @@ public class CodeUnitFormat {
 		InstructionScalarInfo(List<Object> representationList, Reference primaryRef) {
 
 			this.representationList = representationList;
-			boolean hasZeroScalar = false;
+			int zeroScalarCount = 0;
 			int size = representationList.size();
 			for (int i = 0; i < size; i++) {
 				Object obj = representationList.get(i);
 				if (obj instanceof Scalar) {
 					if (((Scalar) obj).getUnsignedValue() == 0) {
-						hasZeroScalar = true;
+						++zeroScalarCount;
 					}
 					else {
 						++scalarCount;
@@ -1573,8 +1573,11 @@ public class CodeUnitFormat {
 				}
 			}
 
-			if (hasZeroScalar && scalarCount == 0 && addressCount == 0 && primaryRef == null) {
-				// only process zero scalar when no other scalar or address found and no reference
+			if (zeroScalarCount > 0 && scalarCount == 0 && addressCount == 0 &&
+				(primaryRef == null ||
+					(zeroScalarCount == 1 && primaryRef.isMemoryReference()))) {
+				// Process a sole zero scalar for an explicit memory reference as well as the
+				// existing no-reference case. Other scalars or addresses remain preferred.
 				++scalarCount;
 				processZeroScalar = true;
 			}
