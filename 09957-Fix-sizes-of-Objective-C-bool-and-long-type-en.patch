From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher Pruijsen <christopher.pruijsen@gmail.com>
Date: Mon, 19 Oct 2026 10:28:49 +0100
Subject: [PATCH] 09957: Fix sizes of Objective-C bool and long type encodings

---
 .../app/util/bin/format/objc/objc1/Objc1TypeEncodings.java  | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/bin/format/objc/objc1/Objc1TypeEncodings.java b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/bin/format/objc/objc1/Objc1TypeEncodings.java
index ef52ee16bd..7d14e99421 100644
--- a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/bin/format/objc/objc1/Objc1TypeEncodings.java
+++ b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/bin/format/objc/objc1/Objc1TypeEncodings.java
@@ -286,11 +286,11 @@ public final class Objc1TypeEncodings {
 			}
 			case _C_LNG: {
 				buffer.deleteCharAt(0);
-				return new TypedefDataType("long", new QWordDataType());
+				return new TypedefDataType("long", new DWordDataType());
 			}
 			case _C_ULNG: {
 				buffer.deleteCharAt(0);
-				return new TypedefDataType("unsigned long", new QWordDataType());
+				return new TypedefDataType("unsigned long", new DWordDataType());
 			}
 			case _C_LNG_LNG: {
 				buffer.deleteCharAt(0);
@@ -318,7 +318,7 @@ public final class Objc1TypeEncodings {
 			}
 			case _C_BOOL: {
 				buffer.deleteCharAt(0);
-				return new TypedefDataType("bool", new DWordDataType());
+				return new TypedefDataType("bool", new BooleanDataType());
 			}
 			case _C_VOID: {
 				buffer.deleteCharAt(0);
-- 
2.45.1

