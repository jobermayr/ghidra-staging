-sla_dbg/%.o:	%.cc
-	$(CXX) $(ARCH_TYPE) -c $(DBG_CXXFLAGS) $(INCLUDES) $(ADDITIONAL_FLAGS) $(SLEIGH_DEBUG)      $< -o $@
-sla_opt/%.o:	%.cc
