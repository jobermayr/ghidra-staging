From: Rudy Celekli <rudy@gradiahq.com>
Date: Tue, 13 Oct 2026 11:00:02 -0400
Subject: [PATCH] 9789: Stop canceled monitored output before writing bytes

Honor cancellation before monitored output writes and small
 file copies

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../main/java/ghidra/util/MonitoredOutputStream.java  | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/Ghidra/Framework/Utility/src/main/java/ghidra/util/MonitoredOutputStream.java b/Ghidra/Framework/Utility/src/main/java/ghidra/util/MonitoredOutputStream.java
index 430735620f..d190d642e8 100644
--- a/Ghidra/Framework/Utility/src/main/java/ghidra/util/MonitoredOutputStream.java
+++ b/Ghidra/Framework/Utility/src/main/java/ghidra/util/MonitoredOutputStream.java
@@ -17,6 +17,7 @@ package ghidra.util;
 
 import java.io.IOException;
 import java.io.OutputStream;
+import java.util.Objects;
 
 import ghidra.util.exception.IOCancelledException;
 import ghidra.util.task.TaskMonitor;
@@ -53,6 +54,9 @@ public class MonitoredOutputStream extends OutputStream {
 	 */
 	@Override
 	public void write(int b) throws IOException {
+		if (monitor.isCancelled()) {
+			throw new IOCancelledException();
+		}
 		out.write(b);
 		++smallCount;
 		if (smallCount >= PROGRESS_INCREMENT) {
@@ -108,6 +112,13 @@ public class MonitoredOutputStream extends OutputStream {
 	 */
 	@Override
 	public void write(byte b[], int off, int len) throws IOException {
+		Objects.checkFromIndexSize(off, len, b.length);
+		if (len == 0) {
+			return;
+		}
+		if (monitor.isCancelled()) {
+			throw new IOCancelledException();
+		}
 		out.write(b, off, len);
 		smallCount += len;
 
