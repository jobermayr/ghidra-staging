From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lzhMeow <2917269045@qq.com>
Date: Wed, 14 Oct 2026 20:36:14 +0800
Subject: [PATCH] 9877: Propagate PyGhidra console subprocess exit status

---
 Ghidra/Features/PyGhidra/support/pyghidra_launcher.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Features/PyGhidra/support/pyghidra_launcher.py b/Ghidra/Features/PyGhidra/support/pyghidra_launcher.py
index b5d3371103..a4988b6c2a 100644
--- a/Ghidra/Features/PyGhidra/support/pyghidra_launcher.py
+++ b/Ghidra/Features/PyGhidra/support/pyghidra_launcher.py
@@ -318,7 +318,7 @@ def main() -> None:
     else:
         py_args += ['pyghidra', '-g', '--install-dir', str(install_dir)]
     if args.console:
-        subprocess.call(py_args + remaining)
+        sys.exit(subprocess.call(py_args + remaining))
     else:
         creation_flags = getattr(subprocess, 'CREATE_NO_WINDOW', 0)
         subprocess.Popen(py_args + remaining, creationflags=creation_flags, stdout=DEVNULL, stderr=DEVNULL)
-- 
