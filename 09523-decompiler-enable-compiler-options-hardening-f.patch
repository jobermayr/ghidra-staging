From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Meow <mdev73677@gmail.com>
Date: Tue, 18 Aug 2026 23:59:32 +0200
Subject: [PATCH] 09523: decompiler: enable compiler options hardening for C
 and C++

Compiler Options Hardening for C++
---
 .../Features/Decompiler/buildNatives.gradle   | 53 ++++++++++---------
 1 file changed, 28 insertions(+), 25 deletions(-)

diff --git a/Ghidra/Features/Decompiler/buildNatives.gradle b/Ghidra/Features/Decompiler/buildNatives.gradle
index c0438240cc..1a863fde2e 100644
--- a/Ghidra/Features/Decompiler/buildNatives.gradle
+++ b/Ghidra/Features/Decompiler/buildNatives.gradle
@@ -220,6 +220,31 @@ def linkBFDUnix(String compilerCmd) {
 	return lFlags
 }
 
+def getOptFlags(NativeBinarySpec b) {
+	def optFlags = []
+	if (project.hasProperty('debug')) {
+		optFlags += "-g"
+	}
+	if (project.hasProperty('opt')) {
+		optFlags += "-O2"
+	}
+	if (project.hasProperty('lto')) {
+		optFlags += "-flto"
+	}
+	if (project.hasProperty('hardening')) {
+		optFlags += "-fstack-protector-strong"
+		optFlags += "-fstack-clash-protection"
+		optFlags += "-fPIE"
+		optFlags += "-Wl,-z,relro"
+		optFlags += "-Wl,-z,now"
+		optFlags += "-pie"
+	}
+	b.cppCompiler.args.addAll optFlags
+	b.cCompiler.args.addAll optFlags
+	b.linker.args.addAll optFlags
+}
+			
+
 /*
  * Define the "native build model" for building the decompiler executables.
  * Options:
@@ -229,6 +254,7 @@ def linkBFDUnix(String compilerCmd) {
  * -Pwait	Wait for debugger to set startDebug = true
  * -Plto	Enable Link Time Optimization (not for debug interfaces (-Pcli), disable on Windows with -Pnolto)
  * -Popt	Build optimized with GCC / Clang (disable on Windows with -Pnoopt)
+ * -Phardening  
  * -PsysZlib	Build against system zlib (ignored for Windows)
  * -PsharedBfd	Link against a shared libbfd
  */
@@ -263,16 +289,7 @@ model {
 			}
 			binaries.all { b ->
 				if (b.toolChain in Gcc || b.toolChain in Clang) {
-					if (project.hasProperty('debug')) {
-						b.cppCompiler.args "-g"
-					}
-					if (project.hasProperty('opt')) {
-						b.cppCompiler.args "-O2"
-					}
-					if (project.hasProperty('lto')) {
-						b.cppCompiler.args "-flto"
-						b.linker.args "-flto"
-					}
+					getOptFlags(b)
 					if (project.hasProperty('gdb')) {
 						b.cppCompiler.define "GDB_BT"
 					}
@@ -318,24 +335,10 @@ model {
 			}
 			binaries.all { b ->
 				if (b.toolChain in Gcc || b.toolChain in Clang) {
-					if (project.hasProperty('debug')) {
-						b.cppCompiler.args "-g"
-						b.cCompiler.args "-g"
-					}
-					if (project.hasProperty('opt')) {
-						b.cppCompiler.args "-O2"
-						b.cCompiler.args "-O2"
-					}
+					getOptFlags(b)
 					if (project.hasProperty('sysZlib')) {
 						b.linker.args "-lz"
 					}
-					if (project.hasProperty('lto')) {
-						b.cppCompiler.args "-flto"
-						if (!project.hasProperty('sysZlib')) {
-							b.cCompiler.args "-flto"
-						}
-						b.linker.args "-flto"
-					}
 				}
 				if (isCurrentWindows() || !project.hasProperty('sysZlib')) {
 					b.cppCompiler.define "LOCAL_ZLIB"
-- 
