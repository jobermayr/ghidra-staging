Subject: [PATCH] 09827: Preserve complete path components in DWARF source
 normalization

Preserve dot-prefixed filenames in DWARF source path
 normalization

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../Base/src/main/java/ghidra/util/SourceFileUtils.java       | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/util/SourceFileUtils.java b/Ghidra/Features/Base/src/main/java/ghidra/util/SourceFileUtils.java
index 8c80185a65..d350f03350 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/util/SourceFileUtils.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/util/SourceFileUtils.java
@@ -187,7 +187,7 @@ public class SourceFileUtils {
 			throw new IllegalArgumentException("path not valid: " + e.getMessage());
 		}
 		int numDotDots = 0;
-		while (path.startsWith("/..")) {
+		while (path.equals("/..") || path.startsWith("/../")) {
 			path = path.substring(3);
 			numDotDots += 1;
 		}
@@ -195,7 +195,7 @@ public class SourceFileUtils {
 			if (!based) {
 				return path; // baseDir not necessary: path normalizes to absolute path without it 
 			}
-			if (path.startsWith("/" + baseDir)) {
+			if (path.equals("/" + baseDir) || path.startsWith("/" + baseDir + "/")) {
 				return path; // adding initial /baseDir was sufficient
 			}
 		}
