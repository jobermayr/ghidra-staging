 .../decompile/cpp/include/ghidra/subflow.hh   |  3 +
 .../Decompiler/src/decompile/cpp/subflow.cc   | 66 +++++++++++++++++++
 .../src/decompile/datatests/callwhole.xml     | 30 +++++++++
 4 files changed, 100 insertions(+)
 create mode 100644 Ghidra/Features/Decompiler/src/decompile/datatests/callwhole.xml

