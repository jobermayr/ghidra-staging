From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Sat, 3 Oct 2026 20:05:08 +0300
Subject: [PATCH] 9709: Set SPARC SDIVCC overflow below signed 32-bit minimum

Set SPARC SDIVCC overflow below signed 32-bit minimum.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 Ghidra/Processors/Sparc/data/languages/SparcV9.sinc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Processors/Sparc/data/languages/SparcV9.sinc b/Ghidra/Processors/Sparc/data/languages/SparcV9.sinc
index 6891cb1af8..a08309edbd 100644
--- a/Ghidra/Processors/Sparc/data/languages/SparcV9.sinc
+++ b/Ghidra/Processors/Sparc/data/languages/SparcV9.sinc
@@ -944,7 +944,7 @@ callreloff: reloc  is disp30 [reloc=inst_start+4*disp30;] { export *:$(SIZE) rel
 	local res:8 = numerator s/ denom;
 	zeroflags(res:4);
 	RD = sext(res:4);
-	i_vf = (res s>= 0x80000000) || (res s<= -0x7ffffffff);
+	i_vf = (res s>= 0x80000000) || (res s< -0x80000000);
 	i_cf = 0;
 	x_vf = 0;
 	x_cf = 0;
-- 
2.45.1

