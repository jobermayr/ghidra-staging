From 35bf936d5d78ae7c18ecd277796dc55085c7c5b5 Mon Sep 17 00:00:00 2001
From: Joel Pasapera <108155277+JoelPasapera@users.noreply.github.com>
Date: Sat, 31 Oct 2026 19:08:34 -0500
Subject: [PATCH] 10077: ARM: treat SUBS PC, LR, #imm as exception return

3688: ARM: treat SUBS PC, LR, #imm as exception return

Fixes #3688

`SUBS PC, LR, #<const>` (the ARMv4-v6 exception return, e.g. `subs pc, lr, #4`) was only
treated as a return when the immediate was 0. Any other immediate fell through to the
generic `sub pc` constructor, which emits `goto [pc]`, so the decompiler reported
"Could not recover jumptable" and showed an indirect call.

This adds a constructor for the S=1 form with Rn=LR and an immediate operand that keeps
the generic semantics (CPSR <- SPSR, Thumb mode taken from SPSR) but ends in `return [pc]`.
The existing `immed=0` constructor is restricted to S=0 so the two do not overlap.
The non-S `sub pc, lr, #imm` is unchanged.

Tested by compiling ARM4/4t/5/6/7/8 LE and ARM8 BE specs (no errors/conflicts) and
decompiling `mov r0,#1; subs pc,lr,#4` with the standalone decompiler:
- before: `(*(code *)(in_lr + -4))(1);` with jumptable warning
- after:  `return 1;`
---
 .../ARM/data/languages/ARMinstructions.sinc    | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
index 542d2fcd48a..302327abfb8 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
@@ -5736,7 +5736,7 @@ armEndianNess: "BE" is c0031=0xf1010200 { export 1:1; }
   goto [pc];
 }
 
-:sub^COND^SBIT_CZNO pc,rn,shift1 	is $(AMODE) & pc & ARMcond=1 & COND & c2124=2 & SBIT_CZNO & rn & Rd=15 & Rn=14 & I25=1 & immed=0 & rotate=0 & c2627=0 & shift1
+:sub^COND^SBIT_CZNO pc,rn,shift1 	is $(AMODE) & pc & ARMcond=1 & COND & c2124=2 & SBIT_CZNO & rn & Rd=15 & Rn=14 & I25=1 & S20=0 & immed=0 & rotate=0 & c2627=0 & shift1
 {
   build COND;
   build rn;
@@ -5750,6 +5750,22 @@ armEndianNess: "BE" is c0031=0xf1010200 { export 1:1; }
   return [pc];
 }
 
+# SUBS PC, LR, #<const> is the exception return (copies SPSR to CPSR)
+:sub^COND^SBIT_CZNO pc,rn,shift1 	is $(AMODE) & pc & ARMcond=1 & COND & c2124=2 & SBIT_CZNO & rn & Rd=15 & Rn=14 & I25=1 & S20=1 & c2627=0 & shift1
+{
+  build COND;
+  build rn;
+  build shift1;
+  subflags(rn,shift1);
+  dest:4 = rn-shift1;
+  resultflags(dest);
+  build SBIT_CZNO;
+  cpsr = spsr;
+  SetThumbMode( ((cpsr >> 5) & 1) != 0 );
+  pc = dest;
+  return [pc];
+}
+
 :sub^COND^SBIT_CZNO pc,rn,shift2 	is $(AMODE) & pc & ARMcond=1 & COND & c2124=2 & SBIT_CZNO & rn & Rd=15 & c2627=0 & shift2
 {
   build COND;
