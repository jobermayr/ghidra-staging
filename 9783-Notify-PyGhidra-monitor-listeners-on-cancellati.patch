Subject: [PATCH] 9783: Notify PyGhidra monitor listeners on cancellation

Notify PyGhidra task monitor listeners on cancellation

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../ghidra/pyghidra/PyGhidraTaskMonitor.java     | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/Ghidra/Features/PyGhidra/src/main/java/ghidra/pyghidra/PyGhidraTaskMonitor.java b/Ghidra/Features/PyGhidra/src/main/java/ghidra/pyghidra/PyGhidraTaskMonitor.java
index 0a10bd4887..1e79d37590 100644
--- a/Ghidra/Features/PyGhidra/src/main/java/ghidra/pyghidra/PyGhidraTaskMonitor.java
+++ b/Ghidra/Features/PyGhidra/src/main/java/ghidra/pyghidra/PyGhidraTaskMonitor.java
@@ -138,16 +138,24 @@ public class PyGhidraTaskMonitor implements TaskMonitor {
 	}
 
 	@Override
-	public void clearCancelled() {
+	public synchronized void clearCancelled() {
 		isCancelled = false;
 	}
 
 	@Override
 	public void cancel() {
-		if (timer != null) {
-			timer.cancel(); // Terminate the timer thread
+		synchronized (this) {
+			if (isCancelled) {
+				return;
+			}
+			if (timer != null) {
+				timer.cancel(); // Terminate the timer thread
+			}
+			isCancelled = true;
+		}
+		for (CancelledListener listener : listeners) {
+			listener.cancelled();
 		}
-		isCancelled = true;
 	}
 
 	@Override
