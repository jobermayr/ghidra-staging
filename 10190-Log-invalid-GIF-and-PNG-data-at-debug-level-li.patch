From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hxreborn <hxreborn@duck.com>
Date: Wed, 11 Nov 2026 08:11:15 +0100
Subject: [PATCH] 10190: Log invalid GIF and PNG data at debug level like JPEG

Signed-off-by: hxreborn <hxreborn@duck.com>
---
 .../src/main/java/ghidra/program/model/data/GifDataType.java  | 4 ++--
 .../src/main/java/ghidra/program/model/data/PngDataType.java  | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/GifDataType.java b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/GifDataType.java
index 9a8bccbca6..06e13936b9 100644
--- a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/GifDataType.java
+++ b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/GifDataType.java
@@ -50,13 +50,13 @@ public class GifDataType extends BuiltIn implements Dynamic, Resource {
 				return gif.getLength();
 			}
 			catch (InvalidDataTypeException e) {
-				Msg.error(this, "Invalid GIF data at " + buf.getAddress());
+				Msg.debug(this, "Invalid GIF data at " + buf.getAddress());
 			}
 			return -1;
 
 		}
 		catch (Exception e) {
-			Msg.error(this, "Invalid GIF data at " + buf.getAddress());
+			Msg.debug(this, "Invalid GIF data at " + buf.getAddress());
 		}
 		return -1;
 	}
diff --git a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/PngDataType.java b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/PngDataType.java
index f51f2840e0..1a53622f86 100644
--- a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/PngDataType.java
+++ b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/PngDataType.java
@@ -52,7 +52,7 @@ public class PngDataType extends BuiltIn implements Dynamic, Resource {
 			Msg.error(this, "PNG error: " + e.getMessage());
 		}
 		catch (InvalidDataTypeException e) {
-			Msg.error(this, "Invalid PNG data at " + buf.getAddress());
+			Msg.debug(this, "Invalid PNG data at " + buf.getAddress());
 		}
 		return -1;
 	}
-- 
2.45.1

