+:mtlbi   Rel16C is $(I32) & $(BR2) & Rt=0b00001 & Br2t=0b0000 & Rel16C { lb = Rel16C; }
+:mtlei   Rel16C is $(I32) & $(BR2) & Rt=0b00010 & Br2t=0b0000 & Rel16C { le = Rel16C; }
+
+
+##########################
+# IFC (Inline Function Call) Extension
+#
+# Single-constructor model: pcode is runtime-conditional on
+# IFC_ON/ifc_lp.  Multi-flow behavior (the same body decompiled
+# both as a normal function AND inlined into ifcall callers) is
+# recovered at decompile time by `Function.setInline(true)` on
+# IFC-exclusive entries -- see NDS32IFCAnalyzer.
+
+# Sub-constructor for ifcall9 target address.
+rel9IFC: addr is imm9u
+    [ addr = inst_start + (imm9u << 1); ]
+    { export *:4 addr; }
+
+# Sub-constructor for ifcall target address (32-bit form).
+Rel16IFC: addr is Imm16s
+    [ addr = inst_start + (Imm16s << 1); ]
+    { export *:4 addr; }
+
+# ifcall (32-bit).  Sets ifc_lp and IFC_ON for runtime tracking,
+# then CALLs the target.  Modeling as CALL (not goto) keeps the
+# caller's primary body extending past the ifcall instruction (CALL
+# has fallthrough at the flow level), so the post-ifcall code stays
+# part of the caller.  The actual IFC inlining -- having the target
+# body decompiled as part of the caller -- is recovered at decompile
+# time via NDS32IFCAnalyzer publishing a per-caller body-extension
+# AddressSetPropertyMap that DecompileCallback consults.  Nested
+# ifcall (IFC_ON already 1) preserves the OUTER caller's ifc_lp
+# so the inner ifret returns to the outermost ifcall site.
+:ifcall Rel16IFC is $(I32) & $(BR2) & Rt=0b00000 & Br2t=0b0000 & Rel16IFC
+{
+    if (IFC_ON != 0) goto <nested>;
+        ifc_lp = inst_next;
+    <nested>
+    IFC_ON = 1;
+    # CBRANCH on the synthetic IFC_CHOOSER register so both edges
+    # (target + fall-through) are followed by Ghidra's symbolic
+    # propagator (stack-depth tracking, value analysis).  Without this,
+    # a plain `goto Rel16IFC; goto inst_next;` pattern only follows
+    # the first branch at the pcode-walk level -- leaving stack depth
+    # "?" at the post-ifcall continuation.  IFC_CHOOSER is always 0
+    # at runtime so the conditional is never taken and control flows
+    # to the unconditional branch below.
+    if (IFC_CHOOSER != 0) goto inst_next;
+    goto Rel16IFC;
+}
+
+# ifret: conditional `goto [ifc_lp]` on IFC_ON.  Modeled as a
+# computed branch back to the caller's instruction-after-ifcall (NOT
+# a function return), so per-caller const-prop on ifc_lp resolves
+# this to the specific call site's fallthrough.  When IFC_ON = 0
+# at runtime, falls through (no-op) -- matches hardware semantics
+# for non-IFC invocations of shared-body functions.
+:ifret is $(I32) & $(JREG) & Rt=0 & Ra=0 & Rb=0 & DtIt=0b00 & Jz=0b01 & JrHint=1 & Sub5=0b00000
+{
+    if (IFC_ON == 0) goto inst_next;
+    psw_ifcon_clear();
+    goto [ifc_lp];
+}
+
+# ifcall9 (16-bit).  See note on ifcall above.
+:ifcall9 rel9IFC is $(I16) & opc6=0b111100 & rel9IFC
+{
+    if (IFC_ON != 0) goto <nested>;
+        ifc_lp = inst_next;
+    <nested>
+    IFC_ON = 1;
+    if (IFC_CHOOSER != 0) goto inst_next;
+    goto rel9IFC;
+}
+
+# ifret16: Special case of MOV55 encoding (Rt=sp, Ra=sp).  See ifret
+# note above for the goto vs return distinction.
+:ifret16 is $(I16) & opc5=0b00000 & rt5=0b11111 & ra5=0b11111
+{
+    if (IFC_ON == 0) goto inst_next;
+    psw_ifcon_clear();
+    goto [ifc_lp];
+}
