From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Igor Savin <iselwin@gmail.com>
Date: Fri, 2 Oct 2026 16:35:01 +0300
Subject: [PATCH] 9704: Build: Fix generateGrammarSource on Windows

The doFirst cleanup passed a "*.tokens" glob to file(). On Windows the
"*" makes the path invalid, so generateGrammarSource fails with
"Illegal char <*>". On other platforms it names a literal file and the
delete does nothing. A fileTree with an include pattern resolves the
glob on every platform.
---
 Ghidra/Framework/SoftwareModeling/build.gradle | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Framework/SoftwareModeling/build.gradle b/Ghidra/Framework/SoftwareModeling/build.gradle
index ee2450f258..8559e8838b 100644
--- a/Ghidra/Framework/SoftwareModeling/build.gradle
+++ b/Ghidra/Framework/SoftwareModeling/build.gradle
@@ -76,7 +76,9 @@ generateGrammarSource {
 	doFirst {
 		// The ANTLR plugin's incremental compilation seems to cause issues, so clean out token
 		// files before any attempted compilation.
-		delete file("$buildDir/${genSrcDir}/ghidra/sleigh/grammar/*.tokens")
+		delete fileTree("$buildDir/${genSrcDir}/ghidra/sleigh/grammar") {
+			include "*.tokens"
+		}
 	}
 
 	doLast {
-- 
2.45.1

