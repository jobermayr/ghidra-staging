+		iconsChanged();
+	}
+
+	@Override
+	public void iconsChanged() {
+		Swing.runIfSwingOrRunLater(marginProvider::repaint);
+	}
+
+	List<ClangLine> getLines() {
+		if (decompilerMarginService == null) {
+			return List.of();
+		}
+		return decompilerMarginService.getDecompilerPanel().getLines();
+	}
+}
