From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DelaySystem <DelaySystem@tubot.lat>
Date: Sat, 7 Nov 2026 19:34:59 -0800
Subject: [PATCH] 10162: ARM: make Q flag sticky for saturating instructions

QADD/QSUB/QDADD/QDSUB/SSAT/USAT/SSAT16/USAT16 assigned Q from the saturation test, clearing a previously set flag. Per the ARM ARM the Q flag is only ever set. OR the test result into Q, matching the existing sticky-Q sites in the same files.
---
 .../data/languages/ARMTHUMBinstructions.sinc  | 20 +++++++++----------
 .../ARM/data/languages/ARMinstructions.sinc   | 16 +++++++--------
 2 files changed, 18 insertions(+), 18 deletions(-)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
index 5a59733916..4eb43b085a 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
@@ -9393,7 +9393,7 @@ thspsrmask: spsr^thpsrmask	is thpsrmask & spsr { export thpsrmask; }
   build ItCond;
   local sum1 = Rm0003 + Rn0003;
   sum1 = SignedSaturate(sum1,32:2);
-  Q = SignedDoesSaturate(sum1,32:2);
+  Q = Q | SignedDoesSaturate(sum1,32:2);
   Rd0811 = sum1;
 }
 
@@ -9461,7 +9461,7 @@ thspsrmask: spsr^thpsrmask	is thpsrmask & spsr { export thpsrmask; }
   build ItCond;
   tmp:4 = Rn0003 * 2;
   tmp = SignedSaturate(tmp,32:2);
-  Q = SignedDoesSaturate(tmp,32:2);
+  Q = Q | SignedDoesSaturate(tmp,32:2);
   tmp = tmp + Rm0003;
   tmp = SignedSaturate(tmp,32:2);
   Q = Q | SignedDoesSaturate(tmp,32:2);
@@ -9473,7 +9473,7 @@ thspsrmask: spsr^thpsrmask	is thpsrmask & spsr { export thpsrmask; }
   build ItCond;
   tmp:4 = Rn0003 * 2;
   tmp = SignedSaturate(tmp);
-  Q = SignedDoesSaturate(tmp,32:2);
+  Q = Q | SignedDoesSaturate(tmp,32:2);
   tmp = Rm0003 - tmp;
   tmp = SignedSaturate(tmp,32:2);
   Q = Q | SignedDoesSaturate(tmp,32:2);
@@ -9508,7 +9508,7 @@ thspsrmask: spsr^thpsrmask	is thpsrmask & spsr { export thpsrmask; }
   build ItCond;
   tmp:4 = Rm0003 - Rn0003;
   tmp = SignedSaturate(tmp,32:2);
-  Q = SignedDoesSaturate(tmp,32:2);
+  Q = Q | SignedDoesSaturate(tmp,32:2);
   Rd0811 = tmp;
 }
 
@@ -10277,7 +10277,7 @@ th2_shift1: ",asr #32" is imm3_shft=0x0 & imm2_shft=0x0 { }
         # Shift bit is 0
         tmpRn:4 = part2Rd0003 << thLsbImm;
         tmp:4 = SignedSaturate(tmpRn, thMsbImm);
-        Q = SignedDoesSaturate(tmpRn, thMsbImm);
+        Q = Q | SignedDoesSaturate(tmpRn, thMsbImm);
         Rt0811 = tmp;
 }
 
@@ -10288,7 +10288,7 @@ th2_shift1: ",asr #32" is imm3_shft=0x0 & imm2_shft=0x0 { }
         # Shift bit is 1
         tmpRn:4 = part2Rd0003 s>> thLsbImm;
         tmp:4 = SignedSaturate(tmpRn, thMsbImm);
-        Q = SignedDoesSaturate(tmpRn, thMsbImm);
+        Q = Q | SignedDoesSaturate(tmpRn, thMsbImm);
         Rt0811 = tmp;
 }
 
@@ -10297,7 +10297,7 @@ th2_shift1: ",asr #32" is imm3_shft=0x0 & imm2_shft=0x0 { }
         op12=0x0 & Rt0811 & thc0407=0x0 & Immed4
 {
         tmp:4 = SignedSaturate(part2Rd0003, Immed4);
-        Q = SignedDoesSaturate(part2Rd0003, Immed4);
+        Q = Q | SignedDoesSaturate(part2Rd0003, Immed4);
         Rt0811 = tmp;
 }
 
@@ -11248,7 +11248,7 @@ Pcrel: [pc,Rm0003]  is Rm0003 & thc0404=1 & pc
         # Shift bit is 0
 	tmpRn:4 = part2Rd0003 << thLsbImm;
         tmp:4 = UnsignedSaturate(tmpRn, thMsbImm);
-        Q = UnsignedDoesSaturate(tmpRn, thMsbImm);
+        Q = Q | UnsignedDoesSaturate(tmpRn, thMsbImm);
         Rt0811 = tmp;
 }
 
@@ -11259,7 +11259,7 @@ Pcrel: [pc,Rm0003]  is Rm0003 & thc0404=1 & pc
         # Shift bit is 1
         tmpRn:4 = part2Rd0003 s>> thLsbImm;
         tmp:4 = UnsignedSaturate(tmpRn, thMsbImm);
-        Q = UnsignedDoesSaturate(tmpRn, thMsbImm);
+        Q = Q | UnsignedDoesSaturate(tmpRn, thMsbImm);
         Rt0811 = tmp;
 }
 
@@ -11268,7 +11268,7 @@ Pcrel: [pc,Rm0003]  is Rm0003 & thc0404=1 & pc
         op12=0x0 & Rt0811 & thc0407=0x0 & Immed4
 {
         tmp:4 = UnsignedSaturate(part2Rd0003, Immed4);
-        Q = UnsignedDoesSaturate(part2Rd0003, Immed4);
+        Q = Q | UnsignedDoesSaturate(part2Rd0003, Immed4);
         Rt0811 = tmp;
 }
 
diff --git a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
index 15174bd67e..7323604103 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
@@ -11966,7 +11966,7 @@ ArmPCRelImmed12: reloff		is U23=0 & immed & rotate
   build COND;
   local sum1 = Rm + Rn;
   sum1 = SignedSaturate(sum1,32:2);
-  Q = SignedDoesSaturate(sum1,32:2);
+  Q = Q | SignedDoesSaturate(sum1,32:2);
   Rd = sum1;
 }
 
@@ -12034,7 +12034,7 @@ ArmPCRelImmed12: reloff		is U23=0 & immed & rotate
   build COND;
   tmp:4 = Rn * 2;
   tmp = SignedSaturate(tmp,32:2);
-  Q = SignedDoesSaturate(tmp,32:2);
+  Q = Q | SignedDoesSaturate(tmp,32:2);
   tmp = tmp + Rm;
   tmp = SignedSaturate(tmp,32:2);
   Q = Q | SignedDoesSaturate(tmp,32:2);
@@ -12046,7 +12046,7 @@ ArmPCRelImmed12: reloff		is U23=0 & immed & rotate
   build COND;
   tmp:4 = Rn * 2;
   tmp = SignedSaturate(tmp);
-  Q = SignedDoesSaturate(tmp,32:2);
+  Q = Q | SignedDoesSaturate(tmp,32:2);
   tmp = Rm - tmp;
   tmp = SignedSaturate(tmp,32:2);
   Q = Q | SignedDoesSaturate(tmp,32:2);
@@ -12081,7 +12081,7 @@ ArmPCRelImmed12: reloff		is U23=0 & immed & rotate
   build COND;
   tmp:4 = Rm - Rn;
   tmp = SignedSaturate(tmp,32:2);
-  Q = SignedDoesSaturate(tmp,32:2);
+  Q = Q | SignedDoesSaturate(tmp,32:2);
   Rd = tmp;
 }
 
@@ -12957,7 +12957,7 @@ armEndianNess: "BE" is c0031=0xf1010200 { export 1:1; }
   build COND;  
   build shift4;
   tmp:4 = SignedSaturate(shift4, sSatImm5);
-  Q = SignedDoesSaturate(shift4, sSatImm5);
+  Q = Q | SignedDoesSaturate(shift4, sSatImm5);
   Rd = tmp;
 }
 
@@ -12969,7 +12969,7 @@ armEndianNess: "BE" is c0031=0xf1010200 { export 1:1; }
   tmpl = SignedSaturate(tmpl, sSatImm4);
   local tmpu = Rm >> 16;
   tmpu = SignedSaturate(tmpu, sSatImm4);
-  Q = SignedDoesSaturate(tmpl,sSatImm4) | SignedDoesSaturate(tmpu,sSatImm4);
+  Q = Q | SignedDoesSaturate(tmpl,sSatImm4) | SignedDoesSaturate(tmpu,sSatImm4);
   Rd = ((tmpu & 0xffff) << 16) | (tmpl & 0xffff);
 }
 
@@ -13847,7 +13847,7 @@ armEndianNess: "BE" is c0031=0xf1010200 { export 1:1; }
   build uSatImm5;
   build shift4;
   tmp:4 = UnsignedSaturate(shift4, uSatImm5);
-  Q = UnsignedDoesSaturate(shift4, uSatImm5);
+  Q = Q | UnsignedDoesSaturate(shift4, uSatImm5);
   Rd = tmp;
 }
 
@@ -13859,7 +13859,7 @@ armEndianNess: "BE" is c0031=0xf1010200 { export 1:1; }
   tmpl = UnsignedSaturate(tmpl, uSatImm4);
   local tmpu = Rm >> 16;
   tmpu = UnsignedSaturate(tmpu, uSatImm4);
-  Q = UnsignedDoesSaturate(tmpl,uSatImm4) | UnsignedDoesSaturate(tmpu,uSatImm4);
+  Q = Q | UnsignedDoesSaturate(tmpl,uSatImm4) | UnsignedDoesSaturate(tmpu,uSatImm4);
   Rd = ((tmpu & 0xffff) << 16) | (tmpl & 0xffff);
 }
 
-- 
