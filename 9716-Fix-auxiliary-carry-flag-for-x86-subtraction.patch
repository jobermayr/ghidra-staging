From: Y <16163586+ZhouZiY@users.noreply.github.com>
Date: Sun, 4 Oct 2026 04:14:34 +0800
Subject: [PATCH] 9716: Fix auxiliary carry flag for x86 subtraction

---
 Ghidra/Processors/x86/data/languages/ia.sinc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Processors/x86/data/languages/ia.sinc b/Ghidra/Processors/x86/data/languages/ia.sinc
index 6fefd16472..6583fac414 100644
--- a/Ghidra/Processors/x86/data/languages/ia.sinc
+++ b/Ghidra/Processors/x86/data/languages/ia.sinc
@@ -2232,7 +2232,7 @@ macro shiftresultflags(result,count) {
 macro subflags(op1,op2) {
  CF = op1 < op2;
  OF = sborrow(op1,op2);
- AF = ((op1 & 0xF) < (op2 & 0xF));
+ AF = ((op1 ^ op2 ^ (op1 - op2)) & 0x10) != 0;
 }
 
 macro negflags(op1) {
