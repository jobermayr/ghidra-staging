From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: designonet <271930877+designonet@users.noreply.github.com>
Date: Thu, 15 Oct 2026 11:34:40 +0800
Subject: [PATCH] 9905: Handle incomplete Objective-C calls and preserve stub
 arguments

---
 .../app/plugin/core/analysis/ObjcMessageAnalyzer.java      | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/plugin/core/analysis/ObjcMessageAnalyzer.java b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/plugin/core/analysis/ObjcMessageAnalyzer.java
index cb3272dbfe..496d3b9899 100644
--- a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/plugin/core/analysis/ObjcMessageAnalyzer.java
+++ b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/plugin/core/analysis/ObjcMessageAnalyzer.java
@@ -323,8 +323,9 @@ public class ObjcMessageAnalyzer extends AbstractAnalyzer {
 
 			int stretParamShift = isStructReturnCall(program, inputs[0], monitor) ? 1 : 0;
 			boolean isStub = isObjcMsgSendStub(program, callTarget);
-			if (inputs.length <= (isStub ? 1 : 2) + stretParamShift) {
-				// The decompiler found fewer parameters than the message send needs
+			// Decompilation may not recover all of the message's required arguments.
+			int requiredInputs = (isStub ? 2 : 3) + stretParamShift;
+			if (inputs.length < requiredInputs) {
 				continue;
 			}
 			Varnode receiverParam = inputs[1 + stretParamShift];
@@ -336,7 +337,7 @@ public class ObjcMessageAnalyzer extends AbstractAnalyzer {
 						monitor);
 			if (ObjectUtils.allNotNull(receiver, selector)) {
 				messages.add(new Message(ObjcUtils.stripClassPrefix(receiver), selector, function,
-					op, 3 + stretParamShift, callTarget));
+					op, requiredInputs, callTarget));
 			}
 		}
 		return messages;
-- 
2.45.1

