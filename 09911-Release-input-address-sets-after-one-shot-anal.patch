From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: designonet <271930877+designonet@users.noreply.github.com>
Date: Thu, 15 Oct 2026 11:34:41 +0800
Subject: [PATCH] 09911: Release input address sets after one-shot analysis
 execution

---
 .../core/analysis/OneShotAnalysisCommand.java       | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/OneShotAnalysisCommand.java b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/OneShotAnalysisCommand.java
index 0efdfff02d..c3693d405c 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/OneShotAnalysisCommand.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/OneShotAnalysisCommand.java
@@ -26,6 +26,9 @@ import ghidra.util.task.TaskMonitor;
 /**
  * Background task to artificially kick off Auto analysis by
  * calling anything that analyzes bytes.
+ * <p>
+ * This command is single use. Its input address set is released when execution completes or the
+ * queued command is disposed. Completed or disposed commands must not be executed again.
  */
 public class OneShotAnalysisCommand extends BackgroundCommand<Program>
 		implements AutoAnalysisManagerListener {
@@ -52,6 +55,16 @@ public class OneShotAnalysisCommand extends BackgroundCommand<Program>
 		catch (CancelledException e) {
 			return false;
 		}
+		finally {
+			// The manager retains this command as an analysis-ended listener.
+			set = null;
+		}
+	}
+
+	@Override
+	public void dispose() {
+		set = null;
+		super.dispose();
 	}
 
 	@Override
-- 
