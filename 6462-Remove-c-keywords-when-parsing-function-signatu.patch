From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Strelsky <ajs222@njit.edu>
Date: Sat, 27 Apr 2024 05:44:09 -0400
Subject: [PATCH] 6462: Remove c keywords when parsing function signatures

remove c keywords when parsing function signatures
---
 .../ghidra/app/util/parser/FunctionSignatureParser.java     | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/parser/FunctionSignatureParser.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/parser/FunctionSignatureParser.java
index 81470c7900..9c7da5c725 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/parser/FunctionSignatureParser.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/parser/FunctionSignatureParser.java
@@ -197,8 +197,8 @@ public class FunctionSignatureParser {
 		if (startIndex < 0 || endIndex < 0 || startIndex >= endIndex) {
 			throw new ParseException("Can't parse function arguments");
 		}
-		String trailingText = newSignatureText.substring(endIndex + 1);
-		if (trailingText.trim().length() > 0) {
+		String trailingText = newSignatureText.substring(endIndex + 1).replaceAll("\\s*;?\\s*$", "");
+		if (!trailingText.isEmpty()) {
 			throw new ParseException(
 				"Unexpected trailing text at end of function: " + trailingText);
 		}
@@ -222,6 +222,7 @@ public class FunctionSignatureParser {
 
 	private void addParameter(List<ParameterDefinition> parameterList, String arg)
 			throws ParseException, CancelledException {
+		arg = arg.replaceAll("\\b((const)|(volatile)|(restrict)|(struct)|(union))\\b", "");
 		if ("...".equals(arg)) {
 			return;
 		}
@@ -290,6 +291,7 @@ public class FunctionSignatureParser {
 	DataType extractReturnType(String signatureText, boolean hasCallingConvention)
 			throws ParseException, CancelledException {
 
+		signatureText = signatureText.replaceAll("\\b((static)|(inline)|(const)|(volatile)|(restrict)|(struct)|(union))\\b", "");
 		int parenIndex = signatureText.indexOf('(');
 		if (parenIndex < 0) {
 			throw new ParseException("Can't find return type");
-- 
2.45.1

