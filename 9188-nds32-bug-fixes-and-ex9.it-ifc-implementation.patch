+# BSE (Bit Stream Extraction) -- AndeStar_ISA_UM025_V2.2 section 9.4.1.
+# BSP (Bit Stream Packing)    -- AndeStar_ISA_UM025_V2.2 section 9.4.2.
+#
+# Both instructions read M = Rb[12:8] (extract/insert width minus one) and
+# N = Rb[4:0] (bit-offset from Ra(31)) and update Rt + Rb according to a
+# three-way case analysis on D = M + N (normal / boundary / over-or-under-
+# flow).  See the spec for the full state machine; the sleigh below
+# expresses each case directly so the decompiler can see the bit-field
+# extracts as plain shift/mask sequences.
+:bse Rt, Ra, Rb is $(I32) & $(ALU_2) & Rt & Ra & Rb & $(ALU2Z) & Sub6=0b001100 {
+    local M:4 = (Rb >> 8) & 0x1F;
+    local N:4 = Rb & 0x1F;
+    local D:4 = M + N;
+    local refillFlag:4 = (Rb >> 30) & 1;
+    local newRt:4 = Rt;
+    local newRb:4 = Rb;
+
+    # If Rb[30] == 0, clear the unused high bits of Rt: Rt[31:Len] = 0.
+    if (refillFlag != 0) goto <bse_skip_clear>;
+        local lenMask:4 = (1 << (M + 1)) - 1;
+        newRt = newRt & lenMask;
+    <bse_skip_clear>
+
+    # Rb[7:5] = 1
+    newRb = (newRb & 0xFFFFFF1F) | 0x20;
+
+    if (D < 31) goto <bse_normal>;
+    if (D == 31) goto <bse_empty>;
+    goto <bse_underflow>;
+
+    <bse_normal>
+        # Rt[M:0] = Ra[31-N:31-N-M]
+        local nFieldMask:4 = (1 << (M + 1)) - 1;
+        local nExtracted:4 = (Ra >> (31 - N - M)) & nFieldMask;
+        newRt = (newRt & ~nFieldMask) | nExtracted;
+        # Rb[4:0] = D + 1; Rb[31] = 0
+        newRb = (newRb & 0xFFFFFFE0) | ((D + 1) & 0x1F);
+        newRb = newRb & 0x7FFFFFFF;
+        # If old Rb[30] was 1, restore Rb[12:8] from Rb[20:16] and clear
+        # Rb[15:13].
+        if (refillFlag == 0) goto <bse_normal_done>;
+            local nSavedM:4 = (Rb >> 16) & 0x1F;
+            newRb = (newRb & 0xFFFFE0FF) | (nSavedM << 8);
+            newRb = newRb & 0xFFFF1FFF;
+        <bse_normal_done>
+        # Rb[30] = 0
+        newRb = newRb & 0xBFFFFFFF;
+        goto <bse_end>;
+
+    <bse_empty>
+        # Rt[M:0] = Ra[M:0]
+        local eMask:4 = (1 << (M + 1)) - 1;
+        newRt = (newRt & ~eMask) | (Ra & eMask);
+        # Rb[4:0] = 0; Rb[30] = 0; Rb[31] = 1
+        newRb = newRb & 0xFFFFFFE0;
+        newRb = (newRb & 0xBFFFFFFF) | 0x80000000;
+        goto <bse_end>;
+
+    <bse_underflow>
+        # Rb[20:16] = M; Rb[12:8] = D - 32; Rb[4:0] = 0; Rb[30] = 1; Rb[31] = 1
+        newRb = (newRb & 0xFFE0FFFF) | (M << 16);
+        newRb = (newRb & 0xFFFFE0FF) | (((D - 32) & 0x1F) << 8);
+        newRb = newRb & 0xFFFFFFE0;
+        newRb = newRb | 0xC0000000;
+        # Rt[M:M+N-31] = Ra[31-N:0]; Rt[M+N-32:0] = 0
+        local uFromRa:4 = Ra & ((1 << (32 - N)) - 1);
+        local uShifted:4 = uFromRa << (M + N - 31);
+        local uBottomMask:4 = (1 << (M + N - 31)) - 1;
+        newRt = newRt & ~uBottomMask;
+        newRt = newRt | uShifted;
+
+    <bse_end>
+    Rt = newRt;
+    Rb = newRb;
+}
+
+:bsp Rt, Ra, Rb is $(I32) & $(ALU_2) & Rt & Ra & Rb & $(ALU2Z) & Sub6=0b001101 {
+    local M:4 = (Rb >> 8) & 0x1F;
+    local N:4 = Rb & 0x1F;
+    local D:4 = M + N;
+    local overflowFlag:4 = (Rb >> 30) & 1;
+    local newRt:4 = Rt;
+    local newRb:4 = Rb;
+
+    # Rb[7:5] = 1
+    newRb = (newRb & 0xFFFFFF1F) | 0x20;
+
+    if (D < 31) goto <bsp_normal>;
+    if (D == 31) goto <bsp_full>;
+    goto <bsp_overflow>;
+
+    <bsp_normal>
+        # Rb[4:0] = D + 1; Rb[31] = 0
+        newRb = (newRb & 0xFFFFFFE0) | ((D + 1) & 0x1F);
+        newRb = newRb & 0x7FFFFFFF;
+        # Rt[31-N:31-N-M] = Ra[M:0]
+        local pFieldMask:4 = (1 << (M + 1)) - 1;
+        local pToInsert:4 = (Ra & pFieldMask) << (31 - N - M);
+        local pClearMask:4 = ~(pFieldMask << (31 - N - M));
+        newRt = (newRt & pClearMask) | pToInsert;
+        # If old Rb[30] was 1, restore Rb[12:8] from Rb[20:16].
+        if (overflowFlag == 0) goto <bsp_normal_done>;
+            local pSavedM:4 = (Rb >> 16) & 0x1F;
+            newRb = (newRb & 0xFFFFE0FF) | (pSavedM << 8);
+            newRb = newRb & 0xFFFF1FFF;
+        <bsp_normal_done>
+        # Rb[30] = 0
+        newRb = newRb & 0xBFFFFFFF;
+        goto <bsp_end>;
+
+    <bsp_full>
+        # Rb[4:0] = 0; Rb[30] = 0; Rb[31] = 1
+        newRb = newRb & 0xFFFFFFE0;
+        newRb = (newRb & 0xBFFFFFFF) | 0x80000000;
+        # Rt[M:0] = Ra[M:0]
+        local fMask:4 = (1 << (M + 1)) - 1;
+        newRt = (newRt & ~fMask) | (Ra & fMask);
+        goto <bsp_end>;
+
+    <bsp_overflow>
+        # Rb[20:16] = M; Rb[12:8] = D - 32; Rb[4:0] = 0; Rb[30] = 1; Rb[31] = 1
+        newRb = (newRb & 0xFFE0FFFF) | (M << 16);
+        newRb = (newRb & 0xFFFFE0FF) | (((D - 32) & 0x1F) << 8);
+        newRb = newRb & 0xFFFFFFE0;
+        newRb = newRb | 0xC0000000;
+        # Rt[31-N:0] = Ra[M:M+N-31]
+        local oFieldMask:4 = (1 << (32 - N)) - 1;
+        local oExtracted:4 = (Ra >> (M + N - 31)) & oFieldMask;
+        newRt = (newRt & ~oFieldMask) | oExtracted;
+
+    <bsp_end>
+    Rt = newRt;
+    Rb = newRb;
+}
 
