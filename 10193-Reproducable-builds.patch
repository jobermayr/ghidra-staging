From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Obermayr <johannesobermayr@gmx.de>
Date: Wed, 11 Nov 2026 18:46:14 +0100
Subject: [PATCH] 10193: Reproducable builds

---
 .../Framework/SoftwareModeling/build.gradle   | 95 +++++++++++++++++++
 .../java/ghidra/doclets/json/JsonDoclet.java  |  9 +-
 gradle/root/distribution.gradle               | 11 +--
 3 files changed, 106 insertions(+), 9 deletions(-)

diff --git a/Ghidra/Framework/SoftwareModeling/build.gradle b/Ghidra/Framework/SoftwareModeling/build.gradle
index 6294bf7802..174a00f4b0 100644
--- a/Ghidra/Framework/SoftwareModeling/build.gradle
+++ b/Ghidra/Framework/SoftwareModeling/build.gradle
@@ -94,6 +94,15 @@ generateGrammarSource {
 			include "*.java"
 		}.each { File src ->
 			def lines = src.readLines()
+
+			// Set dummy DATE/TIME for reproducable builds
+			lines = lines.collect { line ->
+				if (line.trim().startsWith("// \$ANTLR")) {
+					return line.replaceAll(/\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}/, "")
+				}
+				return line
+			}
+
 			if (lines.get(0) != 'package ghidra.sleigh.grammar;') {
 				src.withWriter { wr ->
 					wr.println('package ghidra.sleigh.grammar;');
@@ -103,6 +112,92 @@ generateGrammarSource {
 				}
 			}
 		}
+
+		// Fix antlr sorting issues in SleighParser.java for reproducable builds
+		File parserFile = file("$buildDir/${genSrcDir}/ghidra/sleigh/grammar/SleighParser.java")
+		if (parserFile.exists()) {
+
+			def lines = parserFile.readLines()
+			def newLines = []
+			boolean inRrs = false
+			def rrsLines = []
+			boolean inDelegatedSection = false
+			boolean hasDelegated = false
+			def delegatedMethods = []
+
+			for (int i = 0; i < lines.size(); i++) {
+				def line = lines[i]
+				def trimmed = line.trim()
+
+				if (!hasDelegated && trimmed == "// Delegated rules") {
+					newLines.add(line)
+					hasDelegated = true
+					inDelegatedSection = true
+					continue
+				}
+
+				if (trimmed ==~ /^\/\/\s*[a-zA-Z ]+:\s*.+/) {
+					def parts = line.split(": ", 2)
+					if (parts.length == 2 && parts[1].contains(",")) {
+						def indent = line.substring(0, line.indexOf("//"))
+						def prefix = indent + parts[0].trim() + ":"
+						def items = parts[1].split(",").collect { it.trim() }.findAll { !it.isEmpty() }
+						items.sort()
+						line = prefix + " " + items.join(", ")
+					}
+				}
+
+				if (trimmed ==~ /^RewriteRule[a-zA-Z]+Stream\s+.+/) {
+					inRrs = true
+					rrsLines.add(line)
+					continue
+				} else if (inRrs) {
+					inRrs = false
+					rrsLines.sort()
+					newLines.addAll(rrsLines)
+					rrsLines.clear()
+				}
+
+				if (inDelegatedSection) {
+					if (trimmed.startsWith("public SleighParser_")) {
+						delegatedMethods.add(line)
+						continue
+					} else if (trimmed.isEmpty()) {
+						continue
+					}
+					if (!delegatedMethods.isEmpty()) {
+						delegatedMethods.sort()
+						delegatedMethods.each { m ->
+							newLines.add(m)
+							newLines.add("")
+						}
+						delegatedMethods.clear()
+					}
+					inDelegatedSection = false
+				}
+
+				newLines.add(line)
+			}
+
+			if (!rrsLines.isEmpty()) {
+				rrsLines.sort()
+				newLines.addAll(rrsLines)
+			}
+
+			if (!delegatedMethods.isEmpty()) {
+				delegatedMethods.sort()
+				delegatedMethods.each { m ->
+					newLines.add(m)
+					newLines.add("")
+				}
+			}
+
+			while (!newLines.isEmpty() && newLines.last().trim().isEmpty()) {
+				newLines.remove(newLines.size() - 1)
+			}
+
+			parserFile.text = newLines.join("\n") + "\n"
+		}
 	}
 }
 // must generate grammar before zipping if we want to include it in the source zip
diff --git a/GhidraBuild/BuildFiles/Doclets/src/main/java/ghidra/doclets/json/JsonDoclet.java b/GhidraBuild/BuildFiles/Doclets/src/main/java/ghidra/doclets/json/JsonDoclet.java
index eaeae50e2e..bb9d3995c7 100644
--- a/GhidraBuild/BuildFiles/Doclets/src/main/java/ghidra/doclets/json/JsonDoclet.java
+++ b/GhidraBuild/BuildFiles/Doclets/src/main/java/ghidra/doclets/json/JsonDoclet.java
@@ -213,7 +213,14 @@ public class JsonDoclet implements Doclet {
 		JsonArray fieldArray = new JsonArray();
 		JsonArray methodArray = new JsonArray();
 
-		for (Element el : classElement.getEnclosedElements()) {
+		// Sort elements for reproducable builds
+		List<Element> enclosedElements = new ArrayList<>(classElement.getEnclosedElements());
+		enclosedElements.sort(Comparator
+			.comparing((Element el) -> el.getKind().name())
+			.thenComparing(el -> el.getSimpleName().toString())
+			.thenComparing(el -> el.asType().toString()));
+
+		for (Element el : enclosedElements) {
 
 			JsonObject obj = new JsonObject();
 			obj.addProperty("name", el.getSimpleName().toString());
diff --git a/gradle/root/distribution.gradle b/gradle/root/distribution.gradle
index dadd28b265..a049f93e3f 100644
--- a/gradle/root/distribution.gradle
+++ b/gradle/root/distribution.gradle
@@ -130,6 +130,9 @@ task createJavadocs(type: Javadoc, description: 'Generate javadocs for all proje
 	// Generate documentation using html5
 	options.addBooleanOption("html5", true)
 
+	// Reproducable builds
+	options.setNoTimestamp(true)
+
 	// Control what warnings appear
 	options.addBooleanOption('Xdoclint:html', true)
 	options.addBooleanOption('Xdoclint:syntax', true)
@@ -490,14 +493,6 @@ task assembleDistribution (type: Copy) {
 		exclude "certification.manifest"
 		into "support/eclipse"
 	}
-
-	//////////////////////////////////////
-	// Software Bill of Materials (SBOM)
-	//////////////////////////////////////
-	doLast {
-		def bomFile = file("${destinationDir}/bom.json")
-		writeSoftwareBillOfMaterials(destinationDir, bomFile)
-	}
 }
 
