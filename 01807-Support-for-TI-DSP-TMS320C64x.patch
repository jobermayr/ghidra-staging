+# =============================================================================
+# Parallel "arith || MOV32 mem32" family — 2-word.
+#   LSW: 1110 00X0 YYYY fffe    MSW: eedd daaa mem32
+# X selects the direction of the parallel move and YYYY the arithmetic op:
+#   0xE0 = "... || MOV32 mem32, RaH"  (store)   0xE3 = "... || MOV32 RaH, mem32"  (load)
+#   YYYY: 0000 MPYF32  0001 ADDF32  0010 SUBF32  0011 MACF32 R3H,R2H  1100 MACF32 R7H,R6H
+# All five register selectors are now decoded: RdH = p_rd (MSW 11-13), RaH = p_ra (MSW
+# 8-10), RfH = p_rf (LSW 1-3), ReH = the split p_re sub-table, and mem32 = loc32 on the
+# MSW's low byte. These used to be `p_rd = p_rd` identity stubs with every operand except
+# the dest dropped from the display, which meant a third of the FPU work in a DSP loop was
+# invisible to both the listing and the decompiler.
+#
+# Source-before-dest ordering: the arithmetic reads ReH/RfH and the parallel MOV32 may
+# target one of them (TI only forbids RaH == RdH), so the arithmetic is evaluated first.
+#
+# MACF32's accumulate consumes the PREVIOUS product out of R2H/R6H before RdH is
+# rewritten, per SPRUHS1C: "R3H = R3H + R2H, RdH = ReH * RfH, RaH = [mem32]".
+#   MPYF32 RdH,ReH,RfH || MOV32 mem32, RaH   LSW: E000 sub 0b0000
+:MPYF32 p_rd, p_re_l, p_rf, "||MOV32", loc32, p_ra
+        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0000 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
+    fpu_latch2($(FPK_MPY), p_re_l, p_rf);
+    p_rd = p_re_l f* p_rf;
+    loc32 = p_ra;
+}
+:MPYF32 p_rd, p_re_h, p_rf, "||MOV32", loc32, p_ra
+        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0000 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
+    fpu_latch2($(FPK_MPY), p_re_h, p_rf);
+    p_rd = p_re_h f* p_rf;
+    loc32 = p_ra;
+}
+#   ADDF32 RdH,ReH,RfH || MOV32 mem32, RaH   LSW: E000 sub 0b0001
+:ADDF32 p_rd, p_re_l, p_rf, "||MOV32", loc32, p_ra
+        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0001 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
+    fpu_latch2($(FPK_ADD), p_re_l, p_rf);
+    p_rd = p_re_l f+ p_rf;
+    loc32 = p_ra;
+}
+:ADDF32 p_rd, p_re_h, p_rf, "||MOV32", loc32, p_ra
+        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0001 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
+    fpu_latch2($(FPK_ADD), p_re_h, p_rf);
+    p_rd = p_re_h f+ p_rf;
+    loc32 = p_ra;
+}
+#   SUBF32 RdH,ReH,RfH || MOV32 mem32, RaH   LSW: E000 sub 0b0010
+:SUBF32 p_rd, p_re_l, p_rf, "||MOV32", loc32, p_ra
+        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0010 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
+    fpu_latch2($(FPK_SUB), p_re_l, p_rf);
+    p_rd = p_re_l f- p_rf;
+    loc32 = p_ra;
+}
+:SUBF32 p_rd, p_re_h, p_rf, "||MOV32", loc32, p_ra
+        is rpt_phase=1 & op_hi8=0xE0 & loc_hi4=0b0010 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
+    fpu_latch2($(FPK_SUB), p_re_h, p_rf);
+    p_rd = p_re_h f- p_rf;
+    loc32 = p_ra;
+}
+#   MPYF32 RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b0000
+:MPYF32 p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0000 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
+    fpu_latch2($(FPK_MPY), p_re_l, p_rf);
+    p_rd = p_re_l f* p_rf;
+    p_ra = loc32;
+}
+:MPYF32 p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0000 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
+    fpu_latch2($(FPK_MPY), p_re_h, p_rf);
+    p_rd = p_re_h f* p_rf;
+    p_ra = loc32;
+}
+#   ADDF32 RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b0001
+:ADDF32 p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0001 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
+    fpu_latch2($(FPK_ADD), p_re_l, p_rf);
+    p_rd = p_re_l f+ p_rf;
+    p_ra = loc32;
+}
+:ADDF32 p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0001 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
+    fpu_latch2($(FPK_ADD), p_re_h, p_rf);
+    p_rd = p_re_h f+ p_rf;
+    p_ra = loc32;
+}
+#   SUBF32 RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b0010
+:SUBF32 p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0010 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
+    fpu_latch2($(FPK_SUB), p_re_l, p_rf);
+    p_rd = p_re_l f- p_rf;
+    p_ra = loc32;
+}
+:SUBF32 p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0010 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
+    fpu_latch2($(FPK_SUB), p_re_h, p_rf);
+    p_rd = p_re_h f- p_rf;
+    p_ra = loc32;
+}
+#   MACF32 R3H,R2H,RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b0011
+:MACF32 "R3H,R2H", p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0011 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
+    fpu_latch2($(FPK_ADD), R3H, R2H);
+    R3H = R3H f+ R2H;
+    fpu_latch2($(FPK_MPY), p_re_l, p_rf);
+    p_rd = p_re_l f* p_rf;
+    p_ra = loc32;
+}
+:MACF32 "R3H,R2H", p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b0011 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
+    fpu_latch2($(FPK_ADD), R3H, R2H);
+    R3H = R3H f+ R2H;
+    fpu_latch2($(FPK_MPY), p_re_h, p_rf);
+    p_rd = p_re_h f* p_rf;
+    p_ra = loc32;
+}
+#   MACF32 R7H,R6H,RdH,ReH,RfH || MOV32 RaH, mem32   LSW: E300 sub 0b1100
+:MACF32 "R7H,R6H", p_rd, p_re_l, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b1100 & p_rf & p_re_hi=0 ; p_rd & p_ra & p_re_l & loc32 {
+    fpu_latch2($(FPK_ADD), R7H, R6H);
+    R7H = R7H f+ R6H;
+    fpu_latch2($(FPK_MPY), p_re_l, p_rf);
+    p_rd = p_re_l f* p_rf;
+    p_ra = loc32;
+}
+:MACF32 "R7H,R6H", p_rd, p_re_h, p_rf, "||MOV32", p_ra, loc32
+        is rpt_phase=1 & op_hi8=0xE3 & loc_hi4=0b1100 & p_rf & p_re_hi=1 ; p_rd & p_ra & p_re_h & loc32 {
+    fpu_latch2($(FPK_ADD), R7H, R6H);
+    R7H = R7H f+ R6H;
+    fpu_latch2($(FPK_MPY), p_re_h, p_rf);
+    p_rd = p_re_h f* p_rf;
+    p_ra = loc32;
+}
+
+# =============================================================================
+# Parallel "MPYF32 || ADDF32 / SUBF32" — 2-word, registers only (no memory operand).
+#   LSW: 1110 0111 010Y 00ff    MSW: feee dddc ccbb baaa      (Y: 0 = ADDF32, 1 = SUBF32)
+#   RaH = RbH * RcH ,  RdH = ReH +/- RfH
+# Note the MSW layout differs from the ||MOV32 family above: ddd/eee sit one bit lower
+# (p_rd9 / p_re12), and aaa/bbb/ccc are the ordinary f_ra/f_rb/f_rc.
+:MPYF32 f_ra, f_rb, f_rc, "||ADDF32", p_rd9, p_re12, p_rf7_0
+        is rpt_phase=1 & op_hi8=0xE7 & loc_hi4=0b0100 & p_rf7_0 ; f_ra & f_rb & f_rc & p_rd9 & p_re12 & p_rf_lo1=0 {
+    fpu_latch2($(FPK_MPY), f_rb, f_rc);
+    local prod:4 = f_rb f* f_rc;
+    fpu_latch2($(FPK_ADD), p_re12, p_rf7_0);
+    p_rd9 = p_re12 f+ p_rf7_0;
+    f_ra = prod;
+}
+:MPYF32 f_ra, f_rb, f_rc, "||ADDF32", p_rd9, p_re12, p_rf7_1
+        is rpt_phase=1 & op_hi8=0xE7 & loc_hi4=0b0100 & p_rf7_1 ; f_ra & f_rb & f_rc & p_rd9 & p_re12 & p_rf_lo1=1 {
+    fpu_latch2($(FPK_MPY), f_rb, f_rc);
+    local prod:4 = f_rb f* f_rc;
+    fpu_latch2($(FPK_ADD), p_re12, p_rf7_1);
+    p_rd9 = p_re12 f+ p_rf7_1;
+    f_ra = prod;
+}
+:MPYF32 f_ra, f_rb, f_rc, "||SUBF32", p_rd9, p_re12, p_rf7_0
+        is rpt_phase=1 & op_hi8=0xE7 & loc_hi4=0b0101 & p_rf7_0 ; f_ra & f_rb & f_rc & p_rd9 & p_re12 & p_rf_lo1=0 {
+    fpu_latch2($(FPK_MPY), f_rb, f_rc);
+    local prod:4 = f_rb f* f_rc;
+    fpu_latch2($(FPK_SUB), p_re12, p_rf7_0);
+    p_rd9 = p_re12 f- p_rf7_0;
+    f_ra = prod;
+}
+:MPYF32 f_ra, f_rb, f_rc, "||SUBF32", p_rd9, p_re12, p_rf7_1
+        is rpt_phase=1 & op_hi8=0xE7 & loc_hi4=0b0101 & p_rf7_1 ; f_ra & f_rb & f_rc & p_rd9 & p_re12 & p_rf_lo1=1 {
+    fpu_latch2($(FPK_MPY), f_rb, f_rc);
+    local prod:4 = f_rb f* f_rc;
+    fpu_latch2($(FPK_SUB), p_re12, p_rf7_1);
+    p_rd9 = p_re12 f- p_rf7_1;
+    f_ra = prod;
+}
diff --git a/Ghidra/Processors/TMS320C28x/data/languages/tms320c28x_mac.sinc b/Ghidra/Processors/TMS320C28x/data/languages/tms320c28x_mac.sinc
new file mode 100644
index 0000000000..dac0916c52
--- /dev/null
+++ b/Ghidra/Processors/TMS320C28x/data/languages/tms320c28x_mac.sinc
@@ -0,0 +1,302 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 Nishanth Samala
+# C28x multiply / multiply-accumulate family (MPY / MAC / MOVA / MOVP).
+# Included by tms320c28x.sinc. Encodings verified against ch6_instruction_detail.txt.
+#
+# These compute 16x16 -> 32 products into P (and accumulate into ACC). The product
+# is subject to the PM (product shift mode) bits in ST0; for now we model the raw
+# 16x16->32 product WITHOUT the PM shift (PM defaults to >>0 on most code paths).
+# PM-accurate shifting is a deferred refinement -- noted so the approximation is
+# explicit and not mistaken for full fidelity.
+#
+# T is the high half of XT (the multiplicand register), 16-bit signed by default.
+
+# MPY P,T,loc16     0011 0011 LLLL LLLL   -- P = T * loc16  (signed 16x16->32)
+:MPY Preg, Treg, loc16  is rpt_phase=1 & op_hi8=0x33 & Preg & Treg & loc16  {
+    local a:4 = sext(T);
+    local b:4 = sext(loc16);
+    P = a * b;
+}
+
+# MPY ACC,T,loc16   0001 0010 LLLL LLLL   -- ACC = T * loc16  (signed 16x16->32)
+# SPRU430F: N,Z on the ACC write.
+:MPY ACCreg, Treg, loc16  is rpt_phase=1 & op_hi8=0x12 & ACCreg & Treg & loc16  {
+    local a:4 = sext(T);
+    local b:4 = sext(loc16);
+    ACC = a * b;
+    setNZ32(ACC);
+}
+
+# MPYS P,T,loc16    0001 0011 LLLL LLLL   -- ACC -= P<<PM (PM=0 modeled); then P = T*loc16
+# SPRU430F: N,Z,C(inverted borrow),V from the ACC -= P step.
+:MPYS Preg, Treg, loc16  is rpt_phase=1 & op_hi8=0x13 & Preg & Treg & loc16  {
+    local b:4 = P;
+    $(C) = !(ACC < b);
+    local ovf:1 = sborrow(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC - b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+    local a:4 = sext(T);
+    local m:4 = sext(loc16);
+    P = a * m;
+}
+
+# MPY ACC,loc16,#16bit  0011 0100 LLLL LLLL : iiii iiii iiii iiii  (2-word)
+# T = [loc16]; ACC = signed T * signed #16bit.  SPRU430F: N,Z on the ACC write.
+:MPY ACCreg, loc16, "#"imm16  is rpt_phase=1 & op_hi8=0x34 & ACCreg & loc16 ; imm16  {
+    T = loc16;
+    local tv:2 = T;
+    local iv:2 = imm16;
+    local a:4 = sext(tv);
+    local b:4 = sext(iv);
+    ACC = a * b;
+    setNZ32(ACC);
+}
+
+# MPYA P,T,loc16    0001 0111 LLLL LLLL   -- ACC += P<<PM (PM=0 modeled), then P = T*loc16
+# SPRU430F: N/Z/C/V + OVC on the ACC += P step. Add-form sibling of MPYS above;
+# encoding dis2000-confirmed in tests/mac_ext56.bin.
+:MPYA Preg, Treg, loc16  is rpt_phase=1 & op_hi8=0x17 & Preg & Treg & loc16  {
+    local b:4 = P;
+    $(C) = carry(ACC, b);
+    local ovf:1 = scarry(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC + b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+    local a:4 = sext(T);
+    local m:4 = sext(loc16);
+    P = a * m;
+}
+
+# MPYA P,loc16,#16bit  0001 0101 LLLL LLLL : iiii iiii iiii iiii  (2-word)
+# ACC += P<<PM (PM=0); T = [loc16]; P = signed T * signed #16bit.
+# The T load is a documented side effect (unlike the plain MPY P,#16bit form).
+# SPRU430F: N/Z/C/V + OVC on the ACC += P step; encoding dis2000-confirmed.
+:MPYA Preg, loc16, "#"imm16  is rpt_phase=1 & op_hi8=0x15 & Preg & loc16 ; imm16  {
+    local b:4 = P;
+    $(C) = carry(ACC, b);
+    local ovf:1 = scarry(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC + b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+    T = loc16;
+    local tv:2 = T;
+    local iv:2 = imm16;
+    local a:4 = sext(tv);
+    local m:4 = sext(iv);
+    P = a * m;
+}
+
+# MPY P,loc16,#16bit    1000 1100 LLLL LLLL : iiii iiii iiii iiii  (2-word)
+# P = signed [loc16] * signed #16bit. Unlike the ACC form above, this one does NOT
+# load T (SPRU430F: "P = signed [loc16] * signed 16bit;").
+:MPY Preg, loc16, "#"imm16  is rpt_phase=1 & op_hi8=0x8C & Preg & loc16 ; imm16  {
+    local lv:2 = loc16;
+    local iv:2 = imm16;
+    local a:4 = sext(lv);
+    local b:4 = sext(iv);
+    P = a * b;
+}
+
+# MOVS T,loc16      0001 0001 LLLL LLLL   -- T = [loc16]; ACC -= P<<PM (PM=0 modeled)
+# loc!=0xAC: that one encoding is SUBL ACC,P << PM (see the P<<PM block at the end).
+# SPRU430F: N/Z/C/V + OVC on the ACC -= P step.
+:MOVS Treg, loc16  is rpt_phase=1 & op_hi8=0x11 & loc_full8!=0xAC & Treg & loc16  {
+    local b:4 = P;
+    $(C) = !(ACC < b);
+    local ovf:1 = sborrow(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC - b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+    T = loc16;
+}
+
+# MPYU P,T,loc16    0011 0111 LLLL LLLL   -- P = T * loc16  (unsigned)
+:MPYU Preg, Treg, loc16  is rpt_phase=1 & op_hi8=0x37 & Preg & Treg & loc16  {
+    local a:4 = zext(T);
+    local b:4 = zext(loc16);
+    P = a * b;
+}
+
+# MPYB P,T,#8bit    0011 0001 CCCC CCCC   -- P = T * #8bit (unsigned 8-bit const)
+:MPYB Preg, Treg, "#"imm8  is rpt_phase=1 & op_hi8=0x31 & Preg & Treg & imm8  {
+    local a:4 = sext(T);
+    local b:4 = zext(imm8:2);
+    P = a * b;
+}
+
+# MPYB ACC,T,#8bit  0011 0101 CCCC CCCC   -- ACC = T * #8bit
+# SPRU430F: N,Z on the ACC write.
+:MPYB ACCreg, Treg, "#"imm8  is rpt_phase=1 & op_hi8=0x35 & ACCreg & Treg & imm8  {
+    local a:4 = sext(T);
+    local b:4 = zext(imm8:2);
+    ACC = a * b;
+    setNZ32(ACC);
+}
+
+# MAC P,loc16,0:pma 0001 0100 LLLL LLLL : pma word
+# Multiply-accumulate: ACC += P (shifted by PM, approximated >>0); P = loc16 * (*pma).
+# The second word is the low 16 bits of a program-memory address (0:pma). We model
+# the accumulate of the previous product and the new product load.
+:MAC Preg, loc16, "*"imm16  is rpt_phase=1 & op_hi8=0x14 & Preg & loc16 ; imm16  {
+    local b:4 = P;
+    $(C) = carry(ACC, b);
+    local ovf:1 = scarry(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC + b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+    local pma:4 = zext(imm16:2);
+    local pv:2 = *[ram]:2 pma;
+    local a:4 = sext(loc16);
+    local mb:4 = sext(pv);
+    P = a * mb;
+}
+
+# MOVA T,loc16      0001 0000 LLLL LLLL   -- T = loc16; ACC += P (load T, add prev product)
+# loc!=0xAC: that one encoding is ADDL ACC,P << PM (see the P<<PM block below).
+# SPRU430F: N/Z/C/V + OVC on the ACC += P step.
+:MOVA Treg, loc16  is rpt_phase=1 & op_hi8=0x10 & loc_full8!=0xAC & Treg & loc16  {
+    local b:4 = P;
+    $(C) = carry(ACC, b);
+    local ovf:1 = scarry(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC + b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+    T = loc16;
+}
+
+# MOVP T,loc16      0001 0110 LLLL LLLL   -- T = loc16; ACC = P<<PM (load T, move shifted product)
+# loc!=0xAC: that one encoding is MOVL ACC,P << PM (in tms320c28x_more.sinc as MOVL ACC,"P").
+# SPRU430F p.308: this is documented as an ALIAS for MOVL ACC,P<<PM with loc16=@T -- so both
+# the PM shift and the N/Z flags on ACC must match the alias. Prior body just did `ACC = P`
+# with no shift and no flags (issue #110). pm_shift split parallels MOVL ACC,P in _more.sinc.
+:MOVP Treg, loc16  is rpt_phase=1 & pm_shift=0 & op_hi8=0x16 & loc_full8!=0xAC & Treg & loc16  {
+    ACC = P;
+    setNZ32(ACC);
+    T = loc16;
+}
+:MOVP Treg, loc16  is rpt_phase=1 & pm_shift=1 & op_hi8=0x16 & loc_full8!=0xAC & Treg & loc16  {
+    local v:4; pshift(v);
+    ACC = v;
+    setNZ32(ACC);
+    T = loc16;
+}
+
+# =============================================================================
+# "P << PM" specials -- fully-specified opcodes living INSIDE the loc16 space
+# =============================================================================
+# SPRU430F gives each of these a complete 16-bit encoding whose low byte (0xAC)
+# is also a legal loc16 code, so they sit inside the operand space of the
+# MOVA/MOVS/MOVP forms above. SLEIGH resolves in favour of the more constrained
+# pattern, so these out-match the general forms.
+#
+# Found by TI dis2000 parity on a real F28377D production image: word 0x10AC in a
+# Q-format math routine was decoding as "MOVA T,@TH" -- which silently clobbers T
+# and attributes the accumulate to the wrong register -- when it is really
+# "ADDL ACC,P << PM". The manual's own MPY P,loc16,#16bit example shows exactly
+# the MPY P / ADDL ACC,P << PM sequence this image uses.
+#
+# PM shift: the DEFAULT of each form below is unshifted, consistent with the rest of
+# this file, because PM=0 is what the TI C runtime establishes at every function entry
+# (SPRU514 Table 7-4) and what reaches nearly every product use -- measured, 868 of 924
+# product-consuming instructions in a DIR image sit in a function containing no SPM at
+# all. Where an SPM proves PM non-zero on every path in, TMS320C28xPmShiftAnalyzer sets
+# the pm_shift context bit and the paired variant applies the real shift. See #74.
+
+# (MOVL ACC,P << PM = 0x16AC and MOVL P,ACC = 0xFF5A were already covered in
+#  tms320c28x_more.sinc as MOVL ACC,"P" / MOVL "P",ACC — don't re-add them here.)
+#
+# PRECEDENCE (learned the hard way): being "more specific" is NOT enough. A first
+# attempt declared these as bare op16=0x10AC etc. and they compiled clean but never
+# fired — 0x10AC still decoded as MOVA T,@TH, because the general MOVA/MOVS/MOVP
+# constructors overlap the same word and won the match. CMPL (0xFF59) worked only
+# because nothing else in the 0xFF family overlaps it. The fix is to EXCLUDE the
+# encoding from the general form (loc_full8!=0xAC above) so there is no overlap at
+# all. Verify any addition like this on a real word, not just on a clean compile.
+
+# Each of these comes in a pair: the default (pm_shift=0) keeps the unshifted model
+# described in the file header, and the pm_shift=1 variant applies the real PM shift
+# where TMS320C28xPmShiftAnalyzer has proved PM non-zero on every path in (#74).
+# BOTH sides carry the constraint -- a variant that only adds a bit to one pattern is
+# indistinguishable from the base and the resolver silently picks whichever it likes,
+# the same trap documented for rpt_phase in the slaspec.
+
+# ADDL ACC,P << PM   0001 0000 1010 1100
+# SPRU430F: N,Z,C,V per the 32-bit add. Same flag shape as CMPL ACC,P<<PM below,
+# with ACC actually updated afterward.
+:ADDL "ACC,P << PM"  is rpt_phase=1 & pm_shift=0 & op16=0x10AC  {
+    local b:4 = P;
+    $(C) = carry(ACC, b);
+    local ovf:1 = scarry(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC + b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+}
+:ADDL "ACC,P << PM"  is rpt_phase=1 & pm_shift=1 & op16=0x10AC  {
+    local b:4; pshift(b);
+    $(C) = carry(ACC, b);
+    local ovf:1 = scarry(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC + b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+}
+
+# SUBL ACC,P << PM   0001 0001 1010 1100. SPRU430F: N,Z,C(inverted borrow),V.
+:SUBL "ACC,P << PM"  is rpt_phase=1 & pm_shift=0 & op16=0x11AC  {
+    local b:4 = P;
+    $(C) = !(ACC < b);
+    local ovf:1 = sborrow(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC - b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+}
+:SUBL "ACC,P << PM"  is rpt_phase=1 & pm_shift=1 & op16=0x11AC  {
+    local b:4; pshift(b);
+    $(C) = !(ACC < b);
+    local ovf:1 = sborrow(ACC, b);
+    $(V) = $(V) | ovf;
+    ACC = ACC - b;
+    applyOvcSigned(ovf, ACC);
+    applyOvmSaturateSigned(ovf, ACC);
+    setNZ32(ACC);
+}
+
+# CMPL ACC,P << PM   1111 1111 0101 1001   -- compare only; ACC unchanged
+# SPRU430F: N/Z/C, V not affected. Infinite-precision N via 8-byte sext.
+# See #108.
+:CMPL "ACC,P << PM"  is rpt_phase=1 & pm_shift=0 & op16=0xFF59  {
+    local b:4 = P;
+    local a8:8 = sext(ACC);
+    local b8:8 = sext(b);
+    local r:8 = a8 - b8;
+    $(C) = !(ACC < b);
+    $(N) = (r s< 0);
+    $(Z) = (r == 0);
+}
+:CMPL "ACC,P << PM"  is rpt_phase=1 & pm_shift=1 & op16=0xFF59  {
+    local b:4; pshift(b);
+    local a8:8 = sext(ACC);
+    local b8:8 = sext(b);
+    local r:8 = a8 - b8;
+    $(C) = !(ACC < b);
+    $(N) = (r s< 0);
+    $(Z) = (r == 0);
+}
diff --git a/Ghidra/Processors/TMS320C28x/data/languages/tms320c28x_more.sinc b/Ghidra/Processors/TMS320C28x/data/languages/tms320c28x_more.sinc
