Subject: [PATCH] 10144: Add packed single-precision FMA4 decoding

---
 Ghidra/Processors/x86/certification.manifest  |  1 +
 .../Processors/x86/data/languages/fma4.sinc   | 60 +++++++++++++++++++
 .../Processors/x86/data/languages/x86.slaspec |  1 +
 3 files changed, 62 insertions(+)
 create mode 100644 Ghidra/Processors/x86/data/languages/fma4.sinc

diff --git a/Ghidra/Processors/x86/certification.manifest b/Ghidra/Processors/x86/certification.manifest
index 983a5259a9..50faeccbee 100644
--- a/Ghidra/Processors/x86/certification.manifest
+++ b/Ghidra/Processors/x86/certification.manifest
@@ -17,6 +17,7 @@ data/languages/cet.sinc||GHIDRA||||END|
 data/languages/clwb.sinc||GHIDRA||||END|
 data/languages/cmpccxadd.sinc||GHIDRA||||END|
 data/languages/fma.sinc||GHIDRA||||END|
+data/languages/fma4.sinc||GHIDRA||||END|
 data/languages/gfni.sinc||GHIDRA||||END|
 data/languages/ia.sinc||GHIDRA||||END|
 data/languages/keylocker.sinc||GHIDRA||||END|
diff --git a/Ghidra/Processors/x86/data/languages/fma4.sinc b/Ghidra/Processors/x86/data/languages/fma4.sinc
new file mode 100644
index 0000000000..fc59912a2d
--- /dev/null
+++ b/Ghidra/Processors/x86/data/languages/fma4.sinc
@@ -0,0 +1,60 @@
+# ###
+# IP: GHIDRA
+#
