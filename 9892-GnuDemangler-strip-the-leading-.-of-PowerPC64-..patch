From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FlashHit <56718716+FlashHit@users.noreply.github.com>
Date: Wed, 14 Oct 2026 17:38:53 +0200
Subject: [PATCH] 9892: GnuDemangler: strip the leading . of PowerPC64 ._Z
 symbols

GP-9875: strip the leading '.' of PowerPC64 ._Z symbols
---
 .../java/ghidra/app/util/demangler/gnu/GnuDemangler.java    | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Ghidra/Features/GnuDemangler/src/main/java/ghidra/app/util/demangler/gnu/GnuDemangler.java b/Ghidra/Features/GnuDemangler/src/main/java/ghidra/app/util/demangler/gnu/GnuDemangler.java
index 14d7e934b4..fa06d54acc 100644
--- a/Ghidra/Features/GnuDemangler/src/main/java/ghidra/app/util/demangler/gnu/GnuDemangler.java
+++ b/Ghidra/Features/GnuDemangler/src/main/java/ghidra/app/util/demangler/gnu/GnuDemangler.java
@@ -97,6 +97,9 @@ public class GnuDemangler implements Demangler {
 		else if (mangled.startsWith("__Z")) {
 			mangled = mangled.substring(1);
 		}
+		else if (mangled.startsWith("._Z")) {
+			mangled = mangled.substring(1);
+		}
 
 		boolean isDwarf = false;
 		if (mangled.startsWith(DWARF_REF)) {
@@ -225,6 +228,9 @@ public class GnuDemangler implements Demangler {
 		if (mangled.startsWith("__Z")) {
 			return false;
 		}
+		if (mangled.startsWith("._Z")) {
+			return false;
+		}
 		if (mangled.startsWith("h__")) {
 			return false; // not sure about this one
 		}
-- 
2.45.1

