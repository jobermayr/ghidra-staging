+						inlineMap.getPropertyIterator();
+					List<Address> toRemove = new ArrayList<>();
+					while (existingIt.hasNext()) {
+						Address a = existingIt.next();
+						if (!wanted.contains(a)) toRemove.add(a);
+					}
+					for (Address a : toRemove) inlineMap.remove(a);
