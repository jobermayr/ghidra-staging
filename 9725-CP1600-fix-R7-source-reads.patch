From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Monte Quercus <moqucu@icloud.com>
Date: Sat, 3 Oct 2026 20:36:26 -0700
Subject: [PATCH] 9725: CP1600: fix R7 source reads

---
 .../CP1600/data/languages/CP1600.slaspec      |  34 +++---
 .../ghidra_scripts/CP1600R7SourceTest.java    | 112 ++++++++++++++++++
 2 files changed, 132 insertions(+), 14 deletions(-)
 create mode 100644 Ghidra/Processors/CP1600/ghidra_scripts/CP1600R7SourceTest.java

diff --git a/Ghidra/Processors/CP1600/data/languages/CP1600.slaspec b/Ghidra/Processors/CP1600/data/languages/CP1600.slaspec
index 7a4daa65d8..29da4d755a 100644
--- a/Ghidra/Processors/CP1600/data/languages/CP1600.slaspec
+++ b/Ghidra/Processors/CP1600/data/languages/CP1600.slaspec
@@ -109,6 +109,12 @@ regval0_2:    is reg0_2=7 {
 	export tmp;
 }
 regval0_2:    is reg0_2 { export reg0_2; }
+# R7 source operands read the next instruction's word address.
+srcval3_5:    is reg3_5=7 {
+	local tmp:2 = inst_next / 2;
+	export tmp;
+}
+srcval3_5:    is reg3_5 { export reg3_5; }
 
 cc: ""    is branch_external=0 & branch_condition=0  { local tmp:1 = 1; export tmp; }
 cc: "C"   is branch_external=0 & branch_condition=1  { export C; }
@@ -181,8 +187,8 @@ define pcodeop SoftwareInterrupt;
 	build checkbranch;
 }
 
-:ADDR reg3_5, reg0_2 is opcode6_9=0x0003 & reg3_5 & reg0_2 & regval0_2 & checkbranch {
-	addition(reg0_2, regval0_2, reg3_5);
+:ADDR reg3_5, reg0_2 is opcode6_9=0x0003 & reg3_5 & srcval3_5 & reg0_2 & regval0_2 & checkbranch {
+	addition(reg0_2, regval0_2, srcval3_5);
 	build checkbranch;
 }
 
@@ -199,8 +205,8 @@ define pcodeop SoftwareInterrupt;
 	build checkbranch;
 }
 
-:ANDR reg3_5, reg0_2 is opcode6_9=0x0006 & reg3_5 & reg0_2 & regval0_2 & checkbranch {
-	reg0_2 = regval0_2 & reg3_5;
+:ANDR reg3_5, reg0_2 is opcode6_9=0x0006 & reg3_5 & srcval3_5 & reg0_2 & regval0_2 & checkbranch {
+	reg0_2 = regval0_2 & srcval3_5;
 	resultFlags(reg0_2);
 	build checkbranch;
 }
@@ -232,8 +238,8 @@ define pcodeop SoftwareInterrupt;
 	comparison(reg0_2, impliedval16);
 }
 
-:CMPR reg3_5, reg0_2 is opcode6_9=0x0005 & reg3_5 & reg0_2 {
-	comparison(reg0_2, reg3_5);
+:CMPR reg3_5, reg0_2 is opcode6_9=0x0005 & reg3_5 & srcval3_5 & reg0_2 {
+	comparison(reg0_2, srcval3_5);
 }
 
 :COMR reg0_2 is opcode3_9=0x0003 & reg0_2 & regval0_2 & checkbranch {
@@ -285,8 +291,8 @@ define pcodeop SoftwareInterrupt;
 	goto jmpdest16;
 }
 
-:JR reg3_5 is opcode6_9=0x0002 & reg3_5 & reg0_2 & reg0_2=7 {
-	reg0_2 = reg3_5;
+:JR reg3_5 is opcode6_9=0x0002 & reg3_5 & srcval3_5 & reg0_2 & reg0_2=7 {
+	reg0_2 = srcval3_5;
 	resultFlags(reg0_2);
 	return [reg0_2];
 }
@@ -308,8 +314,8 @@ define pcodeop SoftwareInterrupt;
 	call jmpdest16;
 }
 
-:MOVR reg3_5, reg0_2 is opcode6_9=0x0002 & reg0_2 & reg3_5 & checkbranch {
-	reg0_2 = reg3_5;
+:MOVR reg3_5, reg0_2 is opcode6_9=0x0002 & reg0_2 & reg3_5 & srcval3_5 & checkbranch {
+	reg0_2 = srcval3_5;
 	resultFlags(reg0_2);
 	build checkbranch;
 }
@@ -404,8 +410,8 @@ define pcodeop SoftwareInterrupt;
 	build checkbranch;
 }
 
-:SUBR reg3_5, reg0_2 is opcode6_9=0x0004 & reg3_5 & reg0_2 & regval0_2 & checkbranch {
-	subtraction(reg0_2, regval0_2, reg3_5);
+:SUBR reg3_5, reg0_2 is opcode6_9=0x0004 & reg3_5 & srcval3_5 & reg0_2 & regval0_2 & checkbranch {
+	subtraction(reg0_2, regval0_2, srcval3_5);
 	build checkbranch;
 }
 
@@ -430,8 +436,8 @@ define pcodeop SoftwareInterrupt;
 	build checkbranch;
 }
 
-:XORR reg3_5, reg0_2 is opcode6_9=0x0007 & reg3_5 & reg0_2 & regval0_2 & checkbranch {
-	reg0_2 = regval0_2 ^ reg3_5;
+:XORR reg3_5, reg0_2 is opcode6_9=0x0007 & reg3_5 & srcval3_5 & reg0_2 & regval0_2 & checkbranch {
+	reg0_2 = regval0_2 ^ srcval3_5;
 	resultFlags(reg0_2);
 	build checkbranch;
 }
diff --git a/Ghidra/Processors/CP1600/ghidra_scripts/CP1600R7SourceTest.java b/Ghidra/Processors/CP1600/ghidra_scripts/CP1600R7SourceTest.java
new file mode 100644
index 0000000000..94730e8995
--- /dev/null
+++ b/Ghidra/Processors/CP1600/ghidra_scripts/CP1600R7SourceTest.java
@@ -0,0 +1,112 @@
