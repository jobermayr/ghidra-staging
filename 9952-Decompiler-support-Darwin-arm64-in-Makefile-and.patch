From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Confidential <28762372+0L1v3DaD@users.noreply.github.com>
Date: Sun, 18 Oct 2026 19:50:29 -0500
Subject: [PATCH] 9952: Decompiler: support Darwin arm64 in Makefile and match
 struct tags

---
 .../Features/Decompiler/buildNatives.gradle   | 13 ++++++++++--
 .../Decompiler/src/decompile/cpp/Makefile     | 20 ++++++++++++++-----
 .../cpp/include/ghidra/modelrules.hh          |  2 +-
 .../src/decompile/cpp/include/ghidra/type.hh  |  2 +-
 4 files changed, 28 insertions(+), 9 deletions(-)

diff --git a/Ghidra/Features/Decompiler/buildNatives.gradle b/Ghidra/Features/Decompiler/buildNatives.gradle
index a6c55f6048..8d4f2a7d91 100644
--- a/Ghidra/Features/Decompiler/buildNatives.gradle
+++ b/Ghidra/Features/Decompiler/buildNatives.gradle
@@ -266,12 +266,15 @@ model {
 				if (b.toolChain in Gcc || b.toolChain in Clang) {
 					if (project.hasProperty('debug')) {
 						b.cppCompiler.args "-g"
+						b.cCompiler.args "-g"
 					}
 					if (project.hasProperty('opt')) {
 						b.cppCompiler.args "-O2"
+						b.cCompiler.args "-O2"
 					}
 					if (project.hasProperty('lto')) {
 						b.cppCompiler.args "-flto"
+						b.cCompiler.args "-flto"
 						b.linker.args "-flto"
 					}
 					if (project.hasProperty('gdb')) {
@@ -493,10 +496,16 @@ model {
 					b.cppCompiler.define "_WINDOWS"
 					b.cppCompiler.define "WIN32"
 					b.cppCompiler.define "_WIN32"
-					if (b.targetPlatform.name == "win_x86_64") {
+					b.cCompiler.define "WINDOWS"
+					b.cCompiler.define "_WINDOWS"
+					b.cCompiler.define "WIN32"
+					b.cCompiler.define "_WIN32"
+					if (b.targetPlatform.name == "win_x86_64" || b.targetPlatform.name == "win_arm_64") {
 						b.cppCompiler.define "WIN64"
 						b.cppCompiler.define "_WIN64"
-					}	
+						b.cCompiler.define "WIN64"
+						b.cCompiler.define "_WIN64"
+					}
 				}
 				b.cCompiler.define "_CRT_SECURE_NO_DEPRECATE"
 				b.cCompiler.define "_CRT_NONSTDC_NO_DEPRECATE"
diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/Makefile b/Ghidra/Features/Decompiler/src/decompile/cpp/Makefile
index ab884fd850..88dea057fd 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/Makefile
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/Makefile
@@ -35,9 +35,18 @@ endif
 
 ifeq ($(OS),Darwin)
   MAKE_STATIC=
-  ARCH_TYPE=-arch x86_64
-  ADDITIONAL_FLAGS=-mmacosx-version-min=10.6 -w
-  OSDIR=mac_x86_64
+  ifndef ARCH
+    ARCH=$(CPU)
+  endif
+  ifeq ($(ARCH),arm64)
+    ARCH_TYPE=-arch arm64
+    ADDITIONAL_FLAGS=-mmacosx-version-min=11.0 -w
+    OSDIR=mac_arm_64
+  else
+    ARCH_TYPE=-arch x86_64
+    ADDITIONAL_FLAGS=-mmacosx-version-min=10.6 -w
+    OSDIR=mac_x86_64
+  endif
 endif
 
 ifeq ($(OS),OpenBSD)
@@ -134,7 +143,8 @@ COMMANDLINE_NAMES=$(CORE) $(DECCORE) $(EXTRA) $(SLEIGH) consolemain
 COMMANDLINE_DEBUG=-DCPUI_DEBUG -D__TERMINAL__
 COMMANDLINE_OPT=-D__TERMINAL__
 
-TEST_NAMES=$(CORE) $(DECCORE) $(SLEIGH) $(EXTRA) test
+CLI_NO_BFD=callgraph ifacedecomp ifaceterm inject_sleigh interface libdecomp loadimage_xml raw_arch sleigh_arch testfunction xml_arch
+TEST_NAMES=$(CORE) $(DECCORE) $(SLEIGH) $(CLI_NO_BFD) test
 TEST_DEBUG=-D__TERMINAL__
 
 GHIDRA_NAMES=$(CORE) $(DECCORE) $(GHIDRA)
@@ -243,7 +253,7 @@ decomp_opt:	$(COMMANDLINE_OPT_OBJS)
 
 #decomp_test_dbg:	DBG_CXXFLAGS += -D_GLIBCXX_ASSERTIONS -fsanitize=address,undefined
 decomp_test_dbg:	$(TEST_DEBUG_OBJS)
-	$(CXX) $(DBG_CXXFLAGS) $(ARCH_TYPE) -o decomp_test_dbg $(TEST_DEBUG_OBJS) $(BFDLIB) $(LNK)
+	$(CXX) $(DBG_CXXFLAGS) $(ARCH_TYPE) -o decomp_test_dbg $(TEST_DEBUG_OBJS) $(LNK)
 
 test: decomp_test_dbg
 	./decomp_test_dbg
diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/modelrules.hh b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/modelrules.hh
index 34c24375e5..2a7dfa2853 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/modelrules.hh
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/modelrules.hh
@@ -24,7 +24,7 @@
 namespace ghidra {
 
 class ProtoModel;
-class ParameterPieces;
+struct ParameterPieces;
 class ParamListStandard;
 class ParamEntry;
 class ParamActive;
diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/type.hh b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/type.hh
index 1289ca468c..9024f91ae6 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/type.hh
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/type.hh
@@ -778,7 +778,7 @@ public:
 };
 
 class FuncProto;		// Forward declaration
-class PrototypePieces;
+struct PrototypePieces;
 
 /// \brief Datatype object representing executable code.
 ///
-- 
2.45.1

