+package ghidra.program.model.lang;
+
+import static org.junit.Assert.*;
+
+import org.junit.After;
+import org.junit.Test;
+
+import ghidra.program.database.ProgramBuilder;
+import ghidra.program.model.listing.Instruction;
+import ghidra.program.model.listing.Program;
+import ghidra.program.model.pcode.PcodeOp;
+import ghidra.program.model.symbol.Reference;
+import ghidra.test.AbstractGhidraHeadlessIntegrationTest;
+
+public class SuperHDelaySlotPcRelativeTest extends AbstractGhidraHeadlessIntegrationTest {
+
+	private Program program;
+
+	@After
+	public void tearDown() {
+		if (program != null) {
+			program.release(this);
+		}
+	}
+
+	@Test
+	public void testMovLUsesDirectBranchDestination() throws Exception {
+		assertDelaySlotReference("d3 01", 0xc);
+	}
+
+	@Test
+	public void testMovWUsesDirectBranchDestination() throws Exception {
+		assertDelaySlotReference("93 01", 0xc);
+	}
+
+	@Test
+	public void testMovLUsesDirectCallDestination() throws Exception {
+		ProgramBuilder builder = buildProgram(
+			"b0 02 d3 01 00 09 00 09 00 09 00 09 12 34 56 78");
+		builder.disassemble("0", 16, true);
+		assertOperandReference(builder, 2, 0, 0xc);
+	}
+
+	@Test
+	public void testMovWUsesBackwardBranchDestination() throws Exception {
+		ProgramBuilder builder = buildProgram(
+			"00 09 00 09 00 09 00 09 af fa 93 01 00 09 00 09");
+		builder.disassemble("8", 8, true);
+		assertOperandReference(builder, 0xa, 0, 4);
+	}
+
+	@Test
+	public void testMovaUsesDirectBranchDestination() throws Exception {
+		ProgramBuilder builder = buildProgram(
+			"a0 02 c7 01 00 09 00 09 00 09 00 09 12 34 56 78");
+		builder.disassemble("0", 16, true);
+		Instruction instruction = program.getListing().getInstructionAt(builder.addr(2));
+		assertNotNull(instruction);
+		assertEquals("@(0xc,pc)", instruction.getDefaultOperandRepresentation(0));
+		PcodeOp[] pcode = instruction.getPcode();
+		assertEquals(2, pcode.length);
+		assertEquals(PcodeOp.COPY, pcode[0].getOpcode());
+		assertTrue(pcode[0].getInput(0).isConstant());
+		assertEquals(0xc, pcode[0].getInput(0).getOffset());
+		assertEquals(PcodeOp.COPY, pcode[1].getOpcode());
+	}
+
+	@Test
+	public void testMovLOutsideDelaySlotStillUsesInstructionAddress() throws Exception {
+		ProgramBuilder builder = buildProgram("d3 01 00 09 00 09 00 09 12 34 56 78");
+		builder.disassemble("0", 12, true);
+		assertOperandReference(builder, 0, 0, 8);
+	}
+
+	@Test
+	public void testSh4LittleEndianMovLUsesDirectBranchDestination() throws Exception {
+		ProgramBuilder builder = buildProgram(
+			"02 a0 01 d3 09 00 09 00 09 00 09 00 78 56 34 12",
+			"SuperH4:LE:32:default");
+		builder.disassemble("0", 16, true);
+		assertOperandReference(builder, 2, 0, 0xc);
+	}
+
+	private void assertDelaySlotReference(String delaySlotBytes, long expectedAddress)
+			throws Exception {
+		ProgramBuilder builder = buildProgram(
+			"a0 02 " + delaySlotBytes + " 00 09 00 09 00 09 00 09 12 34 56 78");
+		builder.disassemble("0", 16, true);
+		assertOperandReference(builder, 2, 0, expectedAddress);
+	}
+
+	private ProgramBuilder buildProgram(String bytes) throws Exception {
+		return buildProgram(bytes, "SuperH:BE:32:SH-2A");
+	}
+
+	private ProgramBuilder buildProgram(String bytes, String languageId) throws Exception {
+		ProgramBuilder builder =
+			new ProgramBuilder("SuperH delay-slot PC-relative test", languageId);
+		builder.setBytes("0", bytes);
+		program = builder.getProgram();
+		program.addConsumer(this);
+		return builder;
+	}
+
+	private void assertOperandReference(ProgramBuilder builder, long instructionAddress,
+			int operandIndex, long expectedAddress) {
+		Instruction instruction =
+			program.getListing().getInstructionAt(builder.addr(instructionAddress));
+		assertNotNull(instruction);
+		Reference[] references = instruction.getOperandReferences(operandIndex);
+		assertEquals(1, references.length);
+		assertEquals(builder.addr(expectedAddress), references[0].getToAddress());
+	}
+}
