From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Sat, 3 Oct 2026 20:04:20 +0300
Subject: [PATCH] 9707: Store Xtensa CEIL.S and FLOOR.S results as integers

Store Xtensa CEIL.S and FLOOR.S results as integers.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 .../Processors/Xtensa/data/languages/xtensaInstructions.sinc  | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc b/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
index ce8727c090..7c1d477cc4 100644
--- a/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
+++ b/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
@@ -388,7 +388,7 @@ macro extract_bit(bit, result) {
 # CEIL.S - Ceiling Single to Fixed (RRR), pg. 311.
 :ceil.s ar, fs, op_t is op2 = 0b1011 & op1 = 0b1010 & ar & fs & op_t & op0 = 0 {
 	local scale:4 = 1 << op_t;
-	ar = ceil(fs f* int2float(scale));
+	ar = trunc(ceil(fs f* int2float(scale)));
 }
 
 # CLAMPS - Signed Clamp (RRR), pg. 312.
@@ -511,7 +511,7 @@ macro extract_bit(bit, result) {
 # FLOOR.S - Floor Single to Fixed (RRR), pg. 347.
 :floor.s ar, fs, op_t is op2 = 0b1010 & op1 = 0b1010 & ar & fs & op_t & op0 = 0 {
 	local scale:4 = 1 << op_t;
-	ar = floor(fs f* int2float(scale));
+	ar = trunc(floor(fs f* int2float(scale)));
 }
 
 # IDTLB - Invalidate Data TLB Entry (RRR), pg. 348.
