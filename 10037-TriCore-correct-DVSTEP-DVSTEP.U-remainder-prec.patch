From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: grauulzz <61565419+grauulzz@users.noreply.github.com>
Date: Mon, 26 Oct 2026 15:31:13 -0700
Subject: [PATCH] 10037: TriCore: correct DVSTEP / DVSTEP.U remainder precision
 and destination, implement DIV / DIV.U

---
 .../tricore/data/languages/tricore.sinc       | 75 +++++++++++++++----
 1 file changed, 59 insertions(+), 16 deletions(-)

diff --git a/Ghidra/Processors/tricore/data/languages/tricore.sinc b/Ghidra/Processors/tricore/data/languages/tricore.sinc
index 2f694b7a48..e9f6fbb415 100644
--- a/Ghidra/Processors/tricore/data/languages/tricore.sinc
+++ b/Ghidra/Processors/tricore/data/languages/tricore.sinc
@@ -2090,23 +2090,34 @@ SC: [a10]const0815Z10zz is PCPMode=0 & a10 & const0815Z10zz & op0003=8 & op0404=
 # DIV E[c], D[a], D[b] (RR)
 :div Ree2831/Reo2831,Rd0811,Rd1215 is PCPMode=0 & Rd0811 & Rd1215 & op0007=0x4b ; Ree2831 & Reo2831 & op1627=0x201
 {
-	#TODO  divide
-	#TODO  flags
-	local divres = Rd0811 s/ Rd1215;
-	local divmod = Rd0811 s% Rd1215;
-	Ree2831 = divres;
-	Reo2831 = divmod;
+	# TriCore ISA DIV: quotient to E[c][31:0], remainder (sign of the dividend) to E[c][63:32]
+	local zero:1 = Rd1215 == 0;
+	local minneg:1 = (Rd1215 == 0xffffffff) && (Rd0811 == 0x80000000);
+	local special:1 = zero || minneg;
+	local safe:4 = (Rd1215 * zext(special == 0)) + zext(special != 0);
+	local q:4 = Rd0811 s/ safe;
+	local r:4 = Rd0811 s% safe;
+	local qs:4 = 0x7fffffff + zext(zero && (Rd0811 s< 0));
+	Ree2831 = (q * zext(special == 0)) + (qs * zext(special != 0));
+	Reo2831 = r * zext(special == 0);
+	$(PSW_V) = special;
+	$(PSW_SV) = special | $(PSW_SV);
+	$(PSW_AV) = 0;
 }
 
 # DIV.U E[c], D[a], D[b] (RR)
 :div.u Ree2831/Reo2831,Rd0811,Rd1215 is PCPMode=0 & Rd0811 & Rd1215 & op0007=0x4b ; Ree2831 & Reo2831 & op1627=0x211
 {
-	#TODO  divide
-	#TODO  flags
-	local divres = Rd0811 / Rd1215;
-	local divmod = Rd0811 % Rd1215;
-	Ree2831 = divres;
-	Reo2831 = divmod;
+	# TriCore ISA DIV.U: quotient to E[c][31:0], remainder to E[c][63:32]; zero divisor -> FFFFFFFFH, 0
+	local zero:1 = Rd1215 == 0;
+	local safe:4 = Rd1215 + zext(zero);
+	local q:4 = Rd0811 / safe;
+	local r:4 = Rd0811 % safe;
+	Ree2831 = (q * zext(zero == 0)) + (0xffffffff * zext(zero != 0));
+	Reo2831 = r * zext(zero == 0);
+	$(PSW_V) = zero;
+	$(PSW_SV) = zero | $(PSW_SV);
+	$(PSW_AV) = 0;
 }
 
 @if defined(TRICORE_RIDER_D) || defined(TRICORE_V2)
@@ -2249,8 +2260,26 @@ SC: [a10]const0815Z10zz is PCPMode=0 & a10 & const0815Z10zz & op0003=8 & op0404=
 # Signed divide step — passthrough since DVINIT computes the result directly
 :dvstep Ree2831/Reo2831,Ree2427/Reo2427,Rd1215 is PCPMode=0 & Rd1215 & op0007=0x6b & op0811=0x0 ; Ree2427 & Reo2427 & Ree2831 & Reo2831 & op1623=0xf0
 {
-	Ree2831 = Ree2427;
-	Reo2831 = Reo2427;
+	# TriCore ISA DVSTEP: eight restoring steps; the remainder is exact (infinite precision, manual p49)
+	local dividend_sign:1 = Reo2427[31,1];
+	local quotient_sign:1 = dividend_sign != Rd1215[31,1];
+	local addend:8 = (sext(Rd1215) * zext(quotient_sign != 0)) + ((0 - sext(Rd1215)) * zext(quotient_sign == 0));
+	local dividend_quotient:4 = Ree2427;
+	local remainder:8 = sext(Reo2427);
+	local temp:8 = 0;
+	local take:1 = 0;
+	local index:1 = 0;
+    <loop_start>
+	remainder = (remainder << 1) | zext(dividend_quotient[31,1]);
+	dividend_quotient = dividend_quotient << 1;
+	temp = remainder + addend;
+	take = (temp s< 0) == dividend_sign;
+	remainder = (temp * zext(take != 0)) + (remainder * zext(take == 0));
+	dividend_quotient = dividend_quotient | zext((take != 0 && quotient_sign == 0) || (take == 0 && quotient_sign != 0));
+	index = index + 1;
+	if (index < 8) goto <loop_start>;
+	Reo2831 = remainder:4;
+	Ree2831 = dividend_quotient;
 }
 @endif
 
@@ -2260,8 +2289,22 @@ SC: [a10]const0815Z10zz is PCPMode=0 & a10 & const0815Z10zz & op0003=8 & op0404=
 # Unsigned divide step — passthrough since DVINIT computes the result directly
 :dvstep.u Ree2831/Reo2831,Ree2427/Reo2427,Rd1215 is PCPMode=0 & Rd1215 & op0007=0x6b & op0811=0x0 ; Ree2427 & Reo2427 & Ree2831 & Reo2831 & op1623=0xe0
 {
-	Ree2831 = Ree2427;
-	Reo2831 = Reo2427;
+	# TriCore ISA DVSTEP.U: eight restoring steps on unsigned operands; exact remainder; result to E[c]
+	local divisor:8 = zext(Rd1215);
+	local dividend_quotient:4 = Ree2427;
+	local remainder:8 = zext(Reo2427);
+	local temp:8 = 0;
+	local index:1 = 0;
+    <loop_start>
+	remainder = (remainder << 1) | zext(dividend_quotient[31,1]);
+	dividend_quotient = dividend_quotient << 1;
+	temp = remainder - divisor;
+	remainder = (remainder * zext(temp s< 0)) + (temp * zext(!(temp s< 0)));
+	dividend_quotient = dividend_quotient | zext(!(temp s< 0));
+	index = index + 1;
+	if (index < 8) goto <loop_start>;
+	Reo2831 = remainder:4;
+	Ree2831 = dividend_quotient;
 }
 @endif
 
-- 
