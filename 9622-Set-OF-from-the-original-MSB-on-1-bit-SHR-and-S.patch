From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Sun, 13 Sep 2026 21:59:14 +0300
Subject: [PATCH] 9622: Set OF from the original MSB on 1-bit SHR and SHRD

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 Ghidra/Processors/x86/data/languages/ia.sinc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Processors/x86/data/languages/ia.sinc b/Ghidra/Processors/x86/data/languages/ia.sinc
index ba45e84b47..13c2ec9220 100644
--- a/Ghidra/Processors/x86/data/languages/ia.sinc
+++ b/Ghidra/Processors/x86/data/languages/ia.sinc
@@ -2288,12 +2288,12 @@ macro sarflags(op1,result,count) {
 
 macro shrflags(op1,result,count) {
  conditionalAssign(CF, count==0, CF, ( (op1 >> (count - 1)) & 1 ) != 0 );
- conditionalAssign(OF, count==1, 0, (op1 s< 0)); 
+ conditionalAssign(OF, count==1, (op1 s< 0), OF);
 }
 
 macro shrdflags(op1,result,count) {
  conditionalAssign(CF, count==0, CF, ( (op1 >> (count - 1)) & 1 ) != 0 );
- conditionalAssign(OF, count==1, 0, ((op1 s< 0) ^ (result s< 0))); 
+ conditionalAssign(OF, count==1, ((op1 s< 0) ^ (result s< 0)), OF);
 }
 
 macro fdec() {
-- 
2.45.1

