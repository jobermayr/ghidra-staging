diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/address.hh b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/address.hh
index 2ff56c342e..bff70136c3 100644
