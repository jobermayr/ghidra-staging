-///   - In(0) -> Out(0) and
-///   - In(1) -> Out(1)
-///
-/// Or if \b flipflow is true:
-///   - In(0) -> Out(1)
-///   - In(1) -> Out(0)
-/// \param bl is the given FlowBlock
-/// \param flipflow indicates how the edges are remapped
