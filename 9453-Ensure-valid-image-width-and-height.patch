From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kai Bolay <kai@bolay.de>
Date: Mon, 3 Aug 2026 19:48:34 -0400
Subject: [PATCH] 9453: Ensure valid image width and height

Reject invalid values, prevent out-of-memory downstream.
---
 .../main/java/ghidra/file/formats/ios/png/IHDRChunk.java    | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ios/png/IHDRChunk.java b/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ios/png/IHDRChunk.java
index 013244dd9e..1545b2b87e 100644
--- a/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ios/png/IHDRChunk.java
+++ b/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ios/png/IHDRChunk.java
@@ -49,7 +49,13 @@ public class IHDRChunk {
 				ByteBuffer buff = ByteBuffer.wrap(data);
 
 				imgWidth = buff.getInt();
+				if (imgWidth <= 0 || imgWidth > 65535) {
+					throw new IllegalArgumentException("Invalid image width: " + imgWidth);
+				}
 				imgHeight = buff.getInt();
+				if (imgHeight <= 0 || imgHeight > 65535) {
+					throw new IllegalArgumentException("Invalid image height: " + imgHeight);
+				}
 				bitDepth = buff.get();
 				colorType = buff.get();
 				compressionMethod = buff.get();
-- 
2.45.1

