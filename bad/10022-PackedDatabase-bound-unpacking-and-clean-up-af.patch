From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ranjith Rosan <ranjithrosan17@gmail.com>
Date: Sat, 24 Oct 2026 17:33:53 +0000
Subject: [PATCH] 10022: PackedDatabase: bound unpacking and clean up after a
 failed unpack

The header of a packed database (.gdt) records how many bytes the compressed
stream will produce.  Nothing checked that value, so an archive of a few MB
that inflates to gigabytes was written out in full until the file system ran
out of space, and the partially written file and its cache directory were
left behind afterwards.

- ItemDeserializer: require the declared length to agree with the compressed
  stream, and refuse to write more bytes than it declares.
- PackedDatabase: reject an archive whose declared length exceeds the space
  available for the unpacked copy, before writing anything, and delete the
  partial file when an unpack fails or is cancelled.
- PackedDatabaseCache: drop the cache entry of a database that failed to
  unpack instead of keeping the partial copy.
---
 .../framework/store/db/PackedDatabase.java    | 41 ++++++++++++++++---
 .../store/db/PackedDatabaseCache.java         | 27 +++++++++++-
 .../store/local/ItemDeserializer.java         | 32 ++++++++++-----
 3 files changed, 83 insertions(+), 17 deletions(-)

diff --git a/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/db/PackedDatabase.java b/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/db/PackedDatabase.java
index 8731c57840..37e785f851 100644
--- a/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/db/PackedDatabase.java
+++ b/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/db/PackedDatabase.java
@@ -523,13 +523,17 @@ public class PackedDatabase extends Database {
 		}
 		int version = bfMgr.getCurrentVersion() + 1; // should be 1 in most situations
 		File file = bfMgr.getBufferFile(version);
-		OutputStream out = new BufferedOutputStream(new FileOutputStream(file));
+		OutputStream out = null;
 		ItemDeserializer itemDeserializer = null;
+		boolean success = false;
 		try {
 			Msg.debug(PackedDatabase.class, "Unpacking database " + packedFile + " -> " + file);
 			itemDeserializer = new ItemDeserializer(packedFile);
+			checkUnpackedSize(file, itemDeserializer.getLength());
+			out = new BufferedOutputStream(new FileOutputStream(file));
 			itemDeserializer.saveItem(out, monitor);
 			bfMgr.versionCreated(version, "Unpacked " + packedFile, checkinId);
+			success = true;
 		}
 		catch (IOCancelledException e) {
 			throw new CancelledException();
@@ -538,15 +542,42 @@ public class PackedDatabase extends Database {
 			if (itemDeserializer != null) {
 				itemDeserializer.dispose();
 			}
-			try {
-				out.close();
+			if (out != null) {
+				try {
+					out.close();
+				}
+				catch (IOException e) {
+					// ignore
+				}
 			}
-			catch (IOException e) {
-				// ignore
+			// A failed or cancelled unpack must not leave a partially written file behind
+			if (!success && file.exists() && !file.delete()) {
+				Msg.warn(PackedDatabase.class,
+					"Failed to remove partially unpacked database file: " + file);
 			}
 		}
 	}
 
+	/**
+	 * Rejects a packed file which claims to unpack to more data than the destination file
+	 * system can hold.  The length comes from the packed file header, so this check stops a
+	 * small archive from exhausting the disk before any of it is written.
+	 * @param file destination file for the unpacked database
+	 * @param length unpacked length recorded in the packed file header
+	 * @throws IOException if the destination file system does not have room for the data
+	 */
+	private static void checkUnpackedSize(File file, long length) throws IOException {
+		if (length <= 0) {
+			return;
+		}
+		long usable = file.getParentFile().getUsableSpace();
+		if (usable > 0 && length > usable) {
+			throw new IOException("Packed database cannot be unpacked - it requires " + length +
+				" bytes but only " + usable + " bytes are available in " +
+				file.getParentFile().getAbsolutePath());
+		}
+	}
+
 	/**
 	 * Refresh the temporary database from the packed file if it has been updated
 	 * since the previous refresh.
diff --git a/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/db/PackedDatabaseCache.java b/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/db/PackedDatabaseCache.java
index 0f3eb847ea..a8e08d599a 100644
--- a/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/db/PackedDatabaseCache.java
+++ b/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/db/PackedDatabaseCache.java
@@ -293,6 +293,24 @@ public class PackedDatabaseCache {
 		}
 	}
 
+	/**
+	 * Remove a cached database whose unpacking failed, along with its files.  The caller must
+	 * hold the cache lock.
+	 * @param cachedDb entry to remove
+	 */
+	private void removeCacheEntry(CachedDB cachedDb) {
+		try {
+			List<CachedDB> list = readCache();
+			list.removeIf(entry -> cachedDb.packedDbFilePath.equals(entry.packedDbFilePath));
+			writeCacheList(list);
+		}
+		catch (IOException e) {
+			Msg.warn(this, "Failed to remove packed database cache entry: " +
+				cachedDb.packedDbFilePath + ", " + e.getMessage());
+		}
+		FileUtilities.deleteDir(cachedDb.dbDir);
+	}
+
 	boolean isInCache(ResourceFile packedDbFile) throws IOException {
 		if (!lock.createLock(PackedDatabase.LOCK_TIMEOUT, true)) {
 			throw new IOException("Packed database cache timeout");
@@ -363,7 +381,14 @@ public class PackedDatabaseCache {
 				else {
 					Msg.debug(this, "Using cached packed database: " + cachedDb.packedDbFilePath);
 				}
-				return new PackedDatabase(cachedDb, packedDbFile, packedDbLock, monitor);
+				try {
+					return new PackedDatabase(cachedDb, packedDbFile, packedDbLock, monitor);
+				}
+				catch (IOException | CancelledException | RuntimeException e) {
+					// Do not keep a partially unpacked database in the cache
+					removeCacheEntry(cachedDb);
+					throw e;
+				}
 			}
 			finally {
 				if (packedDbLock != null && packedDbLock.haveLock()) {
diff --git a/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/local/ItemDeserializer.java b/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/local/ItemDeserializer.java
index 1499711f93..5973670f8f 100644
--- a/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/local/ItemDeserializer.java
+++ b/Ghidra/Framework/FileSystem/src/main/java/ghidra/framework/store/local/ItemDeserializer.java
@@ -168,26 +168,36 @@ public class ItemDeserializer {
 		if (entry == null || !ZIP_ENTRY_NAME.equals(entry.getName())) {
 			throw new IOException("Data error");
 		}
-//		if (length != entry.getSize()) {
-//			throw new IOException("Content length is " + entry.getSize() + ", expected " + length);
-//		}
+		// The header supplies the unpacked length, so it must agree with the compressed stream.
+		// A value of -1 means the stream did not record its size.
+		if (entry.getSize() != -1 && entry.getSize() != length) {
+			throw new IOException(
+				"Content length is " + entry.getSize() + ", expected " + length);
+		}
 
 		InputStream itemIn = zipIn;
 		if (monitor != null) {
 			itemIn = new MonitoredInputStream(zipIn, monitor);
-			monitor.initialize((int) length);
+			monitor.initialize((int) Math.min(length, Integer.MAX_VALUE));
 		}
-		long len = length;
 		byte[] buffer = new byte[IO_BUFFER_SIZE];
 
-		// Copy file contents
-		int cnt = (int) (len < IO_BUFFER_SIZE ? len : IO_BUFFER_SIZE);
-		while ((cnt = itemIn.read(buffer, 0, cnt)) > 0) {
+		// Copy file contents, refusing to write more than the declared length: a compressed
+		// stream which inflates past its header must not be allowed to consume disk space.
+		long written = 0;
+		int cnt;
+		while ((cnt = itemIn.read(buffer)) > 0) {
+			if (written + cnt > length) {
+				throw new IOException("Unpacked content is larger than the declared length of " +
+					length + " bytes");
+			}
 			out.write(buffer, 0, cnt);
-			len -= cnt;
-			cnt = (int) (len < IO_BUFFER_SIZE ? len : IO_BUFFER_SIZE);
+			written += cnt;
+		}
+		if (written != length) {
+			throw new IOException("Unpacked content is " + written +
+				" bytes, expected " + length + " bytes");
 		}
-
 	}
 
 }
