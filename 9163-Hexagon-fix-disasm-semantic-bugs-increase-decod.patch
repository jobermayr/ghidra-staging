+	@Test
+	public void testStubCoverage_system_and_dma() {
+		// Y2_icdataw
+		assertDecode("00e0c055", "icdataw R0,R0");
+		// Y2_tlbpp
+		assertDecode("00c0606c", "tlbp R0,R1R0");
