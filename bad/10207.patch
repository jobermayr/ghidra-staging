From f4a1d624119978424b36f501b1d00dc51ae3c85b Mon Sep 17 00:00:00 2001
From: Adil Alperen Ciftci <adilalperenciftci@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:35:11 +0300
Subject: [PATCH] 10207: Skip flow repair when a no-return target cannot be marked

Analysis: skip flow repair for unmapped no-return targets

Signed-off-by: Adil Alperen Ciftci <adilalperenciftci@users.noreply.github.com>
---
 .../FindNoReturnFunctionsAnalyzer.java        |  14 ++-
 .../FindNoReturnFunctionsAnalyzerTest.java    | 111 ++++++++++++++++++
 2 files changed, 120 insertions(+), 5 deletions(-)
 create mode 100644 Ghidra/Features/Base/src/test/java/ghidra/app/plugin/core/analysis/FindNoReturnFunctionsAnalyzerTest.java

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/FindNoReturnFunctionsAnalyzer.java b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/FindNoReturnFunctionsAnalyzer.java
index f0840399caf..9574ee1383a 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/FindNoReturnFunctionsAnalyzer.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/FindNoReturnFunctionsAnalyzer.java
@@ -122,11 +122,14 @@ public boolean added(Program prog, AddressSetView set, TaskMonitor monitor, Mess
 			}
 
 			// mark all detected non-returning functions
+			AddressSet markedNoReturnSet = new AddressSet();
 			AddressIterator noreturns = noReturnSet.getAddresses(true);
 			for (Address address : noreturns) {
 				monitor.checkCancelled();
 
-				setFunctionNonReturning(program, address);
+				if (setFunctionNonReturning(program, address)) {
+					markedNoReturnSet.add(address);
+				}
 
 				monitor.setMessage("NoReturn - Clearing fallthrough at: " + address);
 				setNoFallThru(program, address);
@@ -137,7 +140,7 @@ public boolean added(Program prog, AddressSetView set, TaskMonitor monitor, Mess
 
 			// repair the damage for all non-returning functions
 			if (repairDamageEnabled) {
-				noreturns = noReturnSet.getAddresses(true);
+				noreturns = markedNoReturnSet.getAddresses(true);
 				for (Address address : noreturns) {	
 					AddressSet potentialDamagedLocations = findPotentialDamagedLocations(program, address);
 
@@ -194,19 +197,20 @@ private void repairDamagedLocations(TaskMonitor taskMonitor, AddressSet clearIns
 	 * 
 	 * @param cp program
 	 * @param entry function entry to change to non-returning
+	 * @return true if the function was marked non-returning
 	 */
-	private void setFunctionNonReturning(Program cp, Address entry) {
+	private boolean setFunctionNonReturning(Program cp, Address entry) {
 		Function func = cp.getFunctionManager().getFunctionAt(entry);
 		if (func == null) {
 			CreateFunctionCmd createFunctionCmd = new CreateFunctionCmd(entry);
 			createFunctionCmd.applyTo(cp);
 			func = cp.getFunctionManager().getFunctionAt(entry);
 			if (func == null) {
-				return;
+				return false;
 			}
 		}
-		// if func is null, create one at entry
 		func.setNoReturn(true);
+		return true;
 	}
 
 	/**
diff --git a/Ghidra/Features/Base/src/test/java/ghidra/app/plugin/core/analysis/FindNoReturnFunctionsAnalyzerTest.java b/Ghidra/Features/Base/src/test/java/ghidra/app/plugin/core/analysis/FindNoReturnFunctionsAnalyzerTest.java
new file mode 100644
index 00000000000..9dff22ace2f
--- /dev/null
+++ b/Ghidra/Features/Base/src/test/java/ghidra/app/plugin/core/analysis/FindNoReturnFunctionsAnalyzerTest.java
@@ -0,0 +1,111 @@
