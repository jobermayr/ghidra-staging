@@ -9,6 +9,7 @@ with : lockprefx=0 {
 @include "avx512_manual.sinc"
 @include "avx512_bmm.sinc"
 @include "gfni.sinc"
+@include "avx_vnni.sinc"
 @include "adx.sinc"
 @include "clwb.sinc"
 @include "pclmulqdq.sinc"
