 .../cpp/include/ghidra/coreaction.hh          |  1 +
 .../src/decompile/datatests/zerotop.xml       | 32 ++++++++
 4 files changed, 85 insertions(+), 26 deletions(-)
 create mode 100644 Ghidra/Features/Decompiler/src/decompile/datatests/zerotop.xml

