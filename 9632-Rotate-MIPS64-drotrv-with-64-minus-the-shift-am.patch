From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Mon, 14 Sep 2026 15:21:13 +0300
Subject: [PATCH] 9632: Rotate MIPS64 drotrv with 64 minus the shift amount

The immediate drotr/drotr32 forms and microMIPS drotrv already use a 64-bit complementary shift; the variable form copied 32-bit rotrv.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 Ghidra/Processors/MIPS/data/languages/mips64Instructions.sinc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Processors/MIPS/data/languages/mips64Instructions.sinc b/Ghidra/Processors/MIPS/data/languages/mips64Instructions.sinc
index ad0a80abbe..eb97ab1504 100644
--- a/Ghidra/Processors/MIPS/data/languages/mips64Instructions.sinc
+++ b/Ghidra/Processors/MIPS/data/languages/mips64Instructions.sinc
@@ -110,7 +110,7 @@
     shift:8 = RSsrc & 0x3f;
     tmp:8 = RTsrc;
     tmp1:8 = tmp >> shift;
-    tmp2:8 = tmp << (32 - shift);
+    tmp2:8 = tmp << (64 - shift);
     RD = tmp1 + tmp2;
 }
 
