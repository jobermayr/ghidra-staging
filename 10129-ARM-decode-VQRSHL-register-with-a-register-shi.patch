From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Laxmi Narayan Behera <lnb@lnbfederal.com>
Date: Wed, 4 Nov 2026 13:34:36 -0500
Subject: [PATCH] 10129: ARM: decode VQRSHL (register) with a register shift
 operand

---
 Ghidra/Processors/ARM/data/languages/ARMneon.sinc | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMneon.sinc b/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
index 13f77af079..405bc58048 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
@@ -5734,16 +5734,16 @@ ShiftImmLLI: "#"^shift_amt is TMode=1 & thv_c2021=1 & thv_L7=0 & thv_c1621  [ sh
 ShiftImmLLI: "#"^shift_amt is TMode=1 & thv_c2121=1 & thv_L7=0 & thv_c1621  [ shift_amt = thv_c1621 - 32; ] { export *[const]:8 shift_amt; }
 ShiftImmLLI: "#"^shift_amt is TMode=1 &               thv_L7=1 & thv_c1621  [ shift_amt = thv_c1621 - 0; ] { export *[const]:8 shift_amt; }
 
-:vqrshl.^udt^ShiftSize Qd, Qm, ShiftImmLLI  is ( ($(AMODE) & ARMcond=0 & cond=15 & c2527=1 & c2323=0 & c0811=5 &     c0606=1 &     c0404=1) |
-                                               ($(TMODE_EorF) & thv_c2327=0x1e &       thv_c0811=5 & thv_c0606=1 & thv_c0404=1) ) & udt & ShiftSize & ShiftImmLLI & Qd & Qm
+:vqrshl.^udt^esize2021 Qd, Qm, Qn  is ( ($(AMODE) & ARMcond=0 & cond=15 & c2527=1 & c2323=0 & c0811=5 &     c0606=1 &     c0404=1) |
+                                       ($(TMODE_EorF) & thv_c2327=0x1e &       thv_c0811=5 & thv_c0606=1 & thv_c0404=1) ) & udt & esize2021 & Qd & Qm & Qn
 {
-	Qd = VectorRoundShiftLeft(Qm,ShiftImmLLI,ShiftSize,udt);
+	Qd = VectorRoundShiftLeft(Qm,Qn,esize2021,udt);
 }
 
-:vqrshl.^udt^ShiftSize Dd, Dm, ShiftImmLLI  is ( ($(AMODE) & ARMcond=0 & cond=15 & c2527=1 & c2323=0 & c0811=5 &     c0606=0 &     c0404=1) |
-                                               ($(TMODE_EorF) & thv_c2327=0x1e &       thv_c0811=5 & thv_c0606=0 & thv_c0404=1) ) & udt & ShiftSize & ShiftImmLLI & Dd & Dm
+:vqrshl.^udt^esize2021 Dd, Dm, Dn  is ( ($(AMODE) & ARMcond=0 & cond=15 & c2527=1 & c2323=0 & c0811=5 &     c0606=0 &     c0404=1) |
+                                       ($(TMODE_EorF) & thv_c2327=0x1e &       thv_c0811=5 & thv_c0606=0 & thv_c0404=1) ) & udt & esize2021 & Dd & Dm & Dn
 {
-	Dd = VectorRoundShiftLeft(Dm,ShiftImmLLI,ShiftSize,udt);
+	Dd = VectorRoundShiftLeft(Dm,Dn,esize2021,udt);
 }
 
 
