From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rudy Celekli <rudy@gradiahq.com>
Date: Wed, 14 Oct 2026 15:19:19 -0400
Subject: [PATCH] 9864: Preserve status bits when SuperH NOTT toggles T

Preserve unrelated status bits in SuperH NOTT

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 Ghidra/Processors/SuperH/data/languages/superh.sinc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Processors/SuperH/data/languages/superh.sinc b/Ghidra/Processors/SuperH/data/languages/superh.sinc
index 3778bac605..a8c7401a90 100644
--- a/Ghidra/Processors/SuperH/data/languages/superh.sinc
+++ b/Ghidra/Processors/SuperH/data/languages/superh.sinc
@@ -825,7 +825,7 @@ MovMUReg2: MovMUReg2_15 is MovMUReg2_15 {
 # NOTT                          0000000001101000    ~ T → T
 :nott is opcode_00_15=0b0000000001101000
 {
-    $(T_FLAG) = ~$(T_FLAG);
+    $(T_FLAG) = $(T_FLAG) ^ 1;
 }
 
 @endif
