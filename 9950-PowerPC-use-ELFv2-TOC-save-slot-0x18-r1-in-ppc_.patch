From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Confidential <28762372+0L1v3DaD@users.noreply.github.com>
Date: Sun, 18 Oct 2026 19:07:54 -0500
Subject: [PATCH] 9950: PowerPC: use ELFv2 TOC save slot 0x18(r1) in
 ppc_64_le.cspec

---
 Ghidra/Processors/PowerPC/data/languages/ppc_64_le.cspec   | 6 +++---
 .../PowerPC/data/languages/ppc_instructions.sinc           | 7 +++++++
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Processors/PowerPC/data/languages/ppc_64_le.cspec b/Ghidra/Processors/PowerPC/data/languages/ppc_64_le.cspec
index f95f7990fe..fec7b4869f 100644
--- a/Ghidra/Processors/PowerPC/data/languages/ppc_64_le.cspec
+++ b/Ghidra/Processors/PowerPC/data/languages/ppc_64_le.cspec
@@ -182,9 +182,9 @@
       <pcode inject="uponreturn">
       	<body>
       		# Inject pcode when returning from a function call to place the r2Save
-      		# value into 0x28(r1) which should be restored by the "ld r2,0x28(r1)" 
-      		# which immediately follows calls which comply with the PPC64 ABI spec.
-      		local saveR2ptr = r1 + 0x28;
+		# value into 0x18(r1) which should be restored by the "ld r2,0x18(r1)"
+		# which immediately follows calls which comply with the PPC64 ELFv2 ABI spec.
+		local saveR2ptr = r1 + 0x18;
       		*:8 saveR2ptr = r2Save; 
       	</body>
       </pcode>
diff --git a/Ghidra/Processors/PowerPC/data/languages/ppc_instructions.sinc b/Ghidra/Processors/PowerPC/data/languages/ppc_instructions.sinc
index cfc071b2de..3ce82a5cae 100644
--- a/Ghidra/Processors/PowerPC/data/languages/ppc_instructions.sinc
+++ b/Ghidra/Processors/PowerPC/data/languages/ppc_instructions.sinc
@@ -3422,6 +3422,13 @@ CRM_val: crmval is CRM [crmval = CRM+0;] {export *[const]:1 crmval;}
 	*:8(dsPlusRaOrZeroAddress) = r2;
 }
 
+#std r2,0x18(r1) (ELFv2 TOC save slot)
+:std r2,dsPlusRaOrZeroAddress 	is $(NOTVLE) & OP=62 & S=2 & r2 & A=1 & SIMM_DS=0x6 & dsPlusRaOrZeroAddress & BITS_0_1=0
+{
+	r2Save = r2;
+	*:8(dsPlusRaOrZeroAddress) = r2;
+}
+
 #stdcx. r0,8(0)	0x7c 00 01 AD	
 :stdcx. S,RA_OR_ZERO,B 	is OP=31 & S & RA_OR_ZERO & B & XOP_1_10=214 & BIT_0=1
 {
-- 
