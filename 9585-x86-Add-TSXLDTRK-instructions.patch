From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CUB3D <callumthom11@gmail.com>
Date: Fri, 4 Sep 2026 17:31:57 +0000
Subject: [PATCH] 9585: x86: Add TSXLDTRK instructions

Add tsxldtrk instructions
---
 Ghidra/Processors/x86/certification.manifest       | 1 +
 Ghidra/Processors/x86/data/languages/tsxldtrk.sinc | 5 +++++
 Ghidra/Processors/x86/data/languages/x86.slaspec   | 1 +
 3 files changed, 7 insertions(+)
 create mode 100644 Ghidra/Processors/x86/data/languages/tsxldtrk.sinc

diff --git a/Ghidra/Processors/x86/certification.manifest b/Ghidra/Processors/x86/certification.manifest
index ef225e7095..efb803ee32 100644
--- a/Ghidra/Processors/x86/certification.manifest
+++ b/Ghidra/Processors/x86/certification.manifest
@@ -59,6 +59,7 @@ data/languages/rdrand.sinc||GHIDRA||||END|
 data/languages/sgx.sinc||GHIDRA||||END|
 data/languages/sha.sinc||GHIDRA||||END|
 data/languages/smx.sinc||GHIDRA||||END|
+data/languages/tsxldtrk.sinc||GHIDRA||||END|
 data/languages/x86-16-real.pspec||GHIDRA||||END|
 data/languages/x86-16.cspec||GHIDRA||||END|
 data/languages/x86-16.gdis||GHIDRA||||END|
diff --git a/Ghidra/Processors/x86/data/languages/tsxldtrk.sinc b/Ghidra/Processors/x86/data/languages/tsxldtrk.sinc
new file mode 100644
index 0000000000..53c53a5c15
--- /dev/null
+++ b/Ghidra/Processors/x86/data/languages/tsxldtrk.sinc
@@ -0,0 +1,5 @@
+define pcodeop xsusldtrk;
+:XSUSLDTRK is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x01; byte=0xE8 { xsusldtrk(); }
+
+define pcodeop xresldtrk;
+:XRESLDTRK is vexMode=0 & $(PRE_F2) & byte=0x0F; byte=0x01; byte=0xE9 { xresldtrk(); }
diff --git a/Ghidra/Processors/x86/data/languages/x86.slaspec b/Ghidra/Processors/x86/data/languages/x86.slaspec
index b91331511b..5f3d1dbc8f 100644
--- a/Ghidra/Processors/x86/data/languages/x86.slaspec
+++ b/Ghidra/Processors/x86/data/languages/x86.slaspec
@@ -22,4 +22,5 @@ with : lockprefx=0 {
 @include "rdrand.sinc"
 @include "xop.sinc"
 @include "rao.sinc"
+@include "tsxldtrk.sinc"
 }
-- 
