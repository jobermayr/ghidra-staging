index 0000000000..64c21339b5
--- /dev/null
+++ b/Ghidra/Extensions/GhidrAssist/src/main/java/ghidra/ghidrassist/ProjectExporter.java
@@ -0,0 +1,235 @@
+/* ###
+ * IP: GHIDRA
+ *
