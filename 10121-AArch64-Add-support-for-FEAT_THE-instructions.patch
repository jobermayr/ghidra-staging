+:rcwsclrp^ls_lor Rt_GPR64, Rs_GPR64, [Rn_GPR64xsp]
+is b_2431=0x59 & b_21=1 & Rs_GPR64 & b_1015=0x24 & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 0; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:16 Rn_GPR64xsp;
+@if DATA_ENDIAN == "big"
+	local tmp2:16 = zext(Rs_GPR64) | (zext(Rt_GPR64) << 64);
+@else
+	local tmp2:16 = zext(Rt_GPR64) | (zext(Rs_GPR64) << 64);
+@endif
+	*[ram]:16 Rn_GPR64xsp = tmp & (~tmp2);
+@if DATA_ENDIAN == "big"
+	Rs_GPR64 = tmp:8;
+	Rt_GPR64 = tmp(8);
+@else
+	Rt_GPR64 = tmp:8;
+	Rs_GPR64 = tmp(8);
+@endif
+    build ls_lor;
+}
+
+:rcwset^ls_lor Rs_GPR64, Rt_GPR64, [Rn_GPR64xsp]
+is b_2431=0x38 & b_21=1 & Rs_GPR64 & b_1015=0x2c & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 0; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:8 Rn_GPR64xsp;
+	*[ram]:8 Rn_GPR64xsp = tmp | Rs_GPR64;
+	Rt_GPR64 = tmp;
+    build ls_lor;
+}
+
+:rcwsetp^ls_lor Rt_GPR64, Rs_GPR64, [Rn_GPR64xsp]
+is b_2431=0x19 & b_21=1 & Rs_GPR64 & b_1015=0x2c & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 0; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:16 Rn_GPR64xsp;
+@if DATA_ENDIAN == "big"
+	local tmp2:16 = zext(Rs_GPR64) | (zext(Rt_GPR64) << 64);
+@else
+	local tmp2:16 = zext(Rt_GPR64) | (zext(Rs_GPR64) << 64);
+@endif
+	*[ram]:16 Rn_GPR64xsp = tmp2 | tmp;
+@if DATA_ENDIAN == "big"
+	Rs_GPR64 = tmp:8;
+	Rt_GPR64 = tmp(8);
+@else
+	Rt_GPR64 = tmp:8;
+	Rs_GPR64 = tmp(8);
+@endif
+    build ls_lor;
+}
+
+:rcwsset^ls_lor Rs_GPR64, Rt_GPR64, [Rn_GPR64xsp]
+is b_2431=0x78 & b_21=1 & Rs_GPR64 & b_1015=0x2c & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 0; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:8 Rn_GPR64xsp;
+	*[ram]:8 Rn_GPR64xsp = tmp | Rs_GPR64;
+	Rt_GPR64 = tmp;
+    build ls_lor;
+}
