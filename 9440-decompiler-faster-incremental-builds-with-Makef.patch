+sla_opt/%.o: %.cc | sla_opt
+	$(CXX) $(ARCH_TYPE) $(OPT_CXXFLAGS) $(INCLUDES) $(ADDITIONAL_FLAGS) $(SLEIGH_OPT) \
+		-MMD -MP -MF $(@:.o=.d) -c $< -o $@
