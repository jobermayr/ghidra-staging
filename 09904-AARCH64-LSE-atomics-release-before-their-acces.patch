-{ build ls_loa; build ls_data2; ls_opc_swp(tmp_ldWn, Rs_GPR32, tmp_stWn); build ls_mem2; aa_Xt = zext(tmp_ldWn); build ls_lor; }
+{ build ls_lor; build ls_data2; ls_opc_swp(tmp_ldWn, Rs_GPR32, tmp_stWn); build ls_mem2; aa_Xt = zext(tmp_ldWn); build ls_loa; }
 
