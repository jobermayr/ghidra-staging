+# Record-form vector compares set CR6 from the compare result mask:
+#   CR6 = all_true || 0b0 || all_false || 0b0
+# The 128-bit mask is tested as two 64-bit halves so that the decompiler, whose
+# constants are limited to 64 bits, does not print a truncated all-ones constant.
+macro vectorCompareSetCR6(mask) {
+	local maskHi:8 = mask(8);
+	local maskLo:8 = mask:8;
+	local allTrue:1 = (maskHi == 0xffffffffffffffff) && (maskLo == 0xffffffffffffffff);
+	local allFalse:1 = (maskHi == 0) && (maskLo == 0);
+	cr6 = (allTrue << 3) | (allFalse << 1);
+}
+
+# vcmpbfp. sets CR6 = 0b00 || all_within_bounds || 0b0
+macro vectorBoundsCompareSetCR6(mask) {
+	local maskHi:8 = mask(8);
+	local maskLo:8 = mask:8;
+	local allWithinBounds:1 = (maskHi == 0) && (maskLo == 0);
+	cr6 = allWithinBounds << 1;
+}
