+		-MMD -MP -MF $(@:.o=.d) -c $< -o $@
+
+ghi_opt/%.o: %.cc | ghi_opt
+	$(CXX) $(ARCH_TYPE) $(OPT_CXXFLAGS) $(INCLUDES) $(ADDITIONAL_FLAGS) $(GHIDRA_OPT) \
+		-MMD -MP -MF $(@:.o=.d) -c $< -o $@
+
+sla_dbg/%.o: %.cc | sla_dbg
