Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../program/model/data/BooleanDataType.java     | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/BooleanDataType.java b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/BooleanDataType.java
index a649707f2c..6e6d977c93 100644
--- a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/BooleanDataType.java
+++ b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/data/BooleanDataType.java
@@ -84,6 +84,23 @@ public class BooleanDataType extends AbstractUnsignedIntegerDataType {
 		}
 	}
 
+	@Override
+	protected BigInteger castValueToEncode(Object value) throws DataTypeEncodeException {
+		if (value instanceof Boolean) {
+			return (Boolean) value ? BigInteger.ONE : BigInteger.ZERO;
+		}
+		return super.castValueToEncode(value);
+	}
+
+	@Override
+	public byte[] encodeRepresentation(String repr, MemBuffer buf, Settings settings, int length)
+			throws DataTypeEncodeException {
+		if ("TRUE".equals(repr) || "FALSE".equals(repr)) {
+			return encodeValue("TRUE".equals(repr), buf, settings, length);
+		}
+		return super.encodeRepresentation(repr, buf, settings, length);
+	}
+
 	@Override
 	public Class<?> getValueClass(Settings settings) {
 		return Boolean.class;
