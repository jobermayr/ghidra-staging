From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CUB3D <callumthom11@gmail.com>
Date: Wed, 7 Oct 2026 14:34:23 +0000
Subject: [PATCH] 9751: AArch64: Add FEAT_CMPBR instructions

Add FEAT_CMPBR instructions
---
 .../AARCH64/data/languages/AARCH64base.sinc   | 100 ++++++++++++++++++
 .../data/languages/AARCH64instructions.sinc   |   3 +
 2 files changed, 103 insertions(+)

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index f347b3f015..9a207f5b14 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -9087,3 +9087,103 @@ is b_1931=0b1101010100001 & b_1618=0b000 & b_1215=0b0111 & b_0811=0b1111 & b_050
 :dc "CIGDVAPS", Rt_GPR64
 is b_1931=0b1101010100001 & b_1618=0b000 & b_1215=0b0111 & b_0811=0b1111 & b_0507=0b101 & Rt_GPR64
 { DC_CIGDVAPS(Rt_GPR64); }
+
+# FEAT_CMPBR
+
+Cmpbr_Dest:dest is cmpbr_imm9 [ dest = inst_start + (cmpbr_imm9<<2);] { export *[const]:8 dest; }
+
+with Cmpbr_bcc: {
+	:"gt" is b_2123=0b000 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:1) s> (Rm_GPR32:1); export *[const]:1 flag; }
+	:"ge" is b_2123=0b001 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:1) s>= (Rm_GPR32:1); export *[const]:1 flag; }
+	:"hi" is b_2123=0b010 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:1) > (Rm_GPR32:1); export *[const]:1 flag; }
+	:"hs" is b_2123=0b011 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:1) >= (Rm_GPR32:1); export *[const]:1 flag; }
+	:"eq" is b_2123=0b110 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:1) == (Rm_GPR32:1); export *[const]:1 flag; }
+	:"ne" is b_2123=0b111 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:1) != (Rm_GPR32:1); export *[const]:1 flag; }
+}
+
+with Cmpbr_hcc: {
+	:"gt" is b_2123=0b000 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:2) s> (Rm_GPR32:2); export *[const]:1 flag; }
+	:"ge" is b_2123=0b001 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:2) s>= (Rm_GPR32:2); export *[const]:1 flag; }
+	:"hi" is b_2123=0b010 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:2) > (Rm_GPR32:2); export *[const]:1 flag; }
+	:"hs" is b_2123=0b011 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:2) >= (Rm_GPR32:2); export *[const]:1 flag; }
+	:"eq" is b_2123=0b110 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:2) == (Rm_GPR32:2); export *[const]:1 flag; }
+	:"ne" is b_2123=0b111 & Rt_GPR32 & Rm_GPR32 { local flag = (Rt_GPR32:2) != (Rm_GPR32:2); export *[const]:1 flag; }
+}
+
+with Cmpbr_cc32: {
+	:"gt" is b_2123=0b000 & Rt_GPR32 & Rm_GPR32 { local flag = Rt_GPR32 s> Rm_GPR32; export *[const]:1 flag; }
+	:"ge" is b_2123=0b001 & Rt_GPR32 & Rm_GPR32 { local flag = Rt_GPR32 s>= Rm_GPR32; export *[const]:1 flag; }
+	:"hi" is b_2123=0b010 & Rt_GPR32 & Rm_GPR32 { local flag = Rt_GPR32 > Rm_GPR32; export *[const]:1 flag; }
+	:"hs" is b_2123=0b011 & Rt_GPR32 & Rm_GPR32 { local flag = Rt_GPR32 >= Rm_GPR32; export *[const]:1 flag; }
+	:"eq" is b_2123=0b110 & Rt_GPR32 & Rm_GPR32 { local flag = Rt_GPR32 == Rm_GPR32; export *[const]:1 flag; }
+	:"ne" is b_2123=0b111 & Rt_GPR32 & Rm_GPR32 { local flag = Rt_GPR32 != Rm_GPR32; export *[const]:1 flag; }
+}
+
+with Cmpbr_cc64: {
+	:"gt" is b_2123=0b000 & Rt_GPR64 & Rm_GPR64 { local flag = Rt_GPR64 s> Rm_GPR64; export *[const]:1 flag; }
+	:"ge" is b_2123=0b001 & Rt_GPR64 & Rm_GPR64 { local flag = Rt_GPR64 s>= Rm_GPR64; export *[const]:1 flag; }
+	:"hi" is b_2123=0b010 & Rt_GPR64 & Rm_GPR64 { local flag = Rt_GPR64 > Rm_GPR64; export *[const]:1 flag; }
+	:"hs" is b_2123=0b011 & Rt_GPR64 & Rm_GPR64 { local flag = Rt_GPR64 >= Rm_GPR64; export *[const]:1 flag; }
+	:"eq" is b_2123=0b110 & Rt_GPR64 & Rm_GPR64 { local flag = Rt_GPR64 == Rm_GPR64; export *[const]:1 flag; }
+	:"ne" is b_2123=0b111 & Rt_GPR64 & Rm_GPR64 { local flag = Rt_GPR64 != Rm_GPR64; export *[const]:1 flag; }
+}
+
+with Cmpbr_cci32: {
+	:"gt" is b_2123=0b000 & Rt_GPR32 & cmpbr_imm6 { local flag = Rt_GPR32 s> cmpbr_imm6; export *[const]:1 flag; }
+	:"ge" is b_2123=0b001 & Rt_GPR32 & cmpbr_imm6 { local flag = Rt_GPR32 s>= cmpbr_imm6; export *[const]:1 flag; }
+	:"hi" is b_2123=0b010 & Rt_GPR32 & cmpbr_imm6 { local flag = Rt_GPR32 > cmpbr_imm6; export *[const]:1 flag; }
+	:"hs" is b_2123=0b011 & Rt_GPR32 & cmpbr_imm6 { local flag = Rt_GPR32 >= cmpbr_imm6; export *[const]:1 flag; }
+	:"eq" is b_2123=0b110 & Rt_GPR32 & cmpbr_imm6 { local flag = Rt_GPR32 == cmpbr_imm6; export *[const]:1 flag; }
+	:"ne" is b_2123=0b111 & Rt_GPR32 & cmpbr_imm6 { local flag = Rt_GPR32 != cmpbr_imm6; export *[const]:1 flag; }
+}
+
+with Cmpbr_cci64: {
+	:"gt" is b_2123=0b000 & Rt_GPR64 & cmpbr_imm6 { local flag = Rt_GPR64 s> cmpbr_imm6; export *[const]:1 flag; }
+	:"ge" is b_2123=0b001 & Rt_GPR64 & cmpbr_imm6 { local flag = Rt_GPR64 s>= cmpbr_imm6; export *[const]:1 flag; }
+	:"hi" is b_2123=0b010 & Rt_GPR64 & cmpbr_imm6 { local flag = Rt_GPR64 > cmpbr_imm6; export *[const]:1 flag; }
+	:"hs" is b_2123=0b011 & Rt_GPR64 & cmpbr_imm6 { local flag = Rt_GPR64 >= cmpbr_imm6; export *[const]:1 flag; }
+	:"eq" is b_2123=0b110 & Rt_GPR64 & cmpbr_imm6 { local flag = Rt_GPR64 == cmpbr_imm6; export *[const]:1 flag; }
+	:"ne" is b_2123=0b111 & Rt_GPR64 & cmpbr_imm6 { local flag = Rt_GPR64 != cmpbr_imm6; export *[const]:1 flag; }
+}
+
+:cbb^Cmpbr_bcc Rt_GPR32, Rm_GPR32, Cmpbr_Dest
+is b_2431=0x74 & Cmpbr_bcc & Rm_GPR32 & b_15=1 & b_14=0 & Cmpbr_Dest & Rt_GPR32
+{
+	if(!Cmpbr_bcc) goto inst_next;
+	goto [Cmpbr_Dest];
+}
+
+:cbh^Cmpbr_hcc Rt_GPR32, Rm_GPR32, Cmpbr_Dest
+is b_2431=0x74 & Cmpbr_hcc & Rm_GPR32 & b_15=1 & b_14=1 & Cmpbr_Dest & Rt_GPR32
+{
+	if(!Cmpbr_hcc) goto inst_next;
+	goto [Cmpbr_Dest];
+}
+
+:cb^Cmpbr_cc32 Rt_GPR32, Rm_GPR32, Cmpbr_Dest
+is b_2431=0x74 & Cmpbr_cc32 & Rm_GPR32 & b_15=0 & b_14=0 & Cmpbr_Dest & Rt_GPR32
+{
+	if(!Cmpbr_cc32) goto inst_next;
+	goto [Cmpbr_Dest];
+}
+
+:cb^Cmpbr_cc64 Rt_GPR64, Rm_GPR64, Cmpbr_Dest
+is b_2431=0xf4 & Cmpbr_cc64 & Rm_GPR64 & b_15=0 & b_14=0 & Cmpbr_Dest & Rt_GPR64
+{
+	if(!Cmpbr_cc64) goto inst_next;
+	goto [Cmpbr_Dest];
+}
+
+:cb^Cmpbr_cci32 Rt_GPR32, "#"^cmpbr_imm6, Cmpbr_Dest
+is b_2431=0x75 & Cmpbr_cci32 & cmpbr_imm6 & b_14=0 & Cmpbr_Dest & Rt_GPR32
+{
+	if(!Cmpbr_cci32) goto inst_next;
+	goto [Cmpbr_Dest];
+}
+
+:cb^Cmpbr_cci64 Rt_GPR64, "#"^cmpbr_imm6, Cmpbr_Dest
+is b_2431=0xf5 & Cmpbr_cci64 & cmpbr_imm6 & b_14=0 & Cmpbr_Dest & Rt_GPR64
+{
+	if(!Cmpbr_cci64) goto inst_next;
+	goto [Cmpbr_Dest];
+}
diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc
index de99a269c8..eb0ad38198 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc
@@ -1811,6 +1811,9 @@ define token instrAARCH64 (32) endian = little
 	u = (29,29)
 	v = (26,26)
 
+	cmpbr_imm9 = (5,13) signed
+	cmpbr_imm6 = (15,20)
+
 	# SVE tokens
 
 	Zd = (0,4)
-- 
2.45.1

