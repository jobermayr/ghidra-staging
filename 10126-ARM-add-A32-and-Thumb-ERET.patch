From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Laxmi Narayan Behera <lnb@lnbfederal.com>
Date: Wed, 4 Nov 2026 12:56:48 -0500
Subject: [PATCH] 10126: ARM: add A32 and Thumb ERET

ARM: add A32 ERET

ARM: add Thumb ERET
---
 .../ARM/data/languages/ARMTHUMBinstructions.sinc       | 10 ++++++++++
 .../Processors/ARM/data/languages/ARMinstructions.sinc |  9 +++++++++
 2 files changed, 19 insertions(+)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
index 7bc149e68f..0a69523582 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
@@ -10750,6 +10750,16 @@ thumbEndianNess: "BE" is op0=0xb658 { export 1:1; }
   build thSBIT_CZNO;
 }
 
+# Outside Hyp mode, same as subs pc,lr,#0
+:eret^ItCond	 		is TMode=1 & ItCond & op0=0xf3de; op0=0x8f00
+{
+  build ItCond;
+  cpsr=spsr;
+  SetThumbMode( ((cpsr >> 5) & 1) != 0 );
+  pc = lr;
+  return [pc];
+}
+
 :sub^ItCond	pc,lr,Immed8 		is TMode=1 & ItCond & op4=0xf3d & pc & sop0003=0xe; op8=0x8f & lr & Immed8
 {
   build ItCond;
diff --git a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
index 3e88c023ec..04fef6eebe 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
@@ -2474,6 +2474,15 @@ immed12_4: "#"^tmp is $(AMODE) & immed12 & immed4 [tmp = (immed12 << 4) | immed4
 	software_hvc(immed12_4);
 }
 
+# Requires Virtualization Extensions or ARMv8; outside Hyp mode, same as subs pc,lr,#0
+:eret^COND			is $(AMODE) & COND & c0027=0x160006e
+{
+	build COND;
+	cpsr = spsr;
+	ALUWritePC(lr);
+	return [pc];
+}
+
 @if defined(VERSION_6T2) || defined(VERSION_7)
 
 define pcodeop SG;
-- 
2.45.1

