From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Confidential <28762372+0L1v3DaD@users.noreply.github.com>
Date: Sun, 18 Oct 2026 18:43:33 -0500
Subject: [PATCH] 09940: Decompiler: fix udiv128 zero check and leftshift
 bounds

---
 .../Features/Decompiler/src/decompile/cpp/multiprecision.cc  | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/multiprecision.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/multiprecision.cc
index 35defb1a70..2c200a0039 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/multiprecision.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/multiprecision.cc
@@ -44,7 +44,8 @@ static void leftshift(int4 num,uint8 *in,uint8 *out,int4 sa)
     for(;inIndex>0;--inIndex) {
       out[outIndex--] = (in[inIndex] << sa) | (in[inIndex-1] >> (64-sa));
     }
-    out[outIndex--] = in[0] << sa;
+    if (inIndex == 0)
+      out[outIndex--] = in[0] << sa;
     for(;outIndex>=0;--outIndex) {
       out[outIndex] = 0;
     }
@@ -288,6 +289,8 @@ static void knuth_algorithm_d(int4 m,int4 n,uint4 *u,uint4 *v,uint4 *q)
 void udiv128(uint8 *numer,uint8 *denom,uint8 *quotient_res,uint8 *remainder_res)
 
 {
+  if (denom[0] == 0 && denom[1] == 0)
+    throw LowlevelError("divide by 0");
   if (numer[1] == 0 && denom[1] == 0) {
     quotient_res[0] = numer[0] / denom[0];
     quotient_res[1] = 0;
-- 
2.45.1

