@@ -24,4 +24,6 @@ with : lockprefx=0 {
 @include "rao.sinc"
 @include "keylocker.sinc"
 @include "amx.sinc"
+# must stay last (see nop_reserved.sinc)
+@include "nop_reserved.sinc"
 }
