From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Sun, 13 Sep 2026 21:58:51 +0300
Subject: [PATCH] 9621: Guard calcNZMask against p-code ops with a null input
 varnode

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 .../Decompiler/src/decompile/cpp/funcdata_varnode.cc         | 1 +
 Ghidra/Features/Decompiler/src/decompile/cpp/op.cc           | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/funcdata_varnode.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/funcdata_varnode.cc
index 723ab824fe..4875160092 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/funcdata_varnode.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/funcdata_varnode.cc
@@ -913,6 +913,7 @@ void Funcdata::calcNZMask(void)
       }
       // Traverse edge indicated by slot
       Varnode *vn = node.op->getIn(oldslot);
+      if (vn == (Varnode *)0) continue;
       if (!vn->isWritten()) {
 	if (vn->isConstant())
 	  vn->nzm = vn->getOffset();
diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/op.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/op.cc
index b3709d6892..a20f57de4d 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/op.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/op.cc
@@ -577,6 +577,11 @@ uintb PcodeOp::getNZMaskLocal(bool cliploop) const
   size = output->getSize();
   uintb fullmask = calc_mask( size );
 
+  for(int4 i=0;i<inrefs.size();++i) {
+    if (inrefs[i] == (Varnode *)0)
+      return fullmask;
+  }
+
   switch(opcode->getOpcode()) {
   case CPUI_INT_EQUAL:
   case CPUI_INT_NOTEQUAL:
-- 
