From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ash Pera <ashley.pera@noaa.gov>
Date: Wed, 28 Oct 2026 01:26:54 -0600
Subject: [PATCH] 10049: Fix Go stack parameter alignment

Align a Go struct to its most-aligned field, raised to the RTTI alignment
when known; force 8 for atomic.align64 fields; align complex numbers as
their real part; and align stack slots relative to the start of the
arguments. Recover Go complex64/complex128 as complex types.
---
 .../golang/GoParamStorageAllocator.java       |  12 ++-
 .../bin/format/golang/GoRegisterInfo.java     |  26 ++++-
 .../format/golang/rtti/types/GoBaseType.java  |  10 ++
 .../golang/rtti/types/GoStructType.java       |   3 +
 .../bin/format/golang/GoRegisterInfoTest.java | 100 ++++++++++++++++++
 5 files changed, 145 insertions(+), 6 deletions(-)
 create mode 100644 Ghidra/Features/Base/src/test.slow/java/ghidra/app/util/bin/format/golang/GoRegisterInfoTest.java

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/GoParamStorageAllocator.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/GoParamStorageAllocator.java
index c44b96b6d0..2ab4d264d1 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/GoParamStorageAllocator.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/GoParamStorageAllocator.java
@@ -226,13 +226,17 @@ public class GoParamStorageAllocator {
 	}
 
 	public void alignStackFor(DataType dt) {
-		int alignmentSize = callspecInfo.getAlignmentForType(dt);
-		stackOffset = NumericUtilities.getUnsignedAlignedValue(stackOffset, alignmentSize);
+		alignStack(callspecInfo.getAlignmentForType(dt));
 	}
 
 	public void alignStack() {
-		stackOffset =
-			NumericUtilities.getUnsignedAlignedValue(stackOffset, callspecInfo.getMaxAlign());
+		alignStack(callspecInfo.getMaxAlign());
+	}
+
+	private void alignStack(int alignment) {
+		// Go aligns relative to the start of the stack arguments, not to absolute stack offsets
+		long base = callspecInfo.getStackInitialOffset();
+		stackOffset = base + NumericUtilities.getUnsignedAlignedValue(stackOffset - base, alignment);
 	}
 
 	public Register getClosureContextRegister() {
diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/GoRegisterInfo.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/GoRegisterInfo.java
index 923944ee85..8bec883ed6 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/GoRegisterInfo.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/GoRegisterInfo.java
@@ -165,15 +165,37 @@ public class GoRegisterInfo {
 		if (isIntType(dt) && isIntrinsicSize(dt.getLength())) {
 			return Math.min(maxAlign, dt.getLength());
 		}
-		if (dt instanceof Complex8DataType /* Go complex64 */ ) {
-			return 4;
+		if (dt instanceof AbstractComplexDataType) {	// aligned as its real part
+			return Math.min(maxAlign, dt.getLength() / 2);
 		}
 		if (dt instanceof AbstractFloatDataType) {
 			return Math.min(maxAlign, dt.getLength());
 		}
+		if (dt instanceof Structure struct) {
+			// a Go struct is aligned to its most aligned field, or to its RTTI alignment
+			int align = struct.hasExplicitMinimumAlignment()
+					? struct.getExplicitMinimumAlignment()
+					: 1;
+			for (DataTypeComponent dtc : struct.getDefinedComponents()) {
+				align = Math.max(align, isAtomicAlign64(dtc.getDataType())
+						? 8
+						: getAlignmentForType(dtc.getDataType()));
+			}
+			return align;
+		}
 		return maxAlign;
 	}
 
+	private static boolean isAtomicAlign64(DataType dt) {
+		// as cmd/compile, an atomic.align64 field forces 8-byte alignment on all archs
+		return switch (dt.getName()) {
+			case "sync/atomic.align64", "internal/runtime/atomic.align64",
+					"runtime/internal/atomic.align64" ->
+				true;
+			default -> false;
+		};
+	}
+
 	static boolean isIntType(DataType dt) {
 		return dt instanceof AbstractIntegerDataType || dt instanceof WideCharDataType ||
 			dt instanceof WideChar16DataType || dt instanceof WideChar32DataType ||
diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/rtti/types/GoBaseType.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/rtti/types/GoBaseType.java
