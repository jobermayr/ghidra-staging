From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: qatcod <79017227+qatcod@users.noreply.github.com>
Date: Wed, 2 Sep 2026 20:55:19 +0500
Subject: [PATCH] 9572: #9064 Set the N and Z result flags only on the MCS-251

\#9064 Set the N and Z result flags only on the MCS-251

resultflags writes PSW bit 5 and bit 1 on every variant that includes
8051_main.sinc. Those are the MCS-251's N and Z flags, read by its JE, JG,
JLE, JNE, JSG, JSGE, JSL and JSLE branches, all of which live in 80251.sinc
and are only reachable from 80251.slaspec.

A plain 8051 has neither flag. PSW bit 5 is the user flag F0 and bit 1 is
user-definable, the CPU leaves both alone, and no 8051 instruction reads
them: JZ and JNZ test ACC directly. So on the 8051, 80390, CIP-51 and MX51
the macro was clobbering operator state and putting eight dead p-code
operations on every instruction that sets result flags.

Guard the body on MCS251. The four affected variants do not include
80251.sinc, so nothing there can read what is no longer written. ANL Direct,
Data drops from 19 p-code operations to 10, and the 80251 output is
unchanged.

\#9064 Confine the MCS-251 instructions to phase 1

The two A5-prefix constructors match any instruction in phase 0, which the
instructions themselves also match, so 80251 fails to build once -l is set in
sleighArgs.txt:

  ERROR 8051_main.sinc:892: Constructor pattern cannot be distinguished from
  constructor at 8051_main.sinc:705

Wrap the instructions in `with: phase=1` so only the prefix constructors are
reachable in phase 0. Guarded on MCS251 in 8051_main.sinc; 80251.sinc is only
included there, so its constructors are wrapped unconditionally.

The 80251 instruction set is unchanged: same 347 constructors and 70
mnemonics before and after.

\#9064 Note where the MCS-251 N and Z flags actually live

PSW1.5 and PSW1.1 on the 251 are mapped onto the 8051's F0 and UD user
bits here, which is what the PSW/PSW1 TODO at the top of the file is
about. Say so at the defines so the mapping is not a surprise.
---
 .../Processors/8051/data/languages/80251.sinc |  4 ++++
 .../8051/data/languages/8051_main.sinc        | 24 +++++++++++++++----
 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/Ghidra/Processors/8051/data/languages/80251.sinc b/Ghidra/Processors/8051/data/languages/80251.sinc
index a5acf140c8..6b9e40bb64 100644
--- a/Ghidra/Processors/8051/data/languages/80251.sinc
+++ b/Ghidra/Processors/8051/data/languages/80251.sinc
@@ -184,6 +184,8 @@ macro pop24(val) {
 # NOTE: >>>> Find MCS251 instructions by searching for "Binary Mode = [A5][Encoding]" in PDF manual  <<<<
 # NOTE: All instructions should include the $(GROUP3) pattern prefix
 
+with: phase=1 {
+
 # ADD Rmd,Rms
 :ADD rm47,rm03	is $(GROUP3) & ophi=2 & oplo=12; rm47 & rm03  { addflags(rm47,rm03); rm47 = rm47 + rm03; resultflags(rm47); }
 
@@ -662,3 +664,5 @@ macro pop24(val) {
 
 # XRL Rm,@Drk
 :XRL rm47_,AtDRkb	is $(GROUP3) & ophi=6 & oplo=14; $(ATDRK) & AtDRkb & s03=11; rm47_ & s03_=0  { rm47_ = rm47_ ^ AtDRkb; resultflags(rm47_); }
+
+}
diff --git a/Ghidra/Processors/8051/data/languages/8051_main.sinc b/Ghidra/Processors/8051/data/languages/8051_main.sinc
index 1a75612fd7..f54ed372a7 100644
--- a/Ghidra/Processors/8051/data/languages/8051_main.sinc
+++ b/Ghidra/Processors/8051/data/languages/8051_main.sinc
@@ -212,11 +212,11 @@ define register offset=$(DPS_REG_NUM) size=1 [ AUXR1 ]; # Bit 0 is DPS
 
 @define CY 		"PSW[7,1]"
 @define AC  	"PSW[6,1]"
-@define N   	"PSW[5,1]"
+@define N   	"PSW[5,1]"   # MCS-251 PSW1.5 negative flag, mapped onto the 8051 user flag PSW.F0
 @define RS1  	"PSW[4,1]"
 @define RS0  	"PSW[3,1]"
 @define OV		"PSW[2,1]"
-@define Z  		"PSW[1,1]"
+@define Z  		"PSW[1,1]"   # MCS-251 PSW1.1 zero flag, mapped onto the 8051 user-definable PSW.UD
 
 @if defined(MX51)
 # remap these into the normal register file for decompiler use.
@@ -394,9 +394,16 @@ macro compflags(op1, op2) {  # Flags set by the compare instructions
 $(CY) = (op1 < op2);        # Check for carry
 }
 
+# N and Z are MCS-251 flags, read by its JE/JG/JLE/JNE/JSG/JSGE/JSL/JSLE
+# branches. A plain 8051 has neither: PSW bit 5 is the user flag F0 and bit 1
+# is user-definable, and nothing in the 8051 instruction set reads either one
+# (JZ/JNZ test ACC directly). Writing them there only clobbers operator state
+# and adds p-code noise to every instruction that sets result flags (#9064).
 macro resultflags(op1) { # Set N,Z flag for results
- $(N) = op1 s< 0;
- $(Z) = op1 == 0;
+@if defined(MCS251)
+ $(N) = op1 s< 0;   # PSW1.5 mapped onto PSW.F0
+ $(Z) = op1 == 0;   # PSW1.1 mapped onto PSW.UD
+@endif
 }
 
 macro push8(val) {
@@ -696,6 +703,11 @@ Rel16:   relAddr is rel16		     [ relAddr=inst_next+rel16; ] { export *:1 relAdd
 # detect A5 prefix
 :^instruction	is phase=0 & ophi=0xa & oplo=0x5; instruction [ phase=1; A5Prefix=1; ] { }
 :^instruction	is phase=0 & instruction [ phase=1; A5Prefix=0; ] { }
+
+# The prefix constructors above match any instruction in phase 0, so the
+# instructions themselves have to be confined to phase 1; otherwise the two
+# cannot be told apart and the language fails to build with -l.
+with: phase=1 {
 @endif
 
 @if defined(MCS80390)
@@ -966,3 +978,7 @@ pc:3 = 0; pop24(pc); return[pc];
 :XRL Direct,Areg is $(GROUP1) & ophi=6 & oplo=2 & Areg; Direct	{ Direct = Direct ^ ACC; }
 :XRL Direct,Data is $(GROUP1) & ophi=6 & oplo=3; Direct; Data	{ Direct = Direct ^ Data; }
 
+
+@if defined(MCS251)
+}
+@endif
-- 
