-  intb sval = in;
-  sval <<= (sizeof(intb) - sizein) * 8;
+  if (sizein <= 0 || sizeout <= 0)
+    return 0;
+  sizein = (sizein < (int4)sizeof(uintb)) ? sizein : (int4)sizeof(uintb);
+  sizeout = (sizeout < (int4)sizeof(uintb)) ? sizeout : (int4)sizeof(uintb);
