From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ash Pera <ashley.pera@noaa.gov>
Date: Thu, 12 Nov 2026 02:54:59 -0700
Subject: [PATCH] 10201: Decompiler: RulePullsubIndirect takes the INDIRECT
 input at the first used byte

RulePullsubIndirect narrows an INDIRECT to the bytes minByte..maxByte that its
SUBPIECE descendants use, but built the input of the new INDIRECT from the
truncation offset of whichever SUBPIECE triggered the rule. When that is not the
lowest used byte, the narrowed value is read from the wrong bytes (for example
bytes 1-2 instead of 0-1). Use minByte, as RulePullsubMulti does.
---
 Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc
index aca37ed10c..6f194e5164 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc
@@ -1010,9 +1010,9 @@ int4 RulePullsubIndirect::applyOp(PcodeOp *op,Funcdata &data)
   }
   else {
     Varnode *basevn = indir->getIn(0);
-    Varnode *small1 = RulePullsubMulti::findSubpiece(basevn,newSize,op->getIn(1)->getOffset());
+    Varnode *small1 = RulePullsubMulti::findSubpiece(basevn,newSize,minByte);
     if (small1 == (Varnode *)0)
-      small1 = RulePullsubMulti::buildSubpiece(basevn,newSize,op->getIn(1)->getOffset(),data);
+      small1 = RulePullsubMulti::buildSubpiece(basevn,newSize,minByte,data);
     // Create new indirect near original indirect
     new_ind = data.newIndirect(targ_op);
     small2 = data.newVarnodeOut(newSize,smalladdr2,new_ind);
-- 
