From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ian Cho <124069103+cho2659@users.noreply.github.com>
Date: Fri, 6 Nov 2026 14:45:26 +0900
Subject: [PATCH] 10140: Fix GFNI multiply operands and legacy register
 semantics

---
 .../Processors/x86/data/languages/gfni.sinc   | 26 +++++++------------
 1 file changed, 10 insertions(+), 16 deletions(-)

diff --git a/Ghidra/Processors/x86/data/languages/gfni.sinc b/Ghidra/Processors/x86/data/languages/gfni.sinc
index 469187f7ef..24a4ef26f5 100644
--- a/Ghidra/Processors/x86/data/languages/gfni.sinc
+++ b/Ghidra/Processors/x86/data/languages/gfni.sinc
@@ -3,11 +3,9 @@
 #xmm2/m128, imm8 A V/V
 #GFNI Computes inverse affine transformation in the finite field GF(2^8).
 define pcodeop gf2p8affineinvqb;
-:GF2P8AFFINEINVQB XmmReg1, XmmReg2_m128, imm8 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x3A; byte=0xCF; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128; imm8
-[ evexD8Type = 0; evexTType = 0; ] # (TupleType Full)
+:GF2P8AFFINEINVQB XmmReg1, XmmReg2_m128, imm8 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x3A; byte=0xCF; XmmReg1 ... & XmmReg2_m128; imm8
 {
-	XmmReg1 = gf2p8affineinvqb(XmmReg2_m128, XmmReg1, imm8:1 );
-	ZmmReg1 = zext(XmmReg1);
+	XmmReg1 = gf2p8affineinvqb(XmmReg1, XmmReg2_m128, imm8:1 );
 }
 
 #VEX.128.66.0F3A.W1 CF /r /ib
@@ -68,11 +66,9 @@ define pcodeop vgf2p8affineinvqb_avx512f ;
 #GF2P8AFFINEQB xmm1, xmm2/m128, imm8 A V/V GFNI
 #Computes affine transformation in the finite field GF(2^8).
 define pcodeop gf2p8affineqb;
-:GF2P8AFFINEQB XmmReg1, XmmReg2_m128, imm8 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x3A; byte=0xCE; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128; imm8
-[ evexD8Type = 0; evexTType = 0; ] # (TupleType Full)
+:GF2P8AFFINEQB XmmReg1, XmmReg2_m128, imm8 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x3A; byte=0xCE; XmmReg1 ... & XmmReg2_m128; imm8
 {
-	XmmReg1 = gf2p8affineqb(XmmReg2_m128, XmmReg1, imm8:1 );
-	ZmmReg1 = zext(XmmReg1);
+	XmmReg1 = gf2p8affineqb(XmmReg1, XmmReg2_m128, imm8:1 );
 }
 
 #VEX.128.66.0F3A.W1 CE /r /ib
@@ -132,31 +128,29 @@ define pcodeop vgf2p8affineqb_avx512f ;
 #GF2P8MULB xmm1, xmm2/m128 A V/V
 #GFNI Multiplies elements in the finite field GF(2^8).
 define pcodeop gf2p8mulb;
-:GF2P8MULB XmmReg1, XmmReg2_m128, imm8 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x38; byte=0xCF; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128; imm8
-[ evexD8Type = 0; evexTType = 0; ] # (TupleType Full)
+:GF2P8MULB XmmReg1, XmmReg2_m128 is vexMode=0 & $(PRE_66) & byte=0x0F; byte=0x38; byte=0xCF; XmmReg1 ... & XmmReg2_m128
 {
-	XmmReg1 = gf2p8mulb(XmmReg2_m128, XmmReg1, imm8:1 );
-	ZmmReg1 = zext(XmmReg1);
+	XmmReg1 = gf2p8mulb(XmmReg1, XmmReg2_m128 );
 }
 
 #VEX.128.66.0F38.W0 CF /r
 #VGF2P8MULB xmm1, xmm2, xmm3/m128 B V/V AVX
 #GFNI Multiplies elements in the finite field GF(2^8).
 define pcodeop vgf2p8mulb_avx;
-:VGF2P8MULB XmmReg1, vexVVVV_XmmReg, XmmReg2_m128, imm8 is $(VEX_NONE) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W0) & vexVVVV_XmmReg; byte=0xCF; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128; imm8
+:VGF2P8MULB XmmReg1, vexVVVV_XmmReg, XmmReg2_m128 is $(VEX_NONE) & $(VEX_L128) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W0) & vexVVVV_XmmReg; byte=0xCF; (XmmReg1 & ZmmReg1) ... & XmmReg2_m128
 [ evexD8Type = 0; evexTType = 0; ] # (TupleType Full)
 {
-	XmmReg1 = vgf2p8affineqb_avx( vexVVVV_XmmReg, XmmReg2_m128, imm8:1 );
+	XmmReg1 = vgf2p8mulb_avx( vexVVVV_XmmReg, XmmReg2_m128 );
 	ZmmReg1 = zext(XmmReg1);
 }
 
 #VEX.256.66.0F38.W0 CF /r
 #VGF2P8MULB ymm1, ymm2, ymm3/m256 B V/V AVX
 #GFNI Multiplies elements in the finite field GF(2^8).
-:VGF2P8MULB YmmReg1, vexVVVV_YmmReg, YmmReg2_m256, imm8 is $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W0) & vexVVVV_YmmReg; byte=0xCF; (YmmReg1 & ZmmReg1) ... & YmmReg2_m256; imm8
+:VGF2P8MULB YmmReg1, vexVVVV_YmmReg, YmmReg2_m256 is $(VEX_NONE) & $(VEX_L256) & $(VEX_PRE_66) & $(VEX_0F38) & $(VEX_W0) & vexVVVV_YmmReg; byte=0xCF; (YmmReg1 & ZmmReg1) ... & YmmReg2_m256
 [ evexD8Type = 0; evexTType = 0; ] # (TupleType Full)
 {
-	YmmReg1 = vgf2p8mulb_avx( vexVVVV_YmmReg, YmmReg2_m256, imm8:1 );
+	YmmReg1 = vgf2p8mulb_avx( vexVVVV_YmmReg, YmmReg2_m256 );
 	ZmmReg1 = zext(YmmReg1);
 }
 
-- 
