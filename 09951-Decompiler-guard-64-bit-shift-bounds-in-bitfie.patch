+  if (size <= 0)
+    return false;
+  if (size > (int4)sizeof(uintb))
+    size = (int4)sizeof(uintb);
   uintb mask = 0x80;
   mask <<= 8*(size-1);
   return ((val&mask) != 0);
@@ -996,10 +1002,13 @@ uintb uintb_negate(uintb in,int4 size)
