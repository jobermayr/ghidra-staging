From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Priyanshu Kumar <priyanshukumarpu@gmail.com>
Date: Thu, 15 Oct 2026 01:51:01 +0530
Subject: [PATCH] 9900: AARCH64: casp compares and stores Xs and Xt at the
 address in either byte order

---
 .../Processors/AARCH64/data/languages/AARCH64base.sinc   | 9 +--------
 1 file changed, 1 insertion(+), 8 deletions(-)

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index c50c444b06..10015351dd 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -1079,19 +1079,12 @@ is b_3031=0b00 & b_2329=0b0010000 & b_21=1 & b_1014=0b11111 & b_16=0 & b_00=0 &
 :casp^cas_var aa_Xs, aa_Xss, aa_Xt, aa_Xtt, [Rn_GPR64xsp]
 is b_3031=0b01 & b_2329=0b0010000 & b_21=1 & b_1014=0b11111 & b_16=0 & b_00=0 & cas_var & aa_Xs & aa_Xss & aa_Xt & aa_Xtt & Rn_GPR64xsp & cas_loa & cas_lor
 {
+	# Xs and Xt are at [Xn] in either byte order: comparevalue is s2:s1 little, s1:s2 big.
 	local tmp_s:8 = aa_Xs;
 	local tmp_ss:8 = aa_Xss;
 	local tmp_t:8 = aa_Xt;
 	local tmp_tt:8 = aa_Xtt;
 
-@if DATA_ENDIAN == "little"
-	# for little endian, swap Xss/Xs and Xtt/Xt
-	tmp_s = aa_Xss;
-	tmp_ss = aa_Xs;
-	tmp_t = aa_Xtt;
-	tmp_tt = aa_Xt;
-@endif
-
 	build cas_loa;
 	local tmp_addr:8 = Rn_GPR64xsp;
 	local tmp_d:8 = *:8 tmp_addr;
-- 
2.45.1

