 # C6.2.307 STLLRB page C6-1842 line 108609 MATCH x08800000/mask=xffe08000
 # CONSTRUCT x08800000/mask=xffe08000 MATCHED 1 DOCUMENTED OPCODES
@@ -6924,7 +6924,7 @@ is b_2431=0xd4 & excCode=0 & imm16 & excCode2=0 & ll=1
 
 :swp^ls_lor^"b" Rs_GPR32, aa_Wt, [Rn_GPR64xsp]
 is b_3031=0b00 & b_2429=0b111000 & b_21=1 & b_1215=0b1000 & b_1011=0b00 & ls_loa & ls_lor & aa_Wt & ls_data1 & ls_mem1 & Rn_GPR64xsp & Rs_GPR32 & aa_Xt
-{ build ls_loa; build ls_data1; ls_opc_swp(tmp_ldWn, Rs_GPR32, tmp_stWn); build ls_mem1; aa_Xt = zext(tmp_ldWn); build ls_lor; }
+{ build ls_lor; build ls_data1; ls_opc_swp(tmp_ldWn, Rs_GPR32, tmp_stWn); build ls_mem1; aa_Xt = zext(tmp_ldWn); build ls_loa; }
 
