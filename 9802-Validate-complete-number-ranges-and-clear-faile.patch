Subject: [PATCH] 9802: Validate complete number ranges and clear failed parse
 state

Validate malformed numeric ranges and corrected input

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../docking/widgets/dialogs/NumberRangeInputDialog.java  | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Framework/Docking/src/main/java/docking/widgets/dialogs/NumberRangeInputDialog.java b/Ghidra/Framework/Docking/src/main/java/docking/widgets/dialogs/NumberRangeInputDialog.java
index e9df96fbe1..8dea29148d 100644
--- a/Ghidra/Framework/Docking/src/main/java/docking/widgets/dialogs/NumberRangeInputDialog.java
+++ b/Ghidra/Framework/Docking/src/main/java/docking/widgets/dialogs/NumberRangeInputDialog.java
@@ -137,6 +137,7 @@ public class NumberRangeInputDialog extends DialogComponentProvider {
 		//         -8, 0xc, 0x10:0x20
 		//         -0x20:-0x10
 
+		rangeList.clear();
 		String value = textField.getText();
 		String[] parts = value.split(",");
 		for (String rangeText : parts) {
@@ -163,13 +164,17 @@ public class NumberRangeInputDialog extends DialogComponentProvider {
 		}
 
 		// this must be a range
-		String[] startAndEnd = trimmed.split(RANGE_DELIMITER);
+		String[] startAndEnd = trimmed.split(RANGE_DELIMITER, -1);
+		if (startAndEnd.length != 2) {
+			setStatusText("Unable to parse as a number: '" + trimmed + "'");
+			return false;
+		}
 		try {
 			int startInt = NumericUtilities.parseInt(startAndEnd[0]);
 			int endInt = NumericUtilities.parseInt(startAndEnd[1]);
 			rangeList.addRange(startInt, endInt);
 		}
-		catch (NumberFormatException e) {
+		catch (IllegalArgumentException e) {
 			setStatusText("Unable to parse as a number: '" + trimmed + "'");
 			return false;
 		}
