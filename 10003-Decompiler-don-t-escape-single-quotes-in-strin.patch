From: FlashHit <56718716+FlashHit@users.noreply.github.com>
Date: Tue, 20 Oct 2026 23:47:50 +0200
Subject: [PATCH] 10003: Decompiler: don't escape single quotes in string
 literals

AI-generated by Claude Code.
---
 .../Features/Decompiler/src/decompile/cpp/printlanguage.cc | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/printlanguage.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/printlanguage.cc
index 1d1dcacaca..d9f8793015 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/printlanguage.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/printlanguage.cc
@@ -586,6 +586,8 @@ bool PrintLanguage::unicodeNeedsEscape(int4 codepoint)
 /// \brief Emit a byte buffer to the stream as unicode characters.
 ///
 /// Characters are emitted until we reach a terminator character or \b count bytes is consumed.
+/// The characters are assumed to be emitted inside a double-quoted string literal, so a single
+/// quote character is emitted without an escape.
 /// \param s is the output stream
 /// \param buf is the byte buffer
 /// \param count is the maximum number of bytes to consume
@@ -601,7 +603,10 @@ bool PrintLanguage::escapeCharacterData(ostream &s,const uint1 *buf,int4 count,i
   while(i<count) {
     codepoint = StringManager::getCodepoint(buf+i,count-i,charsize,bigend,skip);
     if (codepoint == 0 || codepoint == -1) break;
-    printUnicode(s,codepoint);
+    if (codepoint == '\'')
+      s << '\'';		// No escape needed inside a double-quoted string
+    else
+      printUnicode(s,codepoint);
     i += skip;
   }
   return (codepoint == 0);
