+  if (cached >= 0) return cached != 0;
+  const char *env = std::getenv("DECOMP_INTRA_GRAPH_STATS");
+  cached = (env != nullptr && std::atoi(env) != 0) ? 1 : 0;
+  return cached != 0;
+}
