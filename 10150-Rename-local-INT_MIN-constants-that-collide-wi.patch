From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leon Zandman <leon@wirwar.com>
Date: Sat, 7 Nov 2026 02:53:43 +0100
Subject: [PATCH] 10150: Rename local INT_MIN constants that collide with the
 <limits.h> macro

GP-7474 added a local constexpr named INT_MIN to the INT_SDIV and
INT_SREM behaviors in opbehavior.cc. INT_MIN is a standard macro, and
Apple's libc++ includes <climits> through <sstream>, so the declaration
expands to an invalid one and the decompiler does not compile with
Apple clang. Rename the constant to INTB_MIN.
---
 .../Features/Decompiler/src/decompile/cpp/opbehavior.cc   | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/opbehavior.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/opbehavior.cc
index b1d0ff5842..34431dcb2e 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/opbehavior.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/opbehavior.cc
@@ -520,9 +520,9 @@ uintb OpBehaviorIntSdiv::evaluateBinary(int4 sizeout,int4 sizein,uintb in1,uintb
   intb denom = sign_extend(in2,8*sizein-1);
   if (denom == 0)
     throw EvaluationError("Divide by 0");
-  constexpr intb INT_MIN = (intb)1 << (sizeof(intb) * 8 - 1);
+  constexpr intb INTB_MIN = (intb)1 << (sizeof(intb) * 8 - 1);
   intb sres;
-  if (num == INT_MIN && denom == -1)	// INT_MIN divided by -1 produces a signed overflow
+  if (num == INTB_MIN && denom == -1)	// INTB_MIN divided by -1 produces a signed overflow
     sres = num;			// Set an explicit result to avoid a possible hardware exception
   else
     sres = num/denom;		// Do the signed division
@@ -547,9 +547,9 @@ uintb OpBehaviorIntSrem::evaluateBinary(int4 sizeout,int4 sizein,uintb in1,uintb
   intb mod = sign_extend(in2,8*sizein-1);
   if (mod == 0)
     throw EvaluationError("Remainder by 0");
-  constexpr intb INT_MIN = (intb)1 << (sizeof(intb) * 8 - 1);
+  constexpr intb INTB_MIN = (intb)1 << (sizeof(intb) * 8 - 1);
   intb sres;
-  if (val == INT_MIN && mod == -1)
+  if (val == INTB_MIN && mod == -1)
     sres = 0;		// Set an explicit result to avoid a possible hardware exception
   else
     sres = val % mod;	// Do the remainder
