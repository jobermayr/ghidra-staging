From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: blaze0089 <267733108+blaze0089@users.noreply.github.com>
Date: Sun, 8 Nov 2026 11:21:55 +0530
Subject: [PATCH] 10167: Handle null Swift context descriptor kinds

ContextDescriptorKind.valueOf() returns null for unknown values, and parseTypeDescriptors() called kind.ordinal() through the switch before reaching the default branch, so an unexpected kind in a malformed or newer Swift binary threw a NullPointerException and aborted parsing.

Log the unknown kind and skip the descriptor.

Fixes #10158
---
 .../ghidra/app/util/bin/format/swift/SwiftTypeMetadata.java   | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Ghidra/Features/Swift/src/main/java/ghidra/app/util/bin/format/swift/SwiftTypeMetadata.java b/Ghidra/Features/Swift/src/main/java/ghidra/app/util/bin/format/swift/SwiftTypeMetadata.java
index 3aade3a562..22dcd8592e 100644
--- a/Ghidra/Features/Swift/src/main/java/ghidra/app/util/bin/format/swift/SwiftTypeMetadata.java
+++ b/Ghidra/Features/Swift/src/main/java/ghidra/app/util/bin/format/swift/SwiftTypeMetadata.java
@@ -453,6 +453,10 @@ public class SwiftTypeMetadata {
 				TargetTypeContextDescriptor descriptor = new TargetTypeContextDescriptor(reader);
 				reader.setPointerIndex(origIndex);
 				ContextDescriptorKind kind = descriptor.getFlags().getKind();
+				if (kind == null) {
+					log("Unrecognized type descriptor kind at index: 0x%x".formatted(origIndex));
+					continue;
+				}
 				descriptor = switch (kind) {
 					case Class:
 						yield new TargetClassDescriptor(reader);
-- 
2.45.1

