 .../src/main/java/ghidra/framework/Architecture.java      | 1 +
 .../Generic/src/main/java/ghidra/framework/Platform.java  | 6 ++++++
 GhidraDocs/GettingStarted.md                              | 2 ++
 7 files changed, 30 insertions(+)

