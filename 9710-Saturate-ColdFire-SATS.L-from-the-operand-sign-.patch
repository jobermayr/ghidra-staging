From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Sat, 3 Oct 2026 20:06:10 +0300
Subject: [PATCH] 9710: Saturate ColdFire SATS.L from the operand sign bit

Saturate ColdFire SATS.L from the operand sign bit.

Co-authored-by: Cursor <cursoragent@cursor.com>

Encode ColdFire SATS.L saturation as a sign select.

A negative register still becomes 0x7fffffff and any other value becomes 0x80000000.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 Ghidra/Processors/68000/data/languages/68000.sinc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Processors/68000/data/languages/68000.sinc b/Ghidra/Processors/68000/data/languages/68000.sinc
index 0114ee8fd3..769da1a271 100644
--- a/Ghidra/Processors/68000/data/languages/68000.sinc
+++ b/Ghidra/Processors/68000/data/languages/68000.sinc
@@ -1782,7 +1782,7 @@ macro move16(src, dst)
 
 :mov3q "#"^d911, eal	is (op=0xa & op68=5 & d911 )  ... & eal		{ eal = d911; }
 
-:sats.l regdn			is opbig=0x4c & op37=0x10 & regdn	{ if (VF == 0) goto inst_next; regdn = (zext(regdn == 0 ) * 0x80000000) + (zext(regdn != 0) * 0x7fffffff); VF=0; CF=0; }
+:sats.l regdn			is opbig=0x4c & op37=0x10 & regdn	{ if (VF == 0) goto inst_next; regdn = (zext(regdn s< 0) * 0x7fffffff) + (zext(regdn s>= 0) * 0x80000000); VF=0; CF=0; }
 
 skip_addr: skipAddr		is op02=2 [skipAddr = inst_next + 2;] { export *[ram]:4 skipAddr; }
 skip_addr: skipAddr		is op02=3 [skipAddr = inst_next + 4;] { export *[ram]:4 skipAddr; }
