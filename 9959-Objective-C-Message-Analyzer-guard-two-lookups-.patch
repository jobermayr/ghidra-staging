From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Giovanni Condello <giovanni.condello@coderit.it>
Date: Mon, 19 Oct 2026 14:53:38 +0200
Subject: [PATCH] 9959: Objective-C Message Analyzer: guard two lookups that
 abort the analysis

Either exception escapes the DecompilerCallback, which disposes the whole
decompiler queue and silently skips every function not yet processed.

- Skip message sends whose decompiled CALL has fewer inputs than the
  receiver/selector indices (ArrayIndexOutOfBoundsException in findMessages)
- Guard the classMap lookup in setReference for class namespaces without
  Objective-C metadata (NullPointerException)
---
 .../ghidra/app/plugin/core/analysis/ObjcMessageAnalyzer.java   | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/plugin/core/analysis/ObjcMessageAnalyzer.java b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/plugin/core/analysis/ObjcMessageAnalyzer.java
index 70642e6e4a..a74337e411 100644
--- a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/plugin/core/analysis/ObjcMessageAnalyzer.java
+++ b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/plugin/core/analysis/ObjcMessageAnalyzer.java
@@ -969,8 +969,9 @@ public class ObjcMessageAnalyzer extends AbstractAnalyzer {
 		List<Symbol> functionSymbols = symbolTable.getSymbols(currentMethodName, namespace);
 		if (functionSymbols.isEmpty()) {
 			// Walk up the superclass chain to see if the method is inherited
+			// null for class namespaces without Objective-C metadata (e.g. external classes)
 			List<Objc2Class> classList = classMap.get(namespace.getName());
-			if (classList.size() == 1) {
+			if (classList != null && classList.size() == 1) {
 				Objc2Class superClass = classList.getFirst().getSuperClass();
 				if (superClass != null) {
 					Objc2ClassRW data = superClass.getData();
-- 
