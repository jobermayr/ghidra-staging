Subject: [PATCH] 9966: Decompiler: name the Max-Payload option when the
 payload limit is exceeded

AI-generated by Claude Code.
---
 .../ghidra/program/model/pcode/LinkedByteBuffer.java   | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/pcode/LinkedByteBuffer.java b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/pcode/LinkedByteBuffer.java
index cbb26793d0..e8080f3234 100644
--- a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/pcode/LinkedByteBuffer.java
+++ b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/model/pcode/LinkedByteBuffer.java
@@ -245,7 +245,7 @@ public class LinkedByteBuffer {
 				return;		// Reached terminator or end of stream, ingest is finished
 			}
 			if (byteCount == maxCount) {
-				throw new IOException("Response buffer size exceeded for: " + description);
+				throw sizeExceeded();
 			}
 			// Set up next buffer
 			currentBuffer.next = new ArrayIter();
@@ -328,7 +328,7 @@ public class LinkedByteBuffer {
 			currentBuffer.array[currentPos++] = tok;
 			byteCount += 1;
 			if (byteCount > maxCount) {
-				throw new IOException("Response buffer size exceeded for: " + description);
+				throw sizeExceeded();
 			}
 		}
 	}
@@ -349,6 +349,12 @@ public class LinkedByteBuffer {
 		currentBuffer.length = currentPos;	// Any bytes after are not in the buffer
 	}
 
+	private IOException sizeExceeded() {
+		return new IOException("Decompiler results exceeded payload limit of " + (maxCount >> 20) +
+			" MBytes for: " + description +
+			". The limit can be raised with the Decompiler Max-Payload (MBytes) tool option.");
+	}
+
 	public Position allocatePosition() {
 		return new Position();
 	}
