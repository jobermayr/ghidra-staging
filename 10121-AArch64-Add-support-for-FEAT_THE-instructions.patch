+is b_2431=0x59 & b_21=1 & Rs_GPR64 & b_1015=0x2c & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 0; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:16 Rn_GPR64xsp;
+@if DATA_ENDIAN == "big"
