From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: designonet <271930877+designonet@users.noreply.github.com>
Date: Thu, 15 Oct 2026 11:34:41 +0800
Subject: [PATCH] 09910: Avoid copying address ranges when no memory blocks are
 excluded

---
 .../app/plugin/core/disassembler/AddressTableAnalyzer.java    | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/disassembler/AddressTableAnalyzer.java b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/disassembler/AddressTableAnalyzer.java
index c17e057c1f..1b3ab815d1 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/disassembler/AddressTableAnalyzer.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/disassembler/AddressTableAnalyzer.java
@@ -365,7 +365,9 @@ public class AddressTableAnalyzer extends AbstractAnalyzer {
 			badBlocks.addRange(memoryBlock.getStart(), memoryBlock.getEnd());
 		}
 
-		addrSet = addrSet.subtract(badBlocks);
+		if (!badBlocks.isEmpty()) {
+			addrSet = addrSet.subtract(badBlocks);
+		}
 
 		return addrSet;
 	}
-- 
