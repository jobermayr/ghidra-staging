+
 	@Test
 	public void testAcceptsMz() throws IOException {
 		assertTrue(accepts(new MzLoader(), mz(new byte[0x10])));
@@ -243,4 +256,27 @@ public class MzLoaderTest extends AbstractGhidraHeadlessIntegrationTest {
 		assertEquals("1003:0000", blockStart("1003:0005"));
 		assertEquals(0x1003, cs("1003:0005"));
 	}
+
+	/** A near branch whose IP wraps stays in its code segment, which is not 64K aligned. */
+	@Test
+	public void testNearBranchWrapsInCodeSegment() throws Exception {
+		byte[] image = nops(0x40);
+		put(image, 0x00, "9a 00 00 03 00"); // CALLF 0003:0000
+		put(image, 0x05, "cb"); // RETF
+		put(image, 0x30, "e8 f0 ff"); // 1003:0000: CALL 1003:fff3
+		load(mz(image, 0x03));
+		assertEquals(0x20023L, flow("1003:0000").getOffset());
+	}
+
+	/** A block can run past seg:FFFF; code there is not in the segment, so the page applies. */
+	@Test
+	public void testNearBranchPastSegmentEndStaysInPage() throws Exception {
+		byte[] image = nops(0x10040);
+		put(image, 0x00, "9a 00 00 03 00"); // CALLF 0003:0000
+		put(image, 0x05, "cb"); // RETF
+		put(image, 0x10033, "e8 10 00"); // 2000:0033, in block 1003: CALL 2000:0046
+		load(mz(image, 0x03));
+		assertEquals("1003:0000", blockStart("2000:0033"));
+		assertEquals(0x20046L, flow("2000:0033").getOffset());
+	}
 }
diff --git a/Ghidra/Processors/x86/data/languages/ia.sinc b/Ghidra/Processors/x86/data/languages/ia.sinc
index c62638ce04..7b16f2395b 100644
--- a/Ghidra/Processors/x86/data/languages/ia.sinc
+++ b/Ghidra/Processors/x86/data/languages/ia.sinc
@@ -376,7 +376,7 @@ define register offset=0x3000 size=1024  [
 ];
 
 # Define context bits
-define register offset=0x2000 size=8   contextreg;
+define register offset=0x2000 size=16   contextreg;
 
 # AVX-512 opmask registers
 define register offset=2100 size=8  [
@@ -484,8 +484,10 @@ define context contextreg
   ctxAX = (48,63)
     ctxAH = (48,55)     # Vice-versa since Sleigh is BE
     ctxAL = (56,63)
-;
 
+  cseg=(64,79) noflow   # stored: real-mode CS of the instruction, set by loaders; 0 if not known
+  # free: 80,127
+;
 
 # These are only to be used with pre-REX (original 8086, 80386) and REX encoding.  Do not use with VEX encoding.
 # These are to be used to designate that the opcode sequence begins with one of these "mandatory" prefix values.
@@ -1179,6 +1181,9 @@ rel8: reloc is simm8        [ reloc=inst_next+simm8; ] { export *[ram]:$(SIZE) r
 # crossing a page boundary into the wrong segment. Plain addition is exact for
 # every in-segment branch (offset result in [0,0xFFFF]), matching rel8 above.
 rel16: reloc is addrsize=0 & simm16 [ reloc=inst_next+simm16; ] { export *[ram]:$(SIZE) reloc; }
+# Real mode: IP wraps in the code segment, cseg. The base is the last byte's address less its
+# offset in the segment (inst_next may be past seg:FFFF); with cseg=0 this is the 64K page.
+rel16: reloc is protectedMode=0 & simm16 [ reloc=(inst_next - 1 - ((inst_next - 1 - (cseg << 4)) & 0xFFFF)) + ((inst_next - (cseg << 4) + simm16) & 0xFFFF); ] { export *[ram]:$(SIZE) reloc; }
 rel16: reloc is simm16      [ reloc=((inst_next >> 16) << 16) | ((inst_next + simm16) & 0xFFFF); ] { export *[ram]:$(SIZE) reloc; }
 rel32: reloc is simm32      [ reloc=inst_next+simm32; ] { export *[ram]:$(SIZE) reloc; }
 
