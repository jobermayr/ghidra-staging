From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hxreborn <hxreborn@duck.com>
Date: Tue, 10 Nov 2026 23:53:40 +0100
Subject: [PATCH] 10183: NE: continue relocation chains through a link of 0

NE: continue relocation chains through a link of 0

Signed-off-by: hxreborn <hxreborn@duck.com>

NE: read the chain link of byte relocations as a 16-bit word

Signed-off-by: hxreborn <hxreborn@duck.com>
---
 .../main/java/ghidra/app/util/opinion/NeLoader.java | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java
index de5fed3e4e..d0984a4191 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java
@@ -744,7 +744,8 @@ public class NeLoader extends AbstractOrdinalSupportLoader {
 				int relocType = reloc.getType();
 				int byteLength = SegmentRelocation.TYPE_LENGTHS[relocType];
 
-				do {
+				Set<Integer> processedOffsets = new HashSet<>();
+				while (processedOffsets.add(offset)) {
 					// TODO: it appears that offset may be a far-offset and not always a segment-offset
 					SegmentedAddress address = space.getAddress(segment, offset);
 					try {
@@ -759,14 +760,13 @@ public class NeLoader extends AbstractOrdinalSupportLoader {
 					if (reloc.isAdditive()) {
 						break;
 					}
-					if (offset <= 0 || offset >= 0xffff) {
+					if (offset < 0 || offset >= 0xffff) {
 						break;
 					}
 					if (monitor.isCancelled()) {
 						break;
 					}
 				}
-				while (true);
 			}
 		}
 	}
@@ -774,10 +774,13 @@ public class NeLoader extends AbstractOrdinalSupportLoader {
 	private int relocate(Memory memory, SegmentRelocation reloc, SegmentedAddress address,
 			SegmentedAddress relocAddr) throws MemoryAccessException {
 
-		int value = 0;
+		int value = -1;
 		switch (reloc.getType()) {
 			case SegmentRelocation.TYPE_LO_BYTE: {
-				value = memory.getByte(address) & 0xff;
+				byte[] link = new byte[2];
+				if (memory.getBytes(address, link) == link.length) {
+					value = Byte.toUnsignedInt(link[0]) | Byte.toUnsignedInt(link[1]) << 8;
+				}
 
 				memory.setByte(address, (byte) relocAddr.getSegmentOffset());
 				break;
-- 
