@@ -10,13 +10,19 @@ define space register type=register_space size=4;
 define register offset=0 size=4
 [r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15];
 
-define register offset=0x100 size=4 [sr gbr vbr mach macl pr pc];
+define register offset=0x100 size=4 [sr gbr vbr mach macl pr pc delay_pc];
 
 
 @if SH_VERSION == "2A"
 define register offset=0x180 size=4 [tbr];
 @endif
 
+define register offset=0x400 size=4 contextreg;
+define context contextreg
+	pc_relative_delay_slot = (0,1) noflow
+	pc_relative_delay_disp = (2,13) signed noflow
+;
