Subject: [PATCH] 9779: Roll back newly created PyGhidra plugin installs after
 copy failures

Roll back newly created PyGhidra plugin installations on copy
 failure

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../src/main/py/src/pyghidra/launcher.py      | 23 ++++++++++---------
 1 file changed, 12 insertions(+), 11 deletions(-)

diff --git a/Ghidra/Features/PyGhidra/src/main/py/src/pyghidra/launcher.py b/Ghidra/Features/PyGhidra/src/main/py/src/pyghidra/launcher.py
index 79032156f2..d4679a67d5 100644
--- a/Ghidra/Features/PyGhidra/src/main/py/src/pyghidra/launcher.py
+++ b/Ghidra/Features/PyGhidra/src/main/py/src/pyghidra/launcher.py
@@ -599,23 +599,24 @@ class PyGhidraLauncher:
         jar_path = path / "lib" / (plugin_name + ".jar")
 
         if not jar_path.exists():
+            created_path = not path.exists()
             path.mkdir(parents=True, exist_ok=True)
 
             try:
                 java_compile(root, jar_path)
-            except:
-                shutil.rmtree(path, ignore_errors=True)
-                raise
-
-            ext.write_text(str(details))
+                ext.write_text(str(details))
 
-            # required empty file
-            manifest.touch()
+                # required empty file
+                manifest.touch()
 
-            # Copy over ghidra_scripts if included.
-            ghidra_scripts = root / "ghidra_scripts"
-            if ghidra_scripts.exists():
-                shutil.copytree(ghidra_scripts, path / "ghidra_scripts")
+                # Copy over ghidra_scripts if included.
+                ghidra_scripts = root / "ghidra_scripts"
+                if ghidra_scripts.exists():
+                    shutil.copytree(ghidra_scripts, path / "ghidra_scripts")
+            except:
+                if created_path:
+                    shutil.rmtree(path, ignore_errors=True)
+                raise
 
             logger.info(f"Installed plugin: {plugin_name} {details.plugin_version}")
             return True
