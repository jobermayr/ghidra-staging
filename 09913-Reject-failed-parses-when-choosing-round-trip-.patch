Subject: [PATCH] 09913: Reject failed parses when choosing round-trip
 floating-point precision

---
 Ghidra/Features/Decompiler/src/decompile/cpp/float.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/float.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/float.cc
index 25661ff810..c774b91a20 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/float.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/float.cc
@@ -472,7 +472,7 @@ string FloatFormat::printDecimal(double host,bool forcesci) const
     else {
       t >> roundtrip;
     }
-    if (roundtrip == host)
+    if (!t.fail() && roundtrip == host)
       break;
   }
   return res;
