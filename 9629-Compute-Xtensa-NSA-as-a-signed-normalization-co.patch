From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Mon, 14 Sep 2026 14:50:39 +0300
Subject: [PATCH] 9629: Compute Xtensa NSA as a signed normalization count

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 .../Processors/Xtensa/data/languages/xtensaInstructions.sinc  | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc b/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
index 23b0381515..2d1bbab1d9 100644
--- a/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
+++ b/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
@@ -898,7 +898,9 @@ macro extract_bit(bit, result) {
 
 # NSA - Normalization Shift Amount (RRR), pg. 461.
 :nsa at, as is op2 = 0b0100 & op1 = 0 & ar = 0b1110 & as & at & op0 = 0 {
-    at = lzcount(~as);
+    # Count leading bits that match the sign bit, minus one. 0 and -1 yield 31.
+    local tmp:4 = (as ^ (as << 1)) | 0x1;
+    at = lzcount(tmp);
 }
 
 # NSAU - Normalization Shift Amount Unsigned (RRR), pg. 462. (Count leading zeros)
