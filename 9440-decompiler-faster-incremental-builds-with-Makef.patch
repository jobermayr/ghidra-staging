+test_dbg/%.o: ../unittests/%.cc | test_dbg
+	$(CXX) -I. $(ARCH_TYPE) $(DBG_CXXFLAGS) $(INCLUDES) $(ADDITIONAL_FLAGS) $(TEST_DEBUG) \
+		-MMD -MP -MF $(@:.o=.d) -c $< -o $@
+
+ghi_dbg/%.o: %.cc | ghi_dbg
