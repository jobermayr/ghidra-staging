From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FlashHit <56718716+FlashHit@users.noreply.github.com>
Date: Mon, 19 Oct 2026 11:26:52 +0200
Subject: [PATCH] 9956: Decompiler: don't declare symbols of a switchD_
 namespace as locals

AI-generated by Claude Code.
---
 Ghidra/Features/Decompiler/src/decompile/cpp/printc.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/printc.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/printc.cc
index bf911f1978..3cc33e9aa1 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/printc.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/printc.cc
@@ -2512,7 +2512,8 @@ void PrintC::emitLocalVarDecls(const Funcdata *fd)
   enditer = fd->getScopeLocal()->childrenEnd();
   while(iter!=enditer) {
     Scope *l1 = (*iter).second;
-    if (emitScopeVarDecls(l1,Symbol::no_category))
+    // Skip namespaces placed under the function (like switchD_...), their symbols are global
+    if (!l1->isGlobal() && emitScopeVarDecls(l1,Symbol::no_category))
       notempty = true;
     ++iter;
   }
