+			LongPropertyMap targetMap = pmm.getLongPropertyMap(ifretMapName);
+			if (!ifretTargetMap.isEmpty()) {
+				if (targetMap == null) {
+					try {
+						targetMap = pmm.createLongPropertyMap(ifretMapName);
+					}
