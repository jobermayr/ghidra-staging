From: Rudy Celekli <rudy@gradiahq.com>
Date: Tue, 13 Oct 2026 10:59:32 -0400
Subject: [PATCH] 09806: Read unwritten EXT4 extents as zero-filled file data

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../java/ghidra/file/formats/ext4/Ext4Extent.java    | 12 +++++++++++-
 .../ghidra/file/formats/ext4/Ext4ExtentsHelper.java  |  7 ++++++-
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ext4/Ext4Extent.java b/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ext4/Ext4Extent.java
index 93b247122a..10f7eff788 100644
--- a/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ext4/Ext4Extent.java
+++ b/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ext4/Ext4Extent.java
@@ -61,7 +61,17 @@ public class Ext4Extent implements StructConverter {
 	 * @return number of blocks in this extent
 	 */
 	public int getExtentBlockCount() {
-		return Short.toUnsignedInt(ee_len);
+		int length = Short.toUnsignedInt(ee_len);
+		return length <= 0x8000 ? length : length - 0x8000;
+	}
+
+	/**
+	 * Returns whether the extent is allocated but has not been initialized.
+	 * Reads from these blocks return zeros, regardless of the backing bytes.
+	 * @return true for an unwritten extent
+	 */
+	public boolean isUnwritten() {
+		return Short.toUnsignedInt(ee_len) > 0x8000;
 	}
 
 	/**
diff --git a/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ext4/Ext4ExtentsHelper.java b/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ext4/Ext4ExtentsHelper.java
index 3c5972b3fc..d9638e0047 100644
--- a/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ext4/Ext4ExtentsHelper.java
+++ b/Ghidra/Features/FileFormats/src/main/java/ghidra/file/formats/ext4/Ext4ExtentsHelper.java
@@ -74,7 +74,12 @@ public class Ext4ExtentsHelper {
 					extentLen = expectedLength - ebp.length();
 				}
 
-				ebp.addRange(providerOfs, extentLen);
+				if (extent.isUnwritten()) {
+					ebp.addSparseRange(extentLen);
+				}
+				else {
+					ebp.addRange(providerOfs, extentLen);
+				}
 			}
 		}
 		else {
