From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FlashHit <56718716+FlashHit@users.noreply.github.com>
Date: Sun, 25 Oct 2026 03:44:17 +0100
Subject: [PATCH] 10100: Decompiler: rename PcodeCacher::PAGE_SIZE, which
 clashes with the musl limits.h macro

AI-generated by Claude Code.
---
 .../Decompiler/src/decompile/cpp/include/ghidra/sleigh.hh | 2 +-
 Ghidra/Features/Decompiler/src/decompile/cpp/sleigh.cc    | 8 ++++----
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/sleigh.hh b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/sleigh.hh
index 593bdaaf89..04e0f08e30 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/sleigh.hh
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/sleigh.hh
@@ -56,7 +56,7 @@ struct PcodeData {
 /// The class acts as a pool of memory for PcodeData and VarnodeData objects
 /// that can be reused repeatedly to emit multiple instructions.
 class PcodeCacher {
-  static constexpr uint4 PAGE_SIZE = 512;///< Initial size of VarnodeData pool
+  static constexpr uint4 POOL_PAGE_SIZE = 512;///< Initial size of VarnodeData pool
   static constexpr uint4 MAX_ALLOCATION = 4096;	///< Maximum VarnodeData in a single instruction
   VarnodeData *curpool;			///< First unused VarnodeData
   VarnodeData *endpool;			///< End of the pool of VarnodeData objects
diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/sleigh.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/sleigh.cc
index a6152875d3..ffda9ad873 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/sleigh.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/sleigh.cc
@@ -22,7 +22,7 @@ PcodeCacher::PcodeCacher(void)
 
 {
   // We aim to allocate this array only once
-  expandPool(PAGE_SIZE);
+  expandPool(POOL_PAGE_SIZE);
 }
 
 PcodeCacher::~PcodeCacher(void)
@@ -37,12 +37,12 @@ PcodeCacher::~PcodeCacher(void)
 void PcodeCacher::expandPool(uint4 size)
 
 {
-  if (size > PAGE_SIZE) {
+  if (size > POOL_PAGE_SIZE) {
     if (size > MAX_ALLOCATION)
       throw LowlevelError("Maximum parameters exceeded for a single p-code op");
   }
   else
-    size = PAGE_SIZE;
+    size = POOL_PAGE_SIZE;
   VarnodeData *poolstart = new VarnodeData[ size ];
   pools.push_back(poolstart);
   endpool = poolstart + size;
@@ -84,7 +84,7 @@ void PcodeCacher::clear(void)
     iter = pools.erase(iter);
   }
   curpool = pools.front();
-  endpool = curpool + PAGE_SIZE;
+  endpool = curpool + POOL_PAGE_SIZE;
   issued.clear();
   label_refs.clear();
   labels.clear();
-- 
