From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Laxmi Narayan Behera <lnb@lnbfederal.com>
Date: Wed, 4 Nov 2026 14:16:23 -0500
Subject: [PATCH] 10132: ARM: don't decode Thumb BLX (immediate) with H=1

---
 .../ARM/data/languages/ARMTHUMBinstructions.sinc           | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
index 773e8a26c2..6b146575ee 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMTHUMBinstructions.sinc
@@ -30,6 +30,7 @@ define token instr2 (16)
   part2c0505=(5,5)
   part2c0404=(4,4)
   part2Rd0003=(0,3)
+  part2c0000=(0,0)
 ;
 
 define token instrThumb (16)
@@ -1555,7 +1556,7 @@ bxns: "ns" is thc0002=0b100 { }
 
 @if defined(VERSION_5)
 
-:blx^ItCond 	ThArmAddr23 			is TMode=1 & ItCond & (op11=0x1e;part2op=0x1d) & ThArmAddr23 [ TMode=0; globalset(ThArmAddr23,TMode); TMode=1; ]
+:blx^ItCond 	ThArmAddr23 			is TMode=1 & ItCond & (op11=0x1e;part2op=0x1d & part2c0000=0) & ThArmAddr23 [ TMode=0; globalset(ThArmAddr23,TMode); TMode=1; ]
 {
   build ItCond;
   lr = inst_next|1;
@@ -1564,7 +1565,7 @@ bxns: "ns" is thc0002=0b100 { }
   # Don't set this, assume return will set for emulation.  Was screwing up decompiler. TB = 1;
 }
 
-:blx^ItCond 	ThArmAddr23 			is TMode=1 & ItCond & CALLoverride=1 & (op11=0x1e;part2op=0x1d) & ThArmAddr23 [ TMode=0; globalset(ThArmAddr23,TMode); TMode=1; ]
+:blx^ItCond 	ThArmAddr23 			is TMode=1 & ItCond & CALLoverride=1 & (op11=0x1e;part2op=0x1d & part2c0000=0) & ThArmAddr23 [ TMode=0; globalset(ThArmAddr23,TMode); TMode=1; ]
 {
   build ItCond;
   lr = inst_next|1;
@@ -1572,7 +1573,7 @@ bxns: "ns" is thc0002=0b100 { }
   goto ThArmAddr23;
 }
 
-:blx^ItCond 	ThArmAddr23 			is TMode=1 & ItCond & (op11=0x1e; part2c1415=3 & part2c1212=0) & ThArmAddr23 [ TMode=0; globalset(ThArmAddr23,TMode); TMode=1; ]
+:blx^ItCond 	ThArmAddr23 			is TMode=1 & ItCond & (op11=0x1e; part2c1415=3 & part2c1212=0 & part2c0000=0) & ThArmAddr23 [ TMode=0; globalset(ThArmAddr23,TMode); TMode=1; ]
 {
   build ItCond;
   lr = inst_next|1;
-- 
2.45.1

