From: Confidential <28762372+0L1v3DaD@users.noreply.github.com>
Date: Sun, 18 Oct 2026 21:02:24 -0500
Subject: [PATCH] 09978: Decompiler: cache parsed .pspec and .cspec XML
 documents in SleighArchitecture

Cache parsed .pspec and .cspec XML Document trees in SleighArchitecture::specxmls
(protected by specxmls_mutex) and register their root elements via
DocumentStorage::registerTag, avoiding repeated disk reads and XML parsing
across SleighArchitecture instances.
---
 .../cpp/include/ghidra/sleigh_arch.hh         |  5 ++++
 .../src/decompile/cpp/sleigh_arch.cc          | 27 +++++++++++++++++--
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/sleigh_arch.hh b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/sleigh_arch.hh
index 30771c70b4..8a1bde92ca 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/sleigh_arch.hh
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/include/ghidra/sleigh_arch.hh
@@ -22,6 +22,8 @@
 #include "ghidra/filemanage.hh"
 #include "ghidra/architecture.hh"
 #include "ghidra/sleigh.hh"
+#include <memory>
+#include <mutex>
 
 namespace ghidra {
 
@@ -107,7 +109,10 @@ public:
 /// object is able to automatically load in configuration and construct the Translate object.
 class SleighArchitecture : public Architecture {
   static map<int4,Sleigh> translators;		///< Map from language index to instantiated translators
+  static map<string,std::unique_ptr<const Document>> specxmls;	///< Cache of parsed immutable .pspec/.cspec XML documents
+  static std::mutex specxmls_mutex;			///< Mutex protecting specxmls cache
   static vector<LanguageDescription> description;	///< List of languages we know about
+  static const Document *getSpecDocument(const string &filename);	///< Parse or retrieve cached immutable XML spec document
   int4 languageindex;					///< Index (within LanguageDescription array) of the active language
   string filename;					///< Name of active load-image file
   string target;					///< The \e language \e id of the active load-image
diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/sleigh_arch.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/sleigh_arch.cc
index adcba0e6e2..bb991c2e55 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/sleigh_arch.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/sleigh_arch.cc
@@ -34,6 +34,8 @@ ElementId ELEM_LANGUAGE = ElementId("language",234);
 ElementId ELEM_LANGUAGE_DEFINITIONS = ElementId("language_definitions",235);
 
 map<int4,Sleigh> SleighArchitecture::translators;
+map<string,std::unique_ptr<const Document>> SleighArchitecture::specxmls;
+std::mutex SleighArchitecture::specxmls_mutex;
 vector<LanguageDescription> SleighArchitecture::description;
 
 FileManage SleighArchitecture::specpaths; // Global specfile manager
@@ -372,7 +374,7 @@ void SleighArchitecture::buildSpecFile(DocumentStorage &store)
   }
   
   try {
-    Document *doc = store.openDocument(processorfile);
+    const Document *doc = getSpecDocument(processorfile);
     store.registerTag(doc->getRoot());
   }
   catch(DecoderError &err) {
@@ -389,7 +391,7 @@ void SleighArchitecture::buildSpecFile(DocumentStorage &store)
   }
   
   try {
-    Document *doc = store.openDocument(compilerfile);
+    const Document *doc = getSpecDocument(compilerfile);
     store.registerTag(doc->getRoot());
   }
   catch(DecoderError &err) {
@@ -629,4 +631,25 @@ const vector<LanguageDescription> &SleighArchitecture::getDescriptions(void)
   return description;
 }
 
+/// Retrieve a parsed immutable XML specification document from the cache, or parse it from disk.
+/// DocumentStorage::registerTag only stores a non-owning const Element* in tagmap (unlike openDocument
+/// which transfers ownership to DocumentStorage::doclist), so cached const Documents remain safely owned
+/// by specxmls across SleighArchitecture instances until process exit.
+const Document *SleighArchitecture::getSpecDocument(const string &filename)
+
+{
+  std::lock_guard<std::mutex> lock(specxmls_mutex);
+  map<string,std::unique_ptr<const Document>>::const_iterator iter = specxmls.find(filename);
+  if (iter != specxmls.end())
+    return iter->second.get();
+  ifstream s(filename.c_str());
+  if (!s)
+    throw DecoderError("Unable to open xml document " + filename);
+  std::unique_ptr<const Document> doc(xml_tree(s));
+  s.close();
+  const Document *res = doc.get();
+  specxmls.emplace(filename,std::move(doc));
+  return res;
+}
+
 } // End namespace ghidra
