From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Mon, 14 Sep 2026 15:39:32 +0300
Subject: [PATCH] 9634: Compute 68000 decimal dest and C/X from packed BCD
 add/sub

ABCD/SBCD/NBCD used a unary bcdAdjust of the binary sum, so dest did not emulate and C/X stayed binary. Packed BCD add/sub writes dest and decimal C together; sticky Z matches ADDX.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 .../68000/data/languages/68000.sinc           | 48 ++++++++++++++-----
 1 file changed, 35 insertions(+), 13 deletions(-)

diff --git a/Ghidra/Processors/68000/data/languages/68000.sinc b/Ghidra/Processors/68000/data/languages/68000.sinc
index 1c5f2b0e1a..0114ee8fd3 100644
--- a/Ghidra/Processors/68000/data/languages/68000.sinc
+++ b/Ghidra/Processors/68000/data/languages/68000.sinc
@@ -394,8 +394,6 @@ define pcodeop fsgldiv;
 define pcodeop ftentox;
 define pcodeop ftwotox;
 
-define pcodeop bcdAdjust;
-
 define pcodeop sin;
 define pcodeop cos;
 define pcodeop tan;
@@ -809,7 +807,36 @@ macro clearflags_fp() {
 
 macro bcdflags(result) {
  XF = CF;
- ZF = (result == 0) * ZF + (result != 0);
+ ZF = (result == 0) && (ZF == 1);
+}
+
+# Packed BCD add/sub (QEMU m68k bcd_add/bcd_sub). Dest is the low 8 bits;
+# C is bit 8 of the 16-bit result, not (res >> 8) != 0.
+macro bcdAdd(dst, src) {
+	local t0:2 = zext(src) + 0x66;
+	local t1:2 = t0 + zext(dst);
+	t1 = t1 + zext(XF);
+	local carries:2 = (t0 ^ zext(dst)) ^ t1;
+	local corr:2 = ~(carries >> 3);
+	corr = corr & 0x22;
+	corr = corr + corr + corr;
+	local res:2 = t1 - corr;
+	dst = res:1;
+	CF = (res & 0x100) != 0;
+}
+
+macro bcdSub(dst, src) {
+	local t0:2 = 0x1ff - zext(src);
+	local t1:2 = t0 + zext(dst);
+	t1 = t1 + 1;
+	t1 = t1 - zext(XF);
+	local carries:2 = (t0 ^ zext(dst)) ^ t1;
+	local corr:2 = ~(carries >> 3);
+	corr = corr & 0x22;
+	corr = corr + corr + corr;
+	local res:2 = t1 - corr;
+	dst = res:1;
+	CF = (res & 0x100) != 0;
 }
 
 macro getbit(res,in,bitnum) {
@@ -952,9 +979,7 @@ with : extGUARD=1 {
 @endif # X68KTRAP
 
 :abcd Tyb,Txb			is op=12 & op48=16 & Tyb & Txb {
-	CF = carry(Txb,carry(Tyb,XF));
-	Txb = Txb + Tyb + XF;
-	XF = bcdAdjust(Txb);
+	bcdAdd(Txb, Tyb);
 	bcdflags(Txb);
 }
 
@@ -2075,10 +2100,9 @@ submul: regdr-regdq		is regdq & divsgn=0 & divsz=1 & regdr	{
 :mul^mulsize e2l,submul		is opbig=0x4c & op67=0 & $(DAT_ALTER_ADDR_MODES); submul & mulsize; e2l [ savmod2=savmod1; regtsan=regtfan; ] { glbdenom=e2l; build submul; }
 
 :nbcd eab	is (opbig=0x48 & op67=0 & $(DAT_ALTER_ADDR_MODES))... & eab {
-	local tmp = eab;
-	CF = (tmp != 0) || (XF == 1);
-	tmp = 0 - tmp - XF;
-	eab = bcdAdjust(tmp);
+	local tmp:1 = 0;
+	bcdSub(tmp, eab);
+	eab = tmp;
 	bcdflags(tmp);
 }
 
@@ -2321,9 +2345,7 @@ define pcodeop rtm;
 :rts				is opbig=0x4e & op37=14 & op02=5		{ PC = *SP; SP = SP+4; return [PC]; }
 
 :sbcd Tyb,Txb		is op=8 & op48=16 & Txb & Tyb {
-	CF = (Txb < Tyb) || ( (XF == 1) && (Txb == Tyb) );
-	Txb = Txb - Tyb - XF;
-	Txb = bcdAdjust(Txb);
+	bcdSub(Txb, Tyb);
 	bcdflags(Txb);
 }
 
