From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Thurston <44538250+betamax80@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:17:52 +0000
Subject: [PATCH] 10206: RISC-V: add Zicond (czero.eqz, czero.nez)

Decode the ratified Zicond 1.0 conditional-zero instructions in every
RISC-V language, from a new riscv.zicond.sinc included by
riscv.instr.sinc. czero.eqz's encoding is a special case of the draft
bitmanip cmov (rs3 = x1), so the new constructor takes precedence there;
czero.nez had no decode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Ghidra/Processors/RISCV/certification.manifest    |  1 +
 .../RISCV/data/languages/riscv.instr.sinc         |  1 +
 .../RISCV/data/languages/riscv.zicond.sinc        | 15 +++++++++++++++
 3 files changed, 17 insertions(+)
 create mode 100644 Ghidra/Processors/RISCV/data/languages/riscv.zicond.sinc

diff --git a/Ghidra/Processors/RISCV/certification.manifest b/Ghidra/Processors/RISCV/certification.manifest
index 01a1b36f1b..95edb5a82c 100644
--- a/Ghidra/Processors/RISCV/certification.manifest
+++ b/Ghidra/Processors/RISCV/certification.manifest
@@ -55,6 +55,7 @@ data/languages/riscv.zi.sinc||GHIDRA||||END|
 data/languages/riscv.zbkx.sinc||GHIDRA||||END|
 data/languages/riscv.zfa.sinc||GHIDRA||||END|
 data/languages/riscv.zfh.sinc||GHIDRA||||END|
+data/languages/riscv.zicond.sinc||GHIDRA||||END|
 data/languages/riscv.zknd.sinc||GHIDRA||||END|
 data/languages/riscv.zkne.sinc||GHIDRA||||END|
 data/languages/riscv.zknh.sinc||GHIDRA||||END|
diff --git a/Ghidra/Processors/RISCV/data/languages/riscv.instr.sinc b/Ghidra/Processors/RISCV/data/languages/riscv.instr.sinc
index 77a90bbe0f..fcfe14d7ae 100644
--- a/Ghidra/Processors/RISCV/data/languages/riscv.instr.sinc
+++ b/Ghidra/Processors/RISCV/data/languages/riscv.instr.sinc
@@ -57,6 +57,7 @@
 @include "riscv.zvkng.sinc"
 @include "riscv.zvksg.sinc"
 @include "riscv.zi.sinc"
+@include "riscv.zicond.sinc"
 
 # todos that may be possible, mostly just artifacts from my
 # script to generate the initial SELIGH
diff --git a/Ghidra/Processors/RISCV/data/languages/riscv.zicond.sinc b/Ghidra/Processors/RISCV/data/languages/riscv.zicond.sinc
new file mode 100644
index 0000000000..da6a31848b
--- /dev/null
+++ b/Ghidra/Processors/RISCV/data/languages/riscv.zicond.sinc
@@ -0,0 +1,15 @@
+# RV32/RV64  Zicond Integer Conditional Operations Extension
+
+# czero.eqz d,s,t 0e005033 fe00707f SIMPLE (0, 0)
+:czero.eqz rd,rs1,rs2 is rs1 & rs2 & rd & op0001=0x3 & op0204=0x4 & op0506=0x1 & funct3=0x5 & funct7=0x7
+{
+	local cond:$(XLEN) = zext(rs2 != 0);
+	rd = rs1 * cond;
+}
+
+# czero.nez d,s,t 0e007033 fe00707f SIMPLE (0, 0)
+:czero.nez rd,rs1,rs2 is rs1 & rs2 & rd & op0001=0x3 & op0204=0x4 & op0506=0x1 & funct3=0x7 & funct7=0x7
+{
+	local cond:$(XLEN) = zext(rs2 == 0);
+	rd = rs1 * cond;
+}
