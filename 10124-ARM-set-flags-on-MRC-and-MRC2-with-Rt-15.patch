From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Laxmi Narayan Behera <lnb@lnbfederal.com>
Date: Wed, 4 Nov 2026 12:26:30 -0500
Subject: [PATCH] 10124: ARM: set flags on MRC and MRC2 with Rt=15

---
 .../ARM/data/languages/ARMinstructions.sinc   | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
index c02d9f0624..3e88c023ec 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMinstructions.sinc
@@ -11683,6 +11683,18 @@ ArmPCRelImmed12: reloff		is U23=0 & immed & rotate
   t_op2:4 = opc2;
   Rd = coprocessor_movefromRt(t_cpn,t_op1,t_op2,CRn,CRm);
 }
+
+:mrc2 cpn,opc1,"APSR_nzcv",CRn,CRm,opc2 is $(AMODE) & ARMcond=0 & cond=15 & c2427=14 & opc1 & c2020=1 & CRn & Rd=15 & cpn & opc2 & c0404=1 & CRm
+{
+  t_cpn:4 = cpn;
+  t_op1:4 = opc1;
+  t_op2:4 = opc2;
+  local tmp:4 = coprocessor_movefromRt(t_cpn,t_op1,t_op2,CRn,CRm);
+  NG = (tmp & 0x80000000) != 0;
+  ZR = (tmp & 0x40000000) != 0;
+  CY = (tmp & 0x20000000) != 0;
+  OV = (tmp & 0x10000000) != 0;
+}
 @endif # VERSION_5
 
 
@@ -11695,6 +11707,20 @@ ArmPCRelImmed12: reloff		is U23=0 & immed & rotate
   Rd = coprocessor_movefromRt(t_cpn,t_op1,t_opc2,CRn,CRm);
 }
 
+# Rt=15: N, Z, C, V from bits 31..28. cp15 is left to the named constructors above.
+:mrc^COND cpn,opc1,"APSR_nzcv",CRn,CRm,opc2 is $(AMODE) & ARMcond=1 & COND & c2427=14 & opc1 & c2020=1 & CRn & Rd=15 & cpn & opc2 & c0404=1 & CRm & (c1111=0 | c1010=0 | c0909=0 | c0808=0)
+{
+  build COND;
+  t_cpn:4 = cpn;
+  t_op1:4 = opc1;
+  t_opc2:4 = opc2;
+  local tmp:4 = coprocessor_movefromRt(t_cpn,t_op1,t_opc2,CRn,CRm);
+  NG = (tmp & 0x80000000) != 0;
+  ZR = (tmp & 0x40000000) != 0;
+  CY = (tmp & 0x20000000) != 0;
+  OV = (tmp & 0x10000000) != 0;
+}
+
 
 :mrs^COND Rd,cpsr 		is $(AMODE) & ARMcond=1 & COND & c2027=16 & c1619=15 & Rd & offset_12=0 & cpsr
 {
-- 
2.45.1

