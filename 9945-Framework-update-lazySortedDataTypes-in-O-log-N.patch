From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Confidential <28762372+0L1v3DaD@users.noreply.github.com>
Date: Sun, 18 Oct 2026 18:44:24 -0500
Subject: [PATCH] 9945: Framework: update lazySortedDataTypes in O(log N) on
 DataType rename

---
 .../program/database/data/DataTypeDB.java     |  1 +
 .../database/data/DataTypeManagerDB.java      | 72 +++++++++++++++++--
 2 files changed, 67 insertions(+), 6 deletions(-)

diff --git a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/database/data/DataTypeDB.java b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/database/data/DataTypeDB.java
index 13bd548ea5..a238ab2963 100644
--- a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/database/data/DataTypeDB.java
+++ b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/database/data/DataTypeDB.java
@@ -458,6 +458,7 @@ abstract class DataTypeDB extends DbObject implements DataType {
 	}
 
 	protected void notifyNameChanged(String oldName) {
+		dataMgr.updateSortedListOnRename(this, oldName);
 		for (DataType dt : dataMgr.getParentDataTypes(key)) {
 			dt.dataTypeNameChanged(this, oldName);
 		}
diff --git a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/database/data/DataTypeManagerDB.java b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/database/data/DataTypeManagerDB.java
index 32d2fb79b9..82f0ac327a 100644
--- a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/database/data/DataTypeManagerDB.java
+++ b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/program/database/data/DataTypeManagerDB.java
@@ -3635,17 +3635,77 @@ abstract public class DataTypeManagerDB implements DataTypeManager {
 		defaultListener.dataTypeMoved(this, oldDataTypePath, newDataTypePath);
 	}
 
-	protected void dataTypeNameChanged(DataType dt, String oldName) {
-		CategoryDB category = (CategoryDB) getCategory(dt.getCategoryPath());
-		category.dataTypeRenamed(dt, oldName);
-
-		// we assume we have the write lock here
+	void updateSortedListOnRename(DataType dt, String oldName) {
 		if (!lock.isWriteLockedByCurrentThread()) {
 			throw new AssertException("Attempted to modify sorted datatypes without write lock");
 		}
-		if (lazySortedDataTypes != null) {
+		if (lazySortedDataTypes == null) {
+			return;
+		}
+		int size = lazySortedDataTypes.size();
+		if (size <= 1) {
+			return;
+		}
+		int low = 0;
+		int high = size - 1;
+		int found = -1;
+		while (low <= high) {
+			int mid = (low + high) >>> 1;
+			DataType midDt = lazySortedDataTypes.get(mid);
+			if (midDt == dt) {
+				found = mid;
+				break;
+			}
+			String midName = midDt.getName();
+			int c = midName.compareToIgnoreCase(oldName);
+			if (c < 0) {
+				low = mid + 1;
+			}
+			else if (c > 0) {
+				high = mid - 1;
+			}
+			else {
+				for (int i = mid - 1; i >= low; --i) {
+					DataType cand = lazySortedDataTypes.get(i);
+					if (cand == dt) {
+						found = i;
+						break;
+					}
+					if (!cand.getName().equalsIgnoreCase(oldName)) {
+						break;
+					}
+				}
+				if (found < 0) {
+					for (int i = mid + 1; i <= high; ++i) {
+						DataType cand = lazySortedDataTypes.get(i);
+						if (cand == dt) {
+							found = i;
+							break;
+						}
+						if (!cand.getName().equalsIgnoreCase(oldName)) {
+							break;
+						}
+					}
+				}
+				break;
+			}
+		}
+		if (found < 0) {
 			Collections.sort(lazySortedDataTypes, nameComparator);
+			return;
+		}
+		lazySortedDataTypes.remove(found);
+		int ins = Collections.binarySearch(lazySortedDataTypes, dt, nameComparator);
+		if (ins < 0) {
+			ins = -ins - 1;
 		}
+		lazySortedDataTypes.add(ins, dt);
+	}
+
+	protected void dataTypeNameChanged(DataType dt, String oldName) {
+		CategoryDB category = (CategoryDB) getCategory(dt.getCategoryPath());
+		category.dataTypeRenamed(dt, oldName);
+
 		updateLastChangeTime();
 		setDirtyFlag(dt);
 		defaultListener.dataTypeRenamed(this, new DataTypePath(dt.getCategoryPath(), oldName),
-- 
