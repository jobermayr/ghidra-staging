From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: eyadstein <Eyada5109@gmail.com>
Date: Fri, 23 Oct 2026 18:24:37 +0300
Subject: [PATCH] 10000: fix(z80): correct ADD IY register pair decoding

---
 Ghidra/Processors/Z80/data/languages/z80.slaspec | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Processors/Z80/data/languages/z80.slaspec b/Ghidra/Processors/Z80/data/languages/z80.slaspec
index b93024298a..c6797e00d1 100644
--- a/Ghidra/Processors/Z80/data/languages/z80.slaspec
+++ b/Ghidra/Processors/Z80/data/languages/z80.slaspec
@@ -1429,9 +1429,9 @@ if (DECOMPILE_MODE) goto <forDecompilation>;
 	IX = IX_temp + pRegPair4_2;
 }
 
-:ADD IY,pRegPair4_2 is op0_8=0xfd & IY; op6_2=0x0 & pRegPair4_2 & bits0_4=0x9 {
+:ADD IY,rRegPair4_2 is op0_8=0xfd & IY; op6_2=0x0 & rRegPair4_2 & bits0_4=0x9 {
 	local IY_temp = IY;
-	local Reg_temp = pRegPair4_2;
+	local Reg_temp = rRegPair4_2;
 
 	additionFlagsNoPV(IY_temp, Reg_temp);
 	IY = IY_temp + Reg_temp;
-- 
2.45.1

