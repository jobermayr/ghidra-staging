Subject: [PATCH] 9781: Ignore commented Java-home overrides in PyGhidra launch
 properties

Ignore commented Java home overrides in PyGhidra launch
 properties

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 Ghidra/Features/PyGhidra/src/main/py/src/pyghidra/launcher.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Ghidra/Features/PyGhidra/src/main/py/src/pyghidra/launcher.py b/Ghidra/Features/PyGhidra/src/main/py/src/pyghidra/launcher.py
index d4679a67d5..8247c123b1 100644
--- a/Ghidra/Features/PyGhidra/src/main/py/src/pyghidra/launcher.py
+++ b/Ghidra/Features/PyGhidra/src/main/py/src/pyghidra/launcher.py
@@ -291,6 +291,8 @@ class PyGhidraLauncher:
         launch_properties = root / "support" / "launch.properties"
 
         for line in Path(launch_properties).read_text().splitlines():
+            if line.lstrip().startswith(("#", "//")):
+                continue
             _, _, override = line.partition("JAVA_HOME_OVERRIDE=")
             if override:
                 if override.startswith('"') and override.endswith('"'):
