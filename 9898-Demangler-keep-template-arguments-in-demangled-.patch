Subject: [PATCH] 9898: Demangler: keep template arguments in demangled
 parameter data types

Fixes #2295

AI-generated by Claude Code.
---
 .../app/util/demangler/DemangledDataType.java   | 17 ++++++++++++++++-
 .../util/demangler/gnu/GnuDemanglerTest.java    |  4 +++-
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/demangler/DemangledDataType.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/demangler/DemangledDataType.java
index 6eeef67874..65cd50c88f 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/demangler/DemangledDataType.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/demangler/DemangledDataType.java
@@ -133,7 +133,7 @@ public class DemangledDataType extends DemangledType {
 	 * @return the Ghidra datatype corresponding to the demangled datatype
 	 */
 	public DataType getDataType(DataTypeManager dataTypeManager) {
-		String name = getName();
+		String name = getDataTypeName();
 		if (name == null) {
 			return DataType.DEFAULT;
 		}
@@ -231,6 +231,21 @@ public class DemangledDataType extends DemangledType {
 		return dt;
 	}
 
+	/**
+	 * Returns the name to use for the Ghidra datatype.  Templates are held separately from the
+	 * name, so they are added back here.  The result is made safe in the same way as the name
+	 * of a templated namespace, so that the datatype matches the class structure of that
+	 * namespace.
+	 * @return the datatype name, including any template arguments
+	 */
+	private String getDataTypeName() {
+		if (template == null) {
+			return getName();
+		}
+		String templatedName = getDemangledName() + template.toTemplate();
+		return DemanglerUtil.stripSuperfluousSignatureSpaces(templatedName).replace(' ', '_');
+	}
+
 	private DataType getBuiltInType(DataTypeManager dataTypeManager) {
 		DataType dt = null;
 		String name = getDemangledName();
diff --git a/Ghidra/Features/GnuDemangler/src/test/java/ghidra/app/util/demangler/gnu/GnuDemanglerTest.java b/Ghidra/Features/GnuDemangler/src/test/java/ghidra/app/util/demangler/gnu/GnuDemanglerTest.java
index a978719bc9..4676d95af1 100644
--- a/Ghidra/Features/GnuDemangler/src/test/java/ghidra/app/util/demangler/gnu/GnuDemanglerTest.java
