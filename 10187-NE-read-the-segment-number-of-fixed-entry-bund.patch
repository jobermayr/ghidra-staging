From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hxreborn <hxreborn@duck.com>
Date: Wed, 11 Nov 2026 07:31:04 +0100
Subject: [PATCH] 10187: NE: read the segment number of fixed entry bundles as
 unsigned

Signed-off-by: hxreborn <hxreborn@duck.com>
---
 .../Base/src/main/java/ghidra/app/util/opinion/NeLoader.java    | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java
index d0984a4191..e95537ca40 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java
@@ -602,7 +602,7 @@ public class NeLoader extends AbstractOrdinalSupportLoader {
 					continue;
 				}
 				else {
-					seg = st.getSegments()[bundle.getType() - 1].getSegmentID();
+					seg = st.getSegments()[Byte.toUnsignedInt(bundle.getType()) - 1].getSegmentID();
 				}
 				int off = Short.toUnsignedInt(pt.getOffset());
 				Address addr = space.getAddress(seg, off);
