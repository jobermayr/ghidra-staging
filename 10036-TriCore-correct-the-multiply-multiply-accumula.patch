From: grauulzz <61565419+grauulzz@users.noreply.github.com>
Date: Mon, 26 Oct 2026 15:31:12 -0700
Subject: [PATCH] 10036: TriCore: correct the multiply / multiply-accumulate
 family's p-code semantics

---
 .../tricore/data/languages/tricore.sinc       | 2042 +++++++++++------
 1 file changed, 1297 insertions(+), 745 deletions(-)

diff --git a/Ghidra/Processors/tricore/data/languages/tricore.sinc b/Ghidra/Processors/tricore/data/languages/tricore.sinc
index 00ccb967d5..2f694b7a48 100644
--- a/Ghidra/Processors/tricore/data/languages/tricore.sinc
+++ b/Ghidra/Processors/tricore/data/languages/tricore.sinc
@@ -592,6 +592,49 @@ macro overflowflagsb(r3, r2, r1, r0) {
 }
 
 
+# 64-bit results of the multiply family (MUL / MADD / MSUB with an E destination): V = the exact result's overflow
+# (passed in), SV sticky, AV = result[63] ^ result[62] of the unsaturated result, SAV sticky (TriCore ISA, Status Flags)
+macro flags64(ov, r) {
+	$(PSW_V) = ov;
+	$(PSW_SV) = ov | $(PSW_SV);
+	$(PSW_AV) = r[63,1] ^ r[62,1];
+	$(PSW_SAV) = $(PSW_AV) | $(PSW_SAV);
+}
+
+# 32-bit results of the multiply family: V = the exact result's overflow (passed in), SV sticky,
+# AV = result[31] ^ result[30] of the unsaturated result, SAV sticky (TriCore ISA, Status Flags)
+macro flags32(ov, r) {
+	$(PSW_V) = ov;
+	$(PSW_SV) = ov | $(PSW_SV);
+	$(PSW_AV) = r[31,1] ^ r[30,1];
+	$(PSW_SAV) = $(PSW_AV) | $(PSW_SAV);
+}
+
+# Packed 32-bit results of the multiply family: one overflow and one advanced overflow per word, ORed (V/SV from
+# the overflow, AV/SAV from the advanced overflow; the manual's packed Status Flags rows)
+macro flagsww(ov1, r1, ov0, r0) {
+	$(PSW_V) = ov1 | ov0;
+	$(PSW_SV) = $(PSW_V) | $(PSW_SV);
+	$(PSW_AV) = (r1[31,1] ^ r1[30,1]) | (r0[31,1] ^ r0[30,1]);
+	$(PSW_SAV) = $(PSW_AV) | $(PSW_SAV);
+}
+
+# 16 x 16 -> 32 half-word product, exact, with the manual's special case (1.4.2, p23):
+# 8000H x 8000H with n == 1 delivers 7FFFFFFFH; that is the only pair whose shifted product is 80000000H,
+# so the flag is subtracted.  hmul4 delivers the 32-bit result (the packed .H forms), hmul the same value
+# sign-extended to 64 bits (the .Q UU/LL forms, which shift it further for an E destination).
+macro hmul(res, x, y, n) {
+	local p:8 = sext(x) * sext(y);
+	p = p << n;
+	res = p - zext((x == 0x8000) && (y == 0x8000) && (n == 1));
+}
+
+macro hmul4(res, x, y, n) {
+	local p:4 = sext(x) * sext(y);
+	p = p << n;
+	res = p - zext((x == 0x8000) && (y == 0x8000) && (n == 1));
+}
+
 #define pcodeop ssov;
 macro ssov(res,x,y) {
         local max_pos = (1 << (y - 1)) - 1;
@@ -3796,23 +3839,30 @@ SC: [a10]const0815Z10zz is PCPMode=0 & a10 & const0815Z10zz & op0003=8 & op0404=
 # MADD D[c], D[d], D[a], D[b] (RRR2)
 :madd Rd2831,Rd2427,Rd0811,Rd1215 is PCPMode=0 & Rd0811 & Rd1215 & op0007=0x3 ; Rd2427 & Rd2831 & op1623=0xa
 {
-	Rd2831 = Rd2427 + (Rd0811 * Rd1215);
-	overflowflags(Rd2831);
+	local result:8 = sext(Rd2427) + (sext(Rd0811) * sext(Rd1215));
+	local ov:1 = result != sext(result:4);
+	flags32(ov, result:4);
+	Rd2831 = result:4;
 }
 
 # MADD D[c], D[d], D[a], const9 (RCR)
 :madd Rd2831,Rd2427,Rd0811,const1220S is PCPMode=0 & ( Rd0811 & op0007=0x13 ; Rd2427 & Rd2831 & op2123=0x1 ) & const1220S
