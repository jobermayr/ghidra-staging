diff --git a/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Architecture.java b/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Architecture.java
index f31dc4673b..04b2648bd5 100644
--- a/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Architecture.java
+++ b/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Architecture.java
@@ -20,6 +20,7 @@ public enum Architecture {
 	X86_64("x86_64", "amd64"),
 	POWERPC("ppc"),
 	POWERPC_64("ppc64"),
+	POWERPC_64LE("ppc64le"),
 	ARM_64("aarch64", "arm64"),
 	LOONGARCH_64("loongarch64", "loong64"),
 	UNKNOWN("Unknown Architecture");
diff --git a/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Platform.java b/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Platform.java
index babc6d0672..17fa75ce8c 100644
--- a/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Platform.java
+++ b/Ghidra/Framework/Generic/src/main/java/ghidra/framework/Platform.java
@@ -61,6 +61,12 @@ public enum Platform {
 	/// Identifies a FreeBSD ARM 64-bit OS
 	FREEBSD_ARM_64(OperatingSystem.FREE_BSD, Architecture.ARM_64, "freebsd_arm_64", ".so", ""),
 
+	/// Identifies a FreeBSD PowerPC 64-bit big-endian OS
+	FREEBSD_PPC_64(OperatingSystem.FREE_BSD, Architecture.POWERPC_64, "freebsd_ppc_64", ".so", ""),
+
+	/// Identifies a FreeBSD PowerPC 64-bit little-endian OS
+	FREEBSD_PPC_64LE(OperatingSystem.FREE_BSD, Architecture.POWERPC_64LE, "freebsd_ppc_64le", ".so", ""),
+
 	/// Identifies a OpenBSD x86 64-bit OS
 	OPENBSD_X86_64(OperatingSystem.OPEN_BSD, Architecture.X86_64, "openbsd_x86_64", ".so", ""),
 
diff --git a/GhidraDocs/GettingStarted.md b/GhidraDocs/GettingStarted.md
index 2dd828b7f1..16b3c8adf8 100644
--- a/GhidraDocs/GettingStarted.md
+++ b/GhidraDocs/GettingStarted.md
@@ -203,6 +203,8 @@ Ghidra supports running on the following additional platforms with user-built na
 * Linux ARM 64-bit
 * FreeBSD x86 64-bit (no debugger support)
 * FreeBSD ARM 64-bit (no debugger support)
+* FreeBSD PowerPC 64-bit big-endian (no debugger support)
+* FreeBSD PowerPC 64-bit little-endian (no debugger support)
 * OpenBSD x86 64-bit
 * OpenBSD ARM 64-bit
 
