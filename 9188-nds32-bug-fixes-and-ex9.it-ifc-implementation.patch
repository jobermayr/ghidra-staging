+							"quiescent: no new writes for %d steps (init done)",
+							quiescentStops);
+						break;
+					}
+				}
+				if ((steps % 100_000) == 0) {
+					monitor.setMessage(String.format(
+						"NDS32 init trace: %d steps, %d writes captured", steps,
+						cb.captureCount()));
+				}
+			}
+		}
+		catch (CancelledException e) {
+			throw e;
+		}
+		catch (Exception e) {
