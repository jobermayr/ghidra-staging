From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chanelle <chanellebingham2020@gmail.com>
Date: Sun, 11 Oct 2026 09:32:36 +1100
Subject: [PATCH] 09767: AVR8: fix BRBC/BRBS display operand order

The display lists printed the branch offset before the SREG bit operand,
inverting the ISA order documented by the constructors' own adjacent
comments (# brbc s,k / # brbs s,k) and followed by every sibling
bit-operand instruction in the file. Display-only; patterns and p-code
unchanged.
---
 Ghidra/Processors/Atmel/data/languages/avr8.sinc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Processors/Atmel/data/languages/avr8.sinc b/Ghidra/Processors/Atmel/data/languages/avr8.sinc
index 8e94a25552..84942ef873 100644
--- a/Ghidra/Processors/Atmel/data/languages/avr8.sinc
+++ b/Ghidra/Processors/Atmel/data/languages/avr8.sinc
@@ -630,12 +630,12 @@ define pcodeop break;
 	RdFull = (RdFull & mask) | b;
 }
 # brbc s,k
-:brbc rel7dst,oplow3_flag        is phase=1 & ophi6=0x3d & rel7dst & oplow3_flag {
+:brbc oplow3_flag,rel7dst        is phase=1 & ophi6=0x3d & rel7dst & oplow3_flag {
 	if (!oplow3_flag)
     goto rel7dst;
 }
 # brbs s,k  (see prev instruction)
-:brbs rel7dst,oplow3_flag        is phase=1 & ophi6=0x3c & rel7dst & oplow3_flag {
+:brbs oplow3_flag,rel7dst        is phase=1 & ophi6=0x3c & rel7dst & oplow3_flag {
 	if (oplow3_flag)
     goto rel7dst;
 }
