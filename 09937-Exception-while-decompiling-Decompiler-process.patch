From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Obermayr <johannesobermayr@gmx.de>
Date: Mon, 19 Oct 2026 17:14:16 +0200
Subject: [PATCH] 09937: Exception while decompiling: Decompiler process died

---
 Ghidra/Features/Decompiler/src/decompile/cpp/coreaction.cc | 5 +++--
 Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc | 2 ++
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/coreaction.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/coreaction.cc
index 79690a9431..f894c2bea1 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/coreaction.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/coreaction.cc
@@ -1841,9 +1841,10 @@ void ActionFuncLink::funcLinkInput(FuncCallSpecs *fc,Funcdata &data)
       ProtoParameter *param = fc->getParam(i);
       if (!param->hasStorage()) continue;
       active->registerTrial(param->getAddress(),param->getSize());
-      active->getTrial(i).markActive(); // Parameter is not optional
+      int4 pos = active->getNumTrials()-1;
+      active->getTrial(pos).markActive(); // Parameter is not optional
       if (varargs){
-    	  active->getTrial(i).setFixedPosition(i);
+         active->getTrial(pos).setFixedPosition(pos);
       }
       AddrSpace *spc = param->getAddress().getSpace();
       uintb off = param->getAddress().getOffset();
diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc
index 02f4f4bbe8..2171844893 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/ruleaction.cc
@@ -8831,6 +8831,8 @@ Datatype *RulePieceStructure::determineDatatype(Varnode *vn,int4 &baseOffset)
 
   if (ct->getSize() != vn->getSize()) {			// vn is a partial
     SymbolEntry *entry = vn->getSymbolEntry();
+    if (entry == (SymbolEntry *)0)
+      return (Datatype *)0;
     if (!entry->isMapEntry())
       return (Datatype *)0;
     baseOffset = vn->getAddr().overlap(0,((MapEntry *)entry)->getAddr(),ct->getSize());
-- 
2.45.1

