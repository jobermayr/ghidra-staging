+					}
+				}
+				if (inlineBodyPm != null) {
+					Set<Address> wanted = inlineBodyMap.keySet();
+					AddressIterator existingIt =
+						inlineBodyPm.getPropertyIterator();
+					List<Address> toRemove = new ArrayList<>();
+					while (existingIt.hasNext()) {
