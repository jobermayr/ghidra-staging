+
 	@FieldMapping(fieldName = {"kind", "Kind_"})
 	@EOLComment
 	private int kind;
@@ -79,6 +82,13 @@ public class GoBaseType implements StructureVerifier {
 		return ptrdata;
 	}
 
+	/**
+	 * {@return the alignment of the type being defined by this structure}
+	 */
+	public int getAlign() {
+		return align;
+	}
+
 	/**
 	 * {@return the {@link GoKind} enum assigned to this type definition}
 	 */
diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/rtti/types/GoStructType.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/rtti/types/GoStructType.java
index ad860e2046..339cdeb364 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/rtti/types/GoStructType.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/golang/rtti/types/GoStructType.java
@@ -169,6 +169,9 @@ public class GoStructType extends GoType {
 		}
 
 		DWARFUtil.packCompositeIfPossible(struct, goTypes.getDTM());
+		if (typ.getAlign() > 1) {
+			struct.setExplicitMinimumAlignment(typ.getAlign());	// omitted zero-len fields may align it
+		}
 		return struct;
 	}
 
diff --git a/Ghidra/Features/Base/src/test.slow/java/ghidra/app/util/bin/format/golang/GoRegisterInfoTest.java b/Ghidra/Features/Base/src/test.slow/java/ghidra/app/util/bin/format/golang/GoRegisterInfoTest.java
