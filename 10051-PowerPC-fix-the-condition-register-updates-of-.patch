From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrei Bacescu <9010245+bacescuandrei@users.noreply.github.com>
Date: Wed, 28 Oct 2026 17:03:17 +0200
Subject: [PATCH] 10051: PowerPC: fix the condition register updates of sradi.,
 mtfsb1. and cr1flags

sradi. did not set CR0, and mtfsb1. did not set CR1. cr1flags wrote
FPSCR[OX] to CR3 bit 2 instead of CR1 bit 3, so record-form floating
point instructions left that CR1 bit stale and overwrote CR3[EQ].
---
 Ghidra/Processors/PowerPC/data/languages/ppc_common.sinc       | 2 +-
 Ghidra/Processors/PowerPC/data/languages/ppc_instructions.sinc | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Processors/PowerPC/data/languages/ppc_common.sinc b/Ghidra/Processors/PowerPC/data/languages/ppc_common.sinc
index f8c0ac9272..4cd2a84aaf 100644
--- a/Ghidra/Processors/PowerPC/data/languages/ppc_common.sinc
+++ b/Ghidra/Processors/PowerPC/data/languages/ppc_common.sinc
@@ -1674,7 +1674,7 @@ macro cr1flags() {
 	setCrBit(cr1, 0, fp_fx);
 	setCrBit(cr1, 1, fp_fex);
 	setCrBit(cr1, 2, fp_vx);
-	setCrBit(cr3, 2, fp_ox);
+	setCrBit(cr1, 3, fp_ox);
 }
 macro setFPRF(result) {
 	fp_cc0 = result f< 0;
diff --git a/Ghidra/Processors/PowerPC/data/languages/ppc_instructions.sinc b/Ghidra/Processors/PowerPC/data/languages/ppc_instructions.sinc
index 9574da8659..3dd6abad9c 100644
--- a/Ghidra/Processors/PowerPC/data/languages/ppc_instructions.sinc
+++ b/Ghidra/Processors/PowerPC/data/languages/ppc_instructions.sinc
@@ -2482,6 +2482,7 @@ define pcodeop lswxOp;
 :mtfsb1. CRBD	is $(NOTVLE) & OP=63 & CRBD & BITS_11_20=0 & XOP_1_10=38 & Rc=1
 {
 	CRBD = 1;
+	cr1flags();
 }
 
 #mtfsf 10,fr0		0xfc 00 05 8e
@@ -3267,6 +3268,7 @@ CRM_val: crmval is CRM [crmval = CRM+0;] {export *[const]:1 crmval;}
 {
 	shiftCarry(S,SH);
 	A = S s>> SH;
+	cr0flags(A);
 }
 
 @endif
