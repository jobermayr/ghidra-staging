From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hxreborn <hxreborn@duck.com>
Date: Wed, 11 Nov 2026 08:07:49 +0100
Subject: [PATCH] 10188: NE: read a segment length of 0 with file data as 64
 KiB

Signed-off-by: hxreborn <hxreborn@duck.com>
---
 .../main/java/ghidra/app/util/bin/format/ne/Segment.java    | 6 +++++-
 .../src/main/java/ghidra/app/util/opinion/NeLoader.java     | 3 +++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/ne/Segment.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/ne/Segment.java
index 4582553924..32017635b0 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/ne/Segment.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/bin/format/ne/Segment.java
@@ -72,7 +72,11 @@ public class Segment {
 
         ArrayList<SegmentRelocation> list = new ArrayList<SegmentRelocation>();
         if (hasRelocation()) {
-            int relocPos = offsetAlign + Short.toUnsignedInt(length);
+            int fileLength = Short.toUnsignedInt(length);
+            if (fileLength == 0 && offsetAlign != 0) {
+                fileLength = 0x10000;
+            }
+            int relocPos = offsetAlign + fileLength;
 
             long oldIndex = reader.getPointerIndex();
             reader.setPointerIndex(relocPos);
diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java
index e95537ca40..79a76e51cb 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/NeLoader.java
@@ -262,6 +262,9 @@ public class NeLoader extends AbstractOrdinalSupportLoader {
 
 				int offset = segments[i].getOffsetShiftAligned();
 				int length = Short.toUnsignedInt(segments[i].getLength());
+				if (length == 0 && offset != 0) {
+					length = 0x10000;
+				}
 				int minalloc = Short.toUnsignedInt(segments[i].getMinAllocSize());
 				if (minalloc == 0) {
 					minalloc = 0x10000;
-- 
2.45.1

