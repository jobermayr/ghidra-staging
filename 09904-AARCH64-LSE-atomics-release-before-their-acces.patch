From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Priyanshu Kumar <priyanshukumarpu@gmail.com>
Date: Thu, 15 Oct 2026 05:23:03 +0530
Subject: [PATCH] 09904: AARCH64: LSE atomics release before their access and
 acquire after it

---
 .../AARCH64/data/languages/AARCH64base.sinc   | 26 +++++++++----------
 1 file changed, 13 insertions(+), 13 deletions(-)

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index 10015351dd..e9c615c3fa 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -2532,7 +2532,7 @@ is b_2431=0xd5 & b_2223=0 & l=0 & Op0=0 & Op1=3 & CRn=0x3 & IsbOption & Op2=6 &
 # C6.2.86 LDADDB, LDADDAB, LDADDALB, LDADDLB page C6-648 line 37726 KEEPWITH
 
 # variants, a=acquire, al=acquire+release, l=release
-# build ls_loa to acquire and ls_lor to release
+# build ls_lor to release before the access and ls_loa to acquire after it
 
 ls_loa: "a" is b_23=1 & b_22=0 { LOAcquire(); }
 ls_loa: "al" is b_23=1 & b_22=1 { LOAcquire(); }
@@ -2638,7 +2638,7 @@ ls_opc8: "umin" is b_3031=0b11 & b_1215=0b0111 & Rs_GPR64 & ls_data8 & ls_mem8 {
 
 :ld^ls_opc1^ls_lor^"b" aa_Ws, aa_Wt, [Rn_GPR64xsp]
 is b_3031=0b00 & b_2429=0b111000 & b_21=1 & b_1515=0 & b_1011=0b00 & ls_opc1 & ls_loa & ls_lor & aa_Wt & aa_Ws & Rn_GPR64xsp & aa_Xt
-{ build ls_loa; build ls_opc1; aa_Xt = zext(tmp_ldWn); build ls_lor; }
+{ build ls_lor; build ls_opc1; aa_Xt = zext(tmp_ldWn); build ls_loa; }
 
 # C6.2.134 LDADDH, LDADDAH, LDADDALH, LDADDLH page C6-1491 line 88670 MATCH x78200000/mask=xff20fc00
 # C6.2.153 LDCLRH, LDCLRAH, LDCLRALH, LDCLRLH page C6-1526 line 90621 MATCH x78201000/mask=xff20fc00
@@ -2655,7 +2655,7 @@ is b_3031=0b00 & b_2429=0b111000 & b_21=1 & b_1515=0 & b_1011=0b00 & ls_opc1 & l
 
 :ld^ls_opc2^ls_lor^"h" aa_Ws, aa_Wt, [Rn_GPR64xsp]
 is b_3031=0b01 & b_2429=0b111000 & b_21=1 & b_1515=0 & b_1011=0b00 & ls_opc2 & ls_loa & ls_lor & aa_Wt & aa_Ws & Rn_GPR64xsp & aa_Xt
-{ build ls_loa; build ls_opc2; aa_Xt = zext(tmp_ldWn); build ls_lor; }
+{ build ls_lor; build ls_opc2; aa_Xt = zext(tmp_ldWn); build ls_loa; }
 
 # C6.2.135 LDADD, LDADDA, LDADDAL, LDADDL page C6-1493 line 88796 MATCH xb8200000/mask=xbf20fc00
 # C6.2.154 LDCLR, LDCLRA, LDCLRAL, LDCLRL page C6-1528 line 90747 MATCH xb8201000/mask=xbf20fc00
@@ -2680,7 +2680,7 @@ is b_3031=0b01 & b_2429=0b111000 & b_21=1 & b_1515=0 & b_1011=0b00 & ls_opc2 & l
 
 :ld^ls_opc4^ls_lor aa_Ws, aa_Wt, [Rn_GPR64xsp]
 is b_3031=0b10 & b_2429=0b111000 & b_21=1 & b_1515=0 & b_1011=0b00 & ls_opc4 & ls_loa & ls_lor & aa_Wt & aa_Ws & Rn_GPR64xsp & aa_Xt
-{ build ls_loa; build ls_opc4; aa_Xt = zext(tmp_ldWn); build ls_lor; }
+{ build ls_lor; build ls_opc4; aa_Xt = zext(tmp_ldWn); build ls_loa; }
 
 # C6.2.135 LDADD, LDADDA, LDADDAL, LDADDL page C6-1493 line 88796 MATCH xb8200000/mask=xbf20fc00
 # C6.2.154 LDCLR, LDCLRA, LDCLRAL, LDCLRL page C6-1528 line 90747 MATCH xb8201000/mask=xbf20fc00
@@ -2705,7 +2705,7 @@ is b_3031=0b10 & b_2429=0b111000 & b_21=1 & b_1515=0 & b_1011=0b00 & ls_opc4 & l
 
 :ld^ls_opc8^ls_lor aa_Xs, aa_Xt, [Rn_GPR64xsp]
 is b_3031=0b11 & b_2429=0b111000 & b_21=1 & b_1515=0 & b_1011=0b00 & ls_opc8 & ls_loa & ls_lor & aa_Xt & aa_Xs & Rn_GPR64xsp
-{ build ls_loa; build ls_opc8; aa_Xt = tmp_ldXn; build ls_lor; }
+{ build ls_lor; build ls_opc8; aa_Xt = tmp_ldXn; build ls_loa; }
 
 define pcodeop LOAcquireRCpc;
 
@@ -5942,7 +5942,7 @@ is sf=1 & op.dp3_op54=0 & b_2428=0x1b & op.dp3_op31=1 & Rm_GPR32 & op.dp3_o0=0 &
 
 :st^ls_opc1^ls_lor^"b" aa_Ws, [Rn_GPR64xsp]
 is b_3031=0b00 & b_2429=0b111000 & b_23=0 & b_21=1 & b_1515=0 & b_1011=0b00 & b_0004=0b11111 & ls_opc1 & ls_lor & aa_Ws & Rn_GPR64xsp
-{ build ls_opc1; build ls_lor; }
+{ build ls_lor; build ls_opc1; }
 
 # C6.2.296 STADDH, STADDLH page C6-1820 line 107469 MATCH x7820001f/mask=xffa0fc1f
 # C6.2.299 STCLRH, STCLRLH page C6-1826 line 107756 MATCH x7820101f/mask=xffa0fc1f
@@ -5967,7 +5967,7 @@ is b_3031=0b00 & b_2429=0b111000 & b_23=0 & b_21=1 & b_1515=0 & b_1011=0b00 & b_
 
 :st^ls_opc2^ls_lor^"h" aa_Ws, [Rn_GPR64xsp]
 is b_3031=0b01 & b_2429=0b111000 & b_23=0 & b_21=1 & b_1515=0 & b_1011=0b00 & b_0004=0b11111 & ls_opc2 & ls_lor & aa_Ws & Rn_GPR64xsp
-{ build ls_opc2; build ls_lor; }
