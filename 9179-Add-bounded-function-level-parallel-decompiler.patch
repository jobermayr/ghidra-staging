+      int4 ne = g.edgeCount();
+      int4 nc = g.getColorCount();
+      int4 maxGroupSize = 0;
+      for (int4 c = 0; c < nc; ++c) {
+       int4 sz = (int4)g.getColorGroup(c).size();
+       if (sz > maxGroupSize) maxGroupSize = sz;
+      }
+      std::fprintf(stderr, "[block-conflict] fn=%s blocks=%d edges=%d colors=%d max_group=%d\n",
