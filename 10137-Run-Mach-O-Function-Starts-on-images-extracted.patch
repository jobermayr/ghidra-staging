From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leon Zandman <leon@wirwar.com>
Date: Thu, 5 Nov 2026 23:31:51 +0100
Subject: [PATCH] 10137: Run Mach-O Function Starts on images extracted from a
 dyld cache

MachoFunctionStartsAnalyzer accepted only the formats "Mac OS X Mach-O" and
the whole dyld cache. Images extracted from a dyld shared cache have the
format "Extracted DYLD Component", so their LC_FUNCTION_STARTS was never
used.
---
 .../plugin/core/analysis/MachoFunctionStartsAnalyzer.java    | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/MachoFunctionStartsAnalyzer.java b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/MachoFunctionStartsAnalyzer.java
index 0c2a5e2942..da4e51c683 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/MachoFunctionStartsAnalyzer.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/plugin/core/analysis/MachoFunctionStartsAnalyzer.java
@@ -97,7 +97,10 @@ public class MachoFunctionStartsAnalyzer extends AbstractAnalyzer {
 	public boolean canAnalyze(Program program) {
 		String format = program.getExecutableFormat();
 		isDyld = DyldCacheLoader.DYLD_CACHE_NAME.equals(format);
-		return isDyld || MachoLoader.MACH_O_NAME.equals(format);
+		// An image extracted from a dyld cache is a Mach-O too. Its format name is a string
+		// because DyldCacheExtractLoader is in FileFormats.
+		return isDyld || MachoLoader.MACH_O_NAME.equals(format) ||
+			"Extracted DYLD Component".equals(format);
 	}
 
 	@Override
-- 
