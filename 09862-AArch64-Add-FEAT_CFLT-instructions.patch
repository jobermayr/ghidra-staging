From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CUB3D <callumthom11@gmail.com>
Date: Fri, 9 Oct 2026 14:58:09 +0000
Subject: [PATCH] 09862: AArch64: Add FEAT_CFLT instructions

Implement FEAT_CFLT instructions
---
 .../AARCH64/data/languages/AARCH64base.sinc   | 160 ++++++++++++++++++
 .../data/languages/AARCH64instructions.sinc   |  12 ++
 2 files changed, 172 insertions(+)

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index e95916e5dc..941cf77cdb 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -9226,3 +9226,163 @@ is b_3031=0b00 & b_2429=0b011001 & b_21=1 & b_1215=0b1000 & b_1011=0b00 & ls_loa
 @endif
 	build ls_lor;
 }
+
+# FEAT_CFLT
+define pcodeop ConditionalFault;
+
+cflt_imm9u_32: res is cflt_imm9hu & cflt_imm9l [ res = (cflt_imm9hu << 4) | cflt_imm9l; ] { export *[const]:4 res; }
+cflt_imm9s_32: res is cflt_imm9hs & cflt_imm9l [ res = (cflt_imm9hs << 4) | cflt_imm9l; ] { export *[const]:4 res; }
+
+cflt_imm9u_64: res is cflt_imm9hu & cflt_imm9l [ res = (cflt_imm9hu << 4) | cflt_imm9l; ] { export *[const]:8 res; }
+cflt_imm9s_64: res is cflt_imm9hs & cflt_imm9l [ res = (cflt_imm9hs << 4) | cflt_imm9l; ] { export *[const]:8 res; }
+
+with cflt_cc32: {
+	:"gt" is b_2123=0b000 & Rm_GPR32wsp & Rt_GPR32wsp { cmp:1 = Rt_GPR32wsp s> Rm_GPR32wsp; export cmp; }
+	:"ge" is b_2123=0b001 & Rm_GPR32wsp & Rt_GPR32wsp { cmp:1 = Rt_GPR32wsp s>= Rm_GPR32wsp; export cmp; }
+	:"hi" is b_2123=0b010 & Rm_GPR32wsp & Rt_GPR32wsp { cmp:1 = Rt_GPR32wsp > Rm_GPR32wsp; export cmp; }
+	:"hs" is b_2123=0b011 & Rm_GPR32wsp & Rt_GPR32wsp { cmp:1 = Rt_GPR32wsp >= Rm_GPR32wsp; export cmp; }
+	:"eq" is b_2123=0b110 & Rm_GPR32wsp & Rt_GPR32wsp { cmp:1 = Rt_GPR32wsp == Rm_GPR32wsp; export cmp; }
+	:"ne" is b_2123=0b111 & Rm_GPR32wsp & Rt_GPR32wsp { cmp:1 = Rt_GPR32wsp != Rm_GPR32wsp; export cmp; }
+}
+
+with cflt_cc64: {
+	:"gt" is b_2123=0b000 & Rm_GPR64xsp & Rt_GPR64xsp { cmp:1 = Rt_GPR64xsp s> Rm_GPR64xsp; export cmp; }
+	:"ge" is b_2123=0b001 & Rm_GPR64xsp & Rt_GPR64xsp { cmp:1 = Rt_GPR64xsp s>= Rm_GPR64xsp; export cmp; }
+	:"hi" is b_2123=0b010 & Rm_GPR64xsp & Rt_GPR64xsp { cmp:1 = Rt_GPR64xsp > Rm_GPR64xsp; export cmp; }
+	:"hs" is b_2123=0b011 & Rm_GPR64xsp & Rt_GPR64xsp { cmp:1 = Rt_GPR64xsp >= Rm_GPR64xsp; export cmp; }
+	:"eq" is b_2123=0b110 & Rm_GPR64xsp & Rt_GPR64xsp { cmp:1 = Rt_GPR64xsp == Rm_GPR64xsp; export cmp; }
+	:"ne" is b_2123=0b111 & Rm_GPR64xsp & Rt_GPR64xsp { cmp:1 = Rt_GPR64xsp != Rm_GPR64xsp; export cmp; }
+}
+
+:cfltgt "#"^cflt_reason, Rt_GPR32wsp, "#"^cflt_imm9s_32
+is sf=0 & b_2430=0x76 & b_2123=0b000 & cflt_imm9s_32 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR32wsp
+{
+	if(Rt_GPR32wsp s<= cflt_imm9s_32) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cfltlt "#"^cflt_reason, Rt_GPR32wsp, "#"^cflt_imm9s_32
+is sf=0 & b_2430=0x76 & b_2123=0b001 & cflt_imm9s_32 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR32wsp
+{
+	if(Rt_GPR32wsp s>= cflt_imm9s_32) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cflthi "#"^cflt_reason, Rt_GPR32wsp, "#"^cflt_imm9u_32
+is sf=0 & b_2430=0x76 & b_2123=0b010 & cflt_imm9u_32 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR32wsp
+{
+	if(Rt_GPR32wsp <= cflt_imm9u_32) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cfltlo "#"^cflt_reason, Rt_GPR32wsp, "#"^cflt_imm9u_32
+is sf=0 & b_2430=0x76 & b_2123=0b011 & cflt_imm9u_32 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR32wsp
+{
+	if(Rt_GPR32wsp >= cflt_imm9u_32) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cflteq "#"^cflt_reason, Rt_GPR32wsp, "#"^cflt_imm9s_32
+is sf=0 & b_2430=0x76 & b_2123=0b100 & cflt_imm9s_32 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR32wsp
+{
+	if(Rt_GPR32wsp != cflt_imm9s_32) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cfltne "#"^cflt_reason, Rt_GPR32wsp, "#"^cflt_imm9s_32
+is sf=0 & b_2430=0x76 & b_2123=0b101 & cflt_imm9s_32 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR32wsp
+{
+	if(Rt_GPR32wsp == cflt_imm9s_32) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cfltgt "#"^cflt_reason, Rt_GPR64xsp, "#"^cflt_imm9s_64
+is sf=1 & b_2430=0x76 & b_2123=0b000 & cflt_imm9s_64 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR64xsp
+{
+	if(Rt_GPR64xsp s<= cflt_imm9s_64) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cfltlt "#"^cflt_reason, Rt_GPR64xsp, "#"^cflt_imm9s_64
+is sf=1 & b_2430=0x76 & b_2123=0b001 & cflt_imm9s_64 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR64xsp
+{
+	if(Rt_GPR64xsp s>= cflt_imm9s_64) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cflthi "#"^cflt_reason, Rt_GPR64xsp, "#"^cflt_imm9u_64
+is sf=1 & b_2430=0x76 & b_2123=0b010 & cflt_imm9u_64 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR64xsp
+{
+	if(Rt_GPR64xsp <= cflt_imm9u_64) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cfltlo "#"^cflt_reason, Rt_GPR64xsp, "#"^cflt_imm9u_64
+is sf=1 & b_2430=0x76 & b_2123=0b011 & cflt_imm9u_64 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR64xsp
+{
+	if(Rt_GPR64xsp >= cflt_imm9u_64) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cflteq "#"^cflt_reason, Rt_GPR64xsp, "#"^cflt_imm9s_64
+is sf=1 & b_2430=0x76 & b_2123=0b100 & cflt_imm9s_64 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR64xsp
+{
+	if(Rt_GPR64xsp != cflt_imm9s_64) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cfltne "#"^cflt_reason, Rt_GPR64xsp, "#"^cflt_imm9s_64
+is sf=1 & b_2430=0x76 & b_2123=0b101 & cflt_imm9s_64 & b_1215=0 & cflt_reason & b_09=0 & Rt_GPR64xsp
+{
+	if(Rt_GPR64xsp == cflt_imm9s_64) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cflt^cflt_cc32 "#"^cflt_reason, Rt_GPR32wsp, Rm_GPR32wsp
+is sf=0 & b_2430=0x76 & cflt_cc32 & Rm_GPR32wsp & b_1215=0 & cflt_reason & b_0509=0b10000 & Rt_GPR32wsp
+{
+	if(!cflt_cc32) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:cflt^cflt_cc64 "#"^cflt_reason, Rt_GPR64xsp, Rm_GPR64xsp
+is sf=1 & b_2430=0x76 & cflt_cc64 & Rm_GPR64xsp & b_1215=0 & cflt_reason & b_0509=0b10000 & Rt_GPR64xsp
+{
+	if(!cflt_cc64) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:flt.^br_cc_op "#"^imm16
+is b_2131=0x6a1 & imm16 & b_04=1 & br_cc_op
+{
+    if(!br_cc_op) goto inst_next;
+	ConditionalFault(imm16:2);
+}
+
+:tfltnz "#"^cflt_reason, Rt_GPR32, "#"^b_1923
+is sf=0 & b_2430=0x76 & b_1923 & b_1218=0 & cflt_reason & b_0509=0x13 & Rt_GPR32
+{
+    if(((Rt_GPR32 >> b_1923) & 1) == 0) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:tfltnz "#"^cflt_reason, Rt_GPR64, "#"^b_1923
+is sf=1 & b_2430=0x76 & b_1923 & b_1218=0 & cflt_reason & b_0509=0x13 & Rt_GPR64
+{
+    if(((Rt_GPR64 >> (b_1923 + 32)) & 1) == 0) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:tfltz "#"^cflt_reason, Rt_GPR32, "#"^b_1923
+is sf=0 & b_2430=0x76 & b_1923 & b_1218=0 & cflt_reason & b_0509=0x12 & Rt_GPR32
+{
+    if(((Rt_GPR32 >> b_1923) & 1) != 0) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
+
+:tfltz "#"^cflt_reason, Rt_GPR64, "#"^b_1923
+is sf=1 & b_2430=0x76 & b_1923 & b_1218=0 & cflt_reason & b_0509=0x12 & Rt_GPR64
+{
+    if(((Rt_GPR64 >> (b_1923 + 32)) & 1) != 0) goto inst_next;
+	ConditionalFault(cflt_reason:1);
+}
diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc
index 1ba7ee82cf..6b02a575c1 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64instructions.sinc
@@ -1598,6 +1598,7 @@ define token instrAARCH64 (32) endian = little
 	b_1215 = (12,15)
 	b_1216 = (12,16)
 	b_1217 = (12,17)
+	b_1218 = (12,18)
 	b_1220 = (12,20)
 	b_1223 = (12,23)
 	b_1229 = (12,29)
@@ -1816,6 +1817,11 @@ define token instrAARCH64 (32) endian = little
 	cmpbr_imm9 = (5,13) signed
 	cmpbr_imm6 = (15,20)
 
+	cflt_reason = (10,11)
+    cflt_imm9hs = (16,20) signed
+    cflt_imm9hu = (16,20)
+    cflt_imm9l = (5,8)
+
 	# SVE tokens
 
 	Zd = (0,4)
@@ -2246,6 +2252,9 @@ attach names [ sve_rot_1011 ] [ "#0" "#90" "#180" "#270" ];
 Rm_GPR32: aa_Wm is aa_Wm { export aa_Wm; }
 Rm_GPR32: wzr is aa_Wm=31 & wzr { tmp:4 = 0; export tmp; }
 
+Rm_GPR32wsp: aa_Wm is aa_Wm { export aa_Wm; }
+Rm_GPR32wsp: wsp is aa_Wm=31 & wsp { export wsp; }
+
 Rd_GPR32: aa_Wd is aa_Wd { export aa_Wd; }
 Rd_GPR32: wzr is aa_Wd=31 & wzr { tmp:4 = 0; export tmp; }
 Rd_GPR32_2: aa_Wd is aa_Wd { export aa_Wd; }
@@ -2274,6 +2283,9 @@ Rn_GPR32wsp: wsp is aa_Wn=31 & wsp { export wsp; }
 Rt_GPR32: aa_Wt is aa_Wt { export aa_Wt; }
 Rt_GPR32: wzr is aa_Wt=31 & wzr { tmp:4 = 0; export tmp; }
 
+Rt_GPR32wsp: aa_Wt is aa_Wt { export aa_Wt; }
+Rt_GPR32wsp: wsp is aa_Wt=31 & wsp { export wsp; }
+
 Rm_GPR64: aa_Xm is aa_Xm { export aa_Xm; }
 Rm_GPR64: xzr is aa_Xm=31 & xzr { export 0:8; }
 
-- 
2.45.1

