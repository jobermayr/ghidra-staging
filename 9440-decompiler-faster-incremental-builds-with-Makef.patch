+-include $(LIBSLA_OPT_OBJS:.o=.d)
+-include $(LIBDECOMP_DBG_OBJS:.o=.d)
+-include $(LIBDECOMP_OPT_OBJS:.o=.d)
+
+com_dbg/%.o: %.cc | com_dbg
+	$(CXX) $(ARCH_TYPE) $(DBG_CXXFLAGS) $(INCLUDES) $(ADDITIONAL_FLAGS) $(COMMANDLINE_DEBUG) \
+		-MMD -MP -MF $(@:.o=.d) -c $< -o $@
+
+com_opt/%.o: %.cc | com_opt
+	$(CXX) $(ARCH_TYPE) $(OPT_CXXFLAGS) $(INCLUDES) $(ADDITIONAL_FLAGS) $(COMMANDLINE_OPT) \
+		-MMD -MP -MF $(@:.o=.d) -c $< -o $@
+
+test_dbg/%.o: %.cc | test_dbg
+	$(CXX) $(ARCH_TYPE) $(DBG_CXXFLAGS) $(INCLUDES) $(ADDITIONAL_FLAGS) $(TEST_DEBUG) \
+		-MMD -MP -MF $(@:.o=.d) -c $< -o $@
 
-com_dbg/%.o:	%.cc
-	$(CXX) $(ARCH_TYPE) -c $(DBG_CXXFLAGS) $(INCLUDES) $(ADDITIONAL_FLAGS) $(COMMANDLINE_DEBUG) $< -o $@
-com_opt/%.o:	%.cc
-	$(CXX) $(ARCH_TYPE) -c $(OPT_CXXFLAGS) $(INCLUDES) $(ADDITIONAL_FLAGS) $(COMMANDLINE_OPT)   $< -o $@
