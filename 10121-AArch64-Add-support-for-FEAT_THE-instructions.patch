+:rcwscasp^ls_lor Rs_GPR64, aa_Xss, Rt_GPR64, aa_Xtt, [Rn_GPR64xsp]
+is b_2431=0x59 & b_21=1 & Rs_GPR64 & aa_Xss & b_16=0 & b_1015=0x03 & b_00=0 & Rn_GPR64xsp & Rt_GPR64 & aa_Xtt & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 1; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:16 Rn_GPR64xsp;
+@if DATA_ENDIAN == "big"
+	local tmp2:16 = zext(aa_Xss) | (zext(Rs_GPR64) << 64);
+	local tmp3:16 = zext(aa_Xtt) | (zext(Rt_GPR64) << 64);
+@else
+	local tmp2:16 = zext(Rs_GPR64) | (zext(aa_Xss) << 64);
+	local tmp3:16 = zext(Rt_GPR64) | (zext(aa_Xtt) << 64);
+@endif
+	if(tmp != tmp2) goto <skip>;
+      NG = 0;
+	  *[ram]:16 Rn_GPR64xsp = tmp3;
+	<skip>
+@if DATA_ENDIAN == "big"
+	aa_Xss = tmp:8;
+	Rs_GPR64 = tmp(8);
+@else
+	Rs_GPR64 = tmp:8;
+	aa_Xss = tmp(8);
+@endif
+    build ls_lor;
+}
+
+:rcwsclr^ls_lor Rs_GPR64, Rt_GPR64, [Rn_GPR64xsp]
+is b_2431=0x78 & b_21=1 & Rs_GPR64 & b_1015=0x24 & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 0; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:8 Rn_GPR64xsp;
+	*[ram]:8 Rn_GPR64xsp = tmp & (~Rs_GPR64);
+	Rt_GPR64 = tmp;
+    build ls_lor;
