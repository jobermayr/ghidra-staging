From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OKAN TIKTAS <346542017+OKAN-SOFTWARE@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:33:47 -0500
Subject: [PATCH] 10114: Fix ARM NEON VQABS and VQNEG instruction decoding

---
 .../assembler/sleigh/ARMAssemblyTest.java     | 52 +++++++++++++++++++
 .../ARM/data/languages/ARMneon.sinc           | 38 +++++++++++---
 2 files changed, 82 insertions(+), 8 deletions(-)

diff --git a/Ghidra/Framework/SoftwareModeling/src/test/java/ghidra/app/plugin/assembler/sleigh/ARMAssemblyTest.java b/Ghidra/Framework/SoftwareModeling/src/test/java/ghidra/app/plugin/assembler/sleigh/ARMAssemblyTest.java
index 32ece588dc..ed40a4541d 100644
--- a/Ghidra/Framework/SoftwareModeling/src/test/java/ghidra/app/plugin/assembler/sleigh/ARMAssemblyTest.java
+++ b/Ghidra/Framework/SoftwareModeling/src/test/java/ghidra/app/plugin/assembler/sleigh/ARMAssemblyTest.java
@@ -141,4 +141,56 @@ public class ARMAssemblyTest extends AbstractAssemblyTest {
 	public void testAssemble_T_tbb_m0_r0() {
 		assertAllSyntaxErrors("tbb [0, r0]");
 	}
+
+	@Test
+	public void testAssemble_vqabs_s8_q6_q7() {
+		assertOneCompatRestExact("vqabs.s8 q6,q7", "4e:c7:b0:f3");
+	}
+
+	@Test
+	public void testAssemble_vqneg_s8_q6_q7() {
+		assertOneCompatRestExact("vqneg.s8 q6,q7", "ce:c7:b0:f3");
+	}
+
+	@Test
+	public void testAssemble_vqabs_s8_d6_d7() {
+		assertOneCompatRestExact("vqabs.s8 d6,d7", "07:67:b0:f3");
+	}
+
+	@Test
+	public void testAssemble_vqneg_s8_d6_d7() {
+		assertOneCompatRestExact("vqneg.s8 d6,d7", "87:67:b0:f3");
+	}
+
+	@Test
+	public void testAssemble_vqabs_s16_q6_q7() {
+		assertOneCompatRestExact("vqabs.s16 q6,q7", "4e:c7:b4:f3");
+	}
+
+	@Test
+	public void testAssemble_vqneg_s16_q6_q7() {
+		assertOneCompatRestExact("vqneg.s16 q6,q7", "ce:c7:b4:f3");
+	}
+
+	@Test
+	public void testAssemble_vqabs_s32_q6_q7() {
+		assertOneCompatRestExact("vqabs.s32 q6,q7", "4e:c7:b8:f3");
+	}
+
+	@Test
+	public void testAssemble_vqneg_s32_q6_q7() {
+		assertOneCompatRestExact("vqneg.s32 q6,q7", "ce:c7:b8:f3");
+	}
+
+	@Test
+	public void testAssemble_T_vqabs_s8_q6_q7() {
+		assertOneCompatRestExact("vqabs.s8 q6,q7", "b0:ff:4e:c7",
+		THUMB, 0x00400000, "vqabs.s8 q6,q7");
+	}
+
+	@Test
+	public void testAssemble_T_vqneg_s8_q6_q7() {
+		assertOneCompatRestExact("vqneg.s8 q6,q7", "b0:ff:ce:c7",
+		THUMB, 0x00400000, "vqneg.s8 q6,q7");
+	}
 }
diff --git a/Ghidra/Processors/ARM/data/languages/ARMneon.sinc b/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
index 73652943c5..911262f564 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
@@ -5412,18 +5412,40 @@ vpopSd64List: "{"^buildVpopSd64List^"}"	is TMode=1 & thv_D22 & thv_c1215 & thv_c
 define pcodeop SatQ;
 define pcodeop SignedSatQ;
 
-:vqabs^".s"^esize1819 Dd,Dn,Dm  is ( ($(AMODE) & ARMcond=0 & cond=15 & c2327=7 &     c2021=3 &     c1617=0 &     c0811=7 &     Q6=0 &     c0404=0) |
-                               ($(TMODE_F) &                    thv_c2327=0x1f & thv_c2021=3 & thv_c1617=0 & thv_c0811=7 & thv_Q6=0 & thv_c0404=0)) & esize1819 & Dn & Dd & Dm
+:vqabs^".s"^esize1819 Dd,Dm is (
+    ($(AMODE) & ARMcond=0 & cond=15 & c2327=7 & c2021=3 & c1819<3 & c1617=0 & c0811=7 & c0707=0 & Q6=0 & c0404=0) |
+    ($(TMODE_F) & thv_c2327=0x1f & thv_c2021=3 & thv_c1819<3 & thv_c1617=0 & thv_c0811=7 & thv_c0707=0 & thv_Q6=0 & thv_c0404=0)
+) & esize1819 & Dd & Dm
 {
-	Dd = VectorAbs(Dn,Dm,esize1819);
-	Dd = SatQ(Dd, esize1819, 0:1);
+    Dd = VectorAbs(Dm,esize1819);
+    Dd = SatQ(Dd,esize1819,0:1);
 }
 
-:vqabs^".s"^esize1819 Qd,Qn,Qm  is ( ($(AMODE) & ARMcond=0 & cond=15 & c2327=7 &     c2021=3 &     c1617=0 &     c0811=7 &     Q6=1 &     c0404=0) |
-                               ($(TMODE_F) &                    thv_c2327=0x1f & thv_c2021=3 & thv_c1617=0 & thv_c0811=7 & thv_Q6=1 & thv_c0404=0) ) & esize1819 & Qm & Qn & Qd
+:vqabs^".s"^esize1819 Qd,Qm is (
+    ($(AMODE) & ARMcond=0 & cond=15 & c2327=7 & c2021=3 & c1819<3 & c1617=0 & c0811=7 & c0707=0 & Q6=1 & c0404=0) |
+    ($(TMODE_F) & thv_c2327=0x1f & thv_c2021=3 & thv_c1819<3 & thv_c1617=0 & thv_c0811=7 & thv_c0707=0 & thv_Q6=1 & thv_c0404=0)
+) & esize1819 & Qd & Qm
 {
-	Qd = VectorAbs(Qn,Qm,esize1819);
-	Qd = SatQ(Qd, esize1819, 0:1);
+    Qd = VectorAbs(Qm,esize1819);
+    Qd = SatQ(Qd,esize1819,0:1);
+}
+
+:vqneg^".s"^esize1819 Dd,Dm is (
+    ($(AMODE) & ARMcond=0 & cond=15 & c2327=7 & c2021=3 & c1819<3 & c1617=0 & c0811=7 & c0707=1 & Q6=0 & c0404=0) |
+    ($(TMODE_F) & thv_c2327=0x1f & thv_c2021=3 & thv_c1819<3 & thv_c1617=0 & thv_c0811=7 & thv_c0707=1 & thv_Q6=0 & thv_c0404=0)
+) & esize1819 & Dd & Dm
+{
+    Dd = FloatVectorNeg(Dm,1:1,esize1819);
+    Dd = SatQ(Dd,esize1819,0:1);
+}
+
+:vqneg^".s"^esize1819 Qd,Qm is (
+    ($(AMODE) & ARMcond=0 & cond=15 & c2327=7 & c2021=3 & c1819<3 & c1617=0 & c0811=7 & c0707=1 & Q6=1 & c0404=0) |
+    ($(TMODE_F) & thv_c2327=0x1f & thv_c2021=3 & thv_c1819<3 & thv_c1617=0 & thv_c0811=7 & thv_c0707=1 & thv_Q6=1 & thv_c0404=0)
+) & esize1819 & Qd & Qm
+{
+    Qd = FloatVectorNeg(Qm,1:1,esize1819);
+    Qd = SatQ(Qd,esize1819,0:1);
 }
 
 :vqadd.^udt^esize2021 Dd,Dn,Dm  is ( ($(AMODE) & ARMcond=0 & cond=15 & c2527=1 &     c2323=0 &     c0811=0 &     Q6=0 &     c0404=1) |
-- 
2.45.1

