From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Sat, 3 Oct 2026 20:04:01 +0300
Subject: [PATCH] 9706: Convert Xtensa TRUNC.S and ROUND.S from the scaled
 float

Convert Xtensa TRUNC.S and ROUND.S from the scaled float.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 .../Processors/Xtensa/data/languages/xtensaInstructions.sinc  | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc b/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
index 2d1bbab1d9..ce8727c090 100644
--- a/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
+++ b/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
@@ -1093,7 +1093,7 @@ rfi_eps: ptr is op_s	[ ptr = $(EPS_BASE) + (4 * op_s); ] { export *[register]:4
 	local result = fs f* int2float(scale);
 	isNan:1 = nan(result);
 	if (isNan) goto <bad>;
-	ar = round(fs f* scale);
+	ar = trunc(round(result));
 	goto <end>;
 	<bad>
 	ar = 0x80000000;
@@ -1332,7 +1332,7 @@ rfi_eps: ptr is op_s	[ ptr = $(EPS_BASE) + (4 * op_s); ] { export *[register]:4
 	local result = fs f* int2float(scale);
 	isNan:1 = nan(result);
 	if (isNan) goto <bad>;
-	ar = trunc(fs f* scale);
+	ar = trunc(result);
 	goto <end>;
 	<bad>
 	ar = 0x80000000;
-- 
