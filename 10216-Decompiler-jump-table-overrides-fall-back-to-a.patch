From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Bongaarts <cab@bongalow.net>
Date: Sat, 14 Nov 2026 02:28:09 -0600
Subject: [PATCH] 10216: Decompiler: jump-table overrides fall back to address
 labels when table is read in two halves

Decompiler: index labels for overrides whose table is read in
 two halves

For a manual override (JumpBasicOverride), trialNorm emulates from the
normalized variable, using findStartOp to choose where emulatePath
starts. PathMeld ops are in reverse execution order and emulatePath runs
from the start op down to index 0, but findStartOp returned the
lowest-index reader of the variable, which is the latest one executed.
When the paths split after the variable, for example a destination
pieced from a low-byte table and a high-byte table read with the same
index, the other branch was never emulated. Its LOAD read an unset
varnode, trialNorm failed, and the override fell back to setupTrivial
with address labels.

- findStartOp scans from the highest index, so it returns the earliest
  reader.
- recoverModel sets varnodeIndex to the common-varnode index of the
  normalized variable instead of the op index; the two only coincide on
  a single path.
- trialNorm steps by getStride(trialvn), as JumpBasic's value range
  does. A doubled index is never odd, and stepping by 1 read misaligned
  table entries that sometimes formed valid destinations, giving bogus
  case labels.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NvtBaQBU5K9LiCeqXgAhG3
---
 .../Decompiler/src/decompile/cpp/jumptable.cc | 22 ++++++++++++++++---
 1 file changed, 19 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/jumptable.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/jumptable.cc
index b16ef10d23..d8bfce88f8 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/jumptable.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/jumptable.cc
@@ -2037,7 +2037,11 @@ int4 JumpBasicOverride::findStartOp(Varnode *vn)
   for(;iter!=enditer;++iter)
     (*iter)->setMark();
   int4 res = -1;
-  for(int4 i=0;i<pathMeld.numOps();++i) {
+  // Ops are in reverse execution order and emulatePath() runs from the start op down to index 0,
+  // so start at the EARLIEST reader (highest index).  When the paths split after the Varnode,
+  // e.g. into the low and high byte reads of a split table, starting at a later reader would
+  // leave the other branch unexecuted.
+  for(int4 i=pathMeld.numOps()-1;i>=0;--i) {
     if (pathMeld.getOp(i)->isMark()) {
       res = i;
       break;
@@ -2076,6 +2080,9 @@ int4 JumpBasicOverride::trialNorm(Funcdata *fd,Varnode *trialvn,uint4 tolerance)
 
   AddrSpace *spc = startop->getAddr().getSpace();
   uintb val = startingvalue;
+  // Step over values the variable cannot hold, like JumpBasic's range does (getStride):  a
+  // doubled index (i << 1) is never odd, and an odd value would read a misaligned table entry.
+  uintb step = getStride(trialvn);
   uintb addr;
   uint4 total = 0;
   uint4 miss = 0;
@@ -2103,7 +2110,7 @@ int4 JumpBasicOverride::trialNorm(Funcdata *fd,Varnode *trialvn,uint4 tolerance)
       miss += 1;
       if (miss >= tolerance) break;
     }
-    val += 1;
+    val += step;
   }
   
   //  if ((loadpoint != (vector<LoadTable> *)0)&&(total == adset.size()))
@@ -2209,7 +2216,16 @@ bool JumpBasicOverride::recoverModel(Funcdata *fd,PcodeOp *indop,const JumpModel
     if (trialvn != (Varnode *)0) {
       int4 opi = trialNorm(fd,trialvn,10);
       if (opi >= 0) {
-	varnodeIndex = opi;
+	// varnodeIndex indexes the common Varnodes, not the ops; the two only coincide on a
+	// single path, so look the normalized Varnode up.
+	int4 vi = -1;
+	for(int4 k=0;k<pathMeld.numCommonVarnode();++k) {
+	  if (pathMeld.getVarnode(k) == trialvn) {
+	    vi = k;
+	    break;
+	  }
+	}
+	varnodeIndex = (vi >= 0) ? vi : opi;
 	normalvn = trialvn;
 	return true;
       }
