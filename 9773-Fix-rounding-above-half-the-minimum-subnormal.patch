From: Rudy Celekli <rudy@gradiahq.com>
Date: Tue, 13 Oct 2026 11:01:50 -0400
Subject: [PATCH] 9773: Fix rounding above half the minimum subnormal

Round underflow values above half the minimum subnormal
 upward

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../ghidra/pcode/floatformat/FloatFormat.java | 22 ++++++++++++++-----
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/pcode/floatformat/FloatFormat.java b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/pcode/floatformat/FloatFormat.java
index 3484d62c6f..a8629068c6 100644
--- a/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/pcode/floatformat/FloatFormat.java
+++ b/Ghidra/Framework/SoftwareModeling/src/main/java/ghidra/pcode/floatformat/FloatFormat.java
@@ -532,10 +532,15 @@ public class FloatFormat {
 			exp = 0;
 			int n = value.scale - value.fracbits + lb_unscaled + bias + frac_size;
 			if (n < 0) {
-				// XXX is it possible to round up to a non-zero in this situation?
-				return getZeroEncoding(value.sign < 0);
+				// Exactly half the minimum subnormal ties to even (zero).
+				if (n < -1 || Long.bitCount(value.unscaled) == 1) {
+					return getZeroEncoding(value.sign < 0);
+				}
+				fraction = 1;
+			}
+			else {
+				fraction = roundToLeadBit(value.unscaled, n);
 			}
-			fraction = roundToLeadBit(value.unscaled, n); // XXX round into normal case?
 		}
 		if (exp >= maxexponent) {
 			return getInfinityEncoding(value.sign < 0);
@@ -592,10 +597,15 @@ public class FloatFormat {
 			exp = 0;
 			int n = value.scale - value.fracbits + lb_unscaled + bias + frac_size;
 			if (n < 0) {
-				// XXX is it possible to round up to a non-zero in this situation?
-				return getBigZeroEncoding(value.sign < 0);
+				// Exactly half the minimum subnormal ties to even (zero).
+				if (n < -1 || value.unscaled.bitCount() == 1) {
+					return getBigZeroEncoding(value.sign < 0);
+				}
+				fraction = BigInteger.ONE;
+			}
+			else {
+				fraction = roundToLeadBit(value.unscaled, n);
 			}
-			fraction = roundToLeadBit(value.unscaled, n);
 		}
 		if (exp >= maxexponent) {
 			return getBigInfinityEncoding(value.sign < 0);
