From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Priyanshu Kumar <priyanshukumarpu@gmail.com>
Date: Wed, 14 Oct 2026 22:28:45 +0530
Subject: [PATCH] 09896: AARCH64: read and write NG/ZR/CY/OV in mrs/msr NZCV

---
 .../AARCH64/data/languages/AARCH64base.sinc    | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index 82ac691444..c50c444b06 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -4718,6 +4718,13 @@ is b_2431=0xd5 & b_2223=0 & l=1 & CopReg & Rt_GPR64
 	Rt_GPR64 = CopReg;
 }
 
+# MRS <Xt>, NZCV: Zeros(32):N:Z:C:V:Zeros(28)
+:mrs Rt_GPR64, CopReg
+is b_2431=0xd5 & b_2223=0 & l=1 & Op0=3 & Op1_uimm3=3 & CRn=4 & CRm=2 & Op2_uimm3=0 & CopReg & Rt_GPR64
+{
+	Rt_GPR64 = (zext(NG) << 31) | (zext(ZR) << 30) | (zext(CY) << 29) | (zext(OV) << 28);
+}
+
 # C6.2.229 MSR (immediate) page C6-1684 line 99649 MATCH xd500401f/mask=xfff8f01f
 # CONSTRUCT xd500401f/mask=xfff8f01f MATCHED 1 DOCUMENTED OPCODES
 # AUNIT --inst xd500401f/mask=xfff8f01f --status nodest
@@ -4736,6 +4743,17 @@ is b_2431=0xd5 & b_2223=0 & l=0 & CopReg & Rt_GPR64
 	CopReg = Rt_GPR64;
 }
 
+# MSR NZCV, <Xt>: PSTATE.<N,Z,C,V> = X[t]<31:28>
+:msr CopReg, Rt_GPR64
+is b_2431=0xd5 & b_2223=0 & l=0 & Op0=3 & Op1_uimm3=3 & CRn=4 & CRm=2 & Op2_uimm3=0 & CopReg & Rt_GPR64
+{
+	local val:8 = Rt_GPR64;
+	NG = ((val >> 31) & 1) != 0;
+	ZR = ((val >> 30) & 1) != 0;
+	CY = ((val >> 29) & 1) != 0;
+	OV = ((val >> 28) & 1) != 0;
+}
+
 # C6.2.231 MSUB page C6-1689 line 99963 MATCH x1b008000/mask=x7fe08000
 # C6.2.219 MNEG page C6-1666 line 98782 MATCH x1b00fc00/mask=x7fe0fc00
 # CONSTRUCT x1b008000/mask=xffe08000 MATCHED 2 DOCUMENTED OPCODES
-- 
