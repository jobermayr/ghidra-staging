From: Rudy Celekli <rudy@gradiahq.com>
Date: Tue, 13 Oct 2026 10:59:31 -0400
Subject: [PATCH] 9807: Preserve bundle paths beside the installation directory

Require path component boundaries when saving bundle path
 placeholders

AI-generated by OpenAI Codex.
Remove AI-generated unit test changes from the submitted diff per Ghidra contributor guidance.
---
 .../Framework/Generic/src/main/java/generic/util/Path.java | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Framework/Generic/src/main/java/generic/util/Path.java b/Ghidra/Framework/Generic/src/main/java/generic/util/Path.java
index 8e64d2976b..5c0ee73d51 100644
--- a/Ghidra/Framework/Generic/src/main/java/generic/util/Path.java
+++ b/Ghidra/Framework/Generic/src/main/java/generic/util/Path.java
@@ -214,7 +214,7 @@ public class Path implements Comparable<Path> {
 		String absolutePath = file.getAbsolutePath();
 		for (ResourceFile appRoot : Application.getApplicationRootDirectories()) {
 			String ghidraHome = appRoot.getAbsolutePath();
-			if (absolutePath.startsWith(ghidraHome)) {
+			if (isSameOrDescendantPath(absolutePath, ghidraHome)) {
 				int length = ghidraHome.length();
 				String relativePath = absolutePath.substring(length);
 				absolutePath = GHIDRA_HOME + relativePath;
@@ -232,6 +232,11 @@ public class Path implements Comparable<Path> {
 		return absolutePath.replace('\\', '/');
 	}
 
+	private static boolean isSameOrDescendantPath(String path, String root) {
+		String prefix = root.endsWith(File.separator) ? root : root + File.separator;
+		return path.equals(root) || path.startsWith(prefix);
+	}
+
 	/**
 	 * Returns the path as a string <b>with path element placeholders</b>, such as 
 	 * {@link #GHIDRA_HOME}.
