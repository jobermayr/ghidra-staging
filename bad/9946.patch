From 7cbb9e4e450d95049bf44cc54f4f42bf6f93ac19 Mon Sep 17 00:00:00 2001
From: Confidential <28762372+0L1v3DaD@users.noreply.github.com>
Date: Sun, 18 Oct 2026 18:44:24 -0500
Subject: [PATCH] 9946: Base: update FunctionPurgeAnalysisCmd progress in place without PGO cold-tail jump

---
 .../ghidra/app/cmd/function/FunctionPurgeAnalysisCmd.java   | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/cmd/function/FunctionPurgeAnalysisCmd.java b/Ghidra/Features/Base/src/main/java/ghidra/app/cmd/function/FunctionPurgeAnalysisCmd.java
index 8f0ad57ab46..a2c1132712a 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/cmd/function/FunctionPurgeAnalysisCmd.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/cmd/function/FunctionPurgeAnalysisCmd.java
@@ -67,7 +67,7 @@ public boolean applyTo(Program p, TaskMonitor monitor) {
 			setupNearFarModels();
 		}
 
-		AddressSetView set = entryPoints;
+		AddressSet set = new AddressSet(entryPoints);
 
 		long maxCount = set.getNumAddresses();
 
@@ -79,8 +79,8 @@ public boolean applyTo(Program p, TaskMonitor monitor) {
 				break;
 			}
 
-			set = set.subtract(
-				new AddressSet(program, entryPoints.getMinAddress(), function.getEntryPoint()));
+			set.deleteFromMin(function.getEntryPoint());
+			set.delete(function.getBody());
 			monitor.setProgress(maxCount - set.getNumAddresses());
 
 			monitor.setMessage("Purge " + function.getName());
