From 9bd9697387ca5aaa8a37da2c2cab757053612a5b Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Sun, 13 Sep 2026 21:59:37 +0300
Subject: [PATCH] Return 3- and 4-byte values in DX:AX for __cdecl16far

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 Ghidra/Processors/x86/data/languages/x86-16.cspec | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Ghidra/Processors/x86/data/languages/x86-16.cspec b/Ghidra/Processors/x86/data/languages/x86-16.cspec
index f07cea0b16a..8082493136f 100644
--- a/Ghidra/Processors/x86/data/languages/x86-16.cspec
+++ b/Ghidra/Processors/x86/data/languages/x86-16.cspec
@@ -121,6 +121,9 @@
       <pentry minsize="1" maxsize="2">
         <register name="AX"/>
       </pentry>
+      <pentry minsize="3" maxsize="4">
+        <addr space="join" piece1="DX" piece2="AX"/>
+      </pentry>
     </output>
     <unaffected>
       <register name="SP"/>
