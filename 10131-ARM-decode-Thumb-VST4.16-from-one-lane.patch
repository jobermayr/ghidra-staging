Subject: [PATCH] 10131: ARM: decode Thumb VST4.16 from one lane

---
 Ghidra/Processors/ARM/data/languages/ARMneon.sinc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Ghidra/Processors/ARM/data/languages/ARMneon.sinc b/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
index 3fc6f3039d..f852e68206 100644
--- a/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
+++ b/Ghidra/Processors/ARM/data/languages/ARMneon.sinc
@@ -6693,7 +6693,7 @@ vst4DdElement2: Dreg^"["^vst4Index^"]"	is Dreg & vst4Index & ((TMode=0 & c1011=0
 	*:1 mult_addr = *[register]:1 ptr;
 }
 
-vst4DdElement2: Dreg^"["^vst4Index^"]"	is Dreg & vst4Index & TMode=0 & ((TMode=0 & c1011=1) | (TMode=1 & thv_c1011=1))
+vst4DdElement2: Dreg^"["^vst4Index^"]"	is Dreg & vst4Index & ((TMode=0 & c1011=1) | (TMode=1 & thv_c1011=1))
 {
 	ptr:4 = &Dreg + vst4Index;
 	*:2 mult_addr = *[register]:2 ptr;
-- 
