From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hxreborn <hxreborn@duck.com>
Date: Tue, 10 Nov 2026 23:51:56 +0100
Subject: [PATCH] 10182: Headless: normalize the project location before
 validating it

Signed-off-by: hxreborn <hxreborn@duck.com>
---
 .../main/java/ghidra/app/util/headless/HeadlessAnalyzer.java   | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/headless/HeadlessAnalyzer.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/headless/HeadlessAnalyzer.java
index 4dd70f4b95..a4ad41951b 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/headless/HeadlessAnalyzer.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/headless/HeadlessAnalyzer.java
@@ -429,7 +429,8 @@ public class HeadlessAnalyzer {
 			Msg.info(HeadlessAnalyzer.class, "HEADLESS: execution starts");
 
 			File dir = new File(projectLocation);
-			ProjectLocator locator = new ProjectLocator(dir.getAbsolutePath(), projectName);
+			String location = dir.toPath().toAbsolutePath().normalize().toString();
+			ProjectLocator locator = new ProjectLocator(location, projectName);
 
 			if (locator.getProjectDir().exists()) {
 				project = openProject(locator);
-- 
