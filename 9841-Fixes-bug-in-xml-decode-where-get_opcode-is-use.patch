From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hanuman Chu <chuhanuman@yahoo.com>
Date: Mon, 12 Oct 2026 04:59:02 -0600
Subject: [PATCH] 9841: Fixes bug in xml decode where get_opcode is used
 incorrectly

---
 Ghidra/Features/Decompiler/src/decompile/cpp/marshal.cc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/marshal.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/marshal.cc
index e36c10ccb6..4a211b3ff0 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/marshal.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/marshal.cc
@@ -430,7 +430,7 @@ OpCode XmlDecode::readOpcode(void)
 {
   const Element *el = elStack.back();
   string nm = el->getAttributeValue(attributeIndex);
-  OpCode opc = get_opcode(nm);
+  OpCode opc = (OpCode)std::stoi(nm);
   if (opc == (OpCode)0)
     throw DecoderError("Bad encoded OpCode");
   return opc;
@@ -448,7 +448,7 @@ OpCode XmlDecode::readOpcode(AttributeId &attribId)
     int4 index = findMatchingAttribute(el, attribId.getName());
     nm = el->getAttributeValue(index);
   }
-  OpCode opc = get_opcode(nm);
+  OpCode opc = (OpCode)std::stoi(nm);
   if (opc == (OpCode)0)
     throw DecoderError("Bad encoded OpCode");
   return opc;
-- 
2.45.1

