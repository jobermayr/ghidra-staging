Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

=?UTF-8?q?=D0=94=D0=BE=D0=B1=D0=B0=D0=B2=D0=BB=D0=B5?=
 =?UTF-8?q?=D0=BD=D1=8B=20=D0=B8=D0=BD=D1=81=D1=82=D1=80=D1=83=D0=BA=D1=86?=
 =?UTF-8?q?=D0=B8=D0=B8=20=D1=81=D1=80=D0=B0=D0=B2=D0=BD=D0=B5=D0=BD=D0=B8?=
 =?UTF-8?q?=D1=8F=20SALT=20=D0=B8=20SALTU=20=D0=B4=D0=BB=D1=8F=20Xtensa?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Результат знакового или беззнакового сравнения расширяется до 32 бит. Проверены оба порядка байтов, предельные значения и совпадение выходного регистра с входным.
---
 .../Xtensa/data/languages/xtensaInstructions.sinc      | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc b/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
index 1039d3dc32..33c12807cb 100644
--- a/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
+++ b/Ghidra/Processors/Xtensa/data/languages/xtensaInstructions.sinc
@@ -1169,6 +1169,16 @@ rfi_eps: ptr is op_s	[ ptr = $(EPS_BASE) + (4 * op_s); ] { export *[register]:4
 	*:4 addr = at;
 }
 
+# SALT (RRR).
+:salt ar, as, at is op2 = 0b0111 & op1 = 0b0010 & ar & as & at & op0 = 0 {
+	ar = zext(as s< at);
+}
+
+# SALTU (RRR).
+:saltu ar, as, at is op2 = 0b0110 & op1 = 0b0010 & ar & as & at & op0 = 0 {
+	ar = zext(as < at);
+}
+
 # SDCT - Store Data Cache Tag (RRR), pg. 516.
 :sdct at, as is op2 = 0b1111 & op1 = 0b0001 & ar = 0b1001 & as & at & op0 = 0 {
 	sdct(as, at);
-- 
