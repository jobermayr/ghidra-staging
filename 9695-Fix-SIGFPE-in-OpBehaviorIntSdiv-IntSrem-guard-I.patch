From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pal Marci <m.pal@pcacybersecurity.com>
Date: Wed, 30 Sep 2026 11:43:59 +0200
Subject: [PATCH] 9695: Fix SIGFPE in OpBehaviorIntSdiv/IntSrem: guard
 INT64_MIN / -1

On x86-64, idiv traps not only on a zero divisor but also when the quotient
overflows the register. INT64_MIN / -1 produces 2^63 which does not fit in
int64_t, raising SIGFPE as a hardware signal. That signal kills the decompile
subprocess rather than being caught by PcodeOp::executeSimple's EvaluationError
handler, so the decompiler process dies instead of returning a recoverable error.

Add a pre-division overflow check to OpBehaviorIntSdiv::evaluateBinary and
OpBehaviorIntSrem::evaluateBinary (INT64_MIN % -1 traps the same way).
---
 .../Features/Decompiler/src/decompile/cpp/opbehavior.cc   | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/opbehavior.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/opbehavior.cc
index d2a24c023e..ba3bd1e0a4 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/opbehavior.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/opbehavior.cc
@@ -514,6 +514,11 @@ uintb OpBehaviorIntSdiv::evaluateBinary(int4 sizeout,int4 sizein,uintb in1,uintb
     throw EvaluationError("Divide by 0");
   intb num = sign_extend(in1,8*sizein-1);		// Convert to signed
   intb denom = sign_extend(in2,8*sizein-1);
+  // On x86-64, idiv also traps when the full-width quotient of INT64_MIN/-1
+  // doesn't fit in the output register.  That trap becomes a native SIGFPE which
+  // cannot be caught as a C++ exception, so we must detect it before dividing.
+  if (denom == -1 && num == (intb)((uintb)1 << (8*sizein-1)))
+    throw EvaluationError("Signed divide overflow");
   intb sres = num/denom;	// Do the signed division
   sres = zero_extend(sres,8*sizeout-1); // Cut to appropriate size
   return (uintb)sres;		// Recast as unsigned
@@ -536,6 +541,9 @@ uintb OpBehaviorIntSrem::evaluateBinary(int4 sizeout,int4 sizein,uintb in1,uintb
     throw EvaluationError("Remainder by 0");
   intb val = sign_extend(in1,8*sizein-1);	// Convert inputs to signed values
   intb mod = sign_extend(in2,8*sizein-1);
+  // Same overflow guard as INT_SDIV: INT64_MIN % -1 also traps on x86-64.
+  if (mod == -1 && val == (intb)((uintb)1 << (8*sizein-1)))
+    throw EvaluationError("Signed remainder overflow");
   intb sres = val % mod;	// Do the remainder
   sres = zero_extend(sres,8*sizeout-1); // Convert back to unsigned
   return (uintb)sres;
-- 
2.45.1

