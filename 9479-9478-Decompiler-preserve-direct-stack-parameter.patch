 .../Decompiler/src/decompile/cpp/fspec.cc     | 42 +++++++++++-
 .../src/decompile/cpp/include/ghidra/fspec.hh |  1 +
 .../cpp/include/ghidra/modelrules.hh          | 18 +++++
 .../src/decompile/datatests/memclassparam.xml | 68 +++++++++++++++++++
 5 files changed, 129 insertions(+), 1 deletion(-)
 create mode 100644 Ghidra/Features/Decompiler/src/decompile/datatests/memclassparam.xml

