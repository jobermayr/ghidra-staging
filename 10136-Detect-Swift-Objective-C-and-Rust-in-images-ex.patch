From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leon Zandman <leon@wirwar.com>
Date: Thu, 5 Nov 2026 17:48:58 +0100
Subject: [PATCH] 10136: Detect Swift, Objective-C and Rust in images extracted
 from a dyld cache

MachoSwiftSourceLanguage, MachoObjcSourceLanguage and MachoRustSourceLanguage
accepted only the format "Mac OS X Mach-O". Images extracted from a dyld
shared cache have the format "Extracted DYLD Component", so since 12.2 their
Swift symbols were no longer demangled.
---
 .../app/util/sourcelanguage/MachoObjcSourceLanguage.java    | 6 +++++-
 .../app/util/sourcelanguage/MachoRustSourceLanguage.java    | 6 +++++-
 .../app/util/sourcelanguage/MachoSwiftSourceLanguage.java   | 6 +++++-
 3 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/sourcelanguage/MachoObjcSourceLanguage.java b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/sourcelanguage/MachoObjcSourceLanguage.java
index 27b2af87c7..370b1d5559 100644
--- a/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/sourcelanguage/MachoObjcSourceLanguage.java
+++ b/Ghidra/Features/Objective-C/src/main/java/ghidra/app/util/sourcelanguage/MachoObjcSourceLanguage.java
@@ -30,7 +30,11 @@ public class MachoObjcSourceLanguage extends ObjcSourceLanguage {
 
 	@Override
 	public boolean existsIn(Program program, TaskMonitor monitor) {
-		if (!program.getExecutableFormat().equals(MachoLoader.MACH_O_NAME)) {
+		// An image extracted from a dyld cache is a Mach-O too. Its format name is a string
+		// because DyldCacheExtractLoader is in FileFormats.
+		String format = program.getExecutableFormat();
+		if (!MachoLoader.MACH_O_NAME.equals(format) &&
+			!"Extracted DYLD Component".equals(format)) {
 			return false;
 		}
 		return Arrays.stream(program.getMemory().getBlocks())
diff --git a/Ghidra/Features/Rust/src/main/java/ghidra/app/util/sourcelanguage/MachoRustSourceLanguage.java b/Ghidra/Features/Rust/src/main/java/ghidra/app/util/sourcelanguage/MachoRustSourceLanguage.java
index 53f033bc92..314f0c3812 100644
--- a/Ghidra/Features/Rust/src/main/java/ghidra/app/util/sourcelanguage/MachoRustSourceLanguage.java
+++ b/Ghidra/Features/Rust/src/main/java/ghidra/app/util/sourcelanguage/MachoRustSourceLanguage.java
@@ -33,7 +33,11 @@ public class MachoRustSourceLanguage extends RustSourceLanguage {
 	@Override
 	public boolean existsIn(Program program, TaskMonitor monitor)
 			throws IOException, CancelledException {
-		if (!program.getExecutableFormat().equals(MachoLoader.MACH_O_NAME)) {
+		// An image extracted from a dyld cache is a Mach-O too. Its format name is a string
+		// because DyldCacheExtractLoader is in FileFormats.
+		String format = program.getExecutableFormat();
+		if (!MachoLoader.MACH_O_NAME.equals(format) &&
+			!"Extracted DYLD Component".equals(format)) {
 			return false;
 		}
 		for (MemoryBlock block : program.getMemory().getBlocks()) {
diff --git a/Ghidra/Features/Swift/src/main/java/ghidra/app/util/sourcelanguage/MachoSwiftSourceLanguage.java b/Ghidra/Features/Swift/src/main/java/ghidra/app/util/sourcelanguage/MachoSwiftSourceLanguage.java
index d5384c8704..c58f0a7bef 100644
--- a/Ghidra/Features/Swift/src/main/java/ghidra/app/util/sourcelanguage/MachoSwiftSourceLanguage.java
+++ b/Ghidra/Features/Swift/src/main/java/ghidra/app/util/sourcelanguage/MachoSwiftSourceLanguage.java
@@ -29,7 +29,11 @@ public class MachoSwiftSourceLanguage extends SwiftSourceLanguage {
 
 	@Override
 	public boolean existsIn(Program program, TaskMonitor monitor) {
-		if (!program.getExecutableFormat().equals(MachoLoader.MACH_O_NAME)) {
+		// An image extracted from a dyld cache is a Mach-O too. Its format name is a string
+		// because DyldCacheExtractLoader is in FileFormats.
+		String format = program.getExecutableFormat();
+		if (!MachoLoader.MACH_O_NAME.equals(format) &&
+			!"Extracted DYLD Component".equals(format)) {
 			return false;
 		}
 		return Arrays.stream(program.getMemory().getBlocks())
-- 
