From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erik Berg <github@slipsprogrammor.no>
Date: Mon, 12 Oct 2026 12:49:59 +0200
Subject: [PATCH] 9856: x86-16: wrap real-mode rel16 targets in the code
 segment

SLEIGH only sees the linear inst_next, so rel16 wrapped a near branch
in the instruction's 64K page rather than in CS. Add a noflow context
field, cseg, in the reserved high bits: the real-mode CS of the
instruction, or 0 when not known. With cseg set, rel16 is exact;
with cseg 0 it reduces to the page formula. MzLoader sets cseg
alongside CS over the first 64K of each segment block.

Decompiler debug dumps name context fields, and a dump with the old
reservedHigh field threw a NullPointerException on load. Skip names
the language does not define, with a log message.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../app/util/opinion/DecompileDebugFormatManager.java  |  8 +++++++-
 .../main/java/ghidra/app/util/opinion/MzLoader.java    | 10 +++++++++-
 Ghidra/Processors/x86/data/languages/ia.sinc           |  8 +++++++-
 3 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/DecompileDebugFormatManager.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/DecompileDebugFormatManager.java
index 420b369bf7..8006556d22 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/DecompileDebugFormatManager.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/DecompileDebugFormatManager.java
@@ -674,7 +674,13 @@ public class DecompileDebugFormatManager {
 					String regName = setElement.getAttribute(ATTRIB_NAME.name());
 					BigInteger regVal = new BigInteger(setElement.getAttribute(ATTRIB_VAL.name()));
 					Register reg = pc.getRegister(regName);
-					pc.setValue(reg, addr, addr, regVal);
+					if (reg == null) {
+						log.appendMsg(parser.getLineNumber(),
+							"Unknown context register skipped: " + regName);
+					}
+					else {
+						pc.setValue(reg, addr, addr, regVal);
+					}
 					parser.end(setElement);
 				}
 			}
diff --git a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/MzLoader.java b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/MzLoader.java
index 4d9c929da3..9749ba6c38 100644
--- a/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/MzLoader.java
+++ b/Ghidra/Features/Base/src/main/java/ghidra/app/util/opinion/MzLoader.java
@@ -506,6 +506,7 @@ public class MzLoader extends AbstractLibrarySupportLoader {
 		Register sp = context.getRegister("sp");
 		Register ds = context.getRegister("ds");
 		Register cs = context.getRegister("cs");
+		Register cseg = context.getRegister("cseg");
 
 		try {
 			context.setValue(sp, entry.getAddress(), entry.getAddress(),
@@ -526,13 +527,20 @@ public class MzLoader extends AbstractLibrarySupportLoader {
 						.valueOf(Integer.toUnsignedLong(((SegmentedAddress) start).getSegment()));
 				
 				context.setValue(cs, start, end, csValue);
+				if (cseg != null) {
+					// a block may run past seg:FFFF, which this CS cannot reach
+					int reach = 0x10000 - ((SegmentedAddress) start).getSegmentOffset();
+					Address csegEnd = start.add(Math.min(block.getSize(), reach) - 1);
+					context.setValue(cseg, start, csegEnd, csValue);
+				}
 				if (shouldSetDS) {
 					context.setValue(ds, start, end, BigInteger.valueOf(dsValue));
 				}
 			}
 		}
 		catch (ContextChangeException e) {
-			// ignore since segment registers should never cause this error
+			// only a context register write over an instruction throws; cs and ds are
+			// plain registers, and the loader has created no instructions for cseg to hit
 		}
 	}
 
diff --git a/Ghidra/Processors/x86/data/languages/ia.sinc b/Ghidra/Processors/x86/data/languages/ia.sinc
index e0c02f0df0..76039706dc 100644
--- a/Ghidra/Processors/x86/data/languages/ia.sinc
+++ b/Ghidra/Processors/x86/data/languages/ia.sinc
@@ -376,7 +376,7 @@ define register offset=0x3000 size=1024  [
 ];
 
 # Define context bits
-define register offset=0x2000 size=8   contextreg;
+define register offset=0x2000 size=16   contextreg;
 
 # AVX-512 opmask registers
 define register offset=2100 size=8  [
@@ -484,6 +484,9 @@ define context contextreg
   ctxAX = (48,63)
     ctxAH = (48,55)     # Vice-versa since Sleigh is BE
     ctxAL = (56,63)
+
+  cseg=(64,79) noflow   # stored: real-mode CS of the instruction, set by loaders; 0 if not known
+  # free=(80,127)
 ;
 
 
@@ -1174,6 +1177,9 @@ EffectiveAddress: addr64    is                   addrsize=2 & addr64    { export
 @endif
 
 rel8: reloc is simm8        [ reloc=inst_next+simm8; ] { export *[ram]:$(SIZE) reloc; }
+# Real mode: IP wraps in the code segment, cseg. The base is the last byte's address less its
+# offset in the segment (inst_next may be past seg:FFFF); with cseg=0 this is the 64K page.
+rel16: reloc is protectedMode=0 & simm16 [ reloc=(inst_next - 1 - ((inst_next - 1 - (cseg << 4)) & 0xFFFF)) + ((inst_next - (cseg << 4) + simm16) & 0xFFFF); ] { export *[ram]:$(SIZE) reloc; }
 rel16: reloc is simm16      [ reloc=((inst_next >> 16) << 16) | ((inst_next + simm16) & 0xFFFF); ] { export *[ram]:$(SIZE) reloc; }
 rel32: reloc is simm32      [ reloc=inst_next+simm32; ] { export *[ram]:$(SIZE) reloc; }
 
