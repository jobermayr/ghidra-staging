From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CUB3D <callumthom11@gmail.com>
Date: Thu, 29 Oct 2026 17:23:56 +0000
Subject: [PATCH] 10121: AArch64: Add support for FEAT_THE instructions

Add support for FEAT_THE instructions
---
 .../AARCH64/data/languages/AARCH64base.sinc   | 282 ++++++++++++++++++
 1 file changed, 282 insertions(+)

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index a7fcb91ec4..eb58261c34 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -10537,3 +10537,285 @@ is b_1931=0b1101010101001 & Op1_uimm3=0b110 & CRn_CRx=0b1001 & CRm_CRx=0b0111 &
 :tlbip "VALE3NXS", Rt_GPR64, Rtt_GPR64
 is b_1931=0b1101010101001 & Op1_uimm3=0b110 & CRn_CRx=0b1001 & CRm_CRx=0b0111 & Op2_uimm3=0b101 & Rt_GPR64 & Rtt_GPR64
 { TLBIP_VALE3NXS(Rt_GPR64, Rtt_GPR64); }
+
+# FEAT_THE
+
+:rcwcas^ls_lor Rs_GPR64, Rt_GPR64, [Rn_GPR64xsp]
+is b_2431=0x19 & b_21=1 & Rs_GPR64 & b_1015=0x02 & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 1; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:8 Rn_GPR64xsp;
+	if(tmp != Rs_GPR64) goto <skip>;
+      NG = 0;
+	  *[ram]:8 Rn_GPR64xsp = Rt_GPR64;
+	<skip>
+	Rs_GPR64 = tmp;
+    build ls_lor;
+}
+
+:rcwcasp^ls_lor Rs_GPR64, aa_Xss, Rt_GPR64, aa_Xtt, [Rn_GPR64xsp]
+is b_2431=0x19 & b_21=1 & Rs_GPR64 & aa_Xss & b_16=0 & b_1015=0x03 & Rn_GPR64xsp & Rt_GPR64 & aa_Xtt & b_00=0 & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 1; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:16 Rn_GPR64xsp;
+@if DATA_ENDIAN == "big"
+	local tmp2:16 = zext(aa_Xss) | (zext(Rs_GPR64) << 64);
+	local tmp3:16 = zext(aa_Xtt) | (zext(Rt_GPR64) << 64);
+@else
+	local tmp2:16 = zext(Rs_GPR64) | (zext(aa_Xss) << 64);
+	local tmp3:16 = zext(Rt_GPR64) | (zext(aa_Xtt) << 64);
+@endif
+	if(tmp != tmp2) goto <skip>;
+      NG = 0;
+	  *[ram]:16 Rn_GPR64xsp = tmp3;
+	<skip>
+@if DATA_ENDIAN == "big"
+	aa_Xss = tmp:8;
+	Rs_GPR64 = tmp(8);
+@else
+	Rs_GPR64 = tmp:8;
+	aa_Xss = tmp(8);
+@endif
+    build ls_lor;
+}
+
+:rcwclr^ls_lor Rs_GPR64, Rt_GPR64, [Rn_GPR64xsp]
+is b_2431=0x38 & b_21=1 & Rs_GPR64 & b_1015=0x24 & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    NG = 0; ZR = 0; CY = 1; OV = 0;
+    build ls_loa;
+	local tmp = *[ram]:8 Rn_GPR64xsp;
+	*[ram]:8 Rn_GPR64xsp = tmp & (~Rs_GPR64);
+	Rt_GPR64 = tmp;
+    build ls_lor;
+}
+
+:rcwclrp^ls_lor Rt_GPR64, Rs_GPR64, [Rn_GPR64xsp]
+is b_2431=0x19 & b_21=1 & Rs_GPR64 & b_1015=0x24 & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    NG = 0; ZR = 0; CY = 1; OV = 0;
+    build ls_loa;
+	local tmp = *[ram]:16 Rn_GPR64xsp;
+@if DATA_ENDIAN == "big"
+	local tmp2:16 = zext(Rs_GPR64) | (zext(Rt_GPR64) << 64);
+@else
+	local tmp2:16 = zext(Rt_GPR64) | (zext(Rs_GPR64) << 64);
+@endif
+	*[ram]:16 Rn_GPR64xsp = tmp & (~tmp2);
+@if DATA_ENDIAN == "big"
+	Rs_GPR64 = tmp:8;
+	Rt_GPR64 = tmp(8);
+@else
+	Rt_GPR64 = tmp:8;
+	Rs_GPR64 = tmp(8);
+@endif
+    build ls_lor;
+}
+
+:rcwscas^ls_lor Rs_GPR64, Rt_GPR64, [Rn_GPR64xsp]
+is b_2431=0x59 & b_21=1 & Rs_GPR64 & b_1015=0x02 & Rn_GPR64xsp & Rt_GPR64 & ls_lor & ls_loa
+{
+    build ls_loa;
+    NG = 1; ZR = 0; CY = 1; OV = 0;
+	local tmp = *[ram]:8 Rn_GPR64xsp;
+	if(tmp != Rs_GPR64) goto <skip>;
+      NG = 0;
+	  *[ram]:8 Rn_GPR64xsp = Rt_GPR64;
+	<skip>
+	Rs_GPR64 = tmp;
+    build ls_lor;
+}
