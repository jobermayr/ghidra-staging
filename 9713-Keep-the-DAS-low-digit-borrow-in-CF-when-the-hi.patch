From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xop <73129829+xop01@users.noreply.github.com>
Date: Sat, 3 Oct 2026 20:43:21 +0300
Subject: [PATCH] 9713: Keep the DAS low-digit borrow in CF when the high digit
 is left alone

Keep the DAS low-digit borrow in CF when the high digit is
 left alone.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 Ghidra/Processors/x86/data/languages/ia.sinc | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/Ghidra/Processors/x86/data/languages/ia.sinc b/Ghidra/Processors/x86/data/languages/ia.sinc
index be05a109e8..7e1bfc5403 100644
--- a/Ghidra/Processors/x86/data/languages/ia.sinc
+++ b/Ghidra/Processors/x86/data/languages/ia.sinc
@@ -3621,14 +3621,13 @@ define pcodeop cpuid_brand_part3_info;
                            resultflags(AL); }
 :DAS            is $(LONGMODE_OFF) & vexMode=0 & byte=0x2f       { local oldAL = AL;
                            local oldCF = CF;
-                           CF = 0;
                            local car = ((AL & 0xf) > 9) | AF;
-                           CF = oldCF | (AL < 6); # borrow from AL - 6
+                           local lowBorrow = car & (AL < 6); # borrow from AL - 6, before AL changes
                            AL = AL - 6 * car;
                            AF = car;
                            car = (oldAL > 0x99) | oldCF;
                            AL = AL - 0x60 * car;
-                           CF = car;
+                           CF = car | lowBorrow;
                            resultflags(AL); }
 
 # See 'lockable.sinc' for memory destination, lockable variants
