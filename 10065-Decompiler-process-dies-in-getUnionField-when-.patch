From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: FlashHit <56718716+FlashHit@users.noreply.github.com>
Date: Thu, 29 Oct 2026 20:41:20 +0100
Subject: [PATCH] 10065: Decompiler: process dies in getUnionField when a
 truncated union field has no exact piece

---
 .../Features/Decompiler/src/decompile/cpp/unionresolve.cc   | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/unionresolve.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/unionresolve.cc
index 29d951e01b..30ff53808f 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/unionresolve.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/unionresolve.cc
@@ -954,6 +954,8 @@ Datatype *ScoreUnionFields::scoreTruncation(Datatype *ct,Varnode *vn,int4 offset
   else {
     score = 10;		// If we can find a size match for the truncation
     int8 curOff = offset;
+    if (offset < 0 || offset + vn->getSize() > ct->getSize())
+      ct = (Datatype *)0;		// Truncation is not contained in the field
     while(ct != (Datatype*)0 && (curOff != 0 || ct->getSize() != vn->getSize())) {
       if (ct->getMetatype() == TYPE_INT || ct->getMetatype() == TYPE_UINT) {
 	if (ct->getSize() >= vn->getSize() + curOff) {
@@ -1185,6 +1187,8 @@ ScoreUnionFields::ScoreUnionFields(Funcdata &fd,TypeUnion *unionType,int4 offset
     run();
   computeBestIndex();
   result.resolve = typegrp.getExactPiece(result.resolve, offset, vn->getSize());
+  if (result.resolve == (Datatype *)0)		// The field can't be split at the truncation
+    result.resolve = typegrp.getBase(vn->getSize(), TYPE_UNKNOWN);
 }
 
 /// \brief Score a union data-type against data-flow, where there is an implied truncation
@@ -1224,6 +1228,8 @@ ScoreUnionFields::ScoreUnionFields(Funcdata &fd,TypeUnion *unionType,int4 offset
     run();
   computeBestIndex();
   result.resolve = typegrp.getExactPiece(result.resolve, offset, vn->getSize());
+  if (result.resolve == (Datatype *)0)		// The field can't be split at the truncation
+    result.resolve = typegrp.getBase(vn->getSize(), TYPE_UNKNOWN);
 }
 
 /// If a resolution for the data-type exists along the given edge, it is cached.  Otherwise there is no change.
-- 
2.45.1

