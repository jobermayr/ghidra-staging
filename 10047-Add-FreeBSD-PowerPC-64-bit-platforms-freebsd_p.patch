--- a/GPL/DemanglerGnu/build.gradle
+++ b/GPL/DemanglerGnu/build.gradle
@@ -85,6 +85,8 @@ model {
 			targetPlatform "mac_arm_64"
 			targetPlatform "freebsd_x86_64"
 			targetPlatform "freebsd_arm_64"
+			targetPlatform "freebsd_ppc_64"
+			targetPlatform "freebsd_ppc_64le"
 			targetPlatform "openbsd_x86_64"
 			targetPlatform "openbsd_arm_64"
 			sources {
@@ -112,6 +114,8 @@ model {
 			targetPlatform "mac_arm_64"
 			targetPlatform "freebsd_x86_64"
 			targetPlatform "freebsd_arm_64"
+			targetPlatform "freebsd_ppc_64"
+			targetPlatform "freebsd_ppc_64le"
 			targetPlatform "openbsd_x86_64"
 			targetPlatform "openbsd_arm_64"
 			sources {
diff --git a/GPL/nativePlatforms.gradle b/GPL/nativePlatforms.gradle
index 6ace12f728..61e6d106a6 100644
--- a/GPL/nativePlatforms.gradle
+++ b/GPL/nativePlatforms.gradle
@@ -29,6 +29,8 @@ project.ext.PLATFORMS = [
 	[name: "mac_arm_64", os: "osx", arch: "arm64"],
 	[name: "freebsd_x86_64", os: "freebsd", arch: "x86_64"],
 	[name: "freebsd_arm_64", os: "freebsd", arch: "arm64"],
+	[name: "freebsd_ppc_64", os: "freebsd", arch: "ppc64"],
+	[name: "freebsd_ppc_64le", os: "freebsd", arch: "ppc64le"],
 	[name: "openbsd_x86_64", os: "openbsd", arch: "x86_64"],
 	[name: "openbsd_arm_64", os: "openbsd", arch: "arm64"]
 ]
@@ -86,6 +88,11 @@ ext.getCurrentPlatformName = {
 		case "loongarch64":
 		case "loong64":
 			arch = "loongarch_64"
+		case "ppc64":
+			arch = "ppc_64"
+			break
+		case "ppc64le":
+			arch = "ppc_64le"
 			break
 		default:
 			throw new GradleException("Unrecognized platform architecture: $arch" )
