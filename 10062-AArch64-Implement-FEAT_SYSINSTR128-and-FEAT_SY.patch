Date: Wed, 28 Oct 2026 14:15:21 +0000
Subject: [PATCH] 10062: AArch64: Implement FEAT_SYSINSTR128 and FEAT_SYSREG128
 instructions

Implement FEAT_SYSINSTR128 and FEAT_SYSREG128 instructions
---
 .../AARCH64/data/languages/AARCH64base.sinc   | 511 ++++++++++++++++++
 .../data/languages/AARCH64instructions.sinc   | 126 ++++-
 2 files changed, 636 insertions(+), 1 deletion(-)

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index d21ab6daca..a7fcb91ec4 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -10026,3 +10026,514 @@ is b_1931=0b1101010100001 & b_1618=0b100 & b_1215=0b1000 & b_0811=0b0101 & b_050
 :tlbi "RVALE2OS", Rt_GPR64
 is b_1931=0b1101010100001 & b_1618=0b100 & b_1215=0b1000 & b_0811=0b0101 & b_0507=0b101 & Rt_GPR64
 { TLBI_RVALE2OS(Rt_GPR64); }
+
+# FEAT_SYSREG128
+
+:mrrs Rt_GPR64, Rtt_GPR64, CopReg
+is b_2031=0xd57 & CopReg & Rt_GPR64 & Rtt_GPR64
+{
+    local tmp:16 = zext(CopReg);
+    Rt_GPR64 = tmp:8;
+    tmp = tmp >> 64;
+    Rtt_GPR64 = tmp:8;
+}
+
+:msrr CopReg, Rt_GPR64, Rtt_GPR64
+is b_2031=0xd55 & CopReg & Rt_GPR64 & Rtt_GPR64
+{
+    local tmp:16 = zext(Rt_GPR64) | (zext(Rtt_GPR64) << 64);
+    CopReg = tmp:8;
+}
+
+# FEAT_SYSINSTR128
+
+SysArgs128: Op1_uimm3, CRn_CRx, CRm_CRx, Op2_uimm3, Rt_GPR64, Rtt_GPR64 is Op1_uimm3 & CRn_CRx & CRm_CRx & Op2_uimm3 & aa_Xt & Rt_GPR64 & Rtt_GPR64 { local tmp:16 = zext(Rt_GPR64) | (zext(Rtt_GPR64) << 64); export tmp; }
+SysArgs128: Op1_uimm3, CRn_CRx, CRm_CRx, Op2_uimm3 is Op1_uimm3 & CRn_CRx & CRm_CRx & Op2_uimm3 & aa_Xt=31 { tmp:16 = 0; export tmp; }
+
+:sysp SysArgs128
+is b_1931=0b1101010101001 & Op1_uimm3 & CRn_CRx & CRm_CRx & Op2_uimm3 & SysArgs128
+{
+	tmp1:4 = Op1_uimm3;
+	tmp2:4 = CRn_CRx;
+	tmp3:4 = CRm_CRx;
+	tmp4:4 = Op2_uimm3;
+	SysOp128(tmp1, tmp2, tmp3, tmp4, SysArgs128);
+}
+
