From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joel Pasapera <108155277+JoelPasapera@users.noreply.github.com>
Date: Sat, 7 Nov 2026 21:11:50 -0500
Subject: [PATCH] 10159: Use ~x instead of x ^ -1 in AARCH64 and MSP430X

Add files via upload

Add files via upload
---
 .../AARCH64/data/languages/AARCH64base.sinc          |  4 ++--
 .../Processors/TI_MSP430/data/languages/TI430X.sinc  | 12 ++++++------
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
index eb58261c34..89cc8367ce 100644
--- a/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
+++ b/Ghidra/Processors/AARCH64/data/languages/AARCH64base.sinc
@@ -2323,7 +2323,7 @@ is b_2431=0xd5 & b_2223=0 & l=0 & Op0=0 & Op1=3 & CRn=0x3 & CRm_32 & CRm_10=2 &
 is sf=0 & opc=2 & b_2428=0xa & N=1 & RegShift32Log & Rn_GPR32 & Rd_GPR32 & Rd_GPR64
 {
 	tmp_3:4 = RegShift32Log;
-	tmp_2:4 = tmp_3 ^ -1:4;
+	tmp_2:4 = ~tmp_3;
 	tmp_1:4 = Rn_GPR32 ^ tmp_2;
 	Rd_GPR64 = zext(tmp_1);
 }
@@ -2336,7 +2336,7 @@ is sf=0 & opc=2 & b_2428=0xa & N=1 & RegShift32Log & Rn_GPR32 & Rd_GPR32 & Rd_GP
 is sf=1 & opc=2 & b_2428=0xa & N=1 & Rm_GPR64 & RegShift64Log & Rn_GPR64 & Rd_GPR64
 {
 	tmp_3:8= RegShift64Log;
-	tmp_2:8 = tmp_3 ^ -1:8;
+	tmp_2:8 = ~tmp_3;
 	tmp_1:8 = Rn_GPR64 ^ tmp_2;
 	Rd_GPR64 = tmp_1;
 }
diff --git a/Ghidra/Processors/TI_MSP430/data/languages/TI430X.sinc b/Ghidra/Processors/TI_MSP430/data/languages/TI430X.sinc
index f2df6affbe..39c53d215c 100644
--- a/Ghidra/Processors/TI_MSP430/data/languages/TI430X.sinc
+++ b/Ghidra/Processors/TI_MSP430/data/languages/TI430X.sinc
@@ -1917,7 +1917,7 @@ define pcodeop bcd_add;
 	# Operation Flags...
 	$(OVERFLOW) = DST8_0_4 s< 0x0;	# V Flag
 	# Operation...
-	DST8_0_4 = DST8_0_4 ^ -1;
+	DST8_0_4 = ~DST8_0_4;
 	bzero(reg_Direct16_0_4,DST8_0_4);
 	# Result Flags...
 	$(SIGN) = (DST8_0_4 s< 0x0);			# S Flag
@@ -1934,7 +1934,7 @@ define pcodeop bcd_add;
 	# Operation Flags...
 	$(OVERFLOW) = DST16_0_4 s< 0x0 ;	# V Flag
 	# Operation...
-	DST16_0_4 = DST16_0_4 ^ -1;
+	DST16_0_4 = ~DST16_0_4;
 	wzero(reg_Direct16_0_4,DST16_0_4);
 	# Result Flags...
 	$(SIGN) = (DST16_0_4 s< 0x0);			# S Flag
@@ -1951,7 +1951,7 @@ define pcodeop bcd_add;
 	# Operation Flags...
 	$(OVERFLOW) = DST20_0_4 s< 0x0;	# V Flag
 	# Operation...
-	DST20_0_4 = DST20_0_4 ^ -1;
+	DST20_0_4 = ~DST20_0_4;
 	DST20_0_4 = sext(DST20_0_4[0,20]);
 	# Result Flags...
 	$(SIGN) = DST20_0_4[19, 1] == 1;
@@ -2864,7 +2864,7 @@ define pcodeop bcd_add;
 	# Operation Flags...
 	$(OVERFLOW) = XDEST_B_AD s< 0x0;	# V Flag
 	# Operation...
-	XDEST_B_AD = XDEST_B_AD ^ -1;
+	XDEST_B_AD = ~XDEST_B_AD;
 	build tbl_bzero;
 	# Result Flags...
 	$(SIGN) = (XDEST_B_AD s< 0x0);			# S Flag
@@ -2877,7 +2877,7 @@ define pcodeop bcd_add;
 	# Operation Flags...
 	$(OVERFLOW) = XDEST_W_AD s< 0x0;	# V Flag
 	# Operation...
-	XDEST_W_AD = XDEST_W_AD ^ -1;
+	XDEST_W_AD = ~XDEST_W_AD;
 	build tbl_wzero;
 	# Result Flags...
 	$(SIGN) = (XDEST_W_AD s< 0x0);			# S Flag
@@ -2890,7 +2890,7 @@ define pcodeop bcd_add;
 	# Operation Flags...
 	$(OVERFLOW) = XDEST_A_AD s< 0x0;	# V Flag
 	# Operation...
-	XDEST_A_AD = XDEST_A_AD ^ -1;
+	XDEST_A_AD = ~XDEST_A_AD;
 	XDEST_A_AD = sext(XDEST_A_AD[0,20]);
 	# Result Flags...
 	$(SIGN) = XDEST_A_AD[19, 1] == 1;
-- 
2.45.1

