+  if (op->isIndirectSource()) return 0;
+  const Varnode *vn = op->getOut();
+  if (vn == (const Varnode *)0) return 0;
+  if (!vn->hasNoDescend()) return 0;
+  if (vn->isAutoLive()) return 0;
+  return 1;
+}
