From: ai-hakzarov <226896199+ai-hakzarov@users.noreply.github.com>
Date: Fri, 9 Oct 2026 00:40:31 -0400
Subject: [PATCH] 9762: Decompiler: lane split follows a zero extension forward

LaneDivide::traceForward had no case for INT_ZEXT, so a vector whose top lanes
are cleared with a byte shift up and back down, which the simplifier folds into
a zero extension of the low lanes, kept the whole-register variable and printed
as byte pieces and shifts. The extension's output is now a placeholder of the
enclosing lanes, the traced lanes at the bottom; traceBackward already builds
the zero constants for the rest. A datatest compiled from a few lines of C
covers a vector scaled lane by lane, its top lane cleared by PSLLDQ and PSRLDQ,
and stored.

The zeroload datatest loads a vector whole, stores its first lane alone and
clears its top lane through two shuffles against a zero register before
storing it whole; the shuffles fold into a zero extension of the low three
lanes, and the split now follows it forward from the loaded vector: four
lanes, the last a zero.
---
 .../Decompiler/certification.manifest         |  1 +
 .../Decompiler/src/decompile/cpp/subflow.cc   | 11 +++++++
 .../src/decompile/datatests/zeroload.xml      | 33 +++++++++++++++++++
 3 files changed, 45 insertions(+)
 create mode 100644 Ghidra/Features/Decompiler/src/decompile/datatests/zeroload.xml

diff --git a/Ghidra/Features/Decompiler/certification.manifest b/Ghidra/Features/Decompiler/certification.manifest
index f58db2605f..d03f9d7ad8 100644
--- a/Ghidra/Features/Decompiler/certification.manifest
+++ b/Ghidra/Features/Decompiler/certification.manifest
@@ -133,6 +133,7 @@ src/decompile/datatests/varcross.xml||GHIDRA||||END|
 src/decompile/datatests/volatilemcs96dup.xml||GHIDRA||||END|
 src/decompile/datatests/wayoffarray.xml||GHIDRA||||END|
 src/decompile/datatests/wraprange.xml||GHIDRA||||END|
+src/decompile/datatests/zeroload.xml||GHIDRA||||END|
 src/decompile/datatests/zerotop.xml||GHIDRA||||END|
 src/decompile/zlib/README.txt||GHIDRA||||END|
 src/main/doc/commonprofile.xsl||GHIDRA||||END|
diff --git a/Ghidra/Features/Decompiler/src/decompile/cpp/subflow.cc b/Ghidra/Features/Decompiler/src/decompile/cpp/subflow.cc
index 8186f1fa05..7c10c4a562 100644
--- a/Ghidra/Features/Decompiler/src/decompile/cpp/subflow.cc
+++ b/Ghidra/Features/Decompiler/src/decompile/cpp/subflow.cc
@@ -4029,6 +4029,17 @@ bool LaneDivide::traceForward(TransformVar *rvn,int4 numLanes,int4 skipLanes)
 	// Don't create the placeholder ops, let traceBackward make them
 	break;
       }
+      case CPUI_INT_ZEXT:
+      {
+	// The traced lanes are the low lanes of the extension; the rest are zero lanes, which traceBackward builds
+	int4 outLanes,outSkip;
+	if (!description.extension(numLanes, skipLanes, 0, outvn->getSize(), outLanes, outSkip))
+	  return false;
+	TransformVar *outRvn = setReplacement(outvn,outLanes,outSkip);
+	if (outRvn == (TransformVar *)0) return false;
+	// Don't create the placeholder ops, let traceBackward make them
+	break;
+      }
       case CPUI_STORE:
 	if (op->getIn(2) != origvn) return false;	// Can only propagate through value being stored
 	if (!buildStore(op,numLanes,skipLanes))
diff --git a/Ghidra/Features/Decompiler/src/decompile/datatests/zeroload.xml b/Ghidra/Features/Decompiler/src/decompile/datatests/zeroload.xml
new file mode 100644
index 0000000000..f3a8774246
--- /dev/null
+++ b/Ghidra/Features/Decompiler/src/decompile/datatests/zeroload.xml
@@ -0,0 +1,33 @@
+<decompilertest>
+<binaryimage arch="x86:LE:64:default:gcc">
+<!--
+#include <xmmintrin.h>
+/* a vector loaded whole, its first lane stored alone (so the vector is known to have four-byte lanes), its top lane
+   replaced by zero through two shuffles against a zero register, the result stored whole: the decompiler folds the
+   shuffles into a zero extension of the low three lanes, which the lane split must follow forward from the loaded vector */
+void zeroload(float *out, float *first, const float *in) {
+  __m128 v = _mm_loadu_ps(in);
+  _mm_store_ss(first, v);
+  __m128 t = _mm_shuffle_ps(v, _mm_setzero_ps(), 0x0a);
+  v = _mm_shuffle_ps(v, t, 0x84);
+  _mm_storeu_ps(out, v);
+}
+-->
+<bytechunk space="ram" offset="0x100000" readonly="true">
+554889e50f1002f30f11060f57c90fc6c8200fc6c1240f11075dc3
+</bytechunk>
+<symbol space="ram" offset="0x100000" name="zeroload"/>
+</binaryimage>
+<script>
+  <com>parse line extern void zeroload(float4 *out, float4 *first, float4 *in);</com>
+  <com>lo fu zeroload</com>
+  <com>decompile</com>
+  <com>print C</com>
+</script>
+<stringmatch name="ZeroLoad #1" min="1" max="1">\*first = fVar1;</stringmatch>
+<stringmatch name="ZeroLoad #2" min="1" max="1">\*out = fVar1;</stringmatch>
+<stringmatch name="ZeroLoad #3" min="1" max="1">out\[1\] = fVar2;</stringmatch>
+<stringmatch name="ZeroLoad #4" min="1" max="1">out\[2\] = fVar3;</stringmatch>
+<stringmatch name="ZeroLoad #5" min="1" max="1">out\[3\] = 0.0;</stringmatch>
+<stringmatch name="ZeroLoad #6" min="0" max="0">axVar</stringmatch>
+</decompilertest>
