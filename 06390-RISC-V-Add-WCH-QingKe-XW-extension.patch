diff --git a/Ghidra/Processors/RISCV/data/languages/qingke-xw.slaspec b/Ghidra/Processors/RISCV/data/languages/qingke-xw.slaspec
new file mode 100644
index 0000000000..469db3cd3e
--- /dev/null
+++ b/Ghidra/Processors/RISCV/data/languages/qingke-xw.slaspec
@@ -0,0 +1,32 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 SEL (Mark Thurston). Part of ghidra-qingke-xw.
+#
+# WCH QingKe RV32IMAC + Zba/Zbb/Zbc/Zbs + Zicond + XW + WCH custom, soft-float (ilp32).
+# The included riscv.*.sinc files are unmodified copies from Ghidra 12.1.4
+# (Apache-2.0), qingke.rvc.sinc a marked copy (see NOTICE).
+#
+# The same base as Ghidra's riscv.ilp32d.slaspec, except:
+#   FPSIZE "0"  no F, D or Q, so c.fld/c.fsd/c.fldsp/c.fsdsp (whose slots XW
+#               takes) and c.flw/c.flwsp/c.fsw/c.fswsp are not built;
+#   no V, P or K (the V3V's vector unit is not decoded; V2/V4 have none);
+#   Ghidra's draft bitmanip (riscv.rv32b.sinc) replaced by ratified
+#   Zba/Zbb/Zbc/Zbs with p-code (qingke.zb.sinc); Zicond added;
+#   XW (qingke.xw.sinc) and WCH's custom instructions (qingke.wch.sinc) added.
+
+define endian=little;
+
+@define XLEN 4
+@define XLEN2 8
+@define FLEN 8
+
+@define CONTEXTLEN 4
+
+@define ADDRSIZE "32"
+@define FPSIZE "0"
+
+@include "riscv.reg.sinc"
+@include "riscv.table.sinc"
+@include "qingke.instr.sinc"
+
+# placeholder decode for the custom-0..3 opcodes, as in Ghidra's own variants
+@include "riscv.custom.sinc"
diff --git a/Ghidra/Processors/RISCV/data/languages/qingke.instr.sinc b/Ghidra/Processors/RISCV/data/languages/qingke.instr.sinc
new file mode 100644
index 0000000000..cbff371b77
--- /dev/null
+++ b/Ghidra/Processors/RISCV/data/languages/qingke.instr.sinc
@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 SEL (Mark Thurston). Part of ghidra-qingke-xw.
+#
+# The instruction sets of a QingKe core: RV32IMAC + Zicsr/Zifencei + Zba/Zbb/Zbc/Zbs + Zicond + XW,
+# plus WCH's custom instructions. Ghidra's riscv.instr.sinc includes every extension; this one includes only
+# those a QingKe core has.
+
+@include "riscv.rv32i.sinc"
+@include "riscv.rv32a.sinc"
+@include "riscv.rv32m.sinc"
+# ratified Zba/Zbb/Zbs/Zbc with p-code (not Ghidra's draft riscv.rv32b.sinc)
+@include "qingke.zb.sinc"
+@include "qingke.zicond.sinc"
+
+@include "riscv.csr.sinc"
+@include "riscv.priv.sinc"
+@include "qingke.rvc.sinc"
+@include "riscv.zi.sinc"
+
+@include "qingke.xw.sinc"
+@include "qingke.wch.sinc"
diff --git a/Ghidra/Processors/RISCV/data/languages/qingke.rvc.sinc b/Ghidra/Processors/RISCV/data/languages/qingke.rvc.sinc
new file mode 100644
index 0000000000..760dab64fc
--- /dev/null
+++ b/Ghidra/Processors/RISCV/data/languages/qingke.rvc.sinc
@@ -0,0 +1,379 @@
+# RVC  Standard Extension for Compressed Instructions
+#
+# SPDX-License-Identifier: Apache-2.0
+# MODIFIED for ghidra-qingke-xw (SEL, 2026): a copy of Ghidra 12.1.4's riscv.rvc.sinc
+# (sha256 b01f8c3ed38005724c2d410701fbe5f64c7743f5a14dce228914ba3c7707df4b, Apache-2.0).
+# One change: c.flw and c.flwsp are now built only when FPSIZE is "32" or "64".
+# Ghidra guards them with ADDRSIZE alone, so a soft-float (FPSIZE "0") language
+# would still decode them. Everything else is unchanged.
+
+# c.add d,CV 00009002 0000f003 SIMPLE (0, 0)
+:c.add crd,crs2 is crd & crs2 & cop0001=0x2 & cop1315=0x4 & cop1212=0x1
+{
+	crd = crd + crs2;
+}
+
+# c.addi d,Co 00000001 0000e003 SIMPLE (0, 0)
+# There may be other nop forms here if (cop0711=0) or (cop1212=0 & cop0206=0)
+:c.addi crd,cimmI is crd & cimmI & cop0001=0x1 & cop1315=0x0
+{
+	crd = crd + cimmI;
+}
+
+:c.nop is cop0001=0x1 & cop1315=0x0 & cop0711=0 & cop1212=0 & cop0206=0
+{
+	local NOP:1 = 0;
+	NOP = NOP;
+}
+
+# c.addi16sp Cc,CL 00006101 0000ef83 SIMPLE (0, 0)
+:c.addi16sp sp,caddi16spimm is cop0711=0x2 & caddi16spimm & sp & cop0001=0x1 & cop1315=0x3
+{
+	sp = sp + caddi16spimm;
+}
+
+# c.addi4spn Ct,Cc,CK 00000000 0000e003 SIMPLE (0, 0)
+:c.addi4spn cr0204s,sp,caddi4spnimm is caddi4spnimm & cr0204s & sp & cop0001=0x0 & cop1315=0x0
+{
+	cr0204s = sp + caddi4spnimm;
+}
+
+@if (ADDRSIZE == "64") || (ADDRSIZE == "128")
+# c.addiw d,Co 00002001 0000e003 SIMPLE (64, 0)
+:c.addiw crd,cimmI is crd & cimmI & cop0001=0x1 & cop1315=0x1
+{
+	local tmp:$(XLEN) = crd + cimmI;
+	crd = sext(tmp:$(WXLEN));
+}
+@endif
+
+@if (ADDRSIZE == "64") || (ADDRSIZE == "128")
+# c.addw Cs,Ct 00009c21 0000fc63 SIMPLE (64, 0)
+:c.addw cr0709s,cr0204s is cr0204s & cr0709s & cop0001=0x1 & cop1315=0x4 & cop0506=0x1 & cop1012=0x7
+{
+	local tmp:4 = cr0709s:4 + cr0204s:4;
+	cr0709s = sext(tmp);
+}
+@endif
+
+# c.and Cs,Ct 00008c61 0000fc63 SIMPLE (0, 0)
+:c.and cr0709s,cr0204s is cr0204s & cr0709s & cop0001=0x1 & cop1315=0x4 & cop0506=0x3 & cop1012=0x3
+{
+	cr0709s = cr0709s & cr0204s;
+}
+
+# c.andi Cs,Co 00008801 0000ec03 SIMPLE (0, 0)
+:c.andi cr0709s,cimmI is cimmI & cr0709s & cop0001=0x1 & cop1315=0x4 & cop1011=0x2
+{
+	cr0709s = cr0709s & cimmI;
+}
+
+# c.beqz Cs,Cp 0000c001 0000e003 CONDBRANCH (0, 0)
+:c.beqz cr0709s,cbimm is cbimm & cr0709s & cop0001=0x1 & cop1315=0x6
+{
+	if (cr0709s == 0) goto cbimm;
+}
+
+# c.bnez Cs,Cp 0000e001 0000e003 CONDBRANCH (0, 0)
+:c.bnez cr0709s,cbimm is cbimm & cr0709s & cop0001=0x1 & cop1315=0x7
+{
+	if (cr0709s != 0) goto cbimm;
+}
+
+# c.ebreak  00009002 0000ffff SIMPLE (0, 0)
+:c.ebreak  is cop0001=0x2 & cop1315=0x4 & cop0212=0x400
+{
+	ebreak();
+}
+
+@if ADDRSIZE == "32" || ADDRSIZE == "64"
+@if FPSIZE == "64"
+# c.fld CD,Cl(Cs) 00002000 0000e003 QWORD|DREF (0, 8)
+:c.fld cfr0204s,cldimm(cr0709s) is cfr0204s & cr0709s & cop0001=0x0 & cop1315=0x1 & cldimm
+{
+	local ea:$(XLEN) = cldimm:$(XLEN) + cr0709s;
+	cfr0204s = *[ram]:$(DFLEN) ea;
+}
+
+
+# c.fldsp D,Cn(Cc) 00002002 0000e003 QWORD|DREF (0, 8)
+:c.fldsp cfrd,cldspimm(sp) is cfrd & sp & cop0001=0x2 & cop1315=0x1 & cldspimm
+{
+	local ea:$(XLEN) = cldspimm:$(XLEN) + sp;
+	cfrd = *[ram]:$(DFLEN) ea;
+}
+@endif
+@endif
+
+@if ADDRSIZE == "32"
+@if FPSIZE == "32" || FPSIZE == "64"
+# c.flw CD,Ck(Cs) 00006000 0000e003 DWORD|DREF (32, 4)
+:c.flw cfr0204s,clwimm(cr0709s) is cfr0204s & cr0709s & cop0001=0x0 & cop1315=0x3 & clwimm
+{
+	local ea:$(XLEN) = clwimm:$(XLEN) + cr0709s;
+	cfr0204s = *[ram]:$(SFLEN) ea;
+}
+
+
+# c.flwsp D,Cm(Cc) 00006002 0000e003 DWORD|DREF (32, 4)
+:c.flwsp cfrd,clwspimm(sp) is cfrd & sp & cop0001=0x2 & cop1315=0x3 & clwspimm
+{
+	local ea:$(XLEN) = clwspimm:$(XLEN) + sp;
+	cfrd = *[ram]:$(SFLEN) ea;
+}
+@endif
+@endif
+
+@if ADDRSIZE == "32" || ADDRSIZE == "64"
+@if FPSIZE == "64"
+# c.fsd CD,Cl(Cs) 0000a000 0000e003 QWORD|DREF (0, 8)
+:c.fsd cfr0204s,cldimm(cr0709s) is cfr0204s & cr0709s & cop0001=0x0 & cop1315=0x5 & cldimm
+{
+	local ea:$(XLEN) = cldimm + cr0709s;
+	*[ram]:8 ea = cfr0204s;
+}
+
+# c.fsdsp CT,CN(Cc) 0000a002 0000e003 QWORD|DREF (0, 8)
+:c.fsdsp cfr0206,csdspimm(sp) is cfr0206 & sp & cop0001=0x2 & cop1315=0x5 & csdspimm
+{
+	local ea:$(XLEN) = csdspimm + sp;
+	*[ram]:8 ea = cfr0206;
+}
+@endif
+@endif
+
+@if ADDRSIZE == "32"
+@if FPSIZE == "32" || FPSIZE == "64"
+# c.fsw CD,Ck(Cs) 0000e000 0000e003 DWORD|DREF (32, 4)
+:c.fsw cfr0204s,clwimm(cr0709s) is cfr0204s & cr0709s & cop0001=0x0 & cop1315=0x7 & clwimm
+{
+	local ea:$(XLEN) = clwimm + cr0709s;
+	*[ram]:4 ea = cfr0204s;
+}
+
+# c.fswsp CT,CM(Cc) 0000e002 0000e003 DWORD|DREF (32, 4)
+:c.fswsp cfr0206,cswspimm(sp) is cfr0206 & sp & cop0001=0x2 & cop1315=0x7 & cswspimm
+{
+	local ea:$(XLEN) = cswspimm + sp;
+	*[ram]:4 ea = cfr0206:4;
+}
+@endif
+@endif
+
+# c.j Ca 0000a001 0000e003 BRANCH (0, 0)
+:c.j cjimm is cjimm & cop0001=0x1 & cop1315=0x5
+{
+	goto cjimm;
+}
+
+@if ADDRSIZE == "32"
+# c.jal Ca 00002001 0000e003 JSR (32, 0)
+:c.jal cjimm is cjimm & cop0001=0x1 & cop1315=0x1
+{
+	ra = inst_next;
+	call cjimm;
+}
+@endif
+
+# c.jalr d 00009002 0000f07f JSR (0, 0)
+:c.jalr crd is crd & cop0001=0x2 & cop1315=0x4 & cop0206=0x0 & cop1212=0x1
+{
+	ra = inst_next;
+	call [crd];
+}
+
+# c.jr d 00008002 0000f07f BRANCH (0, 0)
+:c.jr crd is crd & cop0001=0x2 & cop1315=0x4 & cop0206=0x0 & cop1212=0x0
+{
+	goto [crd];
+}
+
+# ret  00008082 0000ffff BRANCH|ALIAS (0, 0)
+:ret is cop0001=0x2 & cop1315=0x4 & cop0206=0x0 & cop1212=0x0 & cop0711=1
+{
+	return [ra];
+}
+
+@if (ADDRSIZE == "64") || (ADDRSIZE == "128")
+# c.ld Ct,Cl(Cs) 00006000 0000e003 QWORD|DREF (64, 8)
+:c.ld cr0204s,cldimm(cr0709s) is cr0709s & cr0204s & cop0001=0x0 & cop1315=0x3 & cldimm
+{
+	local ea:$(XLEN) = cldimm:$(XLEN) + cr0709s;
+	assignD(cr0204s, *[ram]:$(DXLEN) ea);
+}
+@endif
+
+@if ADDRSIZE == "128"
+:c.lq cr0204s,clqimm(cr0709s) is cr0709s & cr0204s & cop0001=0x0 & cop1315=0x1 & clqimm
+{
+	local ea:$(XLEN) = clqimm:$(XLEN) + cr0709s;
+	cr0204s = *[ram]:$(QXLEN) ea;
+}
+@endif
+
+@if (ADDRSIZE == "64") || (ADDRSIZE == "128")
+# c.ldsp d,Cn(Cc) 00006002 0000e003 QWORD|DREF (64, 8)
+:c.ldsp crd,cldspimm(sp) is crd & sp & cop0001=0x2 & cop1315=0x3 & cldspimm
+{
+	local ea:$(XLEN) = cldspimm + sp;
+	assignD(crd, *[ram]:$(DXLEN) ea);
+}
+@endif
+
+@if ADDRSIZE == "128"
+:c.lqsp crd,clqspimm(sp) is crd & sp & cop0001=0x2 & cop1315=0x1 & clqspimm
+{
+	local ea:$(XLEN) = clqspimm + sp;
+	crd = *[ram]:$(QXLEN) ea;
+}
+@endif
+
+# c.li d,Co 00004001 0000e003 SIMPLE (0, 0)
+:c.li crd,cimmI is crd & cimmI & cop0001=0x1 & cop1315=0x2
+{
+	crd = cimmI;
+}
+
+# c.lui d,Cu 00006001 0000e003 SIMPLE (0, 0)
+:c.lui cd0711NoSp,cbigimm is cd0711NoSp & cbigimm & cop0001=0x1 & cop1315=0x3
+{
+	cd0711NoSp = cbigimm;
+}
+
+# c.lw Ct,Ck(Cs) 00004000 0000e003 DWORD|DREF (0, 4)
+:c.lw cr0204s,clwimm(cr0709s) is cr0709s & cr0204s & cop0001=0x0 & cop1315=0x2 & clwimm
+{
+	local ea:$(XLEN) = clwimm + cr0709s;
+	assignW(cr0204s, *[ram]:4 ea);
+}
+
+# c.lwsp d,Cm(Cc) 00004002 0000e003 SIMPLE (0, 0)
+:c.lwsp crd,clwspimm(sp) is crd & sp & cop0001=0x2 & cop1315=0x2 & clwspimm
+{
+	local ea:$(XLEN) = clwspimm + sp;
+	assignW(crd, *[ram]:4 ea);
+}
+
+# c.mv d,CV 00008002 0000f003 SIMPLE (0, 0)
+:c.mv crd,crs2 is crd & crs2 & cop0001=0x2 & cop1315=0x4 & cop1212=0x0
+{
+	crd = crs2;
+}
+
+# c.or Cs,Ct 00008c41 0000fc63 SIMPLE (0, 0)
+:c.or cr0709s,cr0204s is cr0204s & cr0709s & cop0001=0x1 & cop1315=0x4 & cop0506=0x2 & cop1012=0x3
+{
+	cr0709s = cr0709s | cr0204s;
+}
+
+@if (ADDRSIZE == "64") || (ADDRSIZE == "128")
+# c.sd Ct,Cl(Cs) 0000e000 0000e003 QWORD|DREF (64, 8)
+:c.sd cr0204s,cldimm(cr0709s) is cr0709s & cr0204s & cop0001=0x0 & cop1315=0x7 & cldimm
+{
+	local ea:$(XLEN) = cldimm:$(XLEN) + cr0709s;
+	*[ram]:$(DXLEN) ea = cr0204s:$(DXLEN);
+}
+
+# c.sdsp CV,CN(Cc) 0000e002 0000e003 QWORD|DREF (64, 8)
+:c.sdsp crs2,csdspimm(sp) is crs2 & sp & cop0001=0x2 & cop1315=0x7 & csdspimm
+{
+	local ea:$(XLEN) = csdspimm:$(XLEN) + sp;
+	*[ram]:$(DXLEN) ea = crs2:$(DXLEN);
+}
+@endif
+
+# c.slli d,C> 00000002 0000e003 SIMPLE (0, 0)
+:c.slli crd,c6imm is crd & c6imm & cop0001=0x2 & cop1315=0x0
+{
+	crd = crd << c6imm;
+}
+
+#TODO  hint?
+# c.slli64 d 00000002 0000f07f SIMPLE (0, 0)
+:c.slli64 crd is crd & cop0001=0x2 & cop1315=0x0 & cop0206=0x0 & cop1212=0x0
+{
+	crd = crd << 0;
+}
+
+# c.srai Cs,C> 00008401 0000ec03 SIMPLE (0, 0)
+:c.srai cr0709s,c6imm is c6imm & cr0709s & cop0001=0x1 & cop1315=0x4 & cop1011=0x1
+{
+	cr0709s = cr0709s s>> c6imm;
+}
+
+#TODO  hint?
+# c.srai64 Cs 00008401 0000fc7f SIMPLE (0, 0)
+:c.srai64 cr0709s is cr0709s & cop0001=0x1 & cop1315=0x4 & cop0206=0x0 & cop1012=0x1
+{
+	cr0709s = cr0709s s>> 0;
+}
+
+# c.srli Cs,C> 00008001 0000ec03 SIMPLE (0, 0)
+:c.srli cr0709s,c6imm is c6imm & cr0709s & cop0001=0x1 & cop1315=0x4 & cop1011=0x0
+{
+	cr0709s = cr0709s >> c6imm;
+}
+
+#TODO  hint?
+# c.srli64 Cs 00008001 0000fc7f SIMPLE (0, 0)
+:c.srli64 cr0709s is cr0709s & cop0001=0x1 & cop1315=0x4 & cop0206=0x0 & cop1012=0x0
+{
+	cr0709s = cr0709s >> 0;
+}
+
+# c.sub Cs,Ct 00008c01 0000fc63 SIMPLE (0, 0)
+:c.sub cr0709s,cr0204s is cr0204s & cr0709s & cop0001=0x1 & cop1315=0x4 & cop0506=0x0 & cop1012=0x3
+{
+	cr0709s = cr0709s - cr0204s;
+}
+
+@if (ADDRSIZE == "64") || (ADDRSIZE == "128")
+# c.subw Cs,Ct 00009c01 0000fc63 SIMPLE (64, 0)
+:c.subw cr0709s,cr0204s is cr0204s & cr0709s & cop0001=0x1 & cop1315=0x4 & cop0506=0x0 & cop1012=0x7
+{
+	local tmp:4 = cr0709s:4 - cr0204s:4;
+	cr0709s = sext(tmp);
+}
+@endif
+
+# c.sw Ct,Ck(Cs) 0000c000 0000e003 DWORD|DREF (0, 4)
+:c.sw cr0204s,clwimm(cr0709s) is cr0709s & cr0204s & cop0001=0x0 & cop1315=0x6 & clwimm
+{
+	local ea:$(XLEN) = clwimm + cr0709s;
+	*[ram]:4 ea = cr0204s:4;
+}
+
+@if ADDRSIZE == "128"
+:c.sq cr0204s,clqimm(cr0709s) is cr0709s & cr0204s & cop0001=0x0 & cop1315=0x5 & clqimm
+{
+	local ea:$(XLEN) = clqimm + cr0709s;
+	*[ram]:16 ea = cr0204s;
+}
+
+:c.sqsp crs2,csqspimm(sp) is crs2 & sp & cop0001=0x2 & cop1315=0x5 & csqspimm
+{
+	local ea:$(XLEN) = csqspimm + sp;
+	*[ram]:16 ea = crs2;
+}
+@endif
+
+# c.swsp CV,CM(Cc) 0000c002 0000e003 DWORD|DREF (0, 4)
+:c.swsp crs2,cswspimm(sp) is crs2 & sp & cop0001=0x2 & cop1315=0x6 & cswspimm
+{
+	local ea:$(XLEN) = cswspimm + sp;
+	*[ram]:4 ea = crs2:4;
+}
+
+# c.unimp  00000000 0000ffff SIMPLE (0, 0)
+# would be better not to decode as it is used as padding
+#
+# :c.unimp  is cop0001=0x0 & cop1315=0x0 & cop0212=0x0
+#{
+#	trap();
+#}
+
+# c.xor Cs,Ct 00008c21 0000fc63 SIMPLE (0, 0)
+:c.xor cr0709s,cr0204s is cr0204s & cr0709s & cop0001=0x1 & cop1315=0x4 & cop0506=0x1 & cop1012=0x3
+{
+	cr0709s = cr0709s ^ cr0204s;
+}
diff --git a/Ghidra/Processors/RISCV/data/languages/qingke.wch.sinc b/Ghidra/Processors/RISCV/data/languages/qingke.wch.sinc
new file mode 100644
index 0000000000..bb489776fb
--- /dev/null
+++ b/Ghidra/Processors/RISCV/data/languages/qingke.wch.sinc
@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 SEL (Mark Thurston). Part of ghidra-qingke-xw.
+#
+# WCH's own 32-bit custom instructions on QingKe cores.
+#
+# Encodings: WCH's GCC 15 binutils (WCH's RISC-V GCC 15 toolchain v1.4, the copy MounRiver Studio 3.0.0 ships),
+# whose assembler and objdump know mcpy, mrsl, mrslu and wexti; and the CH32V407 Reference
+# Manual V1.3 (EN), 9.2.1.3-9.2.1.4, printed pp.61-62 (rendered 12 Nov 2026), for the delay instruction and mcpy.
+# Each is checked against WCH's objdump or a transcription of the RM table (proof/xwproof.py sweep32).
+#
+# Semantics are written as p-code only where they are proven; the rest are named operations (pcodeop).
+
+define pcodeop mcpy;
+define pcodeop mcpy_src_after;
+define pcodeop mrsl;
+define pcodeop mrslu;
+define pcodeop wexti;
+define pcodeop qk_delay;
+
+# writeable views of rs2 / rs3 (an x0 operand writes a dropped temporary, as Ghidra's rd does)
+qkw2: r2024 is r2024 { export r2024; }
+qkw2: zero is r2024=0 & zero { local tmp:$(XLEN) = 0; export tmp; }
+qkw3: r2731 is r2731 { export r2731; }
+qkw3: zero is r2731=0 & zero { local tmp:$(XLEN) = 0; export tmp; }
+
+# ---- mcpy rs1, rs2, rs3: hardware memory copy (MISC-MEM, funct3 111, rd and bits 26:25 zero)
+# Operands as WCH's compiler uses them (SDK core_riscv.h ASM_MCPY; CH585 __wrap_memcpy): rs1 = source END
+# (exclusive), rs2 = source start, rs3 = destination. RM V1.3 p.61 labels rs1 "destination" and rs3 "end"; a
+# silicon test settled it for the compiler's order (CH32V467 evaluation board, 8 Nov 2026).
+# Measured in the same run: bytes, upward, any alignment; rs1 unchanged; rs3 = dst + (end - src) in every case
+# (n = 0, 1, 256, 1001 unaligned, 1024 from flash, 4096, 8192 with an interrupt). rs2 afterwards was end rounded
+# up to 4 in those cases, which is a pattern, not a definition, so it stays a named operation. Overlap,
+# end < src and faults are not modelled: the copy itself is the named operation mcpy(dst, src, end).
+:mcpy rs1, rs2, rs3 is op0006=0x0f & funct3=0x7 & op0711=0 & op2526=0 & rs1 & rs2 & rs3 & qkw2 & qkw3
+{
+	local end:$(XLEN) = rs1;
+	local src:$(XLEN) = rs2;
+	local dst:$(XLEN) = rs3;
+	mcpy(dst, src, end);
+	qkw3 = dst + (end - src);
+	qkw2 = mcpy_src_after(src, end);
+}
+
+# ---- mrsl / mrslu / wexti rd, rs1, rs2, imm5 (custom-0, funct3 000; bits 26:25 = 11 / 10 / 00; imm5 = 31:27)
+# WCH's assembler encodes them and its objdump decodes them; bits 26:25 = 01 is not an instruction there.
+# Meaning unknown: the QingKe V3 manual's chapter 9 table lists "MRS (shift multiplication custom instruction)"
+# for V3B only, and on a CH32V467 (V3V) all three trap as illegal (silicon test, 8 Nov 2026). Named operations.
+:mrsl rd, rs1, rs2, op2731 is op0006=0x0b & funct3=0x0 & op2526=0x3 & rd & rs1 & rs2 & op2731
+{
+	rd = mrsl(rs1, rs2, op2731:$(XLEN));
+}
+:mrslu rd, rs1, rs2, op2731 is op0006=0x0b & funct3=0x0 & op2526=0x2 & rd & rs1 & rs2 & op2731
+{
+	rd = mrslu(rs1, rs2, op2731:$(XLEN));
+}
+:wexti rd, rs1, rs2, op2731 is op0006=0x0b & funct3=0x0 & op2526=0x0 & rd & rs1 & rs2 & op2731
+{
+	rd = wexti(rs1, rs2, op2731:$(XLEN));
+}
+
+# ---- the custom delay instruction (custom-0, funct3 001), RM V1.3 9.2.1.3 p.61
+#   [31:20] imm[11:0]   [19:15] rs1   [11:9] match   [8] div   [7] sel (1: rs1 + rs2, 0: rs1 + imm)
+# match: 001 load, 010 store, 011 load/store, 100 delay, 110 all (pipeline paused), 111 per the CSR;
+# 000 and 101 are reserved and are left undecoded. The instruction writes no register (there is no rd field).
+# WCH's tools have no mnemonic for it; "qk.delay" is this language's name (LLVM's prefix for QingKe vendor
+# instructions), and the operands are shown raw: qk.delay match, rs1, imm12, div, sel. With sel = 1 the RM does not
+# say which bits hold rs2 (the imm field's low five bits, by the usual layout), so imm12 is shown as it is.
+# Silicon (CH32V467, 8 Nov 2026): "all" with rs1 + imm = N waits N + 1 cycles; rs1 = imm = 0 stalls for
+# seconds; never emit that.
+qkdlymatch: "load"  is op0911=1 { export 1:1; }
+qkdlymatch: "store" is op0911=2 { export 2:1; }
+qkdlymatch: "ldst"  is op0911=3 { export 3:1; }
+qkdlymatch: "delay" is op0911=4 { export 4:1; }
+qkdlymatch: "all"   is op0911=6 { export 6:1; }
+qkdlymatch: "csr"   is op0911=7 { export 7:1; }
+
+# One constructor per match value: SLEIGH ranks constructors by their own fixed bits, not a subtable's, so each
+# must fix bits 11:9 itself to outrank riscv.custom.sinc's placeholder "custom0" (funct3 001).
+macro qkdelay(m, r, i, d, s) {
+	qk_delay(m, r, i, d, s);
+}
+:qk.delay qkdlymatch, rs1, op2031, op0808, op0707 is op0006=0x0b & funct3=0x1 & op0911=1 & qkdlymatch & rs1
+	& op2031 & op0808 & op0707 { qkdelay(qkdlymatch, rs1, op2031:$(XLEN), op0808:1, op0707:1); }
+:qk.delay qkdlymatch, rs1, op2031, op0808, op0707 is op0006=0x0b & funct3=0x1 & op0911=2 & qkdlymatch & rs1
+	& op2031 & op0808 & op0707 { qkdelay(qkdlymatch, rs1, op2031:$(XLEN), op0808:1, op0707:1); }
+:qk.delay qkdlymatch, rs1, op2031, op0808, op0707 is op0006=0x0b & funct3=0x1 & op0911=3 & qkdlymatch & rs1
+	& op2031 & op0808 & op0707 { qkdelay(qkdlymatch, rs1, op2031:$(XLEN), op0808:1, op0707:1); }
+:qk.delay qkdlymatch, rs1, op2031, op0808, op0707 is op0006=0x0b & funct3=0x1 & op0911=4 & qkdlymatch & rs1
+	& op2031 & op0808 & op0707 { qkdelay(qkdlymatch, rs1, op2031:$(XLEN), op0808:1, op0707:1); }
+:qk.delay qkdlymatch, rs1, op2031, op0808, op0707 is op0006=0x0b & funct3=0x1 & op0911=6 & qkdlymatch & rs1
+	& op2031 & op0808 & op0707 { qkdelay(qkdlymatch, rs1, op2031:$(XLEN), op0808:1, op0707:1); }
+:qk.delay qkdlymatch, rs1, op2031, op0808, op0707 is op0006=0x0b & funct3=0x1 & op0911=7 & qkdlymatch & rs1
+	& op2031 & op0808 & op0707 { qkdelay(qkdlymatch, rs1, op2031:$(XLEN), op0808:1, op0707:1); }
diff --git a/Ghidra/Processors/RISCV/data/languages/qingke.xw.sinc b/Ghidra/Processors/RISCV/data/languages/qingke.xw.sinc
new file mode 100644
index 0000000000..5f89d27b06
--- /dev/null
+++ b/Ghidra/Processors/RISCV/data/languages/qingke.xw.sinc
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 SEL (Mark Thurston). Part of ghidra-qingke-xw.
+#
+# WCH QingKe "XW" compressed byte and half-word loads and stores
+# (LLVM: Xwchc, mnemonics qk.c.*; GCC: the "xw" extension).
+#
+# XW takes two kinds of RVC space:
+#   * the RV32DC slots c.fld / c.fsd / c.fldsp / c.fsdsp (quadrants 0 and 2,
+#     funct3 001 and 101). This language has no D, so those constructors are
+#     not built (FPSIZE "0"); and
+#   * quadrant 0, funct3 100, which the base C extension leaves reserved and
+#     Zcb uses for c.lbu/c.lhu/c.lh/c.sb/c.sh. Ghidra 12.1.4 has no Zcb, so
+#     nothing else claims it here. Never give a QingKe language Zcb.
+#
+# Layouts (bit numbers of the 16-bit parcel), from WCH's encoding table
+# (LLVM discourse 79392) and checked against LLVM 23.1.5's decoder:
+#
+#   qk.c.lbu   001 | u[0] u[4:3] | rs1' | u[2:1] | rd'  | 00   u = 0..31
+#   qk.c.sb    101 | u[0] u[4:3] | rs1' | u[2:1] | rs2' | 00   u = 0..31
+#   qk.c.lhu   001 | u[5:3]      | rs1' | u[2:1] | rd'  | 10   u = 0..62 even
+#   qk.c.sh    101 | u[5:3]      | rs1' | u[2:1] | rs2' | 10   u = 0..62 even
+#   qk.c.lbusp 100 | 00 | u[3:0]      | 00 | rd'  | 00         u = 0..15
+#   qk.c.lhusp 100 | 00 | u[3:1] u[4] | 01 | rd'  | 00         u = 0..30 even
+#   qk.c.sbsp  100 | 00 | u[3:0]      | 10 | rs2' | 00         u = 0..15
+#   qk.c.shsp  100 | 00 | u[3:1] u[4] | 11 | rs2' | 00         u = 0..30 even
+#
+# Loads zero-extend (lbu/lhu); there is no signed form.
+
+# byte offset, register base: u[0]=12, u[4:3]=11:10, u[2:1]=6:5
+xwbimm: uimm is cop1212 & cop1011 & cop0506
+    [ uimm = cop1212 | (cop0506 << 1) | (cop1011 << 3); ]
+    { local tmp:$(XLEN) = uimm; export tmp; }
+
+# half-word offset, register base: u[5:3]=12:10, u[2:1]=6:5
+xwhimm: uimm is cop1012 & cop0506
+    [ uimm = (cop0506 << 1) | (cop1012 << 3); ]
+    { local tmp:$(XLEN) = uimm; export tmp; }
+
+# byte offset, sp base: u[3:0]=10:7
+xwbspimm: uimm is cop0710
+    [ uimm = cop0710 + 0; ]
+    { local tmp:$(XLEN) = uimm; export tmp; }
+
+# half-word offset, sp base: u[3:1]=10:8, u[4]=7
+xwhspimm: uimm is cop0707 & cop0808 & cop0910
+    [ uimm = (cop0808 << 1) | (cop0910 << 2) | (cop0707 << 4); ]
+    { local tmp:$(XLEN) = uimm; export tmp; }
+
+
+:qk.c.lbu cr0204s,xwbimm(cr0709s) is cop0001=0x0 & cop1315=0x1 & cr0204s & cr0709s & xwbimm
+{
+	local ea:$(XLEN) = xwbimm + cr0709s;
+	cr0204s = zext(*[ram]:1 ea);
+}
+
+:qk.c.sb cr0204s,xwbimm(cr0709s) is cop0001=0x0 & cop1315=0x5 & cr0204s & cr0709s & xwbimm
+{
+	local ea:$(XLEN) = xwbimm + cr0709s;
+	*[ram]:1 ea = cr0204s:1;
+}
+
+:qk.c.lhu cr0204s,xwhimm(cr0709s) is cop0001=0x2 & cop1315=0x1 & cr0204s & cr0709s & xwhimm
+{
+	local ea:$(XLEN) = xwhimm + cr0709s;
+	cr0204s = zext(*[ram]:2 ea);
+}
+
+:qk.c.sh cr0204s,xwhimm(cr0709s) is cop0001=0x2 & cop1315=0x5 & cr0204s & cr0709s & xwhimm
+{
+	local ea:$(XLEN) = xwhimm + cr0709s;
+	*[ram]:2 ea = cr0204s:2;
+}
+
+:qk.c.lbusp cr0204s,xwbspimm(sp) is cop0001=0x0 & cop1315=0x4 & cop1112=0x0 & cop0506=0x0 & cr0204s & sp & xwbspimm
+{
+	local ea:$(XLEN) = xwbspimm + sp;
+	cr0204s = zext(*[ram]:1 ea);
+}
+
+:qk.c.lhusp cr0204s,xwhspimm(sp) is cop0001=0x0 & cop1315=0x4 & cop1112=0x0 & cop0506=0x1 & cr0204s & sp & xwhspimm
+{
+	local ea:$(XLEN) = xwhspimm + sp;
+	cr0204s = zext(*[ram]:2 ea);
+}
+
+:qk.c.sbsp cr0204s,xwbspimm(sp) is cop0001=0x0 & cop1315=0x4 & cop1112=0x0 & cop0506=0x2 & cr0204s & sp & xwbspimm
+{
+	local ea:$(XLEN) = xwbspimm + sp;
+	*[ram]:1 ea = cr0204s:1;
+}
+
+:qk.c.shsp cr0204s,xwhspimm(sp) is cop0001=0x0 & cop1315=0x4 & cop1112=0x0 & cop0506=0x3 & cr0204s & sp & xwhspimm
+{
+	local ea:$(XLEN) = xwhspimm + sp;
+	*[ram]:2 ea = cr0204s:2;
+}
diff --git a/Ghidra/Processors/RISCV/data/languages/qingke.zb.sinc b/Ghidra/Processors/RISCV/data/languages/qingke.zb.sinc
new file mode 100644
index 0000000000..9db8e6c313
--- /dev/null
+++ b/Ghidra/Processors/RISCV/data/languages/qingke.zb.sinc
@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 SEL (Mark Thurston). Part of ghidra-qingke-xw.
+#
+# Ratified bit manipulation as WCH's QingKe V4 / V3V cores have it: Zba, Zbb, Zbs and Zbc
+# (RISC-V Bitmanip 1.0.0 encodings).
+#
+# Replaces Ghidra 12.1.4's riscv.rv32b.sinc, which is the 0.92 draft: draft names (sbset, sbext, pcnt, grevi,
+# gorci, pack for zext.h), draft-only ops that never became standard (cmov, cmix, fsl, fsr, shfl, gorc, ...;
+# cmov sits on Zicond's czero.eqz encoding), and every constructor "unimpl" with no p-code, so the decompiler
+# stopped at each one.
+#
+# Which extensions: WCH's own per-chip table (MounRiver III WCHAgent mcu_isa.json) gives
+# rv32imac_zba_zbb_zbc_zbs_..._xw for the CH32V4x7 (QingKe V3V) and rv32imafc_zba_zbb_zbc_zbs_xw for the CH32H417.
+# No Zbkb (pack, packh, brev8, zip, unzip): those encodings stay undecoded here, except pack rd, rs1, zero, which
+# is Zbb's zext.h on RV32.
+#
+# Adapted from the same author's Zb file for the RP2350's Hazard3 core: Zbkb dropped, Zbc added. Each encoding is
+# checked against llvm-objdump 23.1.5 and WCH's GCC 15 objdump, and each p-code body by emulation against a
+# reference model (proof/xwproof.py sweep32, emu).
+
+qkshamt: op2024 is op2024 & op2525=0 { local tmp:$(XLEN) = op2024; export tmp; }
+
+# ---- Zba
+:sh1add rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x2 & funct7=0x10 { rd = (rs1 << 1) + rs2; }
+:sh2add rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x4 & funct7=0x10 { rd = (rs1 << 2) + rs2; }
+:sh3add rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x6 & funct7=0x10 { rd = (rs1 << 3) + rs2; }
+
+# ---- Zbb
+:andn rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x7 & funct7=0x20 { rd = rs1 & ~rs2; }
+:orn  rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x6 & funct7=0x20 { rd = rs1 | ~rs2; }
+:xnor rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x4 & funct7=0x20 { rd = ~(rs1 ^ rs2); }
+
+:clz  rd,rs1 is rd & rs1 & op0006=0x13 & funct3=0x1 & funct7=0x30 & op2024=0x0 { rd = lzcount(rs1); }
+:ctz  rd,rs1 is rd & rs1 & op0006=0x13 & funct3=0x1 & funct7=0x30 & op2024=0x1
+{
+	local x:$(XLEN) = rs1;
+	rd = popcount((x & -x) - 1);
+}
+:cpop rd,rs1 is rd & rs1 & op0006=0x13 & funct3=0x1 & funct7=0x30 & op2024=0x2 { rd = popcount(rs1); }
+:sext.b rd,rs1 is rd & rs1 & op0006=0x13 & funct3=0x1 & funct7=0x30 & op2024=0x4 { rd = sext(rs1:1); }
+:sext.h rd,rs1 is rd & rs1 & op0006=0x13 & funct3=0x1 & funct7=0x30 & op2024=0x5 { rd = sext(rs1:2); }
+# zext.h is pack rd, rs1, zero on RV32 (no other pack encoding is decoded: no Zbkb)
+:zext.h rd,rs1 is rd & rs1 & op0006=0x33 & funct3=0x4 & funct7=0x04 & op2024=0x0 { rd = zext(rs1:2); }
+
+:max  rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x6 & funct7=0x05
+{
+	local a:$(XLEN) = rs1; local b:$(XLEN) = rs2;
+	rd = a ^ ((a ^ b) & (0 - zext(a s< b)));
+}
+:maxu rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x7 & funct7=0x05
+{
+	local a:$(XLEN) = rs1; local b:$(XLEN) = rs2;
+	rd = a ^ ((a ^ b) & (0 - zext(a < b)));
+}
+:min  rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x4 & funct7=0x05
+{
+	local a:$(XLEN) = rs1; local b:$(XLEN) = rs2;
+	rd = a ^ ((a ^ b) & (0 - zext(b s< a)));
+}
+:minu rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x5 & funct7=0x05
+{
+	local a:$(XLEN) = rs1; local b:$(XLEN) = rs2;
+	rd = a ^ ((a ^ b) & (0 - zext(b < a)));
+}
+
+:rol  rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x1 & funct7=0x30
+{
+	local x:$(XLEN) = rs1; local s:$(XLEN) = rs2 & 31;
+	rd = (x << s) | (x >> ((32 - s) & 31));
+}
+:ror  rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x5 & funct7=0x30
+{
+	local x:$(XLEN) = rs1; local s:$(XLEN) = rs2 & 31;
+	rd = (x >> s) | (x << ((32 - s) & 31));
+}
+:rori rd,rs1,qkshamt is rd & rs1 & qkshamt & op0006=0x13 & funct3=0x5 & op2631=0x18
+{
+	local x:$(XLEN) = rs1; local s:$(XLEN) = qkshamt;
+	rd = (x >> s) | (x << ((32 - s) & 31));
+}
+
+:orc.b rd,rs1 is rd & rs1 & op0006=0x13 & funct3=0x5 & op2031=0x287
+{
+	local x:$(XLEN) = rs1;
+	local b0:1 = x:1; local b1:1 = x(1); local b2:1 = x(2); local b3:1 = x(3);
+	rd = (zext(b0 != 0) * 0xff) | ((zext(b1 != 0) * 0xff) << 8) | ((zext(b2 != 0) * 0xff) << 16)
+		| ((zext(b3 != 0) * 0xff) << 24);
+}
+:rev8 rd,rs1 is rd & rs1 & op0006=0x13 & funct3=0x5 & op2031=0x698
+{
+	local x:$(XLEN) = rs1;
+	rd = (x >> 24) | ((x >> 8) & 0xff00) | ((x << 8) & 0xff0000) | (x << 24);
+}
+
+# ---- Zbs
+:bclr rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x1 & funct7=0x24 { rd = rs1 & ~(1 << (rs2 & 31)); }
+:bext rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x5 & funct7=0x24 { rd = (rs1 >> (rs2 & 31)) & 1; }
+:binv rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x1 & funct7=0x34 { rd = rs1 ^ (1 << (rs2 & 31)); }
+:bset rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x1 & funct7=0x14 { rd = rs1 | (1 << (rs2 & 31)); }
+:bclri rd,rs1,qkshamt is rd & rs1 & qkshamt & op0006=0x13 & funct3=0x1 & op2631=0x12 { rd = rs1 & ~(1 << qkshamt); }
+:bexti rd,rs1,qkshamt is rd & rs1 & qkshamt & op0006=0x13 & funct3=0x5 & op2631=0x12 { rd = (rs1 >> qkshamt) & 1; }
+:binvi rd,rs1,qkshamt is rd & rs1 & qkshamt & op0006=0x13 & funct3=0x1 & op2631=0x1a { rd = rs1 ^ (1 << qkshamt); }
+:bseti rd,rs1,qkshamt is rd & rs1 & qkshamt & op0006=0x13 & funct3=0x1 & op2631=0x0a { rd = rs1 | (1 << qkshamt); }
+
+# ---- Zbc
+# Carry-less multiply. P-code has no carry-less multiply; written out it is a 32-step loop that the decompiler
+# would print inline at every use, so these are named operations (standard semantics, RISC-V Bitmanip 1.0.0
+# 2.3): clmul = low 32 bits of the 64-bit carry-less product, clmulh = high 32 bits, clmulr = bits 62..31.
+define pcodeop clmul;
+define pcodeop clmulh;
+define pcodeop clmulr;
+:clmul  rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x1 & funct7=0x05 { rd = clmul(rs1, rs2); }
+:clmulr rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x2 & funct7=0x05 { rd = clmulr(rs1, rs2); }
+:clmulh rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x3 & funct7=0x05 { rd = clmulh(rs1, rs2); }
diff --git a/Ghidra/Processors/RISCV/data/languages/qingke.zicond.sinc b/Ghidra/Processors/RISCV/data/languages/qingke.zicond.sinc
new file mode 100644
index 0000000000..d4dc7d9e25
--- /dev/null
+++ b/Ghidra/Processors/RISCV/data/languages/qingke.zicond.sinc
@@ -0,0 +1,21 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 SEL (Mark Thurston). Part of ghidra-qingke-xw.
+#
+# Zicond (RISC-V Integer Conditional Operations 1.0.0): czero.eqz, czero.nez.
+#
+# QingKe V3V has it: czero gave the specified results on a CH32V467 evaluation board (8 Nov 2026); that part's
+# MIMPID read 0xdc688003, whose low byte 3 the QingKe V3 manual ties to Zicond.
+# Older QingKe cores do not have it; there these encodings are illegal, so decoding them costs nothing.
+#
+# Ghidra 12.1.4's draft bitmanip file put "cmov" (no p-code) on czero.eqz's encoding; that file is not used here.
+
+:czero.eqz rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x5 & funct7=0x07
+{
+	local c:$(XLEN) = zext(rs2 != 0);
+	rd = rs1 * c;
+}
+:czero.nez rd,rs1,rs2 is rd & rs1 & rs2 & op0006=0x33 & funct3=0x7 & funct7=0x07
+{
+	local c:$(XLEN) = zext(rs2 == 0);
+	rd = rs1 * c;
+}
diff --git a/Ghidra/Processors/RISCV/ghidra_scripts/DecompileCheck.java b/Ghidra/Processors/RISCV/ghidra_scripts/DecompileCheck.java
new file mode 100644
index 0000000000..debe843cbc
--- /dev/null
+++ b/Ghidra/Processors/RISCV/ghidra_scripts/DecompileCheck.java
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 SEL (Mark Thurston). Part of ghidra-qingke-xw.
+//
+// Decompile every function of the current program and record, per function, whether the decompiler
+// succeeded, whether its C uses a floating-point type, and how many distinct in_* / unaff_* variables it
+// shows (registers read before anything in the function wrote them; a load decoded into the wrong
+// register file leaves its real destination looking unset). Headless only.
+//
+// Argument: <out.tsv>, appended to (one run may import many objects).
+// Output lines: program  function  ok|FAIL  float|-  nUnset  unsetNames  error  nHaltUnimplemented
+//@category QingKeXW
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+
+import ghidra.app.decompiler.DecompInterface;
+import ghidra.app.decompiler.DecompileResults;
+import ghidra.app.script.GhidraScript;
+import ghidra.program.model.listing.Function;
+
+public class DecompileCheck extends GhidraScript {
+
+	@Override
+	protected void run() throws Exception {
+		String[] args = getScriptArgs();
+		DecompInterface di = new DecompInterface();
+		di.openProgram(currentProgram);
+		int ok = 0, fail = 0, fl = 0;
+		try (PrintWriter out = new PrintWriter(new BufferedWriter(new OutputStreamWriter(
+			new FileOutputStream(args[0], true), StandardCharsets.UTF_8)))) {
+			out.println("# language\t" + currentProgram.getName() + "\t" + currentProgram.getLanguageID());
+			for (Function f : currentProgram.getFunctionManager().getFunctions(true)) {
+				monitor.checkCancelled();
+				if (f.isExternal() || f.isThunk()) {
+					continue;
+				}
+				DecompileResults r = di.decompileFunction(f, 60, monitor);
+				boolean good = r != null && r.decompileCompleted() && r.getDecompiledFunction() != null;
+				String c = good ? r.getDecompiledFunction().getC() : "";
+				boolean usesFloat = c.matches("(?s).*\\b(float|double|float10|float8|float4)\\b.*");
+				String err = (r == null || r.getErrorMessage() == null) ? ""
+						: r.getErrorMessage().replace('\n', ' ').replace('\t', ' ');
+				java.util.TreeSet<String> unset = new java.util.TreeSet<>();
+				java.util.regex.Matcher m =
+					java.util.regex.Pattern.compile("\\b(?:in|unaff)_[A-Za-z0-9_]+").matcher(c);
+				while (m.find()) {
+					unset.add(m.group());
+				}
+				// an instruction with no p-code ("unimpl") makes the decompiler emit halt_unimplemented()
+				int halts = 0;
+				java.util.regex.Matcher h = java.util.regex.Pattern.compile("\\bhalt_unimplemented\\b").matcher(c);
+				while (h.find()) {
+					halts++;
+				}
+				out.println(currentProgram.getName() + "\t" + f.getName() + "\t" + (good ? "ok" : "FAIL") +
+					"\t" + (usesFloat ? "float" : "-") + "\t" + unset.size() + "\t" + String.join(",", unset) +
+					"\t" + err + "\t" + halts);
+				if (good) {
+					ok++;
+				}
+				else {
+					fail++;
+				}
+				if (usesFloat) {
+					fl++;
+				}
+			}
+		}
+		di.dispose();
+		println("DecompileCheck: " + currentProgram.getName() + " " + ok + " ok, " + fail + " failed, " + fl +
+			" with float types");
+	}
+}
diff --git a/Ghidra/Processors/RISCV/ghidra_scripts/DumpLinear.java b/Ghidra/Processors/RISCV/ghidra_scripts/DumpLinear.java
new file mode 100644
index 0000000000..497246a364
--- /dev/null
+++ b/Ghidra/Processors/RISCV/ghidra_scripts/DumpLinear.java
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 SEL (Mark Thurston). Part of ghidra-qingke-xw.
+//
+// Linear-sweep dump of every instruction Ghidra's language decodes, for the
+// ghidra-qingke-xw proofs. Headless only.
+//
+// Arguments: <out.tsv> [<regions.tsv>]
+//   regions.tsv: one region per line, "name<TAB>startHex<TAB>endHex", offsets
+//   from the program's minimum address; each is swept on its own, from its
+//   start, the way llvm-objdump sweeps a section. Without it, every
+//   initialized block with execute permission is swept.
+// Output, one line per decode attempt:
+//   region  offsetHex  length  bytesHex  text  pcode
+// text is "BAD" where Ghidra decodes nothing; the sweep then steps 2 bytes.
+// pcode is written only for qk.* instructions (to check their semantics).
+//@category QingKeXW
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+
+import ghidra.app.script.GhidraScript;
+import ghidra.app.util.PseudoDisassembler;
+import ghidra.app.util.PseudoInstruction;
+import ghidra.program.model.address.Address;
+import ghidra.program.model.mem.MemoryBlock;
+import ghidra.program.model.pcode.PcodeOp;
+
+public class DumpLinear extends GhidraScript {
+
+	private static String hex(byte[] b) {
+		StringBuilder sb = new StringBuilder();
+		for (byte x : b) {
+			sb.append(String.format("%02x", x & 0xff));
+		}
+		return sb.toString();
+	}
+
+	@Override
+	protected void run() throws Exception {
+		String[] args = getScriptArgs();
+		if (args.length < 1) {
+			throw new IllegalArgumentException("usage: DumpLinear <out.tsv> [<regions.tsv>]");
+		}
+		Address base = currentProgram.getMinAddress();
+		List<String[]> regions = new ArrayList<>();
+		if (args.length >= 2) {
+			for (String line : java.nio.file.Files.readAllLines(new File(args[1]).toPath(),
+				StandardCharsets.UTF_8)) {
+				if (line.isBlank()) {
+					continue;
+				}
+				regions.add(line.split("\t"));
+			}
+		}
+		else {
+			for (MemoryBlock b : currentProgram.getMemory().getBlocks()) {
+				if (b.isInitialized() && b.isExecute()) {
+					long s = b.getStart().subtract(base);
+					long e = b.getEnd().subtract(base) + 1;
+					regions.add(new String[] { b.getName(), Long.toHexString(s), Long.toHexString(e) });
+				}
+			}
+		}
+		PseudoDisassembler pd = new PseudoDisassembler(currentProgram);
+		long count = 0, bad = 0;
+		try (PrintWriter out = new PrintWriter(new BufferedWriter(new OutputStreamWriter(
+			new FileOutputStream(args[0]), StandardCharsets.UTF_8)))) {
+			out.println("# language\t" + currentProgram.getLanguageID() + "\t" +
+				currentProgram.getCompilerSpec().getCompilerSpecID());
+			for (String[] r : regions) {
+				String name = r[0];
+				long start = Long.parseLong(r[1], 16);
+				long end = Long.parseLong(r[2], 16);
+				long off = start;
+				out.println("# region\t" + name + "\t" + Long.toHexString(base.add(start).getOffset()));
+				while (off < end) {
+					monitor.checkCancelled();
+					Address a = base.add(off);
+					PseudoInstruction ins = null;
+					try {
+						ins = pd.disassemble(a);
+					}
+					catch (Exception ex) {
+						ins = null;
+					}
+					if (ins != null && off + ins.getLength() <= end) {
+						int len = ins.getLength();
+						String text = ins.toString();
+						String pc = "";
+						if (ins.getMnemonicString().startsWith("qk.")) {
+							StringBuilder sb = new StringBuilder();
+							for (PcodeOp op : ins.getPcode()) {
+								if (sb.length() > 0) {
+									sb.append(" ; ");
+								}
+								sb.append(op.toString());
+							}
+							pc = sb.toString();
+						}
+						out.println(name + "\t" + Long.toHexString(off - start) + "\t" + len + "\t" +
+							hex(ins.getBytes()) + "\t" + text + "\t" + pc);
+						off += len;
+						count++;
+					}
+					else {
+						int n = (int) Math.min(2, end - off);
+						byte[] b = new byte[n];
+						currentProgram.getMemory().getBytes(a, b);
+						out.println(name + "\t" + Long.toHexString(off - start) + "\t" + n + "\t" +
+							hex(b) + "\tBAD\t");
+						off += n;
+						bad++;
+					}
+				}
+			}
+		}
+		println("DumpLinear: " + count + " decoded, " + bad + " BAD, " + regions.size() + " regions -> " +
+			args[0]);
+	}
+}
diff --git a/Ghidra/Processors/RISCV/ghidra_scripts/EmuCheck.java b/Ghidra/Processors/RISCV/ghidra_scripts/EmuCheck.java
new file mode 100644
index 0000000000..cd38b4db9f
--- /dev/null
+++ b/Ghidra/Processors/RISCV/ghidra_scripts/EmuCheck.java
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 SEL (Mark Thurston). Part of ghidra-qingke-xw.
+//
+// Run single instructions through Ghidra's p-code emulator, for the ghidra-qingke-xw "emu" proof.
+// Headless only.
+//
+// Arguments: <cases.tsv> <out.tsv>
+//   The program is a raw blob of instruction words loaded at 0. Each case line:
+//     id  offsetHex  a0Hex  a1Hex  a2Hex
+//   The script sets a0, a1, a2, sets pc to the offset, steps one instruction and writes:
+//     id  a0Hex  a1Hex  a2Hex  pcHex  events
+//   events lists every CALLOTHER (named operation) the instruction ran, ";"-separated, as
+//     name(in1,in2,...)->outRegister
+//   with each input's value in hex. A named operation with an output writes 5eed0000 + its sequence number
+//   into it, so the caller can see where the output went. An error writes "ERROR <message>".
+//@category QingKeXW
+
+import java.io.*;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+
+import ghidra.app.emulator.EmulatorHelper;
+import ghidra.app.script.GhidraScript;
+import ghidra.pcode.emulate.BreakCallBack;
+import ghidra.pcode.memstate.MemoryState;
+import ghidra.pcode.pcoderaw.PcodeOpRaw;
+import ghidra.program.model.address.Address;
+import ghidra.program.model.lang.Register;
+import ghidra.program.model.pcode.Varnode;
+
+public class EmuCheck extends GhidraScript {
+
+	private final List<String> events = new ArrayList<>();
+	private int seq = 0;
+
+	@Override
+	protected void run() throws Exception {
+		String[] args = getScriptArgs();
+		if (args.length != 2) {
+			throw new IllegalArgumentException("usage: EmuCheck <cases.tsv> <out.tsv>");
+		}
+		Address base = currentProgram.getMinAddress();
+		EmulatorHelper emu = new EmulatorHelper(currentProgram);
+		BreakCallBack cb = new BreakCallBack() {
+			@Override
+			public boolean pcodeCallback(PcodeOpRaw op) {
+				MemoryState ms = emulate.getMemoryState();
+				String name = emulate.getLanguage().getUserDefinedOpName((int) op.getInput(0).getOffset());
+				StringBuilder sb = new StringBuilder(name).append('(');
+				for (int i = 1; i < op.getNumInputs(); i++) {
+					Varnode in = op.getInput(i);
+					long v = in.isConstant() ? in.getOffset() : ms.getValue(in);
+					if (in.getSize() < 8) {
+						v &= (1L << (8 * in.getSize())) - 1;
+					}
+					sb.append(i > 1 ? "," : "").append(Long.toHexString(v));
+				}
+				sb.append(')');
+				Varnode out = op.getOutput();
+				if (out != null) {
+					Register r = currentProgram.getLanguage().getRegister(out.getAddress(), out.getSize());
+					sb.append("->").append(r != null ? r.getName() : out.toString());
+					ms.setValue(out, 0x5eed0000L + seq);
+				}
+				seq++;
+				events.add(sb.toString());
+				return true;
+			}
+		};
+		emu.registerDefaultCallOtherCallback(cb);
+		int n = 0, err = 0;
+		try (PrintWriter out = new PrintWriter(new BufferedWriter(new OutputStreamWriter(
+			new FileOutputStream(args[1]), StandardCharsets.UTF_8)))) {
+			out.println("# language\t" + currentProgram.getLanguageID());
+			for (String line : java.nio.file.Files.readAllLines(new File(args[0]).toPath(),
+				StandardCharsets.UTF_8)) {
+				if (line.isBlank() || line.startsWith("#")) {
+					continue;
+				}
+				monitor.checkCancelled();
+				String[] f = line.split("\t");
+				events.clear();
+				seq = 0;
+				try {
+					emu.writeRegister("a0", new BigInteger(f[2], 16));
+					emu.writeRegister("a1", new BigInteger(f[3], 16));
+					emu.writeRegister("a2", new BigInteger(f[4], 16));
+					emu.writeRegister(emu.getPCRegister(), base.add(Long.parseLong(f[1], 16)).getOffset());
+					if (!emu.step(monitor)) {
+						throw new IllegalStateException("step failed: " + emu.getLastError());
+					}
+					out.println(f[0] + "\t" + emu.readRegister("a0").toString(16) + "\t" +
+						emu.readRegister("a1").toString(16) + "\t" + emu.readRegister("a2").toString(16) + "\t" +
+						emu.readRegister(emu.getPCRegister()).toString(16) + "\t" + String.join(";", events));
+				}
+				catch (Exception ex) {
+					out.println(f[0] + "\tERROR " + String.valueOf(ex.getMessage()).replace('\t', ' ')
+						.replace('\n', ' '));
+					err++;
+				}
+				n++;
+			}
+		}
+		emu.dispose();
+		println("EmuCheck: " + n + " cases, " + err + " errors -> " + args[1]);
+	}
+}
-- 
