From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Laxmi Narayan Behera <lnb@lnbfederal.com>
Date: Sat, 7 Nov 2026 06:30:44 -0500
Subject: [PATCH] 10152: Honor CFLAGS, CXXFLAGS and LDFLAGS in native builds

Honor environment flags in native builds
---
 GPL/nativeBuildProperties.gradle | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/GPL/nativeBuildProperties.gradle b/GPL/nativeBuildProperties.gradle
index ccdbf74b68..e43d06fa55 100644
--- a/GPL/nativeBuildProperties.gradle
+++ b/GPL/nativeBuildProperties.gradle
@@ -18,6 +18,23 @@
 apply plugin: 'cpp'
 apply plugin: 'c'
 
+// Append environment flags after each binary's default flags have been configured.
+model {
+	binaries {
+		afterEach { binary ->
+			if (binary.toolChain in Gcc || binary.toolChain in Clang) {
+				def flags = { name ->
+					org.apache.tools.ant.types.Commandline.translateCommandline(
+						providers.environmentVariable(name).getOrElse(''))
+				}
+				binary.cCompiler.args flags('CFLAGS')
+				binary.cppCompiler.args flags('CXXFLAGS')
+				binary.linker.args flags('LDFLAGS')
+			}
+		}
+	}
+}
+
 /****************************************************************************
  * Defines the platforms we have to support in Ghidra.  This model is used 
  * for all native builds and should be extended by each module as-needed.
-- 
2.45.1

