+    if ((c >= '0') && (c <= '9'))
+      digit = c - '0';
+    else if (isHex && (c >= 'a') && (c <= 'f'))
+      digit = c - 'a' + 10;
+    else if (isHex && (c >= 'A') && (c <= 'F'))
+      digit = c - 'A' + 10;
+    else
+      return -1;
 
-  if (ref[0]=='x') {
-    i = 1;
-    mult = 16;
-  }
-  else {
-    i = 0;
-    mult = 10;
+    // Check before multiplying and adding to prevent overflow.
+    if (val > (maxCodePoint - digit) / base)
+      return -1;
+    val = val * base + digit;
   }
-  val = 0;
-  for(;i<ref.size();++i) {
-    if (ref[i]<='9') cur = ref[i]-'0';
-    else if (ref[i]<='F') cur = 10+ref[i]-'A';
-    else cur=10+ref[i]-'a';
-    val *= mult;
-    val += cur;
-  }
-  return val;
+
+  if (!isXmlChar(val))
