@@ -329,8 +329,10 @@ macro set_CY_neg(op1, op2)
 
 macro set_CY_neg2(op1, op2, carryIn)
 {
-	local res = op2 + carryIn;
-	$(CY) = (op1 < res);
+	local borrow1:1 = (op1 < op2);
+	local partial = op1 - op2;
+	local borrow2:1 = (partial < carryIn);
+	$(CY) = borrow1 || borrow2;
 }
 
 
@@ -410,12 +412,22 @@ macro set_OV0_S_Z(var)
 # if condition is != 0
 
 macro either_or(res, cond, trueVal, falseVal) {
-	res = zext(cond) * trueVal | zext(!cond) * falseVal;	
+	if (cond != 0) goto <true_case>;
+	res = falseVal;
+	goto <done>;
+	<true_case>
+	res = trueVal;
+	<done>
 }
 # if condition is == 1
 macro either_or1(res, cond, trueVal, falseVal)
 {
-	res = (trueVal * zext(cond == 1)) + (falseVal * zext(cond != 1));
+	if (cond == 1) goto <true_case>;
+	res = falseVal;
+	goto <done>;
+	<true_case>
+	res = trueVal;
+	<done>
 }
 
 macro shift_right_logic(res, var, shift_)
@@ -481,7 +493,7 @@ macro popsp(reg)
 macro SearchRight(res, var, char)
 {
 	local var_:4 = var;
-	res = 0;
+	res = 1;
 
 	<loop>
 	if ((var_ & 0x1) == char)
@@ -490,7 +502,7 @@ macro SearchRight(res, var, char)
 	var_ = var_ >> 1;
 	res = res + 1;
 
-	if (res < 32)
+	if (res <= 32)
 		goto <loop>;
 	
 	res = 0;
@@ -501,7 +513,7 @@ macro SearchRight(res, var, char)
 macro SearchLeft(res, var, char)
 {
 	local var_:4 = var;
-	res = 0;
+	res = 1;
 
 	<loop>
 	if ((var_ >> 31) == char) 
@@ -510,7 +522,7 @@ macro SearchLeft(res, var, char)
 	var_ = var_ << 1;
 	res = res + 1;
 
-	if (res < 32) 
+	if (res <= 32) 
 		goto <loop>;
 
 	res = 0;
