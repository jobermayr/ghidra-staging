From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rudy Celekli <rudy@gradiahq.com>
Date: Tue, 13 Oct 2026 11:13:29 -0400
Subject: [PATCH] 9840: Set corresponding x87 high bits on MMX register writes

Use attached x87 upper operands for MMX writes

AI-generated by OpenAI Codex.

fix: use x87 high-word aliases for MMX destination writes
---
 Ghidra/Processors/x86/data/languages/ia.sinc | 918 ++++++++++---------
 1 file changed, 462 insertions(+), 456 deletions(-)

diff --git a/Ghidra/Processors/x86/data/languages/ia.sinc b/Ghidra/Processors/x86/data/languages/ia.sinc
index e0c02f0df0..cffb42f405 100644
--- a/Ghidra/Processors/x86/data/languages/ia.sinc
+++ b/Ghidra/Processors/x86/data/languages/ia.sinc
@@ -99,10 +99,8 @@ define register offset=0x1150 size=10  [ ST5 ];
 define register offset=0x1160 size=10  [ ST6 ];
 define register offset=0x1170 size=10  [ ST7 ];
 
-# NOTE: The upper 16-bits of the x87 ST registers go unused in MMX.
-# These upper 16-bits should be set to all ones by any MMX instruction, which correspond to the 
-# floating-point representation of NaNs or infinities.  
-# Although not currently modeled, the 2-byte ST0h..ST7h registers are provided for that purpose.
+# MMX destination writes set the corresponding x87 upper 16 bits to all ones.
+# MMX reads and EMMS leave these bits unchanged; ST0h..ST7h model the upper bits.
                                                                
 define register offset=0x1100 size=8   [ MM0 _ MM1 _ MM2 _ MM3 _ MM4 _ MM5 _ MM6 _ MM7 _ ];
 define register offset=0x1100 size=4   [
@@ -592,6 +590,8 @@ define token modrm (8)
   mmxreg        = (3,5)
   mmxreg1       = (3,5)
   mmxreg2       = (0,2)
+  mmxUpper      = (3,5)
+  mmxUpper2     = (0,2)
   xmmmod        = (6,7)
   xmmreg        = (3,5)
   ymmreg        = (3,5)
@@ -728,6 +728,7 @@ attach variables creg  [ CR0 _ CR2 CR3 CR4 _ _ _ ];
 attach values ss  [ 1 2 4 8];
 
 attach variables [ mmxreg mmxreg1 mmxreg2 ] [ MM0 MM1 MM2 MM3 MM4 MM5 MM6 MM7 ];
+attach variables [ mmxUpper mmxUpper2 ] [ ST0h ST1h ST2h ST3h ST4h ST5h ST6h ST7h ];
 
 attach variables [ xmmreg xmmreg1 xmmreg2 xmm_vsib ] [ XMM0 XMM1 XMM2 XMM3 XMM4 XMM5 XMM6 XMM7 ];
 
@@ -1315,6 +1316,11 @@ Reg32_m8:     m8        is m8                                { local tmp:4 = zex
 Reg32_m16:    Rmr32     is mod=3 & Rmr32                     { export Rmr32; }
 Reg32_m16:    m16       is m16                               { local tmp:4 = zext(m16); export tmp; }
 
+# AI-generated by OpenAI Codex.
+# Write-only MMX operands retain the low 64-bit alias and update the x87 high bits.
+MmxRegDest: mmxreg is mmxreg & mmxUpper { mmxUpper = 0xffff; export mmxreg; }
+MmxRmDest: mmxreg2 is mmxreg2 & mmxUpper2 { mmxUpper2 = 0xffff; export mmxreg2; }
+
 mmxreg2_m64:  mmxreg2   is mod=3 & mmxreg2                   { export mmxreg2; }
 mmxreg2_m64:  m64       is m64                               { export m64; }
 
