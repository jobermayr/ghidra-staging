diff --git a/Ghidra/Processors/6502/src/test/java/ghidra/program/emulation/M6502FlagsAndPointerWrapTest.java b/Ghidra/Processors/6502/src/test/java/ghidra/program/emulation/M6502FlagsAndPointerWrapTest.java
new file mode 100644
index 00000000000..14a125faf22
--- /dev/null
+++ b/Ghidra/Processors/6502/src/test/java/ghidra/program/emulation/M6502FlagsAndPointerWrapTest.java
@@ -0,0 +1,123 @@
+/* ###
